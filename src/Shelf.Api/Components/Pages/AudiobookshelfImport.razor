@page "/import/audiobookshelf"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject IDbContextFactory<ShelfDb> DbFactory
@inject IHttpClientFactory Http
@inject AbsImporter Importer
@inject AbsKeeper Keeper
@inject IEmailSender Email
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Audiobookshelf · Shelf</PageTitle>

<p class="hint"><a href="/backup">@T("Backup & restore")</a></p>
<h1>@T("Bring books from Audiobookshelf")</h1>
<p class="hint">@T("Copies audiobooks and e-books from an Audiobookshelf server to your shelf: their files, covers, series, and genres, and, if you like, where you stopped, your bookmarks, your listening history, and your collections. Nothing on the Audiobookshelf server changes. Books already on your shelf don't come again.") <a href="https://www.audiobookshelf.org" rel="noopener">audiobookshelf.org</a></p>
<p class="hint">@T("Everyone on this shelf brings their own: each signs in to Shelf as themselves and connects their own Audiobookshelf account here.")</p>

@if (kept is { } sync)
{
    @* A library kept in step: what was last found, and a way to look now or to stop. *@
    <section class="panel" aria-labelledby="kept-heading">
        <h2 id="kept-heading">@T("Kept in step")</h2>
        <p>@T("Every day, books new to {0} on {1} come across to your shelf.", sync.LibraryName, sync.Server)</p>
        <p class="hint" role="status">
            @if (sync.Problem is { } trouble)
            {
                <span class="validation-message">@trouble</span>
            }
            else if (sync.CheckedAt is DateTimeOffset checkedAt)
            {
                @(sync.LastFound is int found ? T("Last looked {0}: {1} new.", checkedAt.Medium(), found) : T("Last looked {0}.", checkedAt.Medium()))
            }
        </p>
        <button type="button" class="quiet" @onclick="CheckNow" disabled="@checkAsked">@(checkAsked ? T("Looking within a minute…") : T("Check now"))</button>
        <button type="button" class="quiet" @onclick="StopKeeping">@T("Stop keeping in step")</button>
    </section>
}

@if (job is not null)
{
    <ImportProgress Job="job" />
    @if (job.Finished)
    {
        <button type="button" @onclick="BringMore">@T("Bring more")</button>
    }
}
else if (connection is null)
{
    <section class="panel" aria-labelledby="connect-heading">
        <h2 id="connect-heading">@T("Connect")</h2>
        <div class="account">
            <label>
                @T("Audiobookshelf address")
                <input @bind="address" placeholder="https://audiobooks.example.org" inputmode="url" autocomplete="url" maxlength="300" />
            </label>
            <fieldset>
                <legend>@T("Sign in with")</legend>
                <label class="check"><input type="radio" name="how" checked="@useKey" @onchange="() => useKey = true" /> @T("An API key")</label>
                <label class="check"><input type="radio" name="how" checked="@(!useKey)" @onchange="() => useKey = false" /> @T("A user name and password")</label>
            </fieldset>
            @if (useKey)
            {
                <label>
                    @T("API key")
                    <input type="password" @bind="apiKey" autocomplete="off" maxlength="2000" />
                </label>
                <p class="hint">@T("Make one in Audiobookshelf under Settings, API Keys, and turn it on.")</p>
            }
            else
            {
                <label>
                    @T("User name")
                    <input @bind="user" autocomplete="off" maxlength="200" />
                </label>
                <label>
                    @T("Password")
                    <input type="password" @bind="password" autocomplete="off" maxlength="500" />
                </label>
            }
            <button type="button" class="primary" @onclick="Connect" disabled="@busy">@(busy ? T("Connecting…") : T("Connect"))</button>
            <p class="hint">@T("The key or password is used only for this import and never saved.")</p>
        </div>
    </section>
}
else
{
    <section class="panel" aria-labelledby="choose-heading">
        <h2 id="choose-heading">@T("Choose books")</h2>
        <p class="hint">@T("Connected to {0} as {1}.", connection.Server.GetLeftPart(UriPartial.Authority), connection.User) <button type="button" class="link" @onclick="StartOver">@T("Use another server")</button></p>
        @if (!connection.CanDownload)
        {
            <p class="validation-message" role="alert">@T("This Audiobookshelf user may not download, so its files cannot be copied. Turn on Can Download for them in Audiobookshelf's Users settings, then connect again.")</p>
        }
        @if (connection.Libraries.Count == 0)
        {
            <p>@T("This user can see no book libraries. Podcast libraries are not brought across.")</p>
        }
        else
        {
            <label>
                @T("Library")
                <select @bind="libraryId" @bind:after="LoadItems">
                    @foreach (var library in connection.Libraries)
                    {
                        <option value="@library.Id">@library.Name</option>
                    }
                </select>
            </label>
        }
        @if (listing is var (listed, total))
        {
            @* A large library takes a while to list; this says how far it has got. *@
            <div role="status">
                <progress max="@Math.Max(1, total)" value="@listed" aria-label="@T("Listing the library")"></progress>
                <p class="hint">@(total > 0 ? T("Listing the library: {0} of {1} books…", listed.ToString("N0"), total.ToString("N0")) : T("Listing the library…"))</p>
            </div>
        }
        else if (items is { Count: > 0 })
        {
            <div class="bulk-bar">
                <button type="button" class="quiet" @onclick="() => { chosen = items.Where(item => !onShelf.Contains(item.Id)).Select(item => item.Id).ToHashSet(); }">@T("Choose all new")</button>
                <button type="button" class="quiet" @onclick="() => chosen.Clear()">@T("Choose none")</button>
                <span class="hint">@T("{0} of {1} chosen", chosen.Count.ToString("N0"), items.Count.ToString("N0"))@(onShelf.Count > 0 ? " · " + T("{0} already on your shelf", onShelf.Count.ToString("N0")) : "")</span>
            </div>
            <div class="abs-filter">
                <label>
                    @T("Find in the list")
                    <input type="search" @bind="filter" @bind:event="oninput" placeholder="@T("Title or author")" />
                </label>
                <label>
                    @T("Show")
                    <select @bind="kind">
                        <option value="">@T("Everything")</option>
                        <option value="new">@T("Only what is new to your shelf")</option>
                        <option value="audio">@T("Audiobooks")</option>
                        <option value="ebook">@T("E-books")</option>
                    </select>
                </label>
                @if (Shown.Count != items.Count)
                {
                    <button type="button" class="quiet" @onclick="() => chosen.UnionWith(Shown.Select(item => item.Id))">@T("Choose these {0}", Shown.Count.ToString("N0"))</button>
                    <button type="button" class="quiet" @onclick="() => chosen.ExceptWith(Shown.Select(item => item.Id))">@T("Leave these out")</button>
                }
            </div>
            @* Only the rows in view are drawn, so a library of ten thousand scrolls as easily as one of ten. *@
            <div class="abs-items" tabindex="0" role="group" aria-label="@T("Books in the library")">
                <Virtualize Items="Shown" ItemSize="58" OverscanCount="10" Context="item">
                    <div class="abs-item">
                        <label class="check">
                            <input type="checkbox" checked="@chosen.Contains(item.Id)" @onchange="() => Toggle(item.Id)" aria-label="@T("Choose {0}", item.Title)" />
                            <span>
                                <strong>@item.Title</strong>
                                <span class="hint">@item.Author · @Describe(item)@(onShelf.Contains(item.Id) ? " · " + T("already on your shelf") : "")</span>
                            </span>
                        </label>
                    </div>
                </Virtualize>
            </div>
            <fieldset class="audible-take">
                <legend>@T("Bring my reading too")</legend>
                <label class="check">
                    <input type="checkbox" @bind="placeOn" />
                    @T("Where I stopped listening or reading, and when I started and finished each book")
                </label>
                <label class="check">
                    <input type="checkbox" @bind="bookmarksOn" />
                    @T("My bookmarks")
                </label>
                <label class="check">
                    <input type="checkbox" @bind="historyOn" />
                    @T("My listening history, for Insights and my goals")
                </label>
                <label class="check">
                    <input type="checkbox" @bind="listsOn" />
                    @T("My collections and playlists, as collections")
                </label>
                @if (onShelf.Count > 0)
                {
                    <label class="check">
                        <input type="checkbox" @bind="updateExisting" />
                        @T("Bring all of this for the {0} already on my shelf too, without their files", Localization.Counts.Books(onShelf.Count))
                    </label>
                }
            </fieldset>
            @if (keptKey is not null)
            {
                <label class="check">
                    <input type="checkbox" @bind="keepInStep" />
                    @T("Keep in step: every day, bring books newly added to this library")
                </label>
                <p class="hint">@T("Shelf keeps the API key for this, sealed with its own keys, until you stop.")</p>
            }
            else
            {
                <p class="hint">@T("To keep in step with this library every day, connect with an API key rather than a password.")</p>
            }
            <button type="button" class="primary" @onclick="Import" disabled="@(Updating.Count == 0 && (chosen.Count == 0 || !connection.CanDownload))">
                @(Updating.Count > 0 ? T("Bring {0}, and my reading for {1} already here", Localization.Counts.Books(chosen.Count), Updating.Count.ToString("N0")) : T("Bring {0}", Localization.Counts.Books(chosen.Count)))
            </button>

            @if (isAdmin && connection.Admin)
            {
                @* An admin of both: everyone's books and reading, each to their own shelf. *@
                <details class="panel abs-everyone" open="@(absUsers is not null)">
                    <summary>@T("Bring everyone's books and reading")</summary>
                    <p class="hint">@T("You are an admin of this shelf and of Audiobookshelf, so you can bring each Audiobookshelf user's books and reading to the shelf of the reader they are here, with the choices above. Each reader's books are copies of their own, so this takes room for each.")</p>
                    @if (absUsers is null)
                    {
                        <button type="button" @onclick="LoadUsers" disabled="@busy">@T("List Audiobookshelf's users")</button>
                    }
                    else
                    {
                        <ul class="abs-users">
                            @foreach (var absUser in absUsers)
                            {
                                <li>
                                    <label>
                                        <span><strong>@absUser.Name</strong>@if (absUser.Email is not null) { <span class="hint"> · @absUser.Email</span> }</span>
                                        <select value="@(mapping.GetValueOrDefault(absUser.Id) ?? "")" @onchange="change => mapping[absUser.Id] = change.Value?.ToString() ?? string.Empty">
                                            <option value="">@T("Leave out")</option>
                                            @foreach (var shelfReader in shelfReaders)
                                            {
                                                <option value="@($"r:{shelfReader.Id}")">@T("To {0}'s shelf", shelfReader.Name)</option>
                                            }
                                            @if (absUser.Email is not null && shelfReaders.All(item => !string.Equals(item.Email, absUser.Email, StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <option value="invite">@T("Invite {0} to Shelf", absUser.Email)</option>
                                            }
                                        </select>
                                    </label>
                                </li>
                            }
                        </ul>
                        <fieldset class="audible-take">
                            <legend>@T("Which books")</legend>
                            <label class="check"><input type="radio" name="everyone" checked="@everyoneStarted" @onchange="() => everyoneStarted = true" /> @T("The books each person has started or finished")</label>
                            <label class="check"><input type="radio" name="everyone" checked="@(!everyoneStarted)" @onchange="() => everyoneStarted = false" /> @T("Every book in this library, for each of them")</label>
                        </fieldset>
                        <button type="button" class="primary" @onclick="BringEveryone" disabled="@(mapping.Values.All(value => value.Length == 0))">@T("Bring for everyone chosen")</button>
                        <p class="hint">@T("Someone invited can bring their own once they have joined, or you can come back here then.")</p>
                    }
                    @if (everyoneNote is not null)
                    {
                        <p class="saved" role="status">@everyoneNote</p>
                    }
                    @if (everyoneJobs.Count > 0)
                    {
                        <ul class="tag-counts" role="status">
                            @foreach (var started in everyoneJobs)
                            {
                                var lines = started.Books.Values;
                                <li>
                                    <span>@started.ForName</span>
                                    <span class="hint">@(started.Finished
                                        ? T("{0} brought, {1} already there, {2} could not come", lines.Count(line => line.State == AbsState.Done), lines.Count(line => line.State == AbsState.Skipped), lines.Count(line => line.State == AbsState.Failed))
                                        : T("{0} of {1} done", lines.Count(line => line.State is not (AbsState.Waiting or AbsState.Downloading)), started.Items.Count))</span>
                                </li>
                            }
                        </ul>
                    }
                </details>
            }
            else if (isAdmin)
            {
                <p class="hint">@T("To bring everyone's books and reading at once, connect with an Audiobookshelf admin's API key.")</p>
            }
        }
        else if (items is not null)
        {
            <p>@T("This library has no books.")</p>
        }
    </section>
}

@if (problem is not null)
{
    <p class="validation-message" role="alert">@problem</p>
}

@code {
    private string address = "";
    private bool useKey = true;
    private string apiKey = "";
    private string user = "";
    private string password = "";
    private bool busy;
    private string? problem;
    private AbsConnection? connection;
    private string libraryId = "";
    private List<AbsItem>? items;
    private HashSet<string> onShelf = [];
    private HashSet<string> chosen = [];
    private bool placeOn = true;
    private bool bookmarksOn = true;
    private bool historyOn = true;
    private bool listsOn = true;
    private bool updateExisting = true;

    private AbsOptions Options => new(placeOn, bookmarksOn, historyOn, listsOn, updateExisting);

    // The books already here whose reading comes across, when asked for.
    private HashSet<string> Updating => updateExisting && Options.Any ? onShelf : [];
    private AbsImportJob? job;
    private int readerId;
    private bool isAdmin;
    private Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        readerId = db.ReaderId;
        isAdmin = await ReaderRules.IsAdminAsync(db, readerId);
        job = Importer.Latest(readerId);
        kept = await AbsKeeper.StateAsync(db);
    }

    // Drawn again every two seconds only while something is moving: the listing, or an import running.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            timer = new Timer(_ =>
            {
                if (listing is not null || job is { Finished: false } || (job is not null && !shownFinished) || everyoneJobs.Any(item => !item.Finished) || everyoneJobs.Count > shownEveryone)
                {
                    shownFinished = job?.Finished == true;
                    shownEveryone = everyoneJobs.Count(item => item.Finished);
                    InvokeAsync(StateHasChanged);
                }
            }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
        }
    }

    private bool shownFinished;
    private int shownEveryone;
    private (int Listed, int Total)? listing;
    private CancellationTokenSource? listingStop;
    private string filter = "";
    private string kind = "";

    private List<AbsItem> Shown
    {
        get
        {
            IEnumerable<AbsItem> shown = items ?? [];
            if (filter.Trim() is { Length: > 0 } words)
            {
                shown = shown.Where(item => item.Title.Contains(words, StringComparison.CurrentCultureIgnoreCase) || item.Author.Contains(words, StringComparison.CurrentCultureIgnoreCase));
            }

            shown = kind switch
            {
                "new" => shown.Where(item => !onShelf.Contains(item.Id)),
                "audio" => shown.Where(item => item.AudioFiles > 0),
                "ebook" => shown.Where(item => item.EbookFormat is not null),
                _ => shown,
            };
            return shown.ToList();
        }
    }

    private async Task Connect()
    {
        problem = null;
        if (AbsClient.ServerAddress(address) is not { } server)
        {
            problem = T("Give the address you open Audiobookshelf at, such as https://audiobooks.example.org.");
            return;
        }

        busy = true;
        try
        {
            using var limit = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            connection = await AbsClient.ConnectAsync(Http.CreateClient(AbsClient.ClientFor(isAdmin)), server, useKey ? apiKey : null, user, password, limit.Token);
            // Held for this page only, in case the reader asks to keep in step; saved only then.
            keptKey = useKey && apiKey.Length > 0 ? apiKey : null;
            apiKey = "";
            password = "";
            libraryId = connection.Libraries.FirstOrDefault()?.Id ?? "";
            if (libraryId.Length > 0)
            {
                await LoadItems();
            }
        }
        catch (Exception ex) when (ex is AbsProblem or TaskCanceledException or System.Text.Json.JsonException or KeyNotFoundException or InvalidOperationException)
        {
            problem = ex switch
            {
                AbsProblem => ex.Message,
                TaskCanceledException => T("That address did not answer within 30 seconds. Check it, and that this server can reach it."),
                _ => T("That address did not answer as Audiobookshelf."),
            };
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadItems()
    {
        if (connection is null)
        {
            return;
        }

        problem = null;
        items = null;
        listingStop?.Cancel();
        listingStop = new CancellationTokenSource(TimeSpan.FromMinutes(20));
        listing = (0, 0);
        try
        {
            // Told at once, not later through the page's queue, so a late word cannot bring the listing back after it ends.
            var stop = listingStop;
            var progress = new Told<(int Listed, int Total)>(step =>
            {
                if (listing is not null && !stop.IsCancellationRequested)
                {
                    listing = step;
                }
            });
            items = await AbsClient.ItemsAsync(Http.CreateClient(AbsClient.ClientFor(isAdmin)), connection, libraryId, listingStop.Token, progress);
        }
        catch (Exception ex) when (ex is AbsProblem or TaskCanceledException or OperationCanceledException or System.Text.Json.JsonException or KeyNotFoundException)
        {
            problem = ex is AbsProblem ? ex.Message : T("Audiobookshelf did not list that library.");
            return;
        }
        finally
        {
            listing = null;
        }

        // On the shelf already: the same title and author, with the kinds of file this item has. Looked up by name,
        // so thousands of books on each side take a moment, not millions of comparisons.
        await using var db = await DbFactory.CreateDbContextAsync();
        var shelf = (await db.Books.AsNoTracking()
            .Select(book => new { book.Title, book.Author, Audio = book.AudioStoredName != null, Ebook = book.EbookStoredName != null })
            .ToListAsync())
            .ToLookup(book => Key(book.Title, book.Author));
        onShelf = items
            .Where(item => shelf[Key(item.Title, item.Author)].Any(book => (item.AudioFiles == 0 || book.Audio) && (item.EbookFormat is null || book.Ebook)))
            .Select(item => item.Id)
            .ToHashSet();
        chosen = items.Where(item => !onShelf.Contains(item.Id)).Select(item => item.Id).ToHashSet();
    }

    private sealed class Told<T>(Action<T> told) : IProgress<T>
    {
        public void Report(T value) => told(value);
    }

    private static string Key(string title, string author) => $"{title.Trim().ToUpperInvariant()}\u0001{author.Trim().ToUpperInvariant()}";

    private void Toggle(string id)
    {
        if (!chosen.Remove(id))
        {
            chosen.Add(id);
        }
    }

    private async Task Import()
    {
        if (connection is null || items is null)
        {
            return;
        }

        var updating = Updating;
        job = Importer.Start(readerId, connection, Options, items.Where(item => chosen.Contains(item.Id) || updating.Contains(item.Id)).ToList(), isAdmin);
        if (keepInStep && keptKey is not null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var library = connection.Libraries.FirstOrDefault(item => item.Id == libraryId);
            await Keeper.KeepAsync(db, connection.Server, keptKey, libraryId, library?.Name ?? libraryId, placeOn);
            kept = await AbsKeeper.StateAsync(db);
        }
    }

    private List<AbsUser>? absUsers;
    private List<(int Id, string Name, string? Email)> shelfReaders = [];
    private readonly Dictionary<string, string> mapping = [];
    private bool everyoneStarted = true;
    private string? everyoneNote;
    private readonly List<AbsImportJob> everyoneJobs = [];

    private string Site => EmailRules.PublicAddress(Configuration, null) is { Length: > 0 } configured ? configured : Navigation.BaseUri.TrimEnd('/');

    // Audiobookshelf's users, each matched to the reader here with the same address, or else the same name.
    private async Task LoadUsers()
    {
        if (connection is null)
        {
            return;
        }

        busy = true;
        problem = null;
        try
        {
            absUsers = await AbsClient.UsersAsync(Http.CreateClient(AbsClient.ClientFor(isAdmin)), connection, CancellationToken.None);
            await using var db = await DbFactory.CreateDbContextAsync();
            shelfReaders = [.. (await db.Readers.AsNoTracking().Where(reader => reader.SandboxOf == null && !reader.Suspended)
                .Select(reader => new { reader.Id, reader.Name, Email = reader.NormalizedEmail == null ? null : reader.Email }).ToListAsync())
                .OrderBy(reader => reader.Name, StringComparer.OrdinalIgnoreCase)
                .Select(reader => (reader.Id, reader.Name, reader.Email))];
            foreach (var absUser in absUsers)
            {
                var match = shelfReaders.FirstOrDefault(reader => absUser.Email is not null && string.Equals(reader.Email, absUser.Email, StringComparison.OrdinalIgnoreCase));
                if (match.Name is null)
                {
                    match = shelfReaders.FirstOrDefault(reader => string.Equals(reader.Name, absUser.Name, StringComparison.OrdinalIgnoreCase));
                }

                mapping[absUser.Id] = match.Name is not null ? $"r:{match.Id}" : "";
            }
        }
        catch (Exception ex) when (ex is AbsProblem or System.Text.Json.JsonException or KeyNotFoundException or InvalidOperationException)
        {
            problem = ex is AbsProblem ? ex.Message : T("Audiobookshelf did not list its users.");
        }
        finally
        {
            busy = false;
        }
    }

    // An import for each reader chosen, in turn, and an invitation for each to be invited.
    private async Task BringEveryone()
    {
        if (connection is null || items is null || absUsers is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (!await ReaderRules.IsAdminAsync(db, db.ReaderId))
        {
            return;
        }

        var invites = new List<string>();
        var brought = 0;
        foreach (var absUser in absUsers)
        {
            var choice = mapping.GetValueOrDefault(absUser.Id) ?? "";
            if (choice == "invite" && absUser.Email is not null)
            {
                invites.Add(absUser.Email);
            }
            else if (choice.StartsWith("r:", StringComparison.Ordinal) && int.TryParse(choice[2..], out var target) && shelfReaders.FirstOrDefault(reader => reader.Id == target) is { Name: not null } reader)
            {
                everyoneJobs.Add(Importer.Start(target, connection, Options, items, admin: true, absUserId: absUser.Id, forName: reader.Name, startedOnly: everyoneStarted));
                brought++;
            }
        }

        var invited = invites.Count == 0 ? [] : await Management.InviteAsync(db, Email, string.Join(',', invites), Site);
        await Audit.NoteAsync(db, Say("Brought everyone's books from Audiobookshelf"), detail: $"{brought} readers, {invites.Count} invited");
        everyoneNote = invites.Count == 0
            ? T("Bringing books for {0}. Each reader sees how it goes on their own pages too.", Localization.Counts.Readers(brought))
            : T("Bringing books for {0}, and invited {1}.", Localization.Counts.Readers(brought), string.Join(", ", invited.Where(made => made.Problem is null).Select(made => made.Email)));
    }

    private bool keepInStep;
    private string? keptKey;
    private AbsSyncState? kept;
    private bool checkAsked;

    private async Task CheckNow()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await AbsKeeper.CheckSoonAsync(db);
        checkAsked = true;
    }

    private async Task StopKeeping()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await AbsKeeper.StopAsync(db);
        kept = null;
    }

    // Back to the list, which now marks what just came across.
    private async Task BringMore()
    {
        job = null;
        if (connection is null)
        {
            return;
        }

        await LoadItems();
    }

    private void StartOver()
    {
        keptKey = null;
        connection = null;
        items = null;
        chosen.Clear();
        job = null;
        problem = null;
    }

    private static string Describe(AbsItem item)
    {
        var parts = new List<string>();
        if (item.AudioFiles > 0)
        {
            var length = TimeSpan.FromSeconds(item.Duration);
            parts.Add(length.TotalHours >= 1 ? T("audiobook, {0} h {1} min", (int)length.TotalHours, length.Minutes) : T("audiobook, {0} min", Math.Max(1, length.Minutes)));
        }

        if (item.EbookFormat is not null)
        {
            parts.Add(T("e-book ({0})", item.EbookFormat.ToUpperInvariant()));
        }

        return parts.Count == 0 ? T("no files") : string.Join(T(" and "), parts);
    }

    public void Dispose()
    {
        timer?.Dispose();
        listingStop?.Cancel();
    }
}
