@page "/import/audiobookshelf"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory
@inject IHttpClientFactory Http
@inject AbsImporter Importer
@implements IDisposable

<PageTitle>Audiobookshelf · Shelf</PageTitle>

<p class="hint"><a href="/backup">Backup &amp; restore</a></p>
<h1>Bring books from Audiobookshelf</h1>
<p class="hint">Copies audiobooks and e-books from an <a href="https://www.audiobookshelf.org" rel="noopener">Audiobookshelf</a> server to your shelf: their files, covers, series, and genres, and where you stopped, if you like. Nothing on the Audiobookshelf server changes. Books already on your shelf are left alone.</p>

@if (job is not null)
{
    <section class="panel" aria-labelledby="progress-heading">
        <h2 id="progress-heading">@(job.Finished ? "Brought across" : "Bringing books across")</h2>
        <p class="hint" role="status">@Summary(job)</p>
        <ul class="free-downloads">
            @foreach (var line in job.Items.Select(item => job.Lines[item.Id]))
            {
                <li>
                    <span>@line.Title</span>
                    @switch (line.State)
                    {
                        case AbsState.Waiting:
                            <span class="hint">Waiting</span>
                            break;
                        case AbsState.Downloading:
                            <span class="hint">Copying@(line.Bytes > 0 ? $", {FreeBooks.Size(line.Bytes)}" : "")…</span>
                            break;
                        case AbsState.Done:
                            <a href="/library/@line.BookId">On your shelf</a>
                            break;
                        case AbsState.Skipped:
                            <span class="hint">@line.Note @if (line.BookId is int same) { <a href="/library/@same">See it</a> }</span>
                            break;
                        default:
                            <span class="validation-message">@line.Note</span>
                            break;
                    }
                </li>
            }
        </ul>
        @if (job.Finished)
        {
            <button type="button" @onclick="BringMore">Bring more</button>
        }
    </section>
}
else if (connection is null)
{
    <section class="panel" aria-labelledby="connect-heading">
        <h2 id="connect-heading">Connect</h2>
        <div class="account">
            <label>
                Audiobookshelf address
                <input @bind="address" placeholder="https://audiobooks.example.org" inputmode="url" autocomplete="url" maxlength="300" />
            </label>
            <fieldset>
                <legend>Sign in with</legend>
                <label class="check"><input type="radio" name="how" checked="@useKey" @onchange="() => useKey = true" /> An API key</label>
                <label class="check"><input type="radio" name="how" checked="@(!useKey)" @onchange="() => useKey = false" /> A user name and password</label>
            </fieldset>
            @if (useKey)
            {
                <label>
                    API key
                    <input type="password" @bind="apiKey" autocomplete="off" maxlength="2000" />
                </label>
                <p class="hint">Make one in Audiobookshelf under Settings, API Keys, and turn it on.</p>
            }
            else
            {
                <label>
                    User name
                    <input @bind="user" autocomplete="off" maxlength="200" />
                </label>
                <label>
                    Password
                    <input type="password" @bind="password" autocomplete="off" maxlength="500" />
                </label>
            }
            <button type="button" class="primary" @onclick="Connect" disabled="@busy">@(busy ? "Connecting…" : "Connect")</button>
            <p class="hint">The key or password is used only for this import and never saved.</p>
        </div>
    </section>
}
else
{
    <section class="panel" aria-labelledby="choose-heading">
        <h2 id="choose-heading">Choose books</h2>
        <p class="hint">Connected to @connection.Server.GetLeftPart(UriPartial.Authority) as @connection.User. <button type="button" class="link" @onclick="StartOver">Use another server</button></p>
        @if (!connection.CanDownload)
        {
            <p class="validation-message" role="alert">This Audiobookshelf user may not download, so its files cannot be copied. Turn on Can Download for them in Audiobookshelf's Users settings, then connect again.</p>
        }
        @if (connection.Libraries.Count == 0)
        {
            <p>This user can see no book libraries. Podcast libraries are not brought across.</p>
        }
        else
        {
            <label>
                Library
                <select @bind="libraryId" @bind:after="LoadItems">
                    @foreach (var library in connection.Libraries)
                    {
                        <option value="@library.Id">@library.Name</option>
                    }
                </select>
            </label>
        }
        @if (items is { Count: > 0 })
        {
            <div class="bulk-bar">
                <button type="button" class="quiet" @onclick="() => { chosen = items.Where(item => !onShelf.Contains(item.Id)).Select(item => item.Id).ToHashSet(); }">Choose all new</button>
                <button type="button" class="quiet" @onclick="() => chosen.Clear()">Choose none</button>
                <span class="hint">@chosen.Count of @items.Count chosen</span>
            </div>
            <ul class="abs-items">
                @foreach (var item in items)
                {
                    var here = onShelf.Contains(item.Id);
                    <li>
                        <label class="check">
                            <input type="checkbox" checked="@chosen.Contains(item.Id)" @onchange="() => Toggle(item.Id)" aria-label="@($"Choose {item.Title}")" />
                            <span>
                                <strong>@item.Title</strong> <span class="by">@item.Author</span>
                                <span class="hint">@Describe(item)@(here ? " · already on your shelf" : "")</span>
                            </span>
                        </label>
                    </li>
                }
            </ul>
            <label class="check">
                <input type="checkbox" @bind="bringProgress" />
                Bring where I stopped listening or reading, and which books I finished
            </label>
            <button type="button" class="primary" @onclick="Import" disabled="@(chosen.Count == 0 || !connection.CanDownload)">Bring @chosen.Count @(chosen.Count == 1 ? "book" : "books")</button>
        }
        else if (items is not null)
        {
            <p>This library has no books.</p>
        }
    </section>
}

@if (problem is not null)
{
    <p class="validation-message" role="alert">@problem</p>
}

@code {
    private string address = "";
    private bool useKey = true;
    private string apiKey = "";
    private string user = "";
    private string password = "";
    private bool busy;
    private string? problem;
    private AbsConnection? connection;
    private string libraryId = "";
    private List<AbsItem>? items;
    private HashSet<string> onShelf = [];
    private HashSet<string> chosen = [];
    private bool bringProgress = true;
    private AbsImportJob? job;
    private int readerId;
    private Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        readerId = db.ReaderId;
        job = Importer.Latest(readerId);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            timer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1.5), TimeSpan.FromSeconds(1.5));
        }
    }

    private async Task Connect()
    {
        problem = null;
        if (AbsClient.ServerAddress(address) is not { } server)
        {
            problem = "Give the address you open Audiobookshelf at, such as https://audiobooks.example.org.";
            return;
        }

        busy = true;
        try
        {
            using var limit = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            connection = await AbsClient.ConnectAsync(Http.CreateClient(AbsClient.ClientName), server, useKey ? apiKey : null, user, password, limit.Token);
            apiKey = "";
            password = "";
            libraryId = connection.Libraries.FirstOrDefault()?.Id ?? "";
            if (libraryId.Length > 0)
            {
                await LoadItems();
            }
        }
        catch (Exception ex) when (ex is AbsProblem or TaskCanceledException or System.Text.Json.JsonException or KeyNotFoundException or InvalidOperationException)
        {
            problem = ex is AbsProblem ? ex.Message : "That address did not answer as Audiobookshelf.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadItems()
    {
        if (connection is null)
        {
            return;
        }

        problem = null;
        items = null;
        try
        {
            using var limit = new CancellationTokenSource(TimeSpan.FromMinutes(2));
            items = await AbsClient.ItemsAsync(Http.CreateClient(AbsClient.ClientName), connection, libraryId, limit.Token);
        }
        catch (Exception ex) when (ex is AbsProblem or TaskCanceledException or System.Text.Json.JsonException or KeyNotFoundException)
        {
            problem = ex is AbsProblem ? ex.Message : "Audiobookshelf did not list that library.";
            return;
        }

        // On the shelf already: the same title and author, with the kinds of file this item has.
        await using var db = await DbFactory.CreateDbContextAsync();
        var shelf = await db.Books.AsNoTracking()
            .Select(book => new { book.Title, book.Author, book.Isbn, Audio = book.AudioStoredName != null, Ebook = book.EbookStoredName != null })
            .ToListAsync();
        onShelf = items
            .Where(item => shelf.Any(book => BookRules.IsSameCopy(null, item.Title, item.Author, book.Isbn, book.Title, book.Author)
                && (item.AudioFiles == 0 || book.Audio) && (item.EbookFormat is null || book.Ebook)))
            .Select(item => item.Id)
            .ToHashSet();
        chosen = items.Where(item => !onShelf.Contains(item.Id)).Select(item => item.Id).ToHashSet();
    }

    private void Toggle(string id)
    {
        if (!chosen.Remove(id))
        {
            chosen.Add(id);
        }
    }

    private void Import()
    {
        if (connection is null || items is null)
        {
            return;
        }

        job = Importer.Start(readerId, connection, bringProgress, items.Where(item => chosen.Contains(item.Id)).ToList());
    }

    // Back to the list, which now marks what just came across.
    private async Task BringMore()
    {
        job = null;
        if (connection is null)
        {
            return;
        }

        await LoadItems();
    }

    private void StartOver()
    {
        connection = null;
        items = null;
        chosen.Clear();
        job = null;
        problem = null;
    }

    private static string Describe(AbsItem item)
    {
        var parts = new List<string>();
        if (item.AudioFiles > 0)
        {
            var length = TimeSpan.FromSeconds(item.Duration);
            parts.Add(length.TotalHours >= 1 ? $"audiobook, {(int)length.TotalHours} h {length.Minutes} min" : $"audiobook, {Math.Max(1, length.Minutes)} min");
        }

        if (item.EbookFormat is not null)
        {
            parts.Add($"e-book ({item.EbookFormat.ToUpperInvariant()})");
        }

        return parts.Count == 0 ? "no files" : string.Join(" and ", parts);
    }

    private static string Summary(AbsImportJob job)
    {
        var lines = job.Lines.Values.ToList();
        var done = lines.Count(line => line.State == AbsState.Done);
        var skipped = lines.Count(line => line.State == AbsState.Skipped);
        var failed = lines.Count(line => line.State == AbsState.Failed);
        var text = $"{done} of {lines.Count} brought across";
        if (skipped > 0) text += $", {skipped} already here";
        if (failed > 0) text += $", {failed} could not be";
        return job.Finished ? text + "." : text + " so far. You can leave this page; it carries on.";
    }

    public void Dispose() => timer?.Dispose();
}
