@page "/places"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>@T("Places") · Shelf</PageTitle>

<h1>@T("Places")</h1>

@if (places.Count == 0)
{
    <EmptyState Title="@T("No places yet")" Text="@T("Note where a copy sits, such as a room or a box, in its details, and the places gather here.")" ActionHref="/" ActionLabel="@T("Open the library")" />
}
else
{
    <ul class="tag-counts">
        @foreach (var place in places)
        {
            <li>
                <a href="@($"/?place={Uri.EscapeDataString(place.Name)}")">@place.Name</a>
                <span class="hint">@Localization.Counts.Books(place.Count)</span>
            </li>
        }
    </ul>
}

@code {
    private List<PlaceCount> places = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var locations = await db.Books.AsNoTracking().Select(book => book.Location).ToListAsync();
        places = BookRules.Places(locations).ToList();
    }
}
