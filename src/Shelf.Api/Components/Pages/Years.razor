@page "/years"
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>@T("Years") · Shelf</PageTitle>

<h1>@T("Years")</h1>

@if (years.Count == 0)
{
    <EmptyState Title="@T("No books finished yet")" Text="@T("Finished books are grouped here by the year you finished them.")" ActionHref="/library?status=Reading" ActionLabel="@T("See what you are reading")" />
}
else
{
    @foreach (var year in years)
    {
        <h2>@(year.Year?.ToString() ?? T("Undated"))</h2>
        @if (year.Year is int dated)
        {
            <p class="hint"><a href="/years/@dated">@T("Your {0} in books", dated)</a></p>
        }
        <ul class="tag-counts">
            @foreach (var book in year.Books.Take(MostAYear))
            {
                <li>
                    <a href="/library/@book.Id">@book.Title</a>
                    @if (book.FinishedOn is DateOnly finished)
                    {
                        <span class="hint">@finished.MonthDay()</span>
                    }
                </li>
            }
        </ul>
        @if (year.Books.Length > MostAYear)
        {
            <p class="hint">@T("and {0} more", year.Books.Length - MostAYear)@if (year.Year is int all)
                {
                    <span> · <a href="/years/@all">@T("Your {0} in books", all)</a></span>
                }</p>
        }
    }
}

@code {
    // A year's books past these are on the year's own page: a reader of thousands a year made this page of megabytes.
    private const int MostAYear = 60;

    private List<FinishedYear> years = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var books = await db.Books.AsNoTracking()
            .Where(book => book.Status == BookStatus.Finished)
            .ToListAsync();
        books.AddRange(await Rereads.EarlierBooksAsync(db));
        years = BookRules.FinishedByYear(books).ToList();
    }
}
