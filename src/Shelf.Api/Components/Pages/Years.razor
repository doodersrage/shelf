@page "/years"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>@T("Years") · Shelf</PageTitle>

<h1>@T("Years")</h1>

@if (years.Count == 0)
{
    <EmptyState Title="@T("No books finished yet")" Text="@T("Finished books are grouped here by the year you finished them.")" ActionHref="/?status=Reading" ActionLabel="@T("See what you are reading")" />
}
else
{
    @foreach (var year in years)
    {
        <h2>@(year.Year?.ToString() ?? T("Undated"))</h2>
        <ul class="tag-counts">
            @foreach (var book in year.Books)
            {
                <li>
                    <a href="/library/@book.Id">@book.Title</a>
                    @if (book.FinishedOn is DateOnly finished)
                    {
                        <span class="hint">@finished.MonthDay()</span>
                    }
                </li>
            }
        </ul>
    }
}

@code {
    private List<FinishedYear> years = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var books = await db.Books.AsNoTracking()
            .Where(book => book.Status == BookStatus.Finished)
            .ToListAsync();
        years = BookRules.FinishedByYear(books).ToList();
    }
}
