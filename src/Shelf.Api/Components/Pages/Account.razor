@page "/account"
@using Microsoft.AspNetCore.DataProtection
@using Microsoft.JSInterop
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory
@inject ShelfReader Reader
@inject NavigationManager Navigation
@inject EbookStore Ebooks
@inject AudioStore Audio
@inject IEmailSender Email
@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider Protection
@inject AuthenticationStateProvider Authentication
@inject Microsoft.JSInterop.IJSRuntime Js

<PageTitle>Account · Shelf</PageTitle>

<h1>@Reader.Name</h1>
<p class="hint">Your notes, reviews, quotes, and highlights are yours alone. Other readers see a book of yours only when it is lent to them, or by its title on an open shelf.</p>

<section class="panel">
<h2>Your shelf</h2>
<label class="check">
    <input type="checkbox" checked="@shelfOpen" @onchange="ChangeShelfOpen" />
    Let other readers see the titles on my shelf and ask to borrow one
</label>
<p class="hint">Asks wait on your <a href="/loans">Loans</a> page until you lend the book or decline.</p>

</section>

<section class="panel">
<h2>Email</h2>
@if (!Email.Enabled)
{
    <p class="hint">This shelf has no mail server set up, so it cannot send password resets or reminders. An admin can add one in the Email settings.</p>
}
<label>
    Email address
    <input type="email" @bind="emailAddress" @bind:event="oninput" maxlength="@EmailRules.MaxAddressLength" autocomplete="email" />
</label>
<label class="check">
    <input type="checkbox" @bind="emailReminders" disabled="@(string.IsNullOrWhiteSpace(emailAddress))" />
    Email me once a day when a loan is overdue or due soon, or someone asks to borrow
</label>
<p class="hint">Used only for password resets and the reminders you choose.</p>
<button type="button" class="primary" @onclick="SaveEmail">Save</button>
@if (Email.Enabled)
{
    <button type="button" @onclick="SendTest" disabled="@string.IsNullOrWhiteSpace(savedEmail)">Send a test email</button>
}
@if (emailProblem is AccountProblem shownEmail)
{
    <p class="validation-message" role="alert">@ReaderRules.Describe(shownEmail)</p>
}
else if (emailNote is not null)
{
    <span class="saved" role="status">@emailNote</span>
}
</section>

<section class="panel">
<h2>Dates and numbers</h2>
<label>
    Write dates and numbers the way they are written in
    <select @bind="culture" @bind:after="SaveCulture">
        <option value="">My browser's language</option>
        @foreach (var (name, label) in Regions.Choices)
        {
            <option value="@name">@label</option>
        }
    </select>
</label>
<p class="hint">Today is @DateOnly.FromDateTime(DateTime.UtcNow).Medium() here. The words on the pages stay in English.</p>
</section>

<section class="panel">
<h2>Change the password</h2>
<EditForm Model="form" OnValidSubmit="ChangePassword">
    <label>
        Current password
        <InputText type="password" @bind-Value="form.Current" autocomplete="current-password" />
    </label>
    <label>
        New password, at least @ReaderRules.MinPasswordLength characters
        <InputText type="password" @bind-Value="form.Password" autocomplete="new-password" />
    </label>
    <label>
        The new password again
        <InputText type="password" @bind-Value="form.Confirm" autocomplete="new-password" />
    </label>
    <p class="hint">Changing it signs you out everywhere, here included.</p>
    <button type="submit">Change it</button>
    @if (problem is AccountProblem shown)
    {
        <p class="validation-message" role="alert">@ReaderRules.Describe(shown)</p>
    }
</EditForm>

</section>

<section class="panel">
<h2>Two-step sign-in</h2>
@if (twoFactorOn)
{
    <p>On. Signing in asks for a code from your authenticator app after the password.</p>
    @if (recovery is not null)
    {
        <p><strong>Your recovery codes.</strong> Each works once, in place of a code, if you lose the authenticator. Keep them somewhere safe; they are not shown again.</p>
        <ul class="recovery-codes">
            @foreach (var recoveryCode in recovery)
            {
                <li><code>@recoveryCode</code></li>
            }
        </ul>
    }
    <label class="inline-date">
        Code, to turn it off
        <input @bind="twoFactorCode" autocomplete="one-time-code" maxlength="12" />
    </label>
    <button type="button" class="danger" @onclick="TurnOffTwoFactor">Turn off</button>
}
else if (setupUri is not null)
{
    <p>Scan this with an authenticator app, such as one from your phone's app store, then enter the code it shows.</p>
    <div class="qr" role="img" aria-label="QR code for your authenticator app">@((MarkupString)setupQr!)</div>
    <p class="hint">Or type this key into the app: <code class="key">@setupSecret</code></p>
    <label class="inline-date">
        Code from the app
        <input @bind="twoFactorCode" autocomplete="one-time-code" maxlength="6" inputmode="numeric" />
    </label>
    <button type="button" class="primary" @onclick="ConfirmTwoFactor">Turn on</button>
    <button type="button" @onclick="() => { setupUri = null; twoFactorProblem = null; }">Cancel</button>
}
else
{
    <p class="hint">Off. Turn it on to ask for a code from an authenticator app as well as the password.</p>
    <button type="button" @onclick="StartTwoFactor">Set up two-step sign-in</button>
}
@if (twoFactorProblem is AccountProblem shownTwoFactor)
{
    <p class="validation-message" role="alert">@ReaderRules.Describe(shownTwoFactor)</p>
}
</section>

<section class="panel">
<h2>Passkeys</h2>
<p class="hint">A passkey signs you in with this device's fingerprint, face, or PIN, or a password manager, with no password to type and no code to copy. It counts as both steps of two-step sign-in.</p>
@if (passkeys.Count > 0)
{
    <ul class="tag-counts">
        @foreach (var key in passkeys)
        {
            <li>
                <span>@key.Name</span>
                <span class="hint">added @key.CreatedAt.Medium()@(key.LastUsedAt is { } used ? $", last used {used.Medium()}" : ", not used yet")</span>
                <button type="button" class="quiet" @onclick="() => RemovePasskey(key.Id)" aria-label="@($"Remove the passkey {key.Name}")">Remove</button>
            </li>
        }
    </ul>
}
@if (passkeySupported)
{
    <label class="inline-date">
        Name it, to tell it apart
        <input @bind="passkeyName" maxlength="80" placeholder="@($"My {(passkeys.Count == 0 ? "phone" : "laptop")}")" />
    </label>
    <button type="button" @onclick="AddPasskey" disabled="@addingPasskey">@(addingPasskey ? "Waiting for the device…" : "Add a passkey")</button>
}
else if (passkeyChecked)
{
    <p class="hint">This browser cannot make passkeys.</p>
}
@if (passkeyProblem is not null)
{
    <p class="validation-message" role="alert">@passkeyProblem</p>
}
</section>

<section class="panel">
<h2>Signed-in devices</h2>
<ul class="tag-counts">
    @foreach (var session in sessions)
    {
        <li>
            <span>
                <strong>@(session.Device ?? "A browser")</strong>@(session.Current ? " · this one" : "")
                <span class="hint"> · signed in @session.CreatedAt.Medium() · last used @session.LastSeenAt.ShortStamp() UTC</span>
            </span>
            @if (!session.Current)
            {
                <button type="button" @onclick="() => EndSession(session.Id)">Sign out</button>
            }
        </li>
    }
</ul>
@if (sessions.Count(session => !session.Current) > 1)
{
    <button type="button" @onclick="EndOtherSessions">Sign out everywhere else</button>
}
</section>

<section class="panel">
<h2>Devices</h2>
<p class="hint"><a href="/sync">Make a key</a> for another shelf to trade e-books and audiobooks with yours.</p>

</section>

<section class="panel">
<h2>Recent activity</h2>
<p class="hint">Changes to this account, and sign-ins that failed. If something here was not you, change the password.</p>
<AuditList Lines="activity" />
</section>

<section class="panel">
<h2>Delete the account</h2>
@if (!confirmingRemove)
{
    <button type="button" class="danger" @onclick="() => confirmingRemove = true">Delete my account</button>
}
else
{
    <p>This deletes your account, every book on your shelf, and their e-books and audiobooks. Books other readers have lent you go back to them. Download a <a href="/books/export/full">full backup</a> first if you may want any of it.</p>
    <label>
        Your password
        <input type="password" @bind="removePassword" autocomplete="current-password" />
    </label>
    <button type="button" class="danger" @onclick="RemoveAccount">Yes, delete everything</button>
    <button type="button" @onclick="() => confirmingRemove = false">Cancel</button>
    @if (removeProblem is AccountProblem shownRemove)
    {
        <p class="validation-message" role="alert">@ReaderRules.Describe(shownRemove)</p>
    }
}
</section>

@code {
    private readonly PasswordForm form = new();
    private AccountProblem? problem;
    private bool shelfOpen;
    private bool confirmingRemove;
    private string removePassword = "";
    private AccountProblem? removeProblem;
    private string culture = "";
    private bool twoFactorOn;
    private string? setupSecret;
    private string? setupUri;
    private string? setupQr;
    private string twoFactorCode = "";
    private string[]? recovery;
    private AccountProblem? twoFactorProblem;
    private SessionSummary[] sessions = [];
    private string? currentSession;
    private string emailAddress = "";
    private string? savedEmail;
    private bool emailReminders;
    private AccountProblem? emailProblem;
    private string? emailNote;

    private IReadOnlyList<AuditLine> activity = [];
    private IReadOnlyList<PasskeySummary> passkeys = [];
    private bool passkeySupported;
    private bool passkeyChecked;
    private bool addingPasskey;
    private string passkeyName = "";
    private string? passkeyProblem;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await using var module = await Js.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import", "./passkey.js");
            passkeySupported = await module.InvokeAsync<bool>("supported");
            passkeyChecked = true;
            StateHasChanged();
        }
    }

    private async Task AddPasskey()
    {
        addingPasskey = true;
        passkeyProblem = null;
        await using (var module = await Js.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import", "./passkey.js"))
        {
            passkeyProblem = await module.InvokeAsync<string?>("register", passkeyName.Trim());
        }

        addingPasskey = false;
        if (passkeyProblem is null)
        {
            passkeyName = "";
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        passkeys = await Passkeys.ListAsync(db, db.ReaderId);
        activity = await Audit.RecentAsync(db, db.ReaderId, take: 20);
    }

    private async Task RemovePasskey(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await Passkeys.RemoveAsync(db, db.ReaderId, id);
        passkeys = await Passkeys.ListAsync(db, db.ReaderId);
        activity = await Audit.RecentAsync(db, db.ReaderId, take: 20);
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        shelfOpen = await Asking.IsShelfOpenAsync(db);
        var me = await db.Readers.AsNoTracking().FirstAsync(item => item.Id == db.ReaderId);
        activity = await Audit.RecentAsync(db, me.Id, take: 20);
        passkeys = await Passkeys.ListAsync(db, me.Id);
        savedEmail = me.Email;
        emailAddress = me.Email ?? "";
        emailReminders = me.EmailReminders;
        twoFactorOn = me.TwoFactorEnabled;
        culture = me.Culture ?? "";
        currentSession = (await Authentication.GetAuthenticationStateAsync()).User.FindFirst(TwoFactor.SessionClaim)?.Value;
        sessions = await TwoFactor.SessionsAsync(db, db.ReaderId, currentSession);
    }

    private async Task ChangeShelfOpen(ChangeEventArgs change)
    {
        shelfOpen = change.Value is true;
        await using var db = await DbFactory.CreateDbContextAsync();
        await Asking.SetShelfOpenAsync(db, shelfOpen);
    }

    // A live page keeps the culture it opened with, so the page reloads to show the new one.
    private async Task SaveCulture()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var me = await db.Readers.FirstAsync(item => item.Id == db.ReaderId);
        me.Culture = Regions.Clean(culture);
        await db.SaveChangesAsync();
        Navigation.NavigateTo("/account", forceLoad: true);
    }

    private async Task StartTwoFactor()
    {
        twoFactorProblem = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        var me = await db.Readers.FirstAsync(item => item.Id == db.ReaderId);
        setupSecret = TwoFactor.NewSecret();
        me.TwoFactorSecret = TwoFactor.Protector(Protection).Protect(setupSecret);
        me.TwoFactorEnabled = false;
        await db.SaveChangesAsync();
        setupUri = TwoFactor.Uri(setupSecret, me.Name);
        setupQr = TwoFactor.QrSvg(setupUri);
        twoFactorCode = "";
    }

    private async Task ConfirmTwoFactor()
    {
        if (setupSecret is null || !TwoFactor.Verify(setupSecret, twoFactorCode, DateTimeOffset.UtcNow))
        {
            twoFactorProblem = AccountProblem.CodeWrong;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var me = await db.Readers.FirstAsync(item => item.Id == db.ReaderId);
        me.TwoFactorEnabled = true;
        await db.SaveChangesAsync();
        await Audit.NoteAsync(db, "Turned on two-step sign-in", me);
        recovery = await TwoFactor.NewRecoveryCodesAsync(db, me.Id);
        twoFactorOn = true;
        twoFactorProblem = null;
        setupUri = null;
        setupSecret = null;
        twoFactorCode = "";
    }

    private async Task TurnOffTwoFactor()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var me = await db.Readers.FirstAsync(item => item.Id == db.ReaderId);
        if (!await TwoFactor.CheckAsync(db, Protection, me, twoFactorCode))
        {
            twoFactorProblem = AccountProblem.CodeWrong;
            return;
        }

        await TwoFactor.DisableAsync(db, me);
        twoFactorOn = false;
        recovery = null;
        twoFactorProblem = null;
        twoFactorCode = "";
    }

    private async Task EndSession(string id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await TwoFactor.SignOutDeviceAsync(db, db.ReaderId, id);
        sessions = await TwoFactor.SessionsAsync(db, db.ReaderId, currentSession);
    }

    private async Task EndOtherSessions()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await TwoFactor.EndOtherSessionsAsync(db, db.ReaderId, currentSession);
        sessions = await TwoFactor.SessionsAsync(db, db.ReaderId, currentSession);
    }

    private async Task SaveEmail()
    {
        emailNote = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        emailProblem = await ReaderRules.SetEmailAsync(db, db.ReaderId, emailAddress, emailReminders);
        if (emailProblem is null)
        {
            savedEmail = EmailRules.CleanAddress(emailAddress);
            emailReminders = savedEmail is not null && emailReminders;
            emailNote = "Saved.";
        }
    }

    private async Task SendTest()
    {
        emailProblem = null;
        try
        {
            await Email.SendAsync(new EmailMessage(savedEmail!, "Shelf can reach you", $"Hello {Reader.Name},\n\nThis is a test from your shelf. Email works."), CancellationToken.None);
            emailNote = $"Sent to {savedEmail}.";
        }
        catch (Exception ex) when (ex is MailKit.ProtocolException or MailKit.CommandException or System.Net.Sockets.SocketException or MailKit.Security.AuthenticationException or InvalidOperationException or IOException)
        {
            emailNote = $"The mail server did not take it: {ex.Message}";
        }
    }

    private async Task ChangePassword()
    {
        if (!string.Equals(form.Password, form.Confirm, StringComparison.Ordinal))
        {
            problem = AccountProblem.PasswordsDiffer;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        problem = await ReaderRules.ChangePasswordAsync(db, db.ReaderId, form.Current, form.Password);
        if (problem is null)
        {
            Navigation.NavigateTo("/signin?notice=changed", forceLoad: true);
        }
    }

    private async Task RemoveAccount()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        removeProblem = await ReaderRules.RemoveSelfAsync(db, Ebooks, Audio, db.ReaderId, removePassword);
        if (removeProblem is null)
        {
            Navigation.NavigateTo("/signin?notice=removed", forceLoad: true);
        }
    }

    private sealed class PasswordForm
    {
        public string Current { get; set; } = "";
        public string Password { get; set; } = "";
        public string Confirm { get; set; } = "";
    }
}
