@page "/account"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory
@inject ShelfReader Reader
@inject NavigationManager Navigation
@inject EbookStore Ebooks
@inject AudioStore Audio
@inject IEmailSender Email

<PageTitle>Account · Shelf</PageTitle>

<h1>@Reader.Name</h1>
<p class="hint">Your notes, reviews, quotes, and highlights are yours alone. Other readers see a book of yours only when it is lent to them, or by its title on an open shelf.</p>

<section class="panel">
<h2>Your shelf</h2>
<label class="check">
    <input type="checkbox" checked="@shelfOpen" @onchange="ChangeShelfOpen" />
    Let other readers see the titles on my shelf and ask to borrow one
</label>
<p class="hint">Asks wait on your <a href="/loans">Loans</a> page until you lend the book or decline.</p>

</section>

<section class="panel">
<h2>Email</h2>
@if (!Email.Enabled)
{
    <p class="hint">This shelf has no mail server set up, so it cannot send password resets or reminders. An admin can add one in the Email settings.</p>
}
<label>
    Email address
    <input type="email" @bind="emailAddress" maxlength="@EmailRules.MaxAddressLength" autocomplete="email" />
</label>
<label class="check">
    <input type="checkbox" @bind="emailReminders" disabled="@(string.IsNullOrWhiteSpace(emailAddress))" />
    Email me once a day when a loan is overdue or due soon, or someone asks to borrow
</label>
<p class="hint">Used only for password resets and the reminders you choose.</p>
<button type="button" class="primary" @onclick="SaveEmail">Save</button>
@if (Email.Enabled)
{
    <button type="button" @onclick="SendTest" disabled="@string.IsNullOrWhiteSpace(savedEmail)">Send a test email</button>
}
@if (emailProblem is AccountProblem shownEmail)
{
    <p class="validation-message" role="alert">@ReaderRules.Describe(shownEmail)</p>
}
else if (emailNote is not null)
{
    <span class="saved" role="status">@emailNote</span>
}
</section>

<section class="panel">
<h2>Change the password</h2>
<EditForm Model="form" OnValidSubmit="ChangePassword">
    <label>
        Current password
        <InputText type="password" @bind-Value="form.Current" autocomplete="current-password" />
    </label>
    <label>
        New password, at least @ReaderRules.MinPasswordLength characters
        <InputText type="password" @bind-Value="form.Password" autocomplete="new-password" />
    </label>
    <label>
        The new password again
        <InputText type="password" @bind-Value="form.Confirm" autocomplete="new-password" />
    </label>
    <p class="hint">Changing it signs you out everywhere, here included.</p>
    <button type="submit">Change it</button>
    @if (problem is AccountProblem shown)
    {
        <p class="validation-message" role="alert">@ReaderRules.Describe(shown)</p>
    }
</EditForm>

</section>

<section class="panel">
<h2>Devices</h2>
<p class="hint"><a href="/sync">Make a key</a> for another shelf to trade e-books and audiobooks with yours.</p>

</section>

<section class="panel">
<h2>Delete the account</h2>
@if (!confirmingRemove)
{
    <button type="button" class="danger" @onclick="() => confirmingRemove = true">Delete my account</button>
}
else
{
    <p>This deletes your account, every book on your shelf, and their e-books and audiobooks. Books other readers have lent you go back to them. Download a <a href="/books/export/full">full backup</a> first if you may want any of it.</p>
    <label>
        Your password
        <input type="password" @bind="removePassword" autocomplete="current-password" />
    </label>
    <button type="button" class="danger" @onclick="RemoveAccount">Yes, delete everything</button>
    <button type="button" @onclick="() => confirmingRemove = false">Cancel</button>
    @if (removeProblem is AccountProblem shownRemove)
    {
        <p class="validation-message" role="alert">@ReaderRules.Describe(shownRemove)</p>
    }
}
</section>

@code {
    private readonly PasswordForm form = new();
    private AccountProblem? problem;
    private bool shelfOpen;
    private bool confirmingRemove;
    private string removePassword = "";
    private AccountProblem? removeProblem;
    private string emailAddress = "";
    private string? savedEmail;
    private bool emailReminders;
    private AccountProblem? emailProblem;
    private string? emailNote;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        shelfOpen = await Asking.IsShelfOpenAsync(db);
        var me = await db.Readers.AsNoTracking().FirstAsync(item => item.Id == db.ReaderId);
        savedEmail = me.Email;
        emailAddress = me.Email ?? "";
        emailReminders = me.EmailReminders;
    }

    private async Task ChangeShelfOpen(ChangeEventArgs change)
    {
        shelfOpen = change.Value is true;
        await using var db = await DbFactory.CreateDbContextAsync();
        await Asking.SetShelfOpenAsync(db, shelfOpen);
    }

    private async Task SaveEmail()
    {
        emailNote = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        emailProblem = await ReaderRules.SetEmailAsync(db, db.ReaderId, emailAddress, emailReminders);
        if (emailProblem is null)
        {
            savedEmail = EmailRules.CleanAddress(emailAddress);
            emailReminders = savedEmail is not null && emailReminders;
            emailNote = "Saved.";
        }
    }

    private async Task SendTest()
    {
        emailProblem = null;
        try
        {
            await Email.SendAsync(new EmailMessage(savedEmail!, "Shelf can reach you", $"Hello {Reader.Name},\n\nThis is a test from your shelf. Email works."), CancellationToken.None);
            emailNote = $"Sent to {savedEmail}.";
        }
        catch (Exception ex) when (ex is MailKit.ProtocolException or MailKit.CommandException or System.Net.Sockets.SocketException or MailKit.Security.AuthenticationException or InvalidOperationException or IOException)
        {
            emailNote = $"The mail server did not take it: {ex.Message}";
        }
    }

    private async Task ChangePassword()
    {
        if (!string.Equals(form.Password, form.Confirm, StringComparison.Ordinal))
        {
            problem = AccountProblem.PasswordsDiffer;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        problem = await ReaderRules.ChangePasswordAsync(db, db.ReaderId, form.Current, form.Password);
        if (problem is null)
        {
            Navigation.NavigateTo("/signin?notice=changed", forceLoad: true);
        }
    }

    private async Task RemoveAccount()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        removeProblem = await ReaderRules.RemoveSelfAsync(db, Ebooks, Audio, db.ReaderId, removePassword);
        if (removeProblem is null)
        {
            Navigation.NavigateTo("/signin?notice=removed", forceLoad: true);
        }
    }

    private sealed class PasswordForm
    {
        public string Current { get; set; } = "";
        public string Password { get; set; } = "";
        public string Confirm { get; set; } = "";
    }
}
