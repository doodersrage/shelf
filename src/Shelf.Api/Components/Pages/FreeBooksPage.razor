@page "/free"
@rendermode InteractiveServer
@using Microsoft.Extensions.Caching.Memory
@inject IDbContextFactory<ShelfDb> DbFactory
@inject IHttpClientFactory Http
@inject FreeBooks Downloads
@inject NavigationManager Navigation
@inject IMemoryCache Cache
@inject ILogger<FreeBooksPage> Logger
@implements IDisposable

<PageTitle>@T("Free books") · Shelf</PageTitle>

<h1>@T("Free books")</h1>
<p class="hint">@T("Books whose copyright has run out, free for anyone to read. E-books come from Project Gutenberg, and audiobooks, read by volunteers, from LibriVox. Adding one puts it on your shelf with its file, tagged “{0}”. Public domain differs by country; Project Gutenberg follows United States law.", T("public domain")) <a href="https://www.gutenberg.org" rel="noopener">gutenberg.org</a> · <a href="https://librivox.org" rel="noopener">librivox.org</a></p>

@if (!Downloads.Enabled)
{
    <p class="hint">@T("Free books are turned off on this shelf (FreeBooks:Enabled is false).")</p>
}
else
{
    <form class="filters" action="/free" method="get" role="search">
        <label>
            @T("Title or author")
            <input type="search" name="q" value="@Q" minlength="2" maxlength="200" autofocus />
        </label>
        <label>
            @T("Look for")
            <select name="kind">
                <option value="ebooks" selected="@(Kind != "audio")">@T("E-books")</option>
                <option value="audio" selected="@(Kind == "audio")">@T("Audiobooks")</option>
            </select>
        </label>
        <div><button type="submit">@T("Search")</button></div>
    </form>

    @if (downloads.Count > 0)
    {
        <section class="panel" aria-labelledby="downloads-heading">
            <h2 id="downloads-heading">@T("Adding")</h2>
            <ul class="free-downloads">
                @foreach (var download in downloads)
                {
                    <li>
                        <span>@download.Book.Title</span>
                        @switch (download.State)
                        {
                            case DownloadState.Waiting:
                                <span class="hint">@T("Waiting")</span>
                                break;
                            case DownloadState.Downloading:
                                <span class="hint">@(download.Bytes > 0 ? T("Downloading, {0}…", Localization.Counts.Size(download.Bytes)) : T("Downloading…"))</span>
                                break;
                            case DownloadState.Done:
                                <a href="/library/@download.BookId">@T("On your shelf")</a>
                                break;
                            default:
                                <span class="validation-message">@download.Problem</span>
                                break;
                        }
                    </li>
                }
            </ul>
        </section>
    }

    <form class="filters" action="/free" method="get">
        <input type="hidden" name="kind" value="@(Audio ? "audio" : "ebooks")" />
        <label>
            @T("Browse")
            <select name="shelf">
                <option value="">@(Audio ? T("Newest recordings") : T("Most popular"))</option>
                @foreach (var shelf in Shelves)
                {
                    <option value="@shelf.Key" selected="@(Shelf == shelf.Key)">@T(shelf.Name)</option>
                }
            </select>
        </label>
        <div><button type="submit" class="quiet">@T("Show")</button></div>
    </form>

    @if (problem is not null)
    {
        <p class="validation-message" role="alert">@problem</p>
    }
    else if (results is { Count: 0 })
    {
        <EmptyState Title="@T("Nothing found")" Text="@(Searching
            ? (Audio ? T("LibriVox has no recording by that title or author. Try fewer words, or an author's last name.") : T("Project Gutenberg has nothing by that title or author. Try fewer words."))
            : T("Nothing here just now. Try another part of the catalog."))" />
    }
    else if (results is not null)
    {
        <h2 class="free-heading">@Heading</h2>
        @if (Searching)
        {
            <p class="count">@Localization.Counts.Books(results.Count)</p>
        }
        <ul class="free-results">
            @foreach (var book in results)
            {
                var added = downloads.Any(download => download.Book.Source == book.Source && download.Book.Id == book.Id && download.State != DownloadState.Failed);
                var key = Key(book);
                var open = about.TryGetValue(key, out var shown);
                <li id="@($"book-{key}")">
                    <BookCover Title="@book.Title" Url="@book.CoverUrl" Width="3.5rem" />
                    <div>
                        <strong>@book.Title</strong>
                        <span class="by">@book.Author</span>
                        @if (book.Language is not null || book.Length is not null)
                        {
                            <span class="hint">@string.Join(" · ", new[] { book.Language, book.Length is null ? null : T("{0} long", book.Length) }.Where(part => part is not null))</span>
                        }
                        @if (RendererInfo.IsInteractive)
                        {
                            <button type="button" class="link about-toggle" @onclick="() => ToggleAbout(book)" aria-expanded="@(open ? "true" : "false")" aria-controls="@($"about-{key}")">
                                @(open ? T("Hide the details") : T("About this book"))
                            </button>
                        }
                        else
                        {
                            @* Until the page's live connection is up, or without one, a link: the server opens the details itself. *@
                            <a class="about-toggle" href="@AboutHref(key, open)" aria-expanded="@(open ? "true" : "false")" aria-controls="@($"about-{key}")">
                                @(open ? T("Hide the details") : T("About this book"))
                            </a>
                        }
                    </div>
                    <button type="button" @onclick="() => Add(book)" disabled="@added" aria-label="@T("Add {0} to your shelf", book.Title)">@(added ? T("Added") : T("Add to shelf"))</button>
                    @if (open)
                    {
                        <div class="free-about" id="@($"about-{key}")" role="region" aria-label="@T("About {0}", book.Title)">
                            @if (shown is null)
                            {
                                <p class="hint" role="status">@T("Looking it up…")</p>
                            }
                            else if (shown.Details is not { } details)
                            {
                                <p class="hint">@T("The catalog has nothing more on this book just now.")</p>
                            }
                            else
                            {
                                @if (details.CoverUrl is not null)
                                {
                                    <img class="free-about-cover" src="@details.CoverUrl" alt="" loading="lazy" />
                                }
                                @if (details.About is not null)
                                {
                                    @foreach (var paragraph in details.About.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                    {
                                        <p>@paragraph</p>
                                    }
                                }
                                else
                                {
                                    <p class="hint">@T("No summary or description is given for this book.")</p>
                                }
                                @if (details.Subjects.Count > 0)
                                {
                                    <ul class="free-subjects" aria-label="@(book.Source == FreeSource.LibriVox ? T("Genres") : T("Subjects"))">
                                        @foreach (var subject in details.Subjects)
                                        {
                                            <li>@subject</li>
                                        }
                                    </ul>
                                }
                                <dl class="facts">
                                    @if (details.Language is not null)
                                    {
                                        <dt>@T("Language")</dt><dd>@details.Language</dd>
                                    }
                                    @if (details.Length is not null)
                                    {
                                        <dt>@T("Length")</dt><dd>@details.Length</dd>
                                    }
                                    @if (details.Chapters is int chapters)
                                    {
                                        <dt>@T("Chapters")</dt><dd>@chapters</dd>
                                    }
                                    @if (details.Translators is not null)
                                    {
                                        <dt>@T("Translated by")</dt><dd>@details.Translators</dd>
                                    }
                                    @if (details.Published is not null)
                                    {
                                        <dt>@(book.Source == FreeSource.LibriVox ? T("First published") : T("Online since"))</dt><dd>@details.Published</dd>
                                    }
                                    @if (details.Downloads is int count)
                                    {
                                        <dt>@T("Downloads")</dt><dd>@count.ToString("N0")</dd>
                                    }
                                    @if (details.ReadingLevel is not null)
                                    {
                                        <dt>@T("Reading level")</dt><dd>@details.ReadingLevel</dd>
                                    }
                                </dl>
                                <p class="hint"><a href="@details.Link" rel="noopener">@(book.Source == FreeSource.LibriVox ? T("See it on LibriVox") : T("See it on Project Gutenberg"))</a></p>
                            }
                        </div>
                    }
                </li>
            }
        </ul>
        @if (more)
        {
            <button type="button" class="quiet" @onclick="ShowMore" disabled="@loadingMore">@(loadingMore ? T("Loading…") : T("Show more"))</button>
        }
    }
}

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "kind")]
    public string? Kind { get; set; }

    [SupplyParameterFromQuery(Name = "shelf")]
    public string? Shelf { get; set; }

    // The book whose details are open, as Source-Id, when the page was asked for without its live connection.
    [SupplyParameterFromQuery(Name = "about")]
    public string? About { get; set; }

    private readonly Dictionary<string, Shown?> about = [];
    private bool more;
    private bool loadingMore;
    private int position;

    private List<FreeBook>? results;
    private string? problem;
    private IReadOnlyList<FreeDownload> downloads = [];
    private int readerId;
    private Timer? timer;

    protected override async Task OnParametersSetAsync()
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            readerId = db.ReaderId;
        }

        downloads = Downloads.For(readerId);
        results = null;
        problem = null;
        more = false;
        position = 0;
        about.Clear();
        if (!Downloads.Enabled)
        {
            return;
        }

        var query = Q?.Trim();
        using var limit = new CancellationTokenSource(TimeSpan.FromSeconds(45));
        var http = Http.CreateClient(FreeCatalog.ClientName);
        try
        {
            if (!string.IsNullOrEmpty(query) && query.Length >= 2)
            {
                results = Audio
                    ? await FreeCatalog.SearchLibriVoxAsync(http, query[..Math.Min(query.Length, 200)], limit.Token)
                    : await FreeCatalog.SearchGutenbergAsync(http, query[..Math.Min(query.Length, 200)], limit.Token);
            }
            else
            {
                // With nothing searched for, the catalog is browsed: the most read, the newest, or one part of it.
                var page = await BrowseAsync(http, 0, limit.Token);
                results = page.Books;
                more = page.More;
                position = page.Books.Count;
            }
        }
        catch (Exception ex) when (Unreached(ex))
        {
            Logger.LogInformation(ex, "Free books could not reach the catalog.");
            problem = Unreachable;
        }

        if (About is { } wanted && results?.FirstOrDefault(book => Key(book) == wanted) is { } chosen)
        {
            about[wanted] = new Shown(await LookUpAsync(chosen));
        }
    }

    private static string Key(FreeBook book) => $"{book.Source}-{book.Id}";

    // This page with one book's details open, or closed again, and scrolled to that book.
    private string AboutHref(string key, bool open) =>
        Navigation.GetUriWithQueryParameter("about", open ? null : key) + $"#book-{key}";

    // A catalog that is slow, cut off, or answering nonsense; never a reason to stop the page. Every outgoing request
    // goes through the standard resilience handler, whose timeouts and open circuit throw Polly's rejections.
    private static bool Unreached(Exception ex) =>
        ex is HttpRequestException or Polly.ExecutionRejectedException or OperationCanceledException or IOException or System.Xml.XmlException or System.Text.Json.JsonException;

    // A book's details, kept for half an hour so opening them twice asks the catalog once.
    private async Task<FreeDetails?> LookUpAsync(FreeBook book)
    {
        var cacheKey = $"free-about:{Key(book)}";
        if (Cache.TryGetValue(cacheKey, out FreeDetails? kept))
        {
            return kept;
        }

        try
        {
            // Gutenberg can take most of a minute for one book's record when it is busy.
            using var limit = new CancellationTokenSource(TimeSpan.FromSeconds(50));
            var details = await FreeCatalog.DetailsAsync(Http.CreateClient(FreeCatalog.ClientName), book.Source, book.Id, limit.Token);
            Cache.Set(cacheKey, details, TimeSpan.FromMinutes(30));
            return details;
        }
        catch (Exception ex) when (Unreached(ex))
        {
            Logger.LogInformation(ex, "Could not look up {Source} book {Id}.", book.Source, book.Id);
            return null;
        }
    }

    private Task<FreePage> BrowseAsync(HttpClient http, int from, CancellationToken cancellationToken) => Audio
        ? FreeCatalog.BrowseLibriVoxAsync(http, Shelf, from, cancellationToken)
        // Gutenberg counts its pages from 1.
        : FreeCatalog.BrowseGutenbergAsync(http, Shelf, from + 1, cancellationToken);

    private async Task ShowMore()
    {
        loadingMore = true;
        try
        {
            using var limit = new CancellationTokenSource(TimeSpan.FromSeconds(45));
            var page = await BrowseAsync(Http.CreateClient(FreeCatalog.ClientName), position, limit.Token);
            results ??= [];
            var known = results.Select(book => book.Id).ToHashSet();
            results.AddRange(page.Books.Where(book => known.Add(book.Id)));
            position += page.Books.Count;
            more = page.More && page.Books.Count > 0;
        }
        catch (Exception ex) when (Unreached(ex))
        {
            Logger.LogInformation(ex, "Free books could not reach the catalog.");
            problem = Unreachable;
        }
        finally
        {
            loadingMore = false;
        }
    }

    // The details are fetched the first time a book is opened, and kept while the page is.
    private async Task ToggleAbout(FreeBook book)
    {
        var key = Key(book);
        if (about.Remove(key))
        {
            return;
        }

        about[key] = null;
        var details = await LookUpAsync(book);
        if (about.ContainsKey(key))
        {
            about[key] = new Shown(details);
        }
    }

    private bool Audio => Kind == "audio";

    private bool Searching => !string.IsNullOrWhiteSpace(Q) && Q.Trim().Length >= 2;

    private IReadOnlyList<FreeShelf> Shelves => Audio ? FreeCatalog.LibriVoxGenres : FreeCatalog.GutenbergShelves;

    private string Heading => Searching
        ? T("Found for “{0}”", Q!.Trim())
        : Shelves.FirstOrDefault(item => item.Key == Shelf) is { } shelf ? T(shelf.Name)
        : Audio ? T("Newest recordings") : T("Most popular");

    private string Unreachable => Audio
        ? T("LibriVox could not be reached just now. Try again in a moment.")
        : T("Project Gutenberg could not be reached just now. Try again in a moment.");

    private sealed record Shown(FreeDetails? Details);

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            timer = new Timer(_ => InvokeAsync(Refresh), null, TimeSpan.FromSeconds(1.5), TimeSpan.FromSeconds(1.5));
        }
    }

    // While something is being added, its progress shows.
    private void Refresh()
    {
        var now = Downloads.For(readerId);
        if (now.Count != downloads.Count || now.Zip(downloads).Any(pair => pair.First != pair.Second))
        {
            downloads = now;
            StateHasChanged();
        }
    }

    private void Add(FreeBook book)
    {
        Downloads.Enqueue(readerId, book);
        downloads = Downloads.For(readerId);
    }

    public void Dispose() => timer?.Dispose();
}
