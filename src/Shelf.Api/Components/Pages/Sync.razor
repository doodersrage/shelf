@page "/sync"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory
@inject IHttpClientFactory Http
@inject EbookStore Ebooks
@inject AudioStore Audio
@inject NavigationManager Navigation

<PageTitle>Devices</PageTitle>

<h1>Devices</h1>
<p>Another shelf can trade e-books and audiobooks with yours. The place you stopped, and the notes on a passage, come along. The furthest place is the one that stays.</p>

<section class="panel">
<h2>This shelf's key</h2>
<p class="hint">The other shelf needs this key to reach your books. Anyone with it can read and add to your e-books and audiobooks, so keep it as you would a password.</p>
@if (newKey is not null)
{
    <p><code class="key">@newKey</code></p>
    <p class="hint">Copy it now. It is not shown again.</p>
}
else if (hasKey)
{
    <p class="hint">A key is in use. A new one stops the old one from working.</p>
}
<p>
    <button type="button" @onclick="MakeKey">@(hasKey ? "Make a new key" : "Make a key")</button>
</p>

</section>

<section class="panel">
<h2>E-reader apps</h2>
<p>Reading apps that browse an OPDS catalog, such as KOReader, can download your e-books from this shelf. Add a catalog with this address, any user name, and this shelf's key as the password.</p>
<p><code class="key">@CatalogAddress</code></p>

<h3>Keep your place in step with KOReader</h3>
<p>KOReader's progress sync sends the page you reach to Shelf and fetches the one you reached here. In KOReader, open a book, then Tools, Progress sync, Custom sync server, and enter:</p>
<dl class="facts">
    <dt>Server</dt>
    <dd><code class="key">@KosyncAddress</code></dd>
    <dt>Username</dt>
    <dd><code class="key">@readerName</code></dd>
    <dt>Password</dt>
    <dd>
        @if (newKosyncPassword is not null)
        {
            <code class="key">@newKosyncPassword</code>
            <span class="hint">Copy it now. It is not shown again.</span>
        }
        else
        {
            <span class="hint">@(hasKosync ? "A KOReader password is in use." : "Make one below.")</span>
        }
    </dd>
</dl>
<p class="hint">Then choose Login. A book matches when KOReader has the same file Shelf has, downloaded from the catalog above, say. The furthest place is the one Shelf keeps.</p>
<p>
    <button type="button" @onclick="MakeKosyncPassword">@(hasKosync ? "Make a new KOReader password" : "Make a KOReader password")</button>
    @if (hasKosync)
    {
        <button type="button" class="quiet" @onclick="StopKosync">Stop syncing with KOReader</button>
    }
</p>
</section>

<section class="panel">
<h2>Another shelf</h2>
<EditForm Model="form" OnValidSubmit="Save">
    <label>
        Address of the other shelf
        <InputText @bind-Value="form.Address" maxlength="300" />
    </label>
    <label>
        Key from the other shelf
        <InputText @bind-Value="form.Key" maxlength="100" type="password" autocomplete="off" />
    </label>
    <button type="submit" class="quiet">Save</button>
    @if (saved)
    {
        <span class="hint">Saved.</span>
    }
</EditForm>
<p class="hint">Use an https:// address when the other shelf is not on your own network, so the key is not sent in the clear.</p>

<p>
    <button type="button" class="primary" @onclick="SyncNow" disabled="@busy">@(busy ? "Syncing…" : "Sync now")</button>
</p>

@if (lines is not null)
{
    <ul>
        @foreach (var line in lines)
        {
            <li>@line</li>
        }
    </ul>
}
</section>

@code {
    private readonly AddressForm form = new();
    private bool saved;

    private string CatalogAddress => Navigation.ToAbsoluteUri("/opds").ToString();
    private string KosyncAddress => Navigation.ToAbsoluteUri("/kosync").ToString();
    private string? readerName;
    private bool hasKosync;
    private string? newKosyncPassword;
    private bool busy;
    private bool hasKey;
    private string? newKey;
    private IReadOnlyList<string>? lines;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        form.Address = await BookRules.GetSyncAddressAsync(db) ?? "";
        form.Key = await BookRules.GetSyncKeyAsync(db) ?? "";
        hasKey = await ReaderRules.HasKeyAsync(db, db.ReaderId);
        var reader = await db.Readers.AsNoTracking().FirstOrDefaultAsync(item => item.Id == db.ReaderId);
        readerName = reader?.Name;
        hasKosync = reader?.KosyncHash is not null;
    }

    private async Task MakeKosyncPassword()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var reader = await db.Readers.FirstAsync(item => item.Id == db.ReaderId);
        newKosyncPassword = Kosync.NewPassword();
        reader.KosyncHash = Kosync.HashOf(newKosyncPassword);
        await db.SaveChangesAsync();
        await Audit.NoteAsync(db, "Made a KOReader password", reader);
        hasKosync = true;
    }

    private async Task StopKosync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var reader = await db.Readers.FirstAsync(item => item.Id == db.ReaderId);
        reader.KosyncHash = null;
        await db.SaveChangesAsync();
        await Audit.NoteAsync(db, "Stopped syncing with KOReader", reader);
        hasKosync = false;
        newKosyncPassword = null;
    }

    private async Task MakeKey()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        newKey = await ReaderRules.NewKeyAsync(db, db.ReaderId);
        hasKey = true;
    }

    private async Task Save()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await BookRules.SetSyncAddressAsync(db, form.Address, form.Key);
        saved = true;
        lines = null;
    }

    private async Task SyncNow()
    {
        saved = false;
        busy = true;
        lines = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await BookRules.SetSyncAddressAsync(db, form.Address, form.Key);
            var client = Http.CreateClient("shelf-sync");
            lines = await ShelfSync.FromShelfAsync(client, form.Address, form.Key, db, Ebooks, Audio, CancellationToken.None);
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class AddressForm
    {
        public string Address { get; set; } = "";
        public string Key { get; set; } = "";
    }
}
