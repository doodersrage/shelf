@page "/sync"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory
@inject IHttpClientFactory Http
@inject EbookStore Ebooks
@inject AudioStore Audio
@inject NavigationManager Navigation

<PageTitle>@T("Devices") · Shelf</PageTitle>

<h1>@T("Devices")</h1>
<p>@T("Another shelf can trade e-books and audiobooks with yours. The place you stopped, and the notes on a passage, come along. The furthest place is the one that stays.")</p>

<section class="panel">
<h2>@T("This shelf's key")</h2>
<p class="hint">@T("The other shelf needs this key to reach your books. Anyone with it can read and add to your e-books and audiobooks, so keep it as you would a password.")</p>
@if (newKey is not null)
{
    <p><code class="key">@newKey</code></p>
    <p class="hint">@T("Copy it now. It is not shown again.")</p>
}
else if (hasKey)
{
    <p class="hint">@T("A key is in use. A new one stops the old one from working.")</p>
}
<p>
    <button type="button" @onclick="MakeKey">@(hasKey ? T("Make a new key") : T("Make a key"))</button>
</p>

</section>

<section class="panel">
<h2>@T("E-reader apps")</h2>
<p>@T("Reading apps that browse an OPDS catalog, such as KOReader, can download your e-books from this shelf. Add a catalog with this address, any user name, and this shelf's key as the password.")</p>
<p><code class="key">@CatalogAddress</code></p>

<h3>@T("Keep your place in step with KOReader")</h3>
<p>@T("KOReader's progress sync sends the page you reach to Shelf and fetches the one you reached here. In KOReader, open a book, then Tools, Progress sync, Custom sync server, and enter:")</p>
<dl class="facts">
    <dt>@T("Server")</dt>
    <dd><code class="key">@KosyncAddress</code></dd>
    <dt>@T("Username")</dt>
    <dd><code class="key">@readerName</code></dd>
    <dt>@T("Password")</dt>
    <dd>
        @if (newKosyncPassword is not null)
        {
            <code class="key">@newKosyncPassword</code>
            <span class="hint">@T("Copy it now. It is not shown again.")</span>
        }
        else
        {
            <span class="hint">@(hasKosync ? T("A KOReader password is in use.") : T("Make one below."))</span>
        }
    </dd>
</dl>
<p class="hint">@T("Then choose Login. A book matches when KOReader has the same file Shelf has, downloaded from the catalog above, say. The furthest place is the one Shelf keeps.")</p>
<p>
    <button type="button" @onclick="MakeKosyncPassword">@(hasKosync ? T("Make a new KOReader password") : T("Make a KOReader password"))</button>
    @if (hasKosync)
    {
        <button type="button" class="quiet" @onclick="StopKosync">@T("Stop syncing with KOReader")</button>
    }
</p>

<h3>@T("Bring highlights from KOReader")</h3>
<p>@T("KOReader's sync carries your place, not your highlights. In KOReader, open the menu, then Tools, Export highlights, choose JSON as the format, and export the book or all books. Copy the file it makes to this device, and choose it here. Each highlight goes to its chapter, with its note.")</p>
<label>
    @T("The exported JSON file")
    <InputFile OnChange="ImportHighlights" accept=".json,application/json,text/json" disabled="@importingHighlights" />
</label>
@if (highlightNote is not null)
{
    <p class="@(highlightProblem ? "validation-message" : "saved")" role="status">@highlightNote</p>
}

<h3>@T("Bring highlights from a Kindle")</h3>
<p>@T("A Kindle keeps every highlight and note in a file called My Clippings.txt, in its documents folder. Connect the Kindle to this computer by its cable, and choose that file here. On a book with an EPUB, each highlight goes to its chapter with its note; on other books it becomes a quote.")</p>
<label>
    @T("My Clippings.txt")
    <InputFile OnChange="ImportClippings" accept=".txt,text/plain" disabled="@importingClippings" />
</label>
@if (clippingNote is not null)
{
    <p class="@(clippingProblem ? "validation-message" : "saved")" role="status">@clippingNote</p>
}
</section>

<section class="panel">
<h2>@T("Another shelf")</h2>
<EditForm Model="form" OnValidSubmit="Save">
    <label>
        @T("Address of the other shelf")
        <InputText @bind-Value="form.Address" maxlength="300" />
    </label>
    <label>
        @T("Key from the other shelf")
        <InputText @bind-Value="form.Key" maxlength="100" type="password" autocomplete="off" />
    </label>
    <button type="submit" class="quiet">@T("Save")</button>
    @if (saved)
    {
        <span class="hint">@T("Saved.")</span>
    }
</EditForm>
<p class="hint">@T("Use an https:// address when the other shelf is not on your own network, so the key is not sent in the clear.")</p>

<p>
    <button type="button" class="primary" @onclick="SyncNow" disabled="@busy">@(busy ? T("Syncing…") : T("Sync now"))</button>
</p>

@if (lines is not null)
{
    <ul>
        @foreach (var line in lines)
        {
            <li>@line</li>
        }
    </ul>
}
</section>

@code {
    private bool importingHighlights;
    private string? highlightNote;
    private bool highlightProblem;

    private async Task ImportHighlights(InputFileChangeEventArgs change)
    {
        importingHighlights = true;
        highlightNote = null;
        try
        {
            await using var stream = change.File.OpenReadStream(KoreaderHighlights.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await KoreaderHighlights.ImportAsync(db, Ebooks, buffer, CancellationToken.None);
            highlightProblem = false;
            highlightNote = T("Added: {0}. Already here: {1}. Books matched: {2}.", result.Added, result.AlreadyHere, result.Books)
                + (result.NotFound.Count > 0 ? " " + T("Not on your shelf with an e-book: {0}.", string.Join(", ", result.NotFound)) : "");
        }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or IOException)
        {
            highlightProblem = true;
            highlightNote = T("That is not a highlights file from KOReader. In KOReader, export highlights as JSON.");
        }
        finally
        {
            importingHighlights = false;
        }
    }

    private bool importingClippings;
    private string? clippingNote;
    private bool clippingProblem;

    private async Task ImportClippings(InputFileChangeEventArgs change)
    {
        importingClippings = true;
        clippingNote = null;
        try
        {
            await using var stream = change.File.OpenReadStream(KindleClippings.MaxBytes);
            using var reader = new StreamReader(stream);
            var text = await reader.ReadToEndAsync();
            if (!text.Contains("==========", StringComparison.Ordinal))
            {
                clippingProblem = true;
                clippingNote = T("That is not a Kindle's My Clippings.txt.");
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await KindleClippings.ImportAsync(db, Ebooks, text, CancellationToken.None);
            clippingProblem = false;
            clippingNote = T("Highlights: {0}. Quotes: {1}. Already here: {2}. Books matched: {3}.", result.Highlights, result.Quotes, result.AlreadyHere, result.Books)
                + (result.NotFound.Count > 0 ? " " + T("Not on your shelf: {0}.", string.Join(", ", result.NotFound.Take(20))) : "");
        }
        catch (IOException)
        {
            clippingProblem = true;
            clippingNote = T("Choose the My Clippings.txt file from the Kindle's documents folder, of up to 20 MB.");
        }
        finally
        {
            importingClippings = false;
        }
    }

    private readonly AddressForm form = new();
    private bool saved;

    private string CatalogAddress => Navigation.ToAbsoluteUri("/opds").ToString();
    private string KosyncAddress => Navigation.ToAbsoluteUri("/kosync").ToString();
    private string? readerName;
    private bool hasKosync;
    private string? newKosyncPassword;
    private bool busy;
    private bool hasKey;
    private string? newKey;
    private IReadOnlyList<string>? lines;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        form.Address = await BookRules.GetSyncAddressAsync(db) ?? "";
        form.Key = await BookRules.GetSyncKeyAsync(db) ?? "";
        hasKey = await ReaderRules.HasKeyAsync(db, db.ReaderId);
        var reader = await db.Readers.AsNoTracking().FirstOrDefaultAsync(item => item.Id == db.ReaderId);
        readerName = reader?.Name;
        hasKosync = reader?.KosyncHash is not null;
    }

    private async Task MakeKosyncPassword()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var reader = await db.Readers.FirstAsync(item => item.Id == db.ReaderId);
        newKosyncPassword = Kosync.NewPassword();
        reader.KosyncHash = Kosync.HashOf(newKosyncPassword);
        await db.SaveChangesAsync();
        await Audit.NoteAsync(db, Say("Made a KOReader password"), reader);
        hasKosync = true;
    }

    private async Task StopKosync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var reader = await db.Readers.FirstAsync(item => item.Id == db.ReaderId);
        reader.KosyncHash = null;
        await db.SaveChangesAsync();
        await Audit.NoteAsync(db, Say("Stopped syncing with KOReader"), reader);
        hasKosync = false;
        newKosyncPassword = null;
    }

    private async Task MakeKey()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        newKey = await ReaderRules.NewKeyAsync(db, db.ReaderId);
        hasKey = true;
    }

    private async Task Save()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await BookRules.SetSyncAddressAsync(db, form.Address, form.Key);
        saved = true;
        lines = null;
    }

    private async Task SyncNow()
    {
        saved = false;
        busy = true;
        lines = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await BookRules.SetSyncAddressAsync(db, form.Address, form.Key);
            var client = Http.CreateClient("shelf-sync");
            lines = await ShelfSync.FromShelfAsync(client, form.Address, form.Key, db, Ebooks, Audio, CancellationToken.None);
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class AddressForm
    {
        public string Address { get; set; } = "";
        public string Key { get; set; } = "";
    }
}
