@page "/"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>Shelf</PageTitle>

<h1>Library</h1>

@if (Suggestion is Book suggestion)
{
    <p class="hint">From the want list: <a href="/library/@suggestion.Id">@suggestion.Title</a></p>
}

<div class="filters">
    <label>
        Search
        <input @bind="query" @bind:event="oninput" />
    </label>
    <label>
        Status
        <select @bind="statusFilter">
            <option value="">All</option>
            @foreach (var status in Enum.GetValues<BookStatus>())
            {
                <option value="@status">@status</option>
            }
        </select>
    </label>
    <label>
        Sort
        <select @bind="sort">
            <option value="title">Title</option>
            <option value="author">Author</option>
            <option value="series">Series</option>
            <option value="year">Year</option>
            <option value="rating">Rating</option>
            <option value="added">Recently added</option>
        </select>
    </label>
</div>
<div class="checks">
    <label class="check">
        <input type="checkbox" @bind="lovedOnly" />
        Loved
    </label>
    <label class="check">
        <input type="checkbox" @bind="loanedOnly" />
        On loan
    </label>
</div>

@if (!string.IsNullOrWhiteSpace(tagFilter) || !string.IsNullOrWhiteSpace(authorFilter))
{
    <p class="hint">
        @if (!string.IsNullOrWhiteSpace(authorFilter))
        {
            <span>By <strong>@authorFilter</strong></span>
        }
        @if (!string.IsNullOrWhiteSpace(tagFilter))
        {
            <span>Tagged <strong>@tagFilter</strong></span>
        }
        · <a href="/">Clear</a>
    </p>
}

@{
    var visible = Visible.ToList();
}

@if (books.Count == 0)
{
    <p>Nothing on the shelf yet.</p>
}
else if (visible.Count == 0)
{
    <p>Nothing matches.</p>
}
else
{
    <p class="count">@visible.Count @(visible.Count == 1 ? "book" : "books")</p>
    @foreach (var book in visible)
    {
        <article class="book">
            <h2><a href="/library/@book.Id">@book.Title</a></h2>
            @if (!string.IsNullOrWhiteSpace(book.Subtitle))
            {
                <p class="hint">@book.Subtitle</p>
            }
            <p class="by">
                <a href="@($"/?author={Uri.EscapeDataString(book.Author)}")">@book.Author</a>
                @if (book.Year is int year)
                {
                    <span> (@year)</span>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(book.Series))
            {
                <p class="hint">
                    @book.Series
                    @if (book.SeriesNumber is int number)
                    {
                        <span> · @number</span>
                    }
                </p>
            }
            <p class="meta">
                <label>
                    Status
                    <select @bind:get="book.Status" @bind:set="status => UpdateStatus(book.Id, status)">
                        @foreach (var status in Enum.GetValues<BookStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </label>
                @if (book.Format is BookFormat format)
                {
                    <span>@format</span>
                }
                @if (book.Rating is int rating)
                {
                    <span>@rating/5</span>
                }
                <button type="button" class="@(book.Loved ? "loved" : null)" @onclick="() => ToggleLoved(book.Id)">
                    @(book.Loved ? "Loved" : "Love")
                </button>
                @if (book.Status == BookStatus.Reading && book.Pages is int pages)
                {
                    <span class="progress-wrap">
                        <progress max="@pages" value="@(book.CurrentPage ?? 0)"></progress>
                        <span>@(book.CurrentPage ?? 0)/@pages</span>
                    </span>
                }
                else if (book.Status == BookStatus.Reading && book.CurrentPage is int current)
                {
                    <span>p. @current</span>
                }
                else if (book.Pages is int total)
                {
                    <span>@total pages</span>
                }
                @if (book.FinishedOn is DateOnly finished)
                {
                    <span>Finished @finished.ToString("MMM d, yyyy")</span>
                }
                @if (!string.IsNullOrWhiteSpace(book.Location))
                {
                    <span>@book.Location</span>
                }
                @if (!string.IsNullOrWhiteSpace(book.LoanedTo))
                {
                    <span>
                        Loaned to @book.LoanedTo
                        @if (book.LoanedOn is DateOnly loanedOn)
                        {
                            <span>since @loanedOn.ToString("MMM d, yyyy")</span>
                        }
                    </span>
                    <button type="button" @onclick="() => ReturnLoan(book.Id)">Return</button>
                }
                @if (book.Quotes.Count > 0)
                {
                    <span>@book.Quotes.Count @(book.Quotes.Count == 1 ? "quote" : "quotes")</span>
                }
            </p>
            @if (book.Tags.Count > 0)
            {
                <p class="tags">
                    @foreach (var tag in book.Tags.OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <a href="@($"/?tag={Uri.EscapeDataString(tag.Name)}")">@tag.Name</a>
                    }
                </p>
            }
        </article>
    }
}

<h2>Add a book</h2>

<EditForm Model="draft" OnValidSubmit="AddBook">
    <DataAnnotationsValidator />
    <ValidationSummary />
    @if (formErrors is { Count: > 0 })
    {
        <ul class="validation-errors">
            @foreach (var message in formErrors.SelectMany(pair => pair.Value))
            {
                <li>@message</li>
            }
        </ul>
    }
    <BookFields Model="draft" Shelf="books" />
    <button type="submit">Add</button>
</EditForm>

@code {
    private readonly BookFormModel draft = new();
    private List<Book> books = [];
    private string query = "";
    private string statusFilter = "";
    private string sort = "title";
    private string? tagFilter;
    private string? authorFilter;
    private bool lovedOnly;
    private bool loanedOnly;
    private Dictionary<string, string[]>? formErrors;

    [SupplyParameterFromQuery(Name = "tag")]
    public string? Tag { get; set; }

    [SupplyParameterFromQuery(Name = "author")]
    public string? Author { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        tagFilter = string.IsNullOrWhiteSpace(Tag) ? null : Tag.Trim();
        authorFilter = string.IsNullOrWhiteSpace(Author) ? null : Author.Trim();
        await LoadAsync();
    }

    private Book? Suggestion => BookRules.Pick(books, BookStatus.Want, DateOnly.FromDateTime(DateTime.UtcNow));

    private IEnumerable<Book> Visible
    {
        get
        {
            IEnumerable<Book> result = books;
            if (!string.IsNullOrWhiteSpace(query))
            {
                var term = query.Trim();
                var isbn = BookRules.NormalizeIsbn(term);
                result = result.Where(book =>
                    book.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || book.Author.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (book.Subtitle?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.Series?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (isbn is not null && book.Isbn == isbn)
                    || (book.Isbn?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.Notes?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.Location?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.Translator?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || book.Quotes.Any(quote => quote.Text.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            if (Enum.TryParse<BookStatus>(statusFilter, out var status))
            {
                result = result.Where(book => book.Status == status);
            }

            if (BookRules.CanonicalTag(tagFilter) is { } tagName)
            {
                result = result.Where(book => book.Tags.Any(tag => tag.Name == tagName));
            }

            if (!string.IsNullOrWhiteSpace(authorFilter))
            {
                result = result.Where(book => book.Author.Equals(authorFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (lovedOnly)
            {
                result = result.Where(book => book.Loved);
            }

            if (loanedOnly)
            {
                result = result.Where(book => !string.IsNullOrWhiteSpace(book.LoanedTo));
            }

            return sort switch
            {
                "author" => result.OrderBy(book => book.Author, StringComparer.OrdinalIgnoreCase).ThenBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
                "series" => result.OrderBy(book => book.Series == null).ThenBy(book => book.Series, StringComparer.OrdinalIgnoreCase).ThenBy(book => book.SeriesNumber ?? int.MaxValue).ThenBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
                "year" => result.OrderByDescending(book => book.Year ?? 0).ThenBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
                "rating" => result.OrderByDescending(book => book.Rating ?? 0).ThenBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
                "added" => result.OrderByDescending(book => book.AddedAt).ThenBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
                _ => result.OrderBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
            };
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        books = await db.Books.AsNoTracking().WithDetails().ToListAsync();
    }

    private async Task AddBook()
    {
        var write = draft.ToWrite();
        formErrors = BookRules.Validate(write);
        if (formErrors is not null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var book = new Book
        {
            Title = write.Title.Trim(),
            Author = write.Author.Trim(),
        };
        BookRules.Apply(book, write);
        db.Books.Add(book);
        await BookRules.SyncTagsAsync(db, book, write.Tags, CancellationToken.None);
        await db.SaveChangesAsync();
        await BookRules.RemoveUnusedTagsAsync(db, CancellationToken.None);

        draft.Clear();
        formErrors = null;
        await LoadAsync();
    }

    private async Task UpdateStatus(int id, BookStatus status)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var book = await db.Books.FirstOrDefaultAsync(existing => existing.Id == id);
        if (book is null)
        {
            return;
        }

        BookRules.ChangeStatus(book, status);
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task ToggleLoved(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var book = await db.Books.FirstOrDefaultAsync(existing => existing.Id == id);
        if (book is null)
        {
            return;
        }

        book.Loved = !book.Loved;
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task ReturnLoan(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var book = await db.Books.FirstOrDefaultAsync(existing => existing.Id == id);
        if (book is null)
        {
            return;
        }

        BookRules.ReturnLoan(book);
        await db.SaveChangesAsync();
        await LoadAsync();
    }
}
