@page "/library"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory
@inject DetailsFiller Filler
@inject ShelfJobs Jobs
@inject NavigationManager Navigation
@inject EbookStore Ebooks
@inject AudioStore Audio
@inject CoverStore Covers
@using Microsoft.JSInterop
@inject IJSRuntime Js
@inject ReaderTime Clock

<PageTitle>@T("Library") · Shelf</PageTitle>

<div class="page-head">
    <div class="titled"><h1>@Heading</h1><HelpLink Page="library" /></div>
    @if (!adding && books.Count > 0)
    {
        <button type="button" class="primary add-action" @onclick="() => adding = true">@T("Add a book")</button>
    }
</div>

@if (adding || books.Count == 0)
{
    <section id="add" class="panel" aria-labelledby="add-heading">
        <h2 id="add-heading">@T("Add a book")</h2>
        <p class="hint">@T("Many at once? Scan a shelf, or bring a library from Goodreads, Calibre, or a spreadsheet:") <a href="/add">@T("Add & import")</a></p>
        @if (books.Count == 0)
        {
            <p class="hint">@T("Your shelf is empty. Start with a title and an author; an ISBN lets Shelf fill in the rest from Open Library.")</p>
        }
        <EditForm Model="draft" OnValidSubmit="AddBook">
            <DataAnnotationsValidator />
            <ValidationSummary />
            @if (formErrors is { Count: > 0 })
            {
                <ul class="validation-errors">
                    @foreach (var message in formErrors.SelectMany(pair => pair.Value))
                    {
                        <li>@message</li>
                    }
                </ul>
            }
            <BookFields Model="draft" Shelf="books" LookUpNow="lookUpNow" />
            <button type="submit">@T("Add")</button>
            @if (books.Count > 0)
            {
                <button type="button" class="quiet" @onclick="() => adding = false">@T("Cancel")</button>
            }
        </EditForm>

        <h3>@T("Or add from files")</h3>
        <p class="hint">@T("Choose e-books, audiobooks, or zips of tracks, as many as you like. Each becomes a book, named from what the file says; tracks that share an album become one audiobook.") <a href="/free">@T("Find free public-domain books")</a> · <a href="/import/audiobookshelf">@T("Bring books from Audiobookshelf")</a></p>
        <form action="/books/import/files" method="post" enctype="multipart/form-data" data-enhance="false" data-upload>
            <label>
                @T("EPUB, PDF, comic, Kindle, audio, or zip, up to {0} at a time", Localization.Counts.Size(Math.Max(EbookStore.MaxBytes, AudioStore.MaxBytes)))
                <input type="file" name="file" multiple required
                       accept=".epub,.pdf,.cbz,.cbr,.cb7,.cbt,.mobi,.azw3,.azw,.mp3,.m4a,.m4b,.aac,.ogg,.opus,.wav,.flac,.zip,application/epub+zip,application/pdf,audio/*" />
            </label>
            <label class="check">
                <input type="checkbox" name="keepBoth" value="true" />
                @T("Add a file even when the same one is already on another book")
            </label>
            <progress data-upload-progress max="100" hidden></progress>
            <p class="hint" data-upload-status role="status" hidden></p>
            <button type="submit">@T("Add from files")</button>
        </form>
    </section>
}
@if (addedTitle is not null)
{
    <p class="saved" role="status">@T("Added {0}.", addedTitle ?? "")</p>
}
@if (ImportSummary is { } summary)
{
    <p class="saved" role="status">@summary</p>
}

@if (books.Count > 0)
{
    <div class="filters" role="search" aria-label="@T("Filter the library")">
        <label>
            @T("Search")
            <input type="search" @bind="query" @bind:event="oninput" placeholder="@T("Title, author, ISBN, notes, quotes")" />
        </label>
        <label>
            @T("Sort")
            <select @bind:get="sort" @bind:set="SortBy">
                <option value="title">@T("Title")</option>
                <option value="author">@T("Author")</option>
                <option value="series">@T("Series")</option>
                <option value="year">@T("Year")</option>
                <option value="rating">@T("Rating")</option>
                <option value="added">@T("Recently added")</option>
            </select>
        </label>
    </div>
    @* The common views a tap away: one status at a time, and what kind of copy or where it is. *@
    <div class="chips" role="group" aria-label="@T("Show")">
        <button type="button" class="chip" aria-pressed="@Pressed(statusFilter.Length == 0 && !loanedOnly && !fileOnly && !audioOnly)" @onclick="ShowEverything">@T("All") <span class="chip-count">@books.Count</span></button>
        @foreach (var status in new[] { BookStatus.Reading, BookStatus.Want, BookStatus.Finished, BookStatus.Abandoned })
        {
            var count = books.Count(book => book.Status == status);
            @if (count > 0 || statusFilter == status.ToString())
            {
                <button type="button" class="chip" aria-pressed="@Pressed(statusFilter == status.ToString())" @onclick="() => ToggleStatus(status)">@BookRules.StatusLabel(status) <span class="chip-count">@count</span></button>
            }
        }
        @if (books.Any(book => !string.IsNullOrWhiteSpace(book.LoanedTo)) || loanedOnly)
        {
            <button type="button" class="chip" aria-pressed="@Pressed(loanedOnly)" @onclick="() => loanedOnly = !loanedOnly">@T("On loan")</button>
        }
        @if (books.Any(book => !string.IsNullOrWhiteSpace(book.EbookStoredName)) || fileOnly)
        {
            <button type="button" class="chip" aria-pressed="@Pressed(fileOnly)" @onclick="() => fileOnly = !fileOnly">@T("E-book")</button>
        }
        @if (books.Any(book => !string.IsNullOrWhiteSpace(book.AudioStoredName)) || audioOnly)
        {
            <button type="button" class="chip" aria-pressed="@Pressed(audioOnly)" @onclick="() => audioOnly = !audioOnly">@T("Audiobook")</button>
        }
    </div>
    <div class="toolbar">
        <div class="segmented" role="group" aria-label="@T("Show books as")">
            <button type="button" aria-pressed="@(!listView ? "true" : "false")" @onclick="() => ShowAs(false, false)">@T("Covers")</button>
            <button type="button" aria-pressed="@(listView && !compact ? "true" : "false")" @onclick="() => ShowAs(true, false)">@T("List")</button>
            <button type="button" aria-pressed="@(compact ? "true" : "false")" @onclick="() => ShowAs(true, true)">@T("Compact")</button>
        </div>
        @if (compact)
        {
            <details class="columns-pick">
                <summary>@T("Columns")</summary>
                <div class="checks">
                    @foreach (var column in LibraryColumns.All)
                    {
                        <label class="check">
                            <input type="checkbox" checked="@columns.Contains(column)" @onchange="change => ToggleColumn(column, change.Value is true)" />
                            @LibraryColumns.Label(column)
                        </label>
                    }
                </div>
            </details>
        }
        <details>
            <summary>@T("More filters")@(MoreOn > 0 ? $" ({MoreOn})" : "")</summary>
            <div class="checks">
                <label class="check">
                    <input type="checkbox" @bind="lovedOnly" />
                    @T("Loved")
                </label>
                <label class="check">
                    <input type="checkbox" @bind="queuedOnly" />
                    @T("Read next")
                </label>
                <label class="check">
                    <input type="checkbox" @bind="goneOnly" />
                    @T("Let go")
                </label>
            </div>
        </details>
        @if (FillingJob is { } filling)
        {
            <a class="hint" href="/activity">@filling.Title(false): @ImportJobs.Describe(ImportJobs.Summarize(filling, DateTimeOffset.UtcNow))</a>
        }
        else if (books.Any(DetailsFiller.NeedsDetails))
        {
            <button type="button" class="quiet" @onclick="FillEmptyDetails">@T("Fill empty details")</button>
            @if (fillNote is not null)
            {
                <span class="hint" role="status">@fillNote</span>
            }
        }
        @if (Filtered)
        {
            <button type="button" class="quiet" @onclick="ClearFilters">@T("Clear filters")</button>
            @if (saved is not null)
            {
                <button type="button" class="quiet" @onclick="ForgetSearch">@T("Forget this search")</button>
                @if (saved.ShareToken is null)
                {
                    <button type="button" class="quiet" @onclick="ShareSearch">@T("Share by link")</button>
                }
                else
                {
                    <button type="button" class="quiet" @onclick="StopSharing">@T("Stop sharing")</button>
                }
            }
            else if (naming)
            {
                <form class="save-search" @onsubmit="SaveSearch" @onsubmit:preventDefault>
                    <label>
                        @T("Name")
                        <input @bind="savedName" maxlength="@SavedSearch.MaxNameLength" placeholder="@T("Short sci-fi to read")" required autofocus />
                    </label>
                    <button type="submit" class="primary">@T("Save")</button>
                    <button type="button" class="quiet" @onclick="() => naming = false">@T("Cancel")</button>
                </form>
            }
            else
            {
                <button type="button" class="quiet" @onclick="() => naming = true">@T("Save this search")</button>
            }
        }
    </div>

    @if (saved?.ShareToken is { } shareToken)
    {
        <div class="share-link" id="share-link">
            <label>
                @T("Anyone with this link sees the list as it stands: titles, authors, covers, and your stars. Never your notes, reviews, or loans.")
                <input type="url" readonly value="@Navigation.ToAbsoluteUri($"/shared/{shareToken}")" />
            </label>
        </div>
    }

    @* Every filter not shown as a chip above, each a tap to take away. *@
    @if (!string.IsNullOrWhiteSpace(tagFilter) || !string.IsNullOrWhiteSpace(authorFilter) || !string.IsNullOrWhiteSpace(seriesFilter) || !string.IsNullOrWhiteSpace(placeFilter) || !string.IsNullOrWhiteSpace(recommendedFilter) || !string.IsNullOrWhiteSpace(loanedFilter) || fieldFilter is not null || !string.IsNullOrWhiteSpace(narratorFilter) || MoreOn > 0)
    {
        <ul class="active-filters" aria-label="@T("Filters on")">
            @if (!string.IsNullOrWhiteSpace(narratorFilter))
            {
                <li>@Removable(T("Read by"), narratorFilter, () => narratorFilter = null)</li>
            }
            @if (fieldFilter is int filterField && fieldNames.TryGetValue(filterField, out var filterFieldInfo))
            {
                <li>@Removable(filterFieldInfo.Name, fieldValueFilter is { } given ? CustomFields.Show(filterFieldInfo.Kind, given) : T("filled in"), () => (fieldFilter, fieldValueFilter) = (null, null))</li>
            }
            @if (!string.IsNullOrWhiteSpace(authorFilter))
            {
                <li>@Removable(T("By"), authorFilter, () => authorFilter = null)</li>
            }
            @if (!string.IsNullOrWhiteSpace(seriesFilter))
            {
                <li>@Removable(T("In"), seriesFilter, () => seriesFilter = null)</li>
            }
            @if (!string.IsNullOrWhiteSpace(placeFilter))
            {
                <li>@Removable(T("At"), placeFilter, () => placeFilter = null)</li>
            }
            @if (!string.IsNullOrWhiteSpace(recommendedFilter))
            {
                <li>@Removable(T("From"), recommendedFilter, () => recommendedFilter = null)</li>
            }
            @if (!string.IsNullOrWhiteSpace(loanedFilter))
            {
                <li>@Removable(T("Loaned to"), loanedFilter, () => loanedFilter = null)</li>
            }
            @if (!string.IsNullOrWhiteSpace(tagFilter))
            {
                <li>@Removable(T("Tagged"), tagFilter, () => tagFilter = null)</li>
            }
            @if (lovedOnly)
            {
                <li>@Removable(null, T("Loved"), () => lovedOnly = false)</li>
            }
            @if (goneOnly)
            {
                <li>@Removable(null, T("Let go"), () => goneOnly = false)</li>
            }
            @if (queuedOnly)
            {
                <li>@Removable(null, T("Read next"), () => queuedOnly = false)</li>
            }
        </ul>
    }
}

@{
    var matching = Visible.ToList();
    // The compact table draws only the rows in view, so it holds every match; the others grow as they're scrolled.
    var visible = compact ? matching : matching.Take(shown).ToList();
}

@if (books.Count > 0 && matching.Count == 0)
{
    <EmptyState Title="@T("Nothing matches")" Text="@T("No book on your shelf fits these filters and this search.")">
        <button type="button" class="primary" @onclick="ClearFilters">@T("Clear filters")</button>
        @if (query.Trim().Length >= Search.MinLength)
        {
            <a class="button" href="@($"/search?q={Uri.EscapeDataString(query.Trim())}")">@T("Search inside your e-books")</a>
        }
    </EmptyState>
}
else if (visible.Count > 0)
{
    <p class="count">
        @Localization.Counts.Books(matching.Count)@(matching.Count > visible.Count ? T(", showing {0}", visible.Count) : "")
        @if (query.Trim().Length >= Search.MinLength)
        {
            <span> · <a href="@($"/search?q={Uri.EscapeDataString(query.Trim())}")">@T("Search inside your e-books for “{0}”", query.Trim())</a></span>
        }
    </p>
    @if (!listView)
    {
        <ul class="book-grid">
            @foreach (var book in visible)
            {
                <li class="book-card">
                    <BookCover Title="@book.Title" Url="@book.CoverShown" />
                    <h2 class="title"><a href="/library/@book.Id">@book.Title</a></h2>
                    <p class="by">@book.Author@(book.Year is int year ? $" · {year}" : "")</p>
                    @if (book.Status == BookStatus.Reading && book.Pages is int pages)
                    {
                        <progress max="@pages" value="@(book.CurrentPage ?? 0)" aria-label="@T("Page {0} of {1}", book.CurrentPage ?? 0, pages)"></progress>
                    }
                    @if (book.Rating is int stars)
                    {
                        <p class="stars" aria-label="@T("{0} of 5 stars", stars)">@(new string('★', stars))<span aria-hidden="true">@(new string('★', 5 - stars))</span></p>
                    }
                    <div class="badges">
                        <label class="status-pick">
                            <span class="visually-hidden">@T("Status of {0}", book.Title)</span>
                            <select @bind:get="book.Status" @bind:set="status => UpdateStatus(book.Id, status)" data-status="@book.Status">
                                @foreach (var status in Enum.GetValues<BookStatus>())
                                {
                                    <option value="@status">@BookRules.StatusLabel(status)</option>
                                }
                            </select>
                        </label>
                        @if (!string.IsNullOrWhiteSpace(book.LoanedTo))
                        {
                            <span class="badge loan">@T("On loan")</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(book.EbookStoredName))
                        {
                            <span class="badge plain">@T("E-book")</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(book.AudioStoredName))
                        {
                            <span class="badge plain">@T("Audio")</span>
                        }
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="bulk-bar" role="group" aria-label="@T("Change chosen books")">
            <label class="check">
                <input type="checkbox" checked="@(visible.All(book => chosen.Contains(book.Id)))" @onchange="change => ChooseAll(visible, change.Value is true)" />
                @T("Choose all shown")
            </label>
            @if (chosen.Count > 0)
            {
                <span class="hint">@T("Chosen: {0}", chosen.Count)</span>
                <label>
                    <span class="visually-hidden">@T("Status for the chosen books")</span>
                    <select @bind="bulkStatus">
                        <option value="">@T("Set status…")</option>
                        @foreach (var status in Enum.GetValues<BookStatus>())
                        {
                            <option value="@status">@BookRules.StatusLabel(status)</option>
                        }
                    </select>
                </label>
                <button type="button" disabled="@(bulkStatus.Length == 0)" @onclick="() => ApplyBulk(new BulkRequest([.. chosen], Status: Enum.Parse<BookStatus>(bulkStatus)))">@T("Set")</button>
                <label>
                    <span class="visually-hidden">@T("Tag for the chosen books")</span>
                    <input @bind="bulkTag" @bind:event="oninput" placeholder="@T("Tag")" maxlength="@BookRules.MaxTagLength" />
                </label>
                <button type="button" disabled="@string.IsNullOrWhiteSpace(bulkTag)" @onclick="() => ApplyBulk(new BulkRequest([.. chosen], AddTag: bulkTag))">@T("Add tag")</button>
                <button type="button" disabled="@string.IsNullOrWhiteSpace(bulkTag)" @onclick="() => ApplyBulk(new BulkRequest([.. chosen], RemoveTag: bulkTag))">@T("Remove tag")</button>
                <button type="button" @onclick="() => ApplyBulk(new BulkRequest([.. chosen], Loved: true))">@T("Love")</button>
                <button type="button" @onclick="() => ApplyBulk(new BulkRequest([.. chosen], Loved: false))">@T("Unlove")</button>
                <label>
                    <span class="visually-hidden">@T("Place for the chosen books")</span>
                    <input list="bulk-places" @bind="bulkPlace" @bind:event="oninput" placeholder="@T("A place")" maxlength="80" />
                </label>
                <datalist id="bulk-places">
                    @foreach (var known in placeNames)
                    {
                        <option value="@known"></option>
                    }
                </datalist>
                <button type="button" disabled="@string.IsNullOrWhiteSpace(bulkPlace)" @onclick="() => ApplyBulk(new BulkRequest([.. chosen], Location: bulkPlace))">@T("Put there")</button>
                @if (!confirmingBulkDelete)
                {
                    <button type="button" class="danger" @onclick="() => confirmingBulkDelete = true">@T("Delete…")</button>
                }
                else
                {
                    <span class="hint">@T("Delete these with their quotes, highlights, reading logs, and files? {0}", Localization.Counts.Books(chosen.Count)) @T("They can be brought back together from the trash.")</span>
                    <button type="button" class="danger" @onclick="() => ApplyBulk(new BulkRequest([.. chosen], Delete: true))">@T("Yes, delete")</button>
                    <button type="button" @onclick="() => confirmingBulkDelete = false">@T("Cancel")</button>
                }
            }
            @if (matching.Count > visible.Count && !matching.Take(Bulk.MaxBooks).All(book => chosen.Contains(book.Id)))
            {
                <button type="button" class="quiet" @onclick="() => chosen.UnionWith(matching.Take(Bulk.MaxBooks).Select(book => book.Id))">
                    @(matching.Count > Bulk.MaxBooks ? T("Choose the first {0} that match", Bulk.MaxBooks) : T("Choose all {0} that match", matching.Count))
                </button>
            }
            <StatusNote Text="@bulkNote" UndoBatch="bulkBatch" Undone="LoadAsync" />
        </div>
        @if (compact)
        {
            <table class="book-table">
                <thead>
                    <tr>
                        <th scope="col"><span class="visually-hidden">@T("Choose")</span></th>
                        <th scope="col">@T("Title")</th>
                        <th scope="col">@T("Author")</th>
                        @foreach (var column in columns)
                        {
                            <th scope="col">@LibraryColumns.Label(column)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <Virtualize Items="matching" ItemSize="44" OverscanCount="30" SpacerElement="tr" Context="book">
                        <tr @key="book.Id">
                            <td><input type="checkbox" checked="@chosen.Contains(book.Id)" @onchange="change => Choose(book.Id, change.Value is true)" aria-label="@T("Choose {0}", book.Title)" /></td>
                            <td class="title-cell"><a href="/library/@book.Id" title="@book.Title">@book.Title</a></td>
                            <td><a href="@($"/library?author={Uri.EscapeDataString(book.Author)}")">@book.Author</a></td>
                            @foreach (var column in columns)
                            {
                                <td>@Cell(book, column)</td>
                            }
                        </tr>
                    </Virtualize>
                </tbody>
            </table>
        }
        else
        {
        <ul class="book-list">
        @foreach (var book in visible)
        {
            <li class="book">
            <div class="book-pick">
                <input type="checkbox" checked="@chosen.Contains(book.Id)" @onchange="change => Choose(book.Id, change.Value is true)" aria-label="@T("Choose {0}", book.Title)" />
                <a href="/library/@book.Id" tabindex="-1" aria-hidden="true"><BookCover Title="@book.Title" Url="@book.CoverShown" /></a>
            </div>
            <div>
            <h2><a href="/library/@book.Id">@book.Title</a></h2>
            @if (!string.IsNullOrWhiteSpace(book.Subtitle))
            {
                <p class="hint">@book.Subtitle</p>
            }
            <p class="by">
                <a href="@($"/library?author={Uri.EscapeDataString(book.Author)}")">@book.Author</a>
                @if (book.Year is int year)
                {
                    <span> (@year)</span>
                }
                @if (!string.IsNullOrWhiteSpace(book.Series))
                {
                    <span> · </span>
                    <a href="@($"/library?series={Uri.EscapeDataString(book.Series)}")">@book.Series</a>
                    @if (book.SeriesNumber is int number)
                    {
                        <span> @number</span>
                    }
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(book.OriginalTitle))
            {
                <p class="hint">@T("Originally {0}", book.OriginalTitle)</p>
            }
            <p class="meta">
                <label>
                    <span class="visually-hidden">@T("Status of {0}", book.Title)</span>
                    <select @bind:get="book.Status" @bind:set="status => UpdateStatus(book.Id, status)">
                        @foreach (var status in Enum.GetValues<BookStatus>())
                        {
                            <option value="@status">@BookRules.StatusLabel(status)</option>
                        }
                    </select>
                </label>
                <button type="button" class="@(book.Loved ? "loved" : null)" aria-pressed="@(book.Loved ? "true" : "false")" @onclick="() => ToggleLoved(book.Id)">
                    @(book.Loved ? T("Loved") : T("Love"))
                </button>
                @if (book.Status == BookStatus.Want)
                {
                    <button type="button" class="@(book.Queued ? "queued" : null)" aria-pressed="@(book.Queued ? "true" : "false")" @onclick="() => ToggleQueued(book.Id)">
                        @(book.Queued ? T("Queued") : T("Read next"))
                    </button>
                }
                @if (!string.IsNullOrWhiteSpace(book.EbookStoredName))
                {
                    <a href="/library/@book.Id/read">@T("Read")</a>
                }
                @if (!string.IsNullOrWhiteSpace(book.AudioStoredName))
                {
                    <a href="/library/@book.Id/listen">@T("Listen")</a>
                    <button type="button" class="link" data-play-book="@book.Id" aria-label="@T("Play {0}", book.Title)">@T("Play")</button>
                }
            </p>
            <p class="meta">
                @if (book.Format is BookFormat format)
                {
                    <span>@format</span>
                }
                @if (book.Rating is int rating)
                {
                    <span>@rating/5</span>
                }
                @if (book.Status == BookStatus.Reading && book.Pages is int pages)
                {
                    <span class="progress-wrap">
                        <progress max="@pages" value="@(book.CurrentPage ?? 0)" aria-label="@T("Page {0} of {1}", book.CurrentPage ?? 0, pages)"></progress>
                        <span>@(book.CurrentPage ?? 0)/@pages</span>
                    </span>
                }
                else if (book.Status == BookStatus.Reading && book.CurrentPage is int current)
                {
                    <span>p. @current</span>
                }
                else if (book.Pages is int total)
                {
                    <span>@T("{0} pages", total)</span>
                }
                @if (book.FinishedOn is DateOnly finished)
                {
                    <span>@T("Finished {0}", finished.Medium())</span>
                }
                @if (book.Acquisition is Acquisition arrived)
                {
                    <span>@BookRules.AcquisitionLabel(arrived)</span>
                }
                @if (book.Condition is CopyCondition condition)
                {
                    <span>@BookRules.ConditionLabel(condition)</span>
                }
                @if (!string.IsNullOrWhiteSpace(book.Location))
                {
                    <a href="@($"/library?place={Uri.EscapeDataString(book.Location)}")">@book.Location</a>
                }
                @if (!string.IsNullOrWhiteSpace(book.RecommendedBy))
                {
                    <a href="@($"/library?recommendedBy={Uri.EscapeDataString(book.RecommendedBy)}")">@T("From {0}", book.RecommendedBy)</a>
                }
                @if (book.Quotes.Count > 0)
                {
                    <span>@(book.Quotes.Count == 1 ? T("1 quote") : T("{0} quotes", book.Quotes.Count))</span>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(book.LoanedTo))
            {
                <p class="meta">
                    <span class="badge loan">@T("On loan")</span>
                    <span>
                        @T("to") <a href="@($"/library?loanedTo={Uri.EscapeDataString(book.LoanedTo)}")">@book.LoanedTo</a>
                        @if (book.LoanedOn is DateOnly loanedOn)
                        {
                            <span> @T("since {0}", loanedOn.Medium())</span>
                        }
                        @if (book.DueOn is DateOnly due)
                        {
                            <span class="@(due < Today ? "late" : null)"> · @T("due {0}", due.Medium())@(due < Today ? T(", overdue") : "")</span>
                        }
                    </span>
                    <button type="button" @onclick="() => ReturnLoan(book.Id)">@T("Mark returned")</button>
                </p>
            }
            @if (book.Tags.Count > 0)
            {
                <p class="tags">
                    @foreach (var tag in book.Tags.OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <a href="@($"/library?tag={Uri.EscapeDataString(tag.Name)}")">@tag.Name</a>
                    }
                </p>
            }
            </div>
            </li>
        }
        </ul>
        }
    }
    @if (matching.Count > visible.Count)
    {
        <p>
            <button type="button" data-more @onclick="() => shown += PageSize">@T("Show {0} more", Math.Min(PageSize, matching.Count - visible.Count))</button>
            <span class="hint">@T("Not shown yet: {0}", matching.Count - visible.Count)</span>
        </p>
    }
}

