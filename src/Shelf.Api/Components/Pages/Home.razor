    private RenderFragment Removable(string? label, string value, Action clear) =>
        @<button type="button" class="chip removable" aria-label="@T("Take away the filter {0}", label is null ? value : $"{label} {value}")" @onclick="() => { clear(); shown = PageSize; }">
            @(label is null ? "" : label + " ")<strong>@value</strong> <span aria-hidden="true">×</span>
        </button>;

    // This view's own address, so a book opened from it, then Back, finds the same books, as far down as before.
    private sealed record LibraryPlace(string Url, int Shown, double Y);

    private IJSObjectReference? placeModule;
    private string? keptAddress;
    private int keptShown;
    private double? scrollBackTo;

    private string Address
    {
        get
        {
            var view = CurrentQuery();
            if (saved is not null && saved.Query == view)
            {
                view = $"{view}&saved={saved.Id}";
            }

            return view.Length == 0 ? "/library" : $"/library?{view}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                placeModule = await Js.InvokeAsync<IJSObjectReference>("import", "./library-place.js");
                if (await placeModule.InvokeAsync<LibraryPlace?>("place", Address) is { } back)
                {
                    shown = Math.Max(shown, back.Shown);
                    scrollBackTo = back.Y;
                    StateHasChanged();
                    return;
                }
            }

            if (placeModule is null)
            {
                return;
            }

            if (scrollBackTo is double y)
            {
                scrollBackTo = null;
                await placeModule.InvokeVoidAsync("scrollBack", y);
            }

            if (Address != keptAddress || shown != keptShown)
            {
                (keptAddress, keptShown) = (Address, shown);
                await placeModule.InvokeVoidAsync("keepAddress", keptAddress, keptShown);
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            // Without the browser's help the library still works; it just starts at the top.
        }
    }

    private void ClearFilters()
    {
        shown = PageSize;
        query = "";
        statusFilter = "";
        lovedOnly = loanedOnly = queuedOnly = fileOnly = audioOnly = goneOnly = false;
        if (new Uri(Navigation.Uri).Query.Length > 0)
        {
            Navigation.NavigateTo(compact ? "/library?view=compact" : listView ? "/library?view=list" : "/library");
        }
    }

    private IEnumerable<Book> Visible
    {
        get
        {
            // A copy let go keeps its record, out of the way unless asked for.
            IEnumerable<Book> result = goneOnly ? books.Where(book => book.LeftOn != null) : books.Where(book => book.LeftOn == null);
            if (!string.IsNullOrWhiteSpace(query))
            {
                var term = query.Trim();
                var isbn = BookRules.NormalizeIsbn(term);
                result = result.Where(book =>
                    book.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || book.Author.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (book.Subtitle?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.Series?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (isbn is not null && book.Isbn == isbn)
                    || (book.Isbn?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.Notes?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.Location?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.Translator?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.Narrator?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.OriginalTitle?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.Inscription?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.RecommendedBy?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || book.Quotes.Any(quote => quote.Text.Contains(term, StringComparison.OrdinalIgnoreCase))
                    || bookValues[book.Id].Any(item => item.Value.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            if (!string.IsNullOrWhiteSpace(narratorFilter))
            {
                result = result.Where(book => Narrators.Reads(book.Narrator, narratorFilter));
            }

            if (fieldFilter is int wantedField)
            {
                result = result.Where(book => bookValues[book.Id].Any(item => item.FieldId == wantedField
                    && (fieldValueFilter is null || item.Value.Equals(fieldValueFilter, StringComparison.OrdinalIgnoreCase))));
            }

            if (Enum.TryParse<BookStatus>(statusFilter, out var status))
            {
                result = result.Where(book => book.Status == status);
            }

            if (BookRules.CanonicalTag(tagFilter) is { } tagName)
            {
                result = result.Where(book => book.Tags.Any(tag => tag.Name == tagName));
            }

            if (!string.IsNullOrWhiteSpace(authorFilter))
            {
                result = result.Where(book => book.Author.Equals(authorFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(seriesFilter))
            {
                result = result.Where(book => book.Series != null && book.Series.Equals(seriesFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(placeFilter))
            {
                result = result.Where(book => book.Location != null && (book.Location.Equals(placeFilter, StringComparison.OrdinalIgnoreCase)
                    || book.Location.StartsWith(placeFilter + PlaceTree.Separator, StringComparison.OrdinalIgnoreCase)));
            }

            if (!string.IsNullOrWhiteSpace(recommendedFilter))
            {
                result = result.Where(book => book.RecommendedBy != null && book.RecommendedBy.Equals(recommendedFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(loanedFilter))
            {
                result = result.Where(book => book.LoanedTo != null && book.LoanedTo.Equals(loanedFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (lovedOnly)
            {
                result = result.Where(book => book.Loved);
            }

            if (queuedOnly)
            {
                result = result.Where(book => book.Queued);
            }

            if (fileOnly)
            {
                result = result.Where(book => !string.IsNullOrWhiteSpace(book.EbookStoredName));
            }

            if (audioOnly)
            {
                result = result.Where(book => !string.IsNullOrWhiteSpace(book.AudioStoredName));
            }

            if (loanedOnly)
            {
                result = result.Where(book => !string.IsNullOrWhiteSpace(book.LoanedTo));
            }

            return sort switch
            {
                "author" => result.OrderBy(book => book.Author, StringComparer.OrdinalIgnoreCase).ThenBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
                "series" => result.OrderBy(book => book.Series == null).ThenBy(book => book.Series, StringComparer.OrdinalIgnoreCase).ThenBy(book => book.SeriesNumber ?? int.MaxValue).ThenBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
                "year" => result.OrderByDescending(book => book.Year ?? 0).ThenBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
                "rating" => result.OrderByDescending(book => book.Rating ?? 0).ThenBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
                "added" => result.OrderByDescending(book => book.AddedAt).ThenBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
                _ => result.OrderBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
            };
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        readerId = db.ReaderId;
        placeNames = await Scanning.PlacesAsync(db);
        // Only what the library shows, searches, and sorts by, with tags, and quotes for their count and for search: a
        // big shelf's books also carry chapter lists, reviews, and places in their files, slow to read by the thousand.
        books = await db.Books.AsNoTracking()
            .Select(book => new Book
            {
                Id = book.Id,
                OwnerId = book.OwnerId,
                Title = book.Title,
                Author = book.Author,
                Subtitle = book.Subtitle,
                OriginalTitle = book.OriginalTitle,
                Translator = book.Translator,
                Narrator = book.Narrator,
                Status = book.Status,
                Rating = book.Rating,
                Loved = book.Loved,
                Queued = book.Queued,
                Year = book.Year,
                Isbn = book.Isbn,
                Pages = book.Pages,
                CurrentPage = book.CurrentPage,
                Publisher = book.Publisher,
                Language = book.Language,
                Format = book.Format,
                Series = book.Series,
                SeriesNumber = book.SeriesNumber,
                Notes = book.Notes,
                Inscription = book.Inscription,
                Location = book.Location,
                Condition = book.Condition,
                Acquisition = book.Acquisition,
                RecommendedBy = book.RecommendedBy,
                LoanedTo = book.LoanedTo,
                LoanedOn = book.LoanedOn,
                DueOn = book.DueOn,
                FinishedOn = book.FinishedOn,
                AddedAt = book.AddedAt,
                CoverUrl = book.CoverUrl,
                FileCover = book.FileCover,
                CoverImage = book.CoverImage,
                EbookStoredName = book.EbookStoredName,
                AudioStoredName = book.AudioStoredName,
                Tags = book.Tags.ToList(),
                Quotes = book.Quotes.ToList(),
            })
            .ToListAsync();
        fieldNames = (await db.CustomFields.AsNoTracking().ToListAsync()).ToDictionary(field => field.Id, field => (field.Name, field.Kind));
        bookValues = (await db.CustomValues.AsNoTracking().Select(value => new { value.BookId, value.FieldId, value.Value }).ToListAsync())
            .ToLookup(value => value.BookId, value => (value.FieldId, value.Value));
    }

    private async Task AddBook()
    {
        var write = draft.ToWrite();
        formErrors = BookRules.Validate(write);
        if (formErrors is not null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var book = new Book
        {
            Title = write.Title.Trim(),
            Author = write.Author.Trim(),
        };
        BookRules.Apply(book, write, today: db.Today);
        db.Books.Add(book);
        await BookRules.SyncTagsAsync(db, book, write.Tags, CancellationToken.None);
        await db.SaveChangesAsync();
        await BookRules.RemoveUnusedTagsAsync(db, CancellationToken.None);

        addedTitle = book.Title;
        draft.Clear();
        formErrors = null;
        adding = false;
        await LoadAsync();
    }

    private async Task UpdateStatus(int id, BookStatus status)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var book = await db.Books.FirstOrDefaultAsync(existing => existing.Id == id);
        if (book is null)
        {
            return;
        }

        BookRules.ChangeStatus(book, status, db.Today);
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task ToggleLoved(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var book = await db.Books.FirstOrDefaultAsync(existing => existing.Id == id);
        if (book is null)
        {
            return;
        }

        book.Loved = !book.Loved;
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task ToggleQueued(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var book = await db.Books.FirstOrDefaultAsync(existing => existing.Id == id);
        if (book is null || book.Status != BookStatus.Want)
        {
            return;
        }

        book.Queued = !book.Queued;
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    // Filled in the background, a book at a time; the Activity page shows how far it has got.
    private DetailsJob? FillingJob => Jobs.Of(readerId).OfType<DetailsJob>().FirstOrDefault(job => !job.Finished);

    private async Task FillEmptyDetails()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        fillNote = await Filler.StartAsync(db, DetailsKind.Everything) is null ? T("Nothing to fill in.") : null;
    }

    private async Task ReturnLoan(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var book = await db.Books.FirstOrDefaultAsync(existing => existing.Id == id);
        if (book is null)
        {
            return;
        }

        BookRules.ReturnLoan(book);
        await db.SaveChangesAsync();
        await LoadAsync();
    }
}
