@page "/"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory
@inject IBookLookup Lookup
@inject NavigationManager Navigation
@inject EbookStore Ebooks
@inject AudioStore Audio

<PageTitle>Library · Shelf</PageTitle>

<div class="page-head">
    <h1>@Heading</h1>
    @if (!adding && books.Count > 0)
    {
        <button type="button" class="primary" @onclick="() => adding = true">Add a book</button>
    }
</div>

@if (adding || books.Count == 0)
{
    <section id="add" class="panel" aria-labelledby="add-heading">
        <h2 id="add-heading">Add a book</h2>
        @if (books.Count == 0)
        {
            <p class="hint">Your shelf is empty. Start with a title and an author; an ISBN lets Shelf fill in the rest from Open Library.</p>
        }
        <EditForm Model="draft" OnValidSubmit="AddBook">
            <DataAnnotationsValidator />
            <ValidationSummary />
            @if (formErrors is { Count: > 0 })
            {
                <ul class="validation-errors">
                    @foreach (var message in formErrors.SelectMany(pair => pair.Value))
                    {
                        <li>@message</li>
                    }
                </ul>
            }
            <BookFields Model="draft" Shelf="books" />
            <button type="submit">Add</button>
            @if (books.Count > 0)
            {
                <button type="button" class="quiet" @onclick="() => adding = false">Cancel</button>
            }
        </EditForm>

        <h3>Or add from files</h3>
        <p class="hint">Choose e-books, audiobooks, or zips of tracks, as many as you like. Each becomes a book, named from what the file says; tracks that share an album become one audiobook. <a href="/free">Find free public-domain books</a></p>
        <form action="/books/import" method="post" enctype="multipart/form-data" data-enhance="false" data-upload>
            <label>
                EPUB, PDF, audio, or zip, up to 1 GB at a time
                <input type="file" name="file" multiple required
                       accept=".epub,.pdf,.mp3,.m4a,.m4b,.aac,.ogg,.opus,.wav,.flac,.zip,application/epub+zip,application/pdf,audio/*" />
            </label>
            <label class="check">
                <input type="checkbox" name="keepBoth" value="true" />
                Add a file even when the same one is already on another book
            </label>
            <progress data-upload-progress max="100" hidden></progress>
            <p class="hint" data-upload-status role="status" hidden></p>
            <button type="submit">Add from files</button>
        </form>
    </section>
}
@if (addedTitle is not null)
{
    <p class="saved" role="status">Added @addedTitle.</p>
}
@if (ImportSummary is { } summary)
{
    <p class="saved" role="status">@summary</p>
}

@if (books.Count > 0 && IsOverview)
{
    @if (ReadingNow.Count > 0)
    {
        <h2 class="reading-now">Reading now</h2>
        <ul class="shelf-strip">
            @foreach (var open in ReadingNow)
            {
                <li class="strip-card">
                    <BookCover Title="@open.Title" Url="@open.CoverShown" />
                    <div>
                        <p class="title"><a href="/library/@open.Id">@open.Title</a></p>
                        <p class="by">@open.Author</p>
                        @if (open.Pages is int pages)
                        {
                            <progress max="@pages" value="@(open.CurrentPage ?? 0)" aria-label="@($"Page {open.CurrentPage ?? 0} of {pages}")"></progress>
                            <p class="hint">@(open.CurrentPage ?? 0) of @(pages) pages</p>
                        }
                        else if (open.CurrentPage is int at)
                        {
                            <p class="hint">Page @at</p>
                        }
                    </div>
                </li>
            }
        </ul>
    }

    @if (ReadNext.Count > 0 || Suggestion is not null)
    {
        <h2 class="read-next">@(ReadNext.Count > 0 ? "Read next" : "From the want list")</h2>
        <ul class="shelf-strip">
            @foreach (var next in ReadNext.Count > 0 ? ReadNext : [Suggestion!])
            {
                <li class="strip-card">
                    <BookCover Title="@next.Title" Url="@next.CoverShown" />
                    <div>
                        <p class="title"><a href="/library/@next.Id">@next.Title</a></p>
                        <p class="by">@next.Author</p>
                    </div>
                </li>
            }
        </ul>
    }

    @if (RecentlyFinished.Count > 0)
    {
        <h2>Recently finished</h2>
        <ul class="shelf-strip">
            @foreach (var done in RecentlyFinished)
            {
                <li class="strip-card">
                    <BookCover Title="@done.Title" Url="@done.CoverShown" />
                    <div>
                        <p class="title"><a href="/library/@done.Id">@done.Title</a></p>
                        <p class="by">@done.Author</p>
                        <p class="hint">@done.FinishedOn?.Medium()</p>
                    </div>
                </li>
            }
        </ul>
    }

    <h2>All books</h2>
}

@if (books.Count > 0)
{
    <div class="filters" role="search">
        <label>
            Search
            <input type="search" @bind="query" @bind:event="oninput" placeholder="Title, author, ISBN, notes, quotes" />
        </label>
        <label>
            Status
            <select @bind="statusFilter">
                <option value="">All</option>
                @foreach (var status in Enum.GetValues<BookStatus>())
                {
                    <option value="@status">@BookRules.StatusLabel(status)</option>
                }
            </select>
        </label>
        <label>
            Sort
            <select @bind="sort">
                <option value="title">Title</option>
                <option value="author">Author</option>
                <option value="series">Series</option>
                <option value="year">Year</option>
                <option value="rating">Rating</option>
                <option value="added">Recently added</option>
            </select>
        </label>
    </div>
    <div class="toolbar">
        <div class="segmented" role="group" aria-label="Show books as">
            <button type="button" aria-pressed="@(!listView ? "true" : "false")" @onclick="() => ShowAsList(false)">Covers</button>
            <button type="button" aria-pressed="@(listView ? "true" : "false")" @onclick="() => ShowAsList(true)">List</button>
        </div>
        <details>
            <summary>More filters@(ChecksOn > 0 ? $" ({ChecksOn})" : "")</summary>
            <div class="checks">
                <label class="check">
                    <input type="checkbox" @bind="lovedOnly" />
                    Loved
                </label>
                <label class="check">
                    <input type="checkbox" @bind="loanedOnly" />
                    On loan
                </label>
                <label class="check">
                    <input type="checkbox" @bind="queuedOnly" />
                    Read next
                </label>
                <label class="check">
                    <input type="checkbox" @bind="fileOnly" />
                    E-book
                </label>
                <label class="check">
                    <input type="checkbox" @bind="audioOnly" />
                    Audiobook
                </label>
            </div>
        </details>
        @if (books.Any(NeedsCatalog))
        {
            <button type="button" class="quiet" @onclick="FillEmptyDetails" disabled="@filling">@(filling ? "Looking…" : "Fill empty details")</button>
            @if (fillNote is not null)
            {
                <span class="hint" role="status">@fillNote</span>
            }
        }
        @if (Filtered)
        {
            <button type="button" class="quiet" @onclick="ClearFilters">Clear filters</button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(tagFilter) || !string.IsNullOrWhiteSpace(authorFilter) || !string.IsNullOrWhiteSpace(seriesFilter) || !string.IsNullOrWhiteSpace(placeFilter) || !string.IsNullOrWhiteSpace(recommendedFilter) || !string.IsNullOrWhiteSpace(loanedFilter))
    {
        <p class="active-filters">
            @if (!string.IsNullOrWhiteSpace(authorFilter))
            {
                <span>By <strong>@authorFilter</strong></span>
            }
            @if (!string.IsNullOrWhiteSpace(seriesFilter))
            {
                <span>In <strong>@seriesFilter</strong></span>
            }
            @if (!string.IsNullOrWhiteSpace(placeFilter))
            {
                <span>At <strong>@placeFilter</strong></span>
            }
            @if (!string.IsNullOrWhiteSpace(recommendedFilter))
            {
                <span>From <strong>@recommendedFilter</strong></span>
            }
            @if (!string.IsNullOrWhiteSpace(loanedFilter))
            {
                <span>Loaned to <strong>@loanedFilter</strong></span>
            }
            @if (!string.IsNullOrWhiteSpace(tagFilter))
            {
                <span>Tagged <strong>@tagFilter</strong></span>
            }
        </p>
    }
}

@{
    var matching = Visible.ToList();
    var visible = matching.Take(shown).ToList();
}

@if (books.Count > 0 && matching.Count == 0)
{
    <EmptyState Title="Nothing matches" Text="No book on your shelf fits these filters and this search.">
        <button type="button" class="primary" @onclick="ClearFilters">Clear filters</button>
        @if (query.Trim().Length >= Search.MinLength)
        {
            <a class="button" href="@($"/search?q={Uri.EscapeDataString(query.Trim())}")">Search inside your e-books</a>
        }
    </EmptyState>
}
else if (visible.Count > 0)
{
    <p class="count">
        @matching.Count @(matching.Count == 1 ? "book" : "books")@(matching.Count > visible.Count ? $", showing {visible.Count}" : "")
        @if (query.Trim().Length >= Search.MinLength)
        {
            <span> · <a href="@($"/search?q={Uri.EscapeDataString(query.Trim())}")">Search inside your e-books for “@query.Trim()”</a></span>
        }
    </p>
    @if (!listView)
    {
        <ul class="book-grid">
            @foreach (var book in visible)
            {
                <li class="book-card">
                    <BookCover Title="@book.Title" Url="@book.CoverShown" />
                    <h3 class="title"><a href="/library/@book.Id">@book.Title</a></h3>
                    <p class="by">@book.Author@(book.Year is int year ? $" · {year}" : "")</p>
                    @if (book.Status == BookStatus.Reading && book.Pages is int pages)
                    {
                        <progress max="@pages" value="@(book.CurrentPage ?? 0)" aria-label="@($"Page {book.CurrentPage ?? 0} of {pages}")"></progress>
                    }
                    <div class="badges">
                        <StatusBadge Status="book.Status" />
                        @if (!string.IsNullOrWhiteSpace(book.LoanedTo))
                        {
                            <span class="badge loan">On loan</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(book.EbookStoredName))
                        {
                            <span class="badge plain">E-book</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(book.AudioStoredName))
                        {
                            <span class="badge plain">Audio</span>
                        }
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="bulk-bar" role="group" aria-label="Change chosen books">
            <label class="check">
                <input type="checkbox" checked="@(visible.All(book => chosen.Contains(book.Id)))" @onchange="change => ChooseAll(visible, change.Value is true)" />
                Choose all shown
            </label>
            @if (chosen.Count > 0)
            {
                <span class="hint">@chosen.Count chosen</span>
                <label>
                    <span class="visually-hidden">Status for the chosen books</span>
                    <select @bind="bulkStatus">
                        <option value="">Set status…</option>
                        @foreach (var status in Enum.GetValues<BookStatus>())
                        {
                            <option value="@status">@BookRules.StatusLabel(status)</option>
                        }
                    </select>
                </label>
                <button type="button" disabled="@(bulkStatus.Length == 0)" @onclick="() => ApplyBulk(new BulkRequest([.. chosen], Status: Enum.Parse<BookStatus>(bulkStatus)))">Set</button>
                <label>
                    <span class="visually-hidden">Tag for the chosen books</span>
                    <input @bind="bulkTag" @bind:event="oninput" placeholder="Tag" maxlength="@BookRules.MaxTagLength" />
                </label>
                <button type="button" disabled="@string.IsNullOrWhiteSpace(bulkTag)" @onclick="() => ApplyBulk(new BulkRequest([.. chosen], AddTag: bulkTag))">Add tag</button>
                <button type="button" disabled="@string.IsNullOrWhiteSpace(bulkTag)" @onclick="() => ApplyBulk(new BulkRequest([.. chosen], RemoveTag: bulkTag))">Remove tag</button>
                <button type="button" @onclick="() => ApplyBulk(new BulkRequest([.. chosen], Loved: true))">Love</button>
                <button type="button" @onclick="() => ApplyBulk(new BulkRequest([.. chosen], Loved: false))">Unlove</button>
                @if (!confirmingBulkDelete)
                {
                    <button type="button" class="danger" @onclick="() => confirmingBulkDelete = true">Delete…</button>
                }
                else
                {
                    <span class="hint">Delete @chosen.Count @(chosen.Count == 1 ? "book" : "books") with their quotes, highlights, reading logs, and files?</span>
                    <button type="button" class="danger" @onclick="() => ApplyBulk(new BulkRequest([.. chosen], Delete: true))">Yes, delete</button>
                    <button type="button" @onclick="() => confirmingBulkDelete = false">Cancel</button>
                }
            }
            @if (bulkNote is not null)
            {
                <span class="saved" role="status">@bulkNote</span>
            }
        </div>
        <ul class="book-list">
        @foreach (var book in visible)
        {
            <li class="book">
            <div class="book-pick">
                <input type="checkbox" checked="@chosen.Contains(book.Id)" @onchange="change => Choose(book.Id, change.Value is true)" aria-label="@($"Choose {book.Title}")" />
                <a href="/library/@book.Id" tabindex="-1" aria-hidden="true"><BookCover Title="@book.Title" Url="@book.CoverShown" /></a>
            </div>
            <div>
            <h2><a href="/library/@book.Id">@book.Title</a></h2>
            @if (!string.IsNullOrWhiteSpace(book.Subtitle))
            {
                <p class="hint">@book.Subtitle</p>
            }
            <p class="by">
                <a href="@($"/?author={Uri.EscapeDataString(book.Author)}")">@book.Author</a>
                @if (book.Year is int year)
                {
                    <span> (@year)</span>
                }
                @if (!string.IsNullOrWhiteSpace(book.Series))
                {
                    <span> · </span>
                    <a href="@($"/?series={Uri.EscapeDataString(book.Series)}")">@book.Series</a>
                    @if (book.SeriesNumber is int number)
                    {
                        <span> @number</span>
                    }
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(book.OriginalTitle))
            {
                <p class="hint">Originally @book.OriginalTitle</p>
            }
            <p class="meta">
                <label>
                    <span class="visually-hidden">Status of @book.Title</span>
                    <select @bind:get="book.Status" @bind:set="status => UpdateStatus(book.Id, status)">
                        @foreach (var status in Enum.GetValues<BookStatus>())
                        {
                            <option value="@status">@BookRules.StatusLabel(status)</option>
                        }
                    </select>
                </label>
                <button type="button" class="@(book.Loved ? "loved" : null)" aria-pressed="@(book.Loved ? "true" : "false")" @onclick="() => ToggleLoved(book.Id)">
                    @(book.Loved ? "Loved" : "Love")
                </button>
                @if (book.Status == BookStatus.Want)
                {
                    <button type="button" class="@(book.Queued ? "queued" : null)" aria-pressed="@(book.Queued ? "true" : "false")" @onclick="() => ToggleQueued(book.Id)">
                        @(book.Queued ? "Queued" : "Read next")
                    </button>
                }
                @if (!string.IsNullOrWhiteSpace(book.EbookStoredName))
                {
                    <a href="/library/@book.Id/read">Read</a>
                }
                @if (!string.IsNullOrWhiteSpace(book.AudioStoredName))
                {
                    <a href="/library/@book.Id/listen">Listen</a>
                }
            </p>
            <p class="meta">
                @if (book.Format is BookFormat format)
                {
                    <span>@format</span>
                }
                @if (book.Rating is int rating)
                {
                    <span>@rating/5</span>
                }
                @if (book.Status == BookStatus.Reading && book.Pages is int pages)
                {
                    <span class="progress-wrap">
                        <progress max="@pages" value="@(book.CurrentPage ?? 0)" aria-label="@($"Page {book.CurrentPage ?? 0} of {pages}")"></progress>
                        <span>@(book.CurrentPage ?? 0)/@pages</span>
                    </span>
                }
                else if (book.Status == BookStatus.Reading && book.CurrentPage is int current)
                {
                    <span>p. @current</span>
                }
                else if (book.Pages is int total)
                {
                    <span>@total pages</span>
                }
                @if (book.FinishedOn is DateOnly finished)
                {
                    <span>Finished @finished.Medium()</span>
                }
                @if (book.Acquisition is Acquisition arrived)
                {
                    <span>@(arrived == Acquisition.Gift ? "A gift" : arrived.ToString())</span>
                }
                @if (book.Condition is CopyCondition condition)
                {
                    <span>@BookRules.ConditionLabel(condition)</span>
                }
                @if (!string.IsNullOrWhiteSpace(book.Location))
                {
                    <a href="@($"/?place={Uri.EscapeDataString(book.Location)}")">@book.Location</a>
                }
                @if (!string.IsNullOrWhiteSpace(book.RecommendedBy))
                {
                    <a href="@($"/?recommendedBy={Uri.EscapeDataString(book.RecommendedBy)}")">From @book.RecommendedBy</a>
                }
                @if (book.Quotes.Count > 0)
                {
                    <span>@book.Quotes.Count @(book.Quotes.Count == 1 ? "quote" : "quotes")</span>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(book.LoanedTo))
            {
                <p class="meta">
                    <span class="badge loan">On loan</span>
                    <span>
                        to <a href="@($"/?loanedTo={Uri.EscapeDataString(book.LoanedTo)}")">@book.LoanedTo</a>
                        @if (book.LoanedOn is DateOnly loanedOn)
                        {
                            <span> since @loanedOn.Medium()</span>
                        }
                        @if (book.DueOn is DateOnly due)
                        {
                            <span class="@(due < Today ? "late" : null)"> · due @due.Medium()@(due < Today ? ", overdue" : "")</span>
                        }
                    </span>
                    <button type="button" @onclick="() => ReturnLoan(book.Id)">Mark returned</button>
                </p>
            }
            @if (book.Tags.Count > 0)
            {
                <p class="tags">
                    @foreach (var tag in book.Tags.OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <a href="@($"/?tag={Uri.EscapeDataString(tag.Name)}")">@tag.Name</a>
                    }
                </p>
            }
            </div>
            </li>
        }
        </ul>
    }
    @if (matching.Count > visible.Count)
    {
        <p>
            <button type="button" @onclick="() => shown += PageSize">Show @Math.Min(PageSize, matching.Count - visible.Count) more</button>
            <span class="hint">@(matching.Count - visible.Count) not shown yet</span>
        </p>
    }
}

@code {
    private readonly BookFormModel draft = new();
    private List<Book> books = [];
    private string query = "";
    private string statusFilter = "";
    private string sort = "title";
    private string? tagFilter;
    private string? authorFilter;
    private string? seriesFilter;
    private string? placeFilter;
    private string? recommendedFilter;
    private string? loanedFilter;
    private bool lovedOnly;
    private bool loanedOnly;
    private bool queuedOnly;
    private bool fileOnly;
    private bool audioOnly;
    private Dictionary<string, string[]>? formErrors;
    private bool filling;
    private string? fillNote;
    // A large shelf draws a page of books at a time, so the library stays quick with thousands.
    private const int PageSize = 60;
    private int shown = PageSize;
    private bool adding;
    private readonly HashSet<int> chosen = [];
    private string bulkStatus = "";
    private string bulkTag = "";
    private string? bulkNote;
    private bool confirmingBulkDelete;
    private bool listView;
    private string? addedTitle;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    [SupplyParameterFromQuery(Name = "add")]
    public string? Add { get; set; }

    [SupplyParameterFromQuery(Name = "imported")]
    public int? Imported { get; set; }

    [SupplyParameterFromQuery(Name = "joined")]
    public int? Joined { get; set; }

    [SupplyParameterFromQuery(Name = "skipped")]
    public int? Skipped { get; set; }

    [SupplyParameterFromQuery(Name = "failed")]
    public int? Failed { get; set; }

    // "Added 3 books. 1 file went on a book you had. 2 were already on the shelf."
    private string? ImportSummary
    {
        get
        {
            if (Imported is null)
            {
                return null;
            }

            static string Books(int count) => count == 1 ? "1 book" : $"{count} books";
            static string Files(int count) => count == 1 ? "1 file" : $"{count} files";
            var parts = new List<string> { $"Added {Books(Imported.Value)}." };
            if (Joined is > 0)
            {
                parts.Add($"{Files(Joined.Value)} went on {(Joined == 1 ? "a book" : "books")} you had.");
            }

            if (Skipped is > 0)
            {
                parts.Add($"{Files(Skipped.Value)} {(Skipped == 1 ? "was" : "were")} already on another book; tick the box to add {(Skipped == 1 ? "it" : "them")} anyway.");
            }

            if (Failed is > 0)
            {
                parts.Add($"{Files(Failed.Value)} could not be added: Shelf takes EPUB, PDF, audio, and zips, up to 1 GB.");
            }

            return string.Join(" ", parts);
        }
    }

    [SupplyParameterFromQuery(Name = "tag")]
    public string? Tag { get; set; }

    [SupplyParameterFromQuery(Name = "author")]
    public string? Author { get; set; }

    [SupplyParameterFromQuery(Name = "series")]
    public string? Series { get; set; }

    [SupplyParameterFromQuery(Name = "place")]
    public string? Place { get; set; }

    [SupplyParameterFromQuery(Name = "recommendedBy")]
    public string? RecommendedBy { get; set; }

    [SupplyParameterFromQuery(Name = "loanedTo")]
    public string? LoanedTo { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        tagFilter = string.IsNullOrWhiteSpace(Tag) ? null : Tag.Trim();
        authorFilter = string.IsNullOrWhiteSpace(Author) ? null : Author.Trim();
        seriesFilter = string.IsNullOrWhiteSpace(Series) ? null : Series.Trim();
        placeFilter = string.IsNullOrWhiteSpace(Place) ? null : Place.Trim();
        recommendedFilter = string.IsNullOrWhiteSpace(RecommendedBy) ? null : RecommendedBy.Trim();
        loanedFilter = string.IsNullOrWhiteSpace(LoanedTo) ? null : LoanedTo.Trim();
        query = Query?.Trim() ?? "";
        statusFilter = Enum.TryParse<BookStatus>(Status, ignoreCase: true, out var status) ? status.ToString() : "";
        adding = Add == "1";
        await LoadAsync();

        // A ?view= link wins; otherwise the library opens the way this reader last left it.
        if (View is null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            listView = await BookRules.GetLibraryAsListAsync(db);
        }
        else
        {
            listView = string.Equals(View, "list", StringComparison.OrdinalIgnoreCase);
        }
    }

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);

    private Book? Suggestion => BookRules.Pick(books, BookStatus.Want, Today);

    private List<Book> ReadingNow => books.Where(book => book.Status == BookStatus.Reading)
        .OrderBy(book => book.Title, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private List<Book> RecentlyFinished => books
        .Where(book => book.Status == BookStatus.Finished && book.FinishedOn is not null)
        .OrderByDescending(book => book.FinishedOn)
        .ThenBy(book => book.Title, StringComparer.OrdinalIgnoreCase)
        .Take(4)
        .ToList();

    private int ChecksOn => new[] { lovedOnly, loanedOnly, queuedOnly, fileOnly, audioOnly }.Count(on => on);

    private bool UrlFiltered => tagFilter is not null || authorFilter is not null || seriesFilter is not null
        || placeFilter is not null || recommendedFilter is not null || loanedFilter is not null;

    private bool Filtered => !string.IsNullOrWhiteSpace(query) || statusFilter.Length > 0 || ChecksOn > 0 || UrlFiltered;

    // The overview sections lead the page only while the whole shelf is in view.
    private bool IsOverview => !Filtered;

    private string Heading => Enum.TryParse<BookStatus>(statusFilter, out var status) && !UrlFiltered && string.IsNullOrWhiteSpace(query) && ChecksOn == 0
        ? BookRules.StatusLabel(status)
        : "Library";

    private void Choose(int id, bool on)
    {
        bulkNote = null;
        if (on)
        {
            chosen.Add(id);
        }
        else
        {
            chosen.Remove(id);
        }
    }

    private void ChooseAll(IEnumerable<Book> shown, bool on)
    {
        bulkNote = null;
        foreach (var book in shown)
        {
            Choose(book.Id, on);
        }
    }

    private async Task ApplyBulk(BulkRequest request)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var result = await Bulk.ApplyAsync(db, Ebooks, Audio, request);
            bulkNote = request.Delete
                ? $"Deleted {result.Changed} {(result.Changed == 1 ? "book" : "books")}."
                : $"Changed {result.Changed} {(result.Changed == 1 ? "book" : "books")}.";
        }

        if (request.Delete)
        {
            chosen.Clear();
        }

        confirmingBulkDelete = false;
        bulkStatus = "";
        await LoadAsync();
        chosen.IntersectWith(books.Select(book => book.Id));
    }

    private async Task ShowAsList(bool asList)
    {
        listView = asList;
        await using var db = await DbFactory.CreateDbContextAsync();
        await BookRules.SetLibraryAsListAsync(db, asList);
    }

    private void ClearFilters()
    {
        shown = PageSize;
        query = "";
        statusFilter = "";
        lovedOnly = loanedOnly = queuedOnly = fileOnly = audioOnly = false;
        if (UrlFiltered || Query is not null || Status is not null)
        {
            Navigation.NavigateTo(listView ? "/?view=list" : "/");
        }
    }

    private List<Book> ReadNext => books
        .Where(book => book.Status == BookStatus.Want && book.Queued)
        .OrderBy(book => book.Title, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IEnumerable<Book> Visible
    {
        get
        {
            IEnumerable<Book> result = books;
            if (!string.IsNullOrWhiteSpace(query))
            {
                var term = query.Trim();
                var isbn = BookRules.NormalizeIsbn(term);
                result = result.Where(book =>
                    book.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || book.Author.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (book.Subtitle?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.Series?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (isbn is not null && book.Isbn == isbn)
                    || (book.Isbn?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.Notes?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.Location?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.Translator?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.OriginalTitle?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.Inscription?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (book.RecommendedBy?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || book.Quotes.Any(quote => quote.Text.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            if (Enum.TryParse<BookStatus>(statusFilter, out var status))
            {
                result = result.Where(book => book.Status == status);
            }

            if (BookRules.CanonicalTag(tagFilter) is { } tagName)
            {
                result = result.Where(book => book.Tags.Any(tag => tag.Name == tagName));
            }

            if (!string.IsNullOrWhiteSpace(authorFilter))
            {
                result = result.Where(book => book.Author.Equals(authorFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(seriesFilter))
            {
                result = result.Where(book => book.Series != null && book.Series.Equals(seriesFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(placeFilter))
            {
                result = result.Where(book => book.Location != null && book.Location.Equals(placeFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(recommendedFilter))
            {
                result = result.Where(book => book.RecommendedBy != null && book.RecommendedBy.Equals(recommendedFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(loanedFilter))
            {
                result = result.Where(book => book.LoanedTo != null && book.LoanedTo.Equals(loanedFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (lovedOnly)
            {
                result = result.Where(book => book.Loved);
            }

            if (queuedOnly)
            {
                result = result.Where(book => book.Queued);
            }

            if (fileOnly)
            {
                result = result.Where(book => !string.IsNullOrWhiteSpace(book.EbookStoredName));
            }

            if (audioOnly)
            {
                result = result.Where(book => !string.IsNullOrWhiteSpace(book.AudioStoredName));
            }

            if (loanedOnly)
            {
                result = result.Where(book => !string.IsNullOrWhiteSpace(book.LoanedTo));
            }

            return sort switch
            {
                "author" => result.OrderBy(book => book.Author, StringComparer.OrdinalIgnoreCase).ThenBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
                "series" => result.OrderBy(book => book.Series == null).ThenBy(book => book.Series, StringComparer.OrdinalIgnoreCase).ThenBy(book => book.SeriesNumber ?? int.MaxValue).ThenBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
                "year" => result.OrderByDescending(book => book.Year ?? 0).ThenBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
                "rating" => result.OrderByDescending(book => book.Rating ?? 0).ThenBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
                "added" => result.OrderByDescending(book => book.AddedAt).ThenBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
                _ => result.OrderBy(book => book.Title, StringComparer.OrdinalIgnoreCase),
            };
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        // Only what the library shows: tags, and quotes for their count and for search.
        books = await db.Books.AsNoTracking().Include(book => book.Tags).Include(book => book.Quotes).AsSplitQuery().ToListAsync();
    }

    private async Task AddBook()
    {
        var write = draft.ToWrite();
        formErrors = BookRules.Validate(write);
        if (formErrors is not null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var book = new Book
        {
            Title = write.Title.Trim(),
            Author = write.Author.Trim(),
        };
        BookRules.Apply(book, write);
        db.Books.Add(book);
        await BookRules.SyncTagsAsync(db, book, write.Tags, CancellationToken.None);
        await db.SaveChangesAsync();
        await BookRules.RemoveUnusedTagsAsync(db, CancellationToken.None);

        addedTitle = book.Title;
        draft.Clear();
        formErrors = null;
        adding = false;
        await LoadAsync();
    }

    private async Task UpdateStatus(int id, BookStatus status)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var book = await db.Books.FirstOrDefaultAsync(existing => existing.Id == id);
        if (book is null)
        {
            return;
        }

        BookRules.ChangeStatus(book, status);
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task ToggleLoved(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var book = await db.Books.FirstOrDefaultAsync(existing => existing.Id == id);
        if (book is null)
        {
            return;
        }

        book.Loved = !book.Loved;
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task ToggleQueued(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var book = await db.Books.FirstOrDefaultAsync(existing => existing.Id == id);
        if (book is null || book.Status != BookStatus.Want)
        {
            return;
        }

        book.Queued = !book.Queued;
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private static bool NeedsCatalog(Book book) =>
        book.Year is null
        || book.Pages is null
        || string.IsNullOrWhiteSpace(book.Publisher)
        || string.IsNullOrWhiteSpace(book.Language)
        || string.IsNullOrWhiteSpace(book.CoverUrl);

    private async Task FillEmptyDetails()
    {
        filling = true;
        fillNote = null;
        var filled = 0;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var pending = (await db.Books.WithDetails().ToListAsync()).Where(NeedsCatalog).ToList();
            foreach (var book in pending)
            {
                var match = await Lookup.FindAsync(book.Isbn, book.Title, book.Author, CancellationToken.None);
                if (match is null)
                {
                    continue;
                }

                var tags = book.Tags.Select(tag => tag.Name).ToList();
                if (!BookRules.FillEmpty(book, match, tags))
                {
                    continue;
                }

                await BookRules.SyncTagsAsync(db, book, tags, CancellationToken.None);
                filled++;
            }

            if (filled > 0)
            {
                await db.SaveChangesAsync();
                await BookRules.RemoveUnusedTagsAsync(db, CancellationToken.None);
            }
        }
        finally
        {
            filling = false;
        }

        fillNote = filled switch
        {
            0 => "Nothing new turned up.",
            1 => "Filled 1 book.",
            _ => $"Filled {filled} books.",
        };
        await LoadAsync();
    }

    private async Task ReturnLoan(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var book = await db.Books.FirstOrDefaultAsync(existing => existing.Id == id);
        if (book is null)
        {
            return;
        }

        BookRules.ReturnLoan(book);
        await db.SaveChangesAsync();
        await LoadAsync();
    }
