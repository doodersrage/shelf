@page "/shelves"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>@T("Shelves") · Shelf</PageTitle>

<h1>@T("Shelves")</h1>
<p class="hint">@T("Readers who have opened their shelf. Ask to borrow a book, and it shows on its owner's loans until they lend it or decline.") <a href="/account">@T("Open your shelf to them too.")</a></p>

@if (shelves.Count == 0)
{
    <EmptyState Title="@T("No open shelves yet")" Text="@T("When another reader opens their shelf from their account, its titles appear here and you can ask to borrow one.")" ActionHref="/account" ActionLabel="@T("Open your own shelf")" />
}
else
{
    <ul class="tag-counts">
        @foreach (var shelf in shelves)
        {
            <li>
                <a href="/shelves/@shelf.Id">@shelf.Name</a>
                <span class="hint">@Localization.Counts.Books(shelf.Books)</span>
            </li>
        }
    </ul>
}

@code {
    private List<OpenShelf> shelves = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        shelves = (await Asking.OpenShelvesAsync(db)).ToList();
    }
}
