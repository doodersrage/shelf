@page "/shelves/linked/{LinkId:int}/{OwnerId:int}"
@inject IDbContextFactory<ShelfDb> DbFactory
@inject Federation Federation

<PageTitle>@(owner ?? "Shelf") · Shelf</PageTitle>

@if (!loaded)
{
    <p role="status">@T("Looking…")</p>
}
else if (owner is null)
{
    <h1>@T("Not an open shelf")</h1>
    <p>@T("That shelf could not be reached, or is no longer open.") <a href="/shelves">@T("Back to the shelves")</a></p>
}
else
{
    <p class="hint"><a href="/shelves">@T("Shelves")</a> · @server</p>
    <h1>@T("{0}'s shelf", owner)</h1>
    <p class="hint">@T("{0} is a reader on {1}, a shelf linked to this one. Ask for a book, and when they lend it, a copy comes to your shelf while it is out.", owner, server ?? "")</p>
    @if (more || Skip > 0 || !string.IsNullOrWhiteSpace(Q))
    {
        <form class="filters" action="/shelves/linked/@LinkId/@OwnerId" method="get" role="search" aria-label="@T("Search {0}'s shelf", owner)">
            <input type="search" name="q" value="@Q" maxlength="200" placeholder="@T("Title or author")" aria-label="@T("Search {0}'s shelf", owner)" />
            <button type="submit">@T("Search")</button>
        </form>
    }
    @if (books.Length == 0)
    {
        <p class="hint">@(string.IsNullOrWhiteSpace(Q) && Skip == 0 ? T("Nothing on it yet.") : T("No books here match that."))</p>
    }
    else
    {
        <ul class="book-grid">
            @foreach (var book in books)
            {
                <li class="book-card">
                    <BookCover Title="@book.Title" Url="@book.CoverUrl" />
                    <h2 class="title">@book.Title</h2>
                    <p class="by">@book.Author@(book.Year is int year ? $" · {year}" : "")</p>
                    <div class="badges">
                        @if (book.OnLoan)
                        {
                            <span class="badge loan">@T("On loan")</span>
                        }
                        @if (book.HasEbook)
                        {
                            <span class="badge plain">@T("E-book")</span>
                        }
                        @if (book.HasAudio)
                        {
                            <span class="badge plain">@T("Audio")</span>
                        }
                    </div>
                    @if (book.Asked)
                    {
                        <p class="saved">@T("Asked")</p>
                    }
                    else
                    {
                        <form method="post" @formname="@($"ask-{book.Id}")" @onsubmit="Ask" data-enhance>
                            <AntiforgeryToken />
                            <input type="hidden" name="BookId" value="@book.Id" />
                            <button type="submit" aria-label="@T("Ask to borrow {0}", book.Title)">@T("Ask to borrow")</button>
                        </form>
                    }
                </li>
            }
        </ul>
        @if (more || Skip > 0)
        {
            <nav class="actions" aria-label="@T("Pages")">
                @if (Skip > 0)
                {
                    <a class="button" href="@PageHref(Page - 1)">@T("Previous")</a>
                }
                @if (more)
                {
                    <a class="button" href="@PageHref(Page + 1)">@T("Next")</a>
                }
            </nav>
        }
    }
    @if (message is not null)
    {
        <p class="hint" role="status">@message</p>
    }
}

@code {
    [Parameter]
    public int LinkId { get; set; }

    [Parameter]
    public int OwnerId { get; set; }

    private bool loaded;
    private string? owner;
    private string? server;
    private const int PageSize = 60;
    private LinkedBook[] books = [];
    private bool more;
    private string? message;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageNumber { get; set; }

    private int Page => Math.Max(1, PageNumber ?? 1);

    private int Skip => (Page - 1) * PageSize;

    private string PageHref(int page) =>
        $"/shelves/linked/{LinkId}/{OwnerId}?page={page}" + (string.IsNullOrWhiteSpace(Q) ? "" : $"&q={Uri.EscapeDataString(Q)}");

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var shelf = await Federation.ShelfAsync(db, LinkId, OwnerId, Q, Skip, PageSize);
        (owner, server, books, more, loaded) = shelf is { } found ? (found.Owner, found.Server, found.Books, found.More, true) : (null, null, [], false, true);
    }

    [SupplyParameterFromForm]
    private int? BookId { get; set; }

    private async Task Ask()
    {
        if (BookId is not int bookId)
        {
            return;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            message = await Federation.AskAsync(db, LinkId, OwnerId, bookId) ? T("Asked. It shows under Loans until it is lent or declined.") : T("The other shelf could not take the ask just now.");
        }

        await LoadAsync();
    }
}
