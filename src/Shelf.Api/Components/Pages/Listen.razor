@page "/library/{Id:int}/listen"
@rendermode InteractiveServer
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IDbContextFactory<ShelfDb> DbFactory
@inject AudioStore Audio
@inject IJSRuntime Js

<PageTitle>@(book?.Title ?? "Shelf")</PageTitle>

@if (missing)
{
    <h1>@T("Not on the shelf")</h1>
    <p>@T("That book is not here.") <a href="/">@T("Back to the library")</a></p>
}
else if (book is not null)
{
    <div class="player">
        @if (borrowed)
        {
            <p class="hint"><a href="/loans">@T("Loans")</a> · @T("lent to you")</p>
        }
        else
        {
            <p class="hint"><a href="/library/@book.Id">@book.Title</a></p>
        }
        <h1>@book.Title</h1>
        @if (tracks.Count == 0)
        {
            <p>@T("This book has no audiobook.")@if (!borrowed) { <text> <a href="/library/@book.Id">@T("Add one")</a></text> }</p>
        }
        else
        {
            @if (tracks.Count > 1)
            {
                <div class="reader-nav">
                    <button type="button" @onclick="Previous" disabled="@(track == 0)">@T("Previous")</button>
                    <label>
                        @T("Track")
                        <select @bind="track" @bind:after="ChooseTrack">
                            @foreach (var item in tracks)
                            {
                                <option value="@item.Index">@item.Title</option>
                            }
                        </select>
                    </label>
                    <button type="button" @onclick="Next" disabled="@(track >= tracks.Count - 1)">@T("Next")</button>
                </div>
            }
            else
            {
                <p class="hint">@tracks[0].Title</p>
            }
            <audio @key="track" @ref="player" controls preload="metadata" src="/books/@book.Id/audio/tracks/@track"></audio>
            <div class="reader-settings">
                <label>
                    @T("Speed")
                    <select @bind="speed" @bind:after="SaveSpeed">
                        <option value="80">0.8×</option>
                        <option value="100">1×</option>
                        <option value="125">1.25×</option>
                        <option value="150">1.5×</option>
                        <option value="175">1.75×</option>
                        <option value="200">2×</option>
                    </select>
                </label>
                <label>
                    @T("Sleep timer")
                    <select @bind="sleep" @bind:after="SetSleep">
                        <option value="">@T("Off")</option>
                        <option value="15">@T("In 15 minutes")</option>
                        <option value="30">@T("In 30 minutes")</option>
                        <option value="45">@T("In 45 minutes")</option>
                        <option value="60">@T("In an hour")</option>
                        <option value="track">@T("At the end of this track")</option>
                    </select>
                </label>
            </div>
            @if (sleepNote is not null)
            {
                <p class="hint" role="status">@sleepNote</p>
            }
            @if (chapters.Count > 1)
            {
                <div class="reader-nav">
                    <button type="button" @onclick="() => GoToChapter(chapterIndex - 1)" disabled="@(chapterIndex <= 0)">@T("Previous chapter")</button>
                    <label>
                        @T("Chapter")
                        <select value="@chapterIndex" @onchange="change => GoToChapter(int.Parse((string)change.Value!))">
                            @foreach (var chapter in chapters)
                            {
                                <option value="@chapter.Index">@chapter.Title · @Clock(chapter.Start)</option>
                            }
                        </select>
                    </label>
                    <button type="button" @onclick="() => GoToChapter(chapterIndex + 1)" disabled="@(chapterIndex >= chapters.Count - 1)">@T("Next chapter")</button>
                </div>
                <p class="hint" aria-live="polite">@T("Now in {0}", chapters[chapterIndex].Title)</p>
            }

            <h2>@T("Bookmarks")</h2>
            <div class="reader-settings">
                <label>
                    @T("Note, if you like")
                    <input @bind="bookmarkNote" maxlength="500" />
                </label>
                <button type="button" class="primary" @onclick="AddBookmark">@T("Bookmark this moment")</button>
            </div>
            @if (bookmarks.Count == 0)
            {
                <p class="hint">@T("No bookmarks yet. Bookmark a moment to come back to it.")</p>
            }
            else
            {
                <ul class="quotes">
                    @foreach (var mark in bookmarks)
                    {
                        <li>
                            <strong>@Where(mark)</strong>
                            @if (!string.IsNullOrWhiteSpace(mark.Note))
                            {
                                <p>@mark.Note</p>
                            }
                            <button type="button" @onclick="() => GoToBookmark(mark)">@T("Go there")</button>
                            <button type="button" @onclick="() => RemoveBookmark(mark.Id)">@T("Remove")</button>
                        </li>
                    }
                </ul>
            }
        }
    </div>
}

@code {
    private Book? book;
    private IReadOnlyList<AudioChapter> chapters = [];
    private int chapterIndex;
    private List<AudioBookmark> bookmarks = [];
    private string bookmarkNote = "";
    private int speed = BookRules.DefaultAudioSpeed;
    private string sleep = "";
    private string? sleepNote;
    private OpenBook? open;
    private bool borrowed;
    private bool missing;
    private int track;
    private int resumeSeconds;
    private int boundTrack = -1;
    private IReadOnlyList<AudioTrack> tracks = [];
    private ElementReference player;
    private IJSObjectReference? module;
    private DotNetObjectReference<Listen>? self;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        open = await Lending.OpenAsync(db, Id);
        book = open?.Book;
        borrowed = open?.Borrowed == true;
        missing = book is null;
        speed = await BookRules.GetAudioSpeedAsync(db);
        tracks = [];
        track = 0;
        resumeSeconds = 0;
        boundTrack = -1;
        if (book is null || string.IsNullOrWhiteSpace(book.AudioStoredName))
        {
            return;
        }

        tracks = Audio.Tracks(book.AudioStoredName);
        chapters = Audio.Chapters(book.AudioStoredName);
        bookmarks = await Lending.Bookmarks(db, open!).AsNoTracking().OrderBy(mark => mark.Track).ThenBy(mark => mark.Seconds).ToListAsync();
        if (tracks.Count == 0)
        {
            return;
        }

        var place = await Lending.PlaceAsync(db, open!);
        var saved = place.AudioTrack ?? 0;
        track = saved >= 0 && saved < tracks.Count ? saved : 0;
        resumeSeconds = Math.Max(0, place.AudioSeconds ?? 0);
        chapterIndex = chapters.Count > 1 ? ChapterAt(resumeSeconds) : 0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (tracks.Count == 0 || boundTrack == track)
        {
            return;
        }

        if (module is null)
        {
            self = DotNetObjectReference.Create(this);
            module = await Js.InvokeAsync<IJSObjectReference>("import", "./player.js");
        }

        boundTrack = track;
        await module.InvokeVoidAsync("attach", player, self, speed / 100.0);
        if (resumeSeconds > 0)
        {
            await module.InvokeVoidAsync("seek", player, resumeSeconds);
        }
    }

    [JSInvokable]
    public async Task Progress(int seconds)
    {
        await Remember(track, Math.Max(0, seconds));
        if (chapters.Count > 1)
        {
            var now = ChapterAt(seconds);
            if (now != chapterIndex)
            {
                chapterIndex = now;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private int ChapterAt(double seconds) => chapters.LastOrDefault(chapter => chapter.Start <= seconds + 0.5)?.Index ?? 0;

    private async Task GoToChapter(int index)
    {
        if (index < 0 || index >= chapters.Count || module is null)
        {
            return;
        }

        chapterIndex = index;
        var start = (int)Math.Floor(chapters[index].Start);
        await module.InvokeVoidAsync("seek", player, start);
        await Remember(track, start);
    }

    private async Task AddBookmark()
    {
        if (open is null || module is null)
        {
            return;
        }

        var seconds = await module.InvokeAsync<int>("position");
        await using var db = await DbFactory.CreateDbContextAsync();
        if (open.Borrowed && !await db.Books.IgnoreQueryFilters().AnyAsync(item => item.Id == open.Book.Id && item.BorrowerId == db.ReaderId))
        {
            return;
        }

        db.AudioBookmarks.Add(new AudioBookmark
        {
            BookId = open.Book.Id,
            ReaderId = open.Borrowed ? db.ReaderId : null,
            Track = track,
            Seconds = Math.Max(0, seconds),
            Note = string.IsNullOrWhiteSpace(bookmarkNote) ? null : bookmarkNote.Trim()[..Math.Min(500, bookmarkNote.Trim().Length)],
            CreatedAt = DateTimeOffset.UtcNow,
        });
        await db.SaveChangesAsync();
        bookmarkNote = "";
        await ReloadBookmarks(db);
    }

    private async Task GoToBookmark(AudioBookmark mark)
    {
        if (mark.Track != track)
        {
            track = mark.Track;
            resumeSeconds = mark.Seconds;
            boundTrack = -1;
            await Remember(track, mark.Seconds);
            return;
        }

        if (module is not null)
        {
            await module.InvokeVoidAsync("seek", player, mark.Seconds);
            await Remember(track, mark.Seconds);
        }
    }

    private async Task RemoveBookmark(int id)
    {
        if (open is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var mark = await Lending.Bookmarks(db, open).FirstOrDefaultAsync(item => item.Id == id);
        if (mark is not null)
        {
            db.AudioBookmarks.Remove(mark);
            await db.SaveChangesAsync();
        }

        await ReloadBookmarks(db);
    }

    private async Task ReloadBookmarks(ShelfDb db) =>
        bookmarks = await Lending.Bookmarks(db, open!).AsNoTracking().OrderBy(mark => mark.Track).ThenBy(mark => mark.Seconds).ToListAsync();

    private string Where(AudioBookmark mark)
    {
        var place = Clock(mark.Seconds);
        if (chapters.Count > 1)
        {
            return $"{chapters[ChapterAt(mark.Seconds)].Title} · {place}";
        }

        return tracks.Count > 1 && mark.Track < tracks.Count ? $"{tracks[mark.Track].Title} · {place}" : place;
    }

    private static string Clock(double seconds)
    {
        var time = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return time.TotalHours >= 1 ? time.ToString(@"h\:mm\:ss") : time.ToString(@"m\:ss");
    }

    [JSInvokable]
    public Task Slept()
    {
        sleep = "";
        sleepNote = T("Paused by the sleep timer. Play to carry on from here.");
        return InvokeAsync(StateHasChanged);
    }

    private async Task SaveSpeed()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await BookRules.SetAudioSpeedAsync(db, speed);
        if (module is not null)
        {
            await module.InvokeVoidAsync("speed", speed / 100.0);
        }
    }

    private async Task SetSleep()
    {
        sleepNote = null;
        var minutes = int.TryParse(sleep, out var value) ? value : 0;
        if (module is not null)
        {
            await module.InvokeVoidAsync("sleep", minutes);
        }

        sleepNote = sleep switch
        {
            "" => null,
            "track" => T("Stops at the end of this track."),
            _ => T("Stops in {0} minutes.", minutes),
        };
    }

    [JSInvokable]
    public async Task Ended()
    {
        if (sleep == "track")
        {
            // The sleep timer said this track was the last one tonight; the next one starts from its beginning.
            sleep = "";
            sleepNote = T("Stopped at the end of the track, as the sleep timer asked.");
            if (track < tracks.Count - 1)
            {
                track++;
                resumeSeconds = 0;
                boundTrack = -1;
            }

            await Remember(track, 0);
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (track >= tracks.Count - 1)
        {
            await Remember(track, 0);
            return;
        }

        track++;
        resumeSeconds = 0;
        boundTrack = -1;
        await Remember(track, 0);
        await InvokeAsync(StateHasChanged);
    }

    private async Task Previous()
    {
        if (track == 0)
        {
            return;
        }

        track--;
        await ChooseTrack();
    }

    private async Task Next()
    {
        if (track >= tracks.Count - 1)
        {
            return;
        }

        track++;
        await ChooseTrack();
    }

    private async Task ChooseTrack()
    {
        resumeSeconds = 0;
        boundTrack = -1;
        await Remember(track, 0);
    }

    private async Task Remember(int index, int seconds)
    {
        if (open is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await Lending.KeepPlaceAsync(db, open, place =>
        {
            place.AudioTrack = index;
            place.AudioSeconds = seconds;
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("detach");
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        self?.Dispose();
    }
}
