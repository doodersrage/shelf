@page "/library/{Id:int}/listen"
@rendermode InteractiveServer
@using Microsoft.JSInterop
@inject IDbContextFactory<ShelfDb> DbFactory
@inject AudioStore Audio
@inject IJSRuntime Js
@inject EbookStore Ebooks
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Caching.Memory.IMemoryCache Cache

<PageTitle>@(book?.Title ?? "Shelf")</PageTitle>

@if (missing)
{
    <h1>@T("Not on the shelf")</h1>
    <p>@T("That book is not here.") <a href="/">@T("Back to the library")</a></p>
}
else if (book is not null)
{
    @if (plan is null)
    {
        <div class="player">
            <p class="hint"><a href="/library/@book.Id">@book.Title</a></p>
            <h1>@book.Title</h1>
            <p>@T("This book has no audiobook.")@if (!borrowed) { <text> <a href="/library/@book.Id">@T("Add one")</a></text> }</p>
        </div>
    }
    else
    {
        @* Everything here is drawn once; listen.js keeps the times, bars, and buttons up to date as the book plays. *@
        <div class="listen" data-player-view="full" data-book="@book.Id">
            <div class="listen-cover">
                <BookCover Title="@book.Title" Url="@book.CoverShown" Width="100%" />
            </div>
            <div class="listen-main">
                <p class="hint">
                    @if (borrowed)
                    {
                        <a href="/loans">@T("Loans")</a> <text>·</text> @T("lent to you")
                    }
                    else
                    {
                        <a href="/library/@book.Id">@T("About this book")</a>
                    }
                </p>
                <h1>@book.Title</h1>
                <p class="listen-author">@book.Author</p>

                <p class="listen-chapter" aria-live="polite"><span data-show="chapter">@plan.Chapters.FirstOrDefault()?.Title</span></p>
                @if (plan.Chapters.Length > 1)
                {
                    <p class="hint" data-show="chapter-number" data-template="@T("Chapter {0} of {1}")"></p>
                }

                <div class="listen-scrub">
                    <span class="time" data-show="elapsed">0:00</span>
                    <input type="range" min="0" max="1000" value="0" step="1" data-player="scrub" aria-label="@T("Place in this chapter")" />
                    <span class="time" data-show="remaining">-0:00</span>
                </div>

                <div class="listen-controls">
                    <button type="button" class="icon-button" data-player="prev" aria-label="@T("Previous chapter")" disabled="@(plan.Chapters.Length < 2)"><PlayerIcon Name="prev" /></button>
                    <button type="button" class="icon-button jump" data-player="back" aria-label="@T("Back")"><PlayerIcon Name="back" /><span class="jump-by" data-show="back-by">15</span></button>
                    <button type="button" class="icon-button play big" data-player="toggle" data-label-play="@T("Play")" data-label-pause="@T("Pause")" aria-label="@T("Play")"><PlayerIcon Name="play" /><PlayerIcon Name="pause" /></button>
                    <button type="button" class="icon-button jump" data-player="forward" aria-label="@T("Forward")"><PlayerIcon Name="forward" /><span class="jump-by" data-show="forward-by">30</span></button>
                    <button type="button" class="icon-button" data-player="next" aria-label="@T("Next chapter")" disabled="@(plan.Chapters.Length < 2)"><PlayerIcon Name="next" /></button>
                </div>

                <div class="listen-book">
                    <div class="book-bar" aria-hidden="true"><div class="book-fill" data-show="book-bar"></div><div class="book-ticks" data-show="ticks"></div></div>
                    <p class="hint">
                        <span data-show="book-elapsed">0:00</span> / @Clock(Total) ·
                        <span data-show="book-left" data-template="@T("{0} left")"></span> ·
                        <span data-show="percent">0%</span>
                    </p>
                </div>

                <div class="listen-options">
                    <div class="speed" role="group" aria-label="@T("Speed")">
                        <button type="button" class="icon-button small" data-player="slower" aria-label="@T("Slower")">−</button>
                        <output data-show="rate" aria-live="polite">1×</output>
                        <button type="button" class="icon-button small" data-player="faster" aria-label="@T("Faster")">+</button>
                    </div>
                    <details class="menu">
                        <summary class="button">@T("Speed")</summary>
                        <div class="menu-body chips">
                            @foreach (var rate in new[] { 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.5, 3.0 })
                            {
                                <button type="button" class="chip" data-player="rate" data-rate="@rate.ToString(System.Globalization.CultureInfo.InvariantCulture)">@(rate.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture))×</button>
                            }
                        </div>
                    </details>
                    <details class="menu">
                        <summary class="button"><PlayerIcon Name="sleep" /> @T("Sleep timer") <span class="sleep-left" data-show="sleep" data-chapter-text="@T("end of chapter")" hidden></span></summary>
                        <div class="menu-body chips">
                            @foreach (var minutes in new[] { 5, 10, 15, 30, 45, 60, 90 })
                            {
                                <button type="button" class="chip" data-player="sleep" data-sleep="@minutes">@T("{0} min", minutes)</button>
                            }
                            <button type="button" class="chip" data-player="sleep" data-sleep="chapter">@T("End of chapter")</button>
                            <button type="button" class="chip" data-player="sleep-more">@T("5 more minutes")</button>
                            <button type="button" class="chip" data-player="sleep" data-sleep="off">@T("Off")</button>
                        </div>
                    </details>
                    <label class="volume">
                        <PlayerIcon Name="volume" />
                        <span class="visually-hidden">@T("Volume")</span>
                        <input type="range" min="0" max="100" value="100" data-player="volume" />
                    </label>
                </div>
                <p class="hint" role="status" data-show="note" data-slept="@T("Paused by the sleep timer. Play to carry on from here.")" hidden></p>

                @if (plan.HasEbook)
                {
                    <p><button type="button" class="quiet" @onclick="ContinueInEbook">@T("Continue in the e-book")</button></p>
                }
            </div>
        </div>

        <div class="listen-panels">
            <section class="panel">
                <h2>@T("Bookmarks")</h2>
                <div class="reader-settings">
                    <label>
                        @T("Note, if you like")
                        <input @bind="bookmarkNote" maxlength="500" />
                    </label>
                    <button type="button" class="primary" @onclick="AddBookmark">@T("Bookmark this moment")</button>
                </div>
                @if (bookmarks.Count == 0)
                {
                    <p class="hint">@T("No bookmarks yet. Bookmark a moment to come back to it.")</p>
                }
                else
                {
                    <ul class="quotes">
                        @foreach (var mark in bookmarks)
                        {
                            <li>
                                <strong>@Where(mark)</strong>
                                @if (!string.IsNullOrWhiteSpace(mark.Note))
                                {
                                    <p>@mark.Note</p>
                                }
                                <button type="button" @onclick="() => GoToBookmark(mark)">@T("Go there")</button>
                                <button type="button" @onclick="() => RemoveBookmark(mark.Id)">@T("Remove")</button>
                            </li>
                        }
                    </ul>
                }
            </section>

            @if (plan.Chapters.Length > 1)
            {
                <section class="panel">
                    <h2>@(marks.Count > 1 ? T("Chapters") : T("Tracks"))</h2>
                    <ol class="chapter-list">
                        @foreach (var chapter in plan.Chapters)
                        {
                            <li>
                                <button type="button" data-player="chapter" data-chapter="@chapter.Index">
                                    <span>@chapter.Title</span>
                                    @if (StartOf(chapter) is double start)
                                    {
                                        <span class="hint">@Clock(start)</span>
                                    }
                                </button>
                            </li>
                        }
                    </ol>
                </section>
            }

            <details class="panel">
                <summary>@T("Player settings")</summary>
                <div class="reader-settings">
                    <label>
                        @T("Back by")
                        <select data-jump="back">
                            @foreach (var seconds in Jumps)
                            {
                                <option value="@seconds">@T("{0} seconds", seconds)</option>
                            }
                        </select>
                    </label>
                    <label>
                        @T("Forward by")
                        <select data-jump="forward">
                            @foreach (var seconds in Jumps)
                            {
                                <option value="@seconds">@T("{0} seconds", seconds)</option>
                            }
                        </select>
                    </label>
                </div>
                <p class="hint">@T("Keys: Space plays and pauses, the arrow keys go back and forward, Shift and an arrow key moves by chapter, [ and ] change the speed, and M mutes.")</p>
            </details>
        </div>
    }
}

@code {
    private static readonly int[] Jumps = [5, 10, 15, 30, 45, 60];
    private Book? book;
    private AudioPlan? plan;
    private IReadOnlyList<AudioChapter> marks = [];
    private List<AudioBookmark> bookmarks = [];
    private string bookmarkNote = "";
    private OpenBook? open;
    private bool borrowed;
    private bool missing;
    private int openedFor;
    private object? arriving;

    [Parameter]
    public int Id { get; set; }

    // The way in from the e-book: a part (a chapter marked in the file, or else a track) and how far through it.
    [SupplyParameterFromQuery(Name = "part")]
    public int? PartQuery { get; set; }

    [SupplyParameterFromQuery(Name = "at")]
    public double? AtQuery { get; set; }

    public sealed record PlayerNow(int BookId, int Track, double Seconds, double TrackLength, int Chapter, double BookSeconds);

    private double Total => plan?.Tracks.Sum(track => track.Length ?? 0) ?? 0;

    // Where a chapter starts in the whole recording, when every track before it has a known length.
    private double? StartOf(AudioPlanChapter chapter)
    {
        var before = plan!.Tracks.Take(chapter.Track).ToList();
        return before.Any(track => track.Length is null) ? null : before.Sum(track => track.Length!.Value) + chapter.Start;
    }

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        open = await Lending.OpenAsync(db, Id);
        book = open?.Book;
        borrowed = open?.Borrowed == true;
        missing = book is null;
        plan = book is null ? null : await AudioPlayback.PlanAsync(db, Audio, Id);
        marks = book is null ? [] : Audio.Chapters(book.AudioStoredName);
        arriving = null;
        if (plan is null)
        {
            return;
        }

        bookmarks = await Lending.Bookmarks(db, open!).AsNoTracking().OrderBy(mark => mark.Track).ThenBy(mark => mark.Seconds).ToListAsync();
        if (PartQuery is int part && AtQuery is double within)
        {
            if (marks.Count > 1)
            {
                var index = Math.Clamp(part, 0, marks.Count - 1);
                arriving = new { track = 0, from = marks[index].Start, to = index + 1 < marks.Count ? marks[index + 1].Start : (double?)null, fraction = within };
            }
            else
            {
                arriving = new { track = Math.Clamp(part, 0, plan.Tracks.Length - 1), from = 0.0, to = (double?)null, fraction = within };
            }
        }

        openedFor = 0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (plan is null || openedFor == plan.BookId)
        {
            return;
        }

        openedFor = plan.BookId;
        try
        {
            await Js.InvokeVoidAsync("shelfPlayer.open", plan, new { arrive = arriving });
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
        }
    }

    private async Task<PlayerNow?> NowAsync()
    {
        try
        {
            var now = await Js.InvokeAsync<PlayerNow>("shelfPlayer.now");
            return now.BookId == book?.Id ? now : null;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            return null;
        }
    }

    // The same place in the e-book: by the chapters' titles where they agree, and how far through otherwise.
    private async Task ContinueInEbook()
    {
        if (book is null || open is null || Crossover.EbookParts(Ebooks, book.EbookStoredName, Cache) is not { } text || await NowAsync() is not { } now)
        {
            return;
        }

        PartSpot heard;
        if (marks.Count > 1)
        {
            var index = marks.LastOrDefault(mark => mark.Start <= now.Seconds + 0.5)?.Index ?? 0;
            var start = marks[index].Start;
            var end = index + 1 < marks.Count ? marks[index + 1].Start : now.TrackLength;
            heard = new PartSpot(index, end > start ? (now.Seconds - start) / (end - start) : 0);
        }
        else
        {
            heard = new PartSpot(now.Track, now.TrackLength > 0 ? now.Seconds / now.TrackLength : 0);
        }

        var spot = new Crossover(Crossover.AudioParts(Audio, book.AudioStoredName), text).ToEbook(heard);
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await Lending.KeepPlaceAsync(db, open, place =>
            {
                place.AudioTrack = now.Track;
                place.AudioSeconds = (int)now.Seconds;
                place.EbookChapter = spot.Part;
            });
        }

        try
        {
            await Js.InvokeVoidAsync("shelfPlayer.pause");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
        }

        Navigation.NavigateTo($"/library/{book.Id}/read?chapter={spot.Part}&at={spot.Within.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)}");
    }

    private async Task AddBookmark()
    {
        if (open is null || await NowAsync() is not { } now)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (open.Borrowed && !await db.Books.IgnoreQueryFilters().AnyAsync(item => item.Id == open.Book.Id && item.BorrowerId == db.ReaderId))
        {
            return;
        }

        db.AudioBookmarks.Add(new AudioBookmark
        {
            BookId = open.Book.Id,
            ReaderId = open.Borrowed ? db.ReaderId : null,
            Track = now.Track,
            Seconds = Math.Max(0, (int)now.Seconds),
            Note = string.IsNullOrWhiteSpace(bookmarkNote) ? null : bookmarkNote.Trim()[..Math.Min(500, bookmarkNote.Trim().Length)],
            CreatedAt = DateTimeOffset.UtcNow,
        });
        await db.SaveChangesAsync();
        bookmarkNote = "";
        await ReloadBookmarks(db);
    }

    private async Task GoToBookmark(AudioBookmark mark)
    {
        try
        {
            await Js.InvokeVoidAsync("shelfPlayer.seekTrack", mark.Track, mark.Seconds);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
        }
    }

    private async Task RemoveBookmark(int id)
    {
        if (open is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var mark = await Lending.Bookmarks(db, open).FirstOrDefaultAsync(item => item.Id == id);
        if (mark is not null)
        {
            db.AudioBookmarks.Remove(mark);
            await db.SaveChangesAsync();
        }

        await ReloadBookmarks(db);
    }

    private async Task ReloadBookmarks(ShelfDb db) =>
        bookmarks = await Lending.Bookmarks(db, open!).AsNoTracking().OrderBy(mark => mark.Track).ThenBy(mark => mark.Seconds).ToListAsync();

    private string Where(AudioBookmark mark)
    {
        var place = Clock(mark.Seconds);
        if (marks.Count > 1)
        {
            return $"{marks.LastOrDefault(item => item.Start <= mark.Seconds + 0.5)?.Title ?? marks[0].Title} · {place}";
        }

        return plan is { Tracks.Length: > 1 } && mark.Track < plan.Tracks.Length ? $"{plan.Tracks[mark.Track].Title} · {place}" : place;
    }

    private static string Clock(double seconds)
    {
        var time = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return time.TotalHours >= 1 ? $"{(int)time.TotalHours}:{time:mm\\:ss}" : time.ToString(@"m\:ss");
    }
}
