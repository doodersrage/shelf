@page "/recommenders"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>Recommenders · Shelf</PageTitle>

<h1>Recommenders</h1>

@if (people.Count == 0)
{
    <EmptyState Title="No recommendations yet" Text="Note who suggested a book in its details, and the people who recommend books gather here." ActionHref="/" ActionLabel="Open the library" />
}
else
{
    <ul class="tag-counts">
        @foreach (var person in people)
        {
            <li>
                <a href="@($"/?recommendedBy={Uri.EscapeDataString(person.Name)}")">@person.Name</a>
                <span class="hint">@person.Count @(person.Count == 1 ? "book" : "books")</span>
            </li>
        }
    </ul>
}

@code {
    private List<RecommenderCount> people = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var names = await db.Books.AsNoTracking().Select(book => book.RecommendedBy).ToListAsync();
        people = BookRules.Recommenders(names).ToList();
    }
}
