@page "/recommenders"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>@T("Recommenders") · Shelf</PageTitle>

<h1>@T("Recommenders")</h1>

@if (people.Count == 0)
{
    <EmptyState Title="@T("No recommendations yet")" Text="@T("Note who suggested a book in its details, and the people who recommend books gather here.")" ActionHref="/" ActionLabel="@T("Open the library")" />
}
else
{
    <ul class="tag-counts">
        @foreach (var person in people)
        {
            <li>
                <a href="@($"/?recommendedBy={Uri.EscapeDataString(person.Name)}")">@person.Name</a>
                <span class="hint">@Localization.Counts.Books(person.Count)</span>
            </li>
        }
    </ul>
}

@code {
    private List<RecommenderCount> people = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var names = await db.Books.AsNoTracking().Select(book => book.RecommendedBy).ToListAsync();
        people = BookRules.Recommenders(names).ToList();
    }
}
