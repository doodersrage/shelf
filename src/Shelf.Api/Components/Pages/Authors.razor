@page "/authors"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>@T("Authors") · Shelf</PageTitle>

<h1>@T("Authors")</h1>

@if (authors.Count == 0)
{
    <EmptyState Title="@T("No authors yet")" Text="@T("Each author on your shelf is listed here with how many of their books you have.")" ActionHref="/?add=1" ActionLabel="@T("Add a book")" />
}
else
{
    <ul class="tag-counts">
        @foreach (var author in authors)
        {
            <li>
                <a href="@($"/?author={Uri.EscapeDataString(author.Name)}")">@author.Name</a>
                <span class="hint">@Localization.Counts.Books(author.Count)</span>
            </li>
        }
    </ul>
}

@code {
    private List<AuthorCount> authors = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var names = await db.Books.AsNoTracking().Select(book => book.Author).ToListAsync();
        authors = BookRules.AuthorCounts(names).ToList();
    }
}
