@page "/authors"
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>@T("Authors") · Shelf</PageTitle>

<div class="page-head">
    <h1>@T("Authors")</h1>
    <a href="/find">@T("Find new books")</a>
</div>

@if (authors.Count == 0)
{
    <EmptyState Title="@T("No authors yet")" Text="@T("Each author on your shelf is listed here with how many of their books you have.")" ActionHref="/library?add=1" ActionLabel="@T("Add a book")" />
}
else
{
    @* One form for every Follow button, each sending its author's name: a plain page, no live connection. *@
    <form method="post" @formname="follow" @onsubmit="FollowAsync" data-enhance>
    <AntiforgeryToken />
    <ul class="tag-counts">
        @foreach (var author in authors)
        {
            <li>
                <a href="@($"/library?author={Uri.EscapeDataString(author.Name)}")">@author.Name</a>
                <span class="hint">@Localization.Counts.Books(author.Count)</span>
                @if (author.Name != BookImport.UnknownAuthor)
                {
                    @if (followed.Contains(Tidy.AuthorKey(author.Name)))
                    {
                        <span class="hint">· @T("Following")</span>
                    }
                    else
                    {
                        <button type="submit" class="quiet" name="Follow" value="@author.Name" aria-label="@T("Follow {0}", author.Name)">@T("Follow")</button>
                    }
                }
            </li>
        }
    </ul>
    </form>
}

@code {
    private List<AuthorCount> authors = [];
    private HashSet<string> followed = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var names = await db.Books.AsNoTracking().Select(book => book.Author).ToListAsync();
        authors = BookRules.AuthorCounts(names).ToList();
        followed = [.. (await Finding.FollowsAsync(db)).Select(item => Tidy.AuthorKey(item.Name))];
    }

    [SupplyParameterFromForm(FormName = "follow")]
    private string? Follow { get; set; }

    private async Task FollowAsync()
    {
        if (string.IsNullOrWhiteSpace(Follow))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await Finding.FollowAsync(db, Follow);
        followed.Add(Tidy.AuthorKey(Follow));
    }
}
