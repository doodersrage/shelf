@page "/shelves/{Id:int}"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>@(owner ?? "Shelf") · Shelf</PageTitle>

@if (owner is null)
{
    <h1>@T("Not an open shelf")</h1>
    <p>@T("That reader has not opened their shelf.") <a href="/shelves">@T("Back to the shelves")</a></p>
}
else
{
    <p class="hint"><a href="/shelves">@T("Shelves")</a></p>
    <h1>@T("{0}'s shelf", owner)</h1>
    <p class="hint">@T("Ask for a book and it waits on {0}'s Loans page until they lend it or decline. You see titles here, never their notes.", owner)</p>
    @if (books.Count == 0)
    {
        <p class="hint">@T("Nothing on it yet.")</p>
    }
    else
    {
        <ul class="book-grid">
            @foreach (var book in books)
            {
                <li class="book-card">
                    <BookCover Title="@book.Title" Url="@book.CoverUrl" />
                    <h2 class="title">@book.Title</h2>
                    <p class="by">@book.Author@(book.Year is int year ? $" · {year}" : "")</p>
                    <div class="badges">
                        @if (book.OnLoan)
                        {
                            <span class="badge loan">@T("On loan")</span>
                        }
                        @if (book.HasEbook)
                        {
                            <span class="badge plain">@T("E-book")</span>
                        }
                        @if (book.HasAudio)
                        {
                            <span class="badge plain">@T("Audio")</span>
                        }
                    </div>
                    @if (book.Asked)
                    {
                        <p class="saved">@T("Asked")</p>
                    }
                    else
                    {
                        <button type="button" @onclick="() => Ask(book.Id)" aria-label="@T("Ask to borrow {0}", book.Title)">@T("Ask to borrow")</button>
                    }
                </li>
            }
        </ul>
    }
    @if (message is not null)
    {
        <p class="hint" role="status">@message</p>
    }
}

@code {
    private string? owner;
    private List<ShelfBook> books = [];
    private string? message;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var shelf = await Asking.ShelfAsync(db, Id);
        owner = shelf?.Owner;
        books = shelf?.Books.ToList() ?? [];
    }

    private async Task Ask(int bookId)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            message = await Asking.AskAsync(db, bookId) switch
            {
                AskResult.Asked => null,
                AskResult.AlreadyYours => T("That book is already lent to you."),
                _ => T("That book is no longer on an open shelf."),
            };
        }

        await LoadAsync();
    }
}
