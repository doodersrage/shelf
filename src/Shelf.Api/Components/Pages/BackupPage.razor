@page "/backup"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>Backup &amp; restore · Shelf</PageTitle>

<h1>Backup &amp; restore</h1>
<p class="hint">A backup copies your shelf out and changes nothing here. A restore only adds: it never deletes or overwrites a book, and it skips any book already on your shelf.</p>

<section class="panel" aria-labelledby="download-heading">
    <h2 id="download-heading">Download a backup</h2>
    <p>Everything on your shelf in one zip: the catalog, notes, reviews, quotes, reading log, highlights, e-books, and audiobooks.</p>
    <a class="button primary" href="/books/export/full">Download everything</a>
    <p class="hint">Only the catalog, without files: <a href="/books/export">download JSON</a>.</p>
    <p class="hint">Your quotes, highlights, notes, and reviews as Markdown, one file a book, for a notes app: <a href="/books/notes.zip" download>download notes</a>.</p>
</section>

<section class="panel" aria-labelledby="restore-heading">
    <h2 id="restore-heading">Restore from a backup</h2>
    <p>Choose a zip made by Download everything. Its books are added to your shelf with their files.</p>
    <form action="/books/import/full" method="post" enctype="multipart/form-data" data-enhance="false" data-upload>
        <label>
            Zip backup
            <input type="file" name="file" accept=".zip,application/zip" required />
        </label>
        <p class="hint">A large backup takes a while to send. Keep this page open until it comes back with the result.</p>
        <progress data-upload-progress max="100" hidden></progress>
        <p class="hint" data-upload-status role="status" hidden></p>
        <button type="submit" class="quiet">Restore from this zip</button>
    </form>
    @if (Restore == "done")
    {
        <p class="saved" role="status">Restored. Added @Added @(Added == 1 ? "book" : "books") with @Files @(Files == 1 ? "file" : "files"), and skipped @Skipped already on your shelf.</p>
    }
    else if (Restore == "unreadable")
    {
        <p class="validation-message" role="alert">That file is not a shelf backup zip, so nothing was added.</p>
    }

    <h3>From a JSON backup</h3>
    <label>
        JSON backup
        <InputFile OnChange="ImportBackup" accept="application/json" />
    </label>
    @if (!string.IsNullOrWhiteSpace(importMessage))
    {
        <p class="@(imported ? "saved" : "validation-message")" role="status">@importMessage</p>
    }
</section>

<section class="panel" aria-labelledby="abs-heading">
    <h2 id="abs-heading">Bring books from Audiobookshelf</h2>
    <p>Copy audiobooks and e-books from an Audiobookshelf server, with their covers, series, and where you stopped.</p>
    <a class="button" href="/import/audiobookshelf">Connect to Audiobookshelf</a>
</section>

<section class="panel" aria-labelledby="csv-heading">
    <h2 id="csv-heading">Bring a library from Goodreads or StoryGraph</h2>
    <p>Export your library from Goodreads (My Books, then Import and export) or The StoryGraph (Manage account, then Export), and choose the CSV file here. Shelves, reading status, ratings, dates, reviews, and tags come along; books already on your shelf are skipped.</p>
    <form action="/books/import/csv" method="post" enctype="multipart/form-data" data-enhance="false" data-upload>
        <label>
            CSV export
            <input type="file" name="file" accept=".csv,text/csv" required />
        </label>
        <progress data-upload-progress max="100" hidden></progress>
        <p class="hint" data-upload-status role="status" hidden></p>
        <button type="submit" class="quiet">Import this file</button>
    </form>
    @if (Csv == "done")
    {
        <p class="saved" role="status">Imported from @(Source == "StoryGraph" ? "The StoryGraph" : "Goodreads"). Added @Added @(Added == 1 ? "book" : "books"), and skipped @Skipped already on your shelf or missing a title or author.</p>
    }
    else if (Csv == "unreadable")
    {
        <p class="validation-message" role="alert">That file is not a Goodreads or StoryGraph export, so nothing was added.</p>
    }
</section>

<p class="hint">An admin can also keep a snapshot of the whole server, every reader included, from <a href="/admin">Readers</a>.</p>

@code {
    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions = new(System.Text.Json.JsonSerializerDefaults.Web)
    {
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() },
    };

    // A backup holds every book, quote, and session, so a large shelf runs well past a megabyte.
    private const long MaxBackupBytes = 50L * 1024 * 1024;

    private string? importMessage;
    private bool imported;

    [SupplyParameterFromQuery]
    public string? Restore { get; set; }

    [SupplyParameterFromQuery]
    public int Added { get; set; }

    [SupplyParameterFromQuery]
    public int Skipped { get; set; }

    [SupplyParameterFromQuery]
    public int Files { get; set; }

    [SupplyParameterFromQuery]
    public string? Csv { get; set; }

    [SupplyParameterFromQuery]
    public string? Source { get; set; }

    private async Task ImportBackup(InputFileChangeEventArgs change)
    {
        importMessage = null;
        imported = false;
        if (change.File.Size > MaxBackupBytes)
        {
            importMessage = "That backup is larger than 50 MB, so nothing was added.";
            return;
        }

        try
        {
            await using var stream = change.File.OpenReadStream(MaxBackupBytes);
            var export = await System.Text.Json.JsonSerializer.DeserializeAsync<LibraryExport>(stream, JsonOptions);
            if (export?.Books is null)
            {
                importMessage = "That file is not a shelf backup, so nothing was added.";
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await BookRules.ImportAsync(db, export);
            imported = true;
            importMessage = $"Restored. Added {result.Added} {(result.Added == 1 ? "book" : "books")}, and skipped {result.Skipped} already on your shelf.";
        }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or IOException)
        {
            importMessage = "That file is not a shelf backup, so nothing was added.";
        }
    }
}
