@page "/backup"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory
@inject BackupCheck Backups

<PageTitle>@T("Backup & restore") · Shelf</PageTitle>

<div class="titled"><h1>@T("Backup & restore")</h1><HelpLink Page="backups" Section="a-reader-39-s-full-backup" /></div>
<p class="hint">@T("A backup copies your shelf out and changes nothing here. A restore only adds: it never deletes or overwrites a book, and it skips any book already on your shelf.")</p>

<section class="panel" aria-labelledby="download-heading">
    <h2 id="download-heading">@T("Download a backup")</h2>
    <p>@T("Everything on your shelf in one zip: the catalog, notes, reviews, quotes, reading log, highlights, e-books, audiobooks, and covers.") @T("It also holds your books as a spreadsheet, your collections, the loans of your books, and what you marked in books you borrowed, with a README saying what each file is. Only your own records are in it, never another reader's.")</p>
    <a class="button primary" href="/books/export/full">@T("Download everything")</a>
    <p class="hint">@T("Only the catalog, without files:") <a href="/books/export">@T("download JSON")</a>.</p>
    <p class="hint">@T("Your quotes, highlights, notes, and reviews as Markdown, one file a book, for a notes app:") <a href="/books/notes.zip" download>@T("download notes")</a>.</p>
    <p class="hint">@T("Your books' files in folders by author and title, as Calibre keeps them, each with a metadata.opf that Calibre and other programs read:") <a href="/books/export/folders" download>@T("download as folders")</a>.</p>
</section>

@if (nightly.Count > 0)
{
    <section class="panel" id="from-backup" aria-labelledby="from-backup-heading">
        <h2 id="from-backup-heading">@T("Bring back a book from a nightly backup")</h2>
        <p>@T("For a book deleted longer ago than the trash keeps things: find it in one of the shelf's nightly backups and bring it back with its notes, reading log, and the files the backup has. Nothing else on your shelf changes.")</p>
        <div class="inline-form">
            <label>
                @T("Backup")
                <select @bind="chosenBackup">
                    @foreach (var backup in nightly)
                    {
                        <option value="@backup.Name">@backup.TakenAt.Medium()@(backup.Verdict is { Ok: false } ? " · " + T("failed its check") : "")</option>
                    }
                </select>
            </label>
            <label>
                @T("Title or author (optional)")
                <input @bind="backupSearch" maxlength="100" />
            </label>
            <button type="button" @onclick="LookInBackup" disabled="@looking">@T("Look")</button>
        </div>
        @if (backupNote is not null)
        {
            <p class="@(backupProblem ? "validation-message" : "saved")" role="status">@backupNote</p>
        }
        @if (gone is not null)
        {
            @if (gone.Length == 0)
            {
                <p class="hint">@T("Every book of yours in that backup is on your shelf now.")</p>
            }
            else
            {
                <ul class="plain-list">
                    @foreach (var book in gone)
                    {
                        <li>
                            <strong>@book.Title</strong>
                            <span class="hint">@book.Author · @T("added {0}", book.AddedAt.Medium())</span>
                            <button type="button" @onclick="() => BringBack(book)" disabled="@looking">@T("Bring back")</button>
                        </li>
                    }
                </ul>
            }
        }
    </section>
}

<section class="panel" aria-labelledby="restore-heading">
    <h2 id="restore-heading">@T("Restore from a backup")</h2>
    <p>@T("Choose a zip made by Download everything. Its books are added to your shelf with their files.")</p>
    <form action="/books/import/full" method="post" enctype="multipart/form-data" data-enhance="false" data-upload>
        <label>
            @T("Zip backup")
            <input type="file" name="file" accept=".zip,application/zip" required />
        </label>
        <p class="hint">@T("A large backup takes a while to send. Keep this page open until it comes back with the result.")</p>
        <progress data-upload-progress max="100" hidden></progress>
        <p class="hint" data-upload-status role="status" hidden></p>
        <button type="submit" class="quiet">@T("Restore from this zip")</button>
    </form>
    @if (Restore == "done")
    {
        <p class="saved" role="status">@T("Restored. Added {0} with {1}, and skipped {2} already on your shelf.", Localization.Counts.Books(Added), Localization.Counts.Files(Files), Skipped)
            @if (Collections > 0 || Loans > 0)
            {
                @(" " + T("Brought back {0} collections and {1} past loans.", Collections, Loans))
            }
        </p>
        @if (Lost > 0)
        {
            <p class="validation-message" role="alert">@T("{0} files could not be brought back, as they were damaged in the download or there was no room for them. Their books are here without them.", Lost)</p>
        }
        @if (Damaged > 0)
        {
            <p class="validation-message" role="alert">@T("{0} files in the download did not match its manifest: they were damaged or changed after it was made. Bring back from another copy if you have one.", Damaged)</p>
        }
    }
    else if (Restore == "unreadable")
    {
        <p class="validation-message" role="alert">@T("That file is not a shelf backup zip, so nothing was added.")</p>
    }

    <h3>@T("From a JSON backup")</h3>
    <label>
        @T("JSON backup")
        <InputFile OnChange="ImportBackup" accept="application/json" />
    </label>
    @if (!string.IsNullOrWhiteSpace(importMessage))
    {
        <p class="@(imported ? "saved" : "validation-message")" role="status">@importMessage</p>
    }
</section>

<section class="panel" aria-labelledby="abs-heading">
    <h2 id="abs-heading">@T("Bring books from Audiobookshelf")</h2>
    <p>@T("Copy audiobooks and e-books from an Audiobookshelf server, with their covers, series, and where you stopped.")</p>
    <a class="button" href="/import/audiobookshelf">@T("Connect to Audiobookshelf")</a>
</section>

<section class="panel" aria-labelledby="calibre-heading">
    <h2 id="calibre-heading">@T("Bring books from Calibre")</h2>
    <p>@T("Copy a Calibre library on this server, with its files, covers, series, tags, and ratings. An admin can do it.")</p>
    <a class="button" href="/import/calibre">@T("Open a Calibre library")</a>
</section>

<section class="panel" id="csv" aria-labelledby="csv-heading">
    <h2 id="csv-heading">@T("Bring a library from Goodreads or StoryGraph")</h2>
    <p>@T("Export your library from Goodreads (My Books, then Import and export) or The StoryGraph (Manage account, then Export), and choose the CSV file here. Shelves, reading status, ratings, dates, reviews, and tags come along. A book already on your shelf in any edition, an audiobook too, isn't added again: its status, dates, rating, review, and tags fill in what it doesn't have yet.")</p>
    <form action="/books/import/csv" method="post" enctype="multipart/form-data" data-enhance="false" data-upload>
        <label>
            @T("CSV export")
            <input type="file" name="file" accept=".csv,text/csv" required />
        </label>
        <progress data-upload-progress max="100" hidden></progress>
        <p class="hint" data-upload-status role="status" hidden></p>
        <button type="submit" class="quiet">@T("Import this file")</button>
    </form>
    <p class="hint">@T("From another app or service?") <a href="/import/spreadsheet">@T("Bring in any spreadsheet")</a>, @T("choosing which column holds what.")</p>
    @if (Csv == "done")
    {
        <p class="saved" role="status">@T("Imported from {0}. Added {1}, filled in the reading of {2} already on your shelf, and skipped {3} with nothing new or missing a title or author.", Source == "StoryGraph" ? "The StoryGraph" : "Goodreads", Localization.Counts.Books(Added), Updated, Skipped)</p>
    }
    else if (Csv == "unreadable")
    {
        <p class="validation-message" role="alert">@T("That file is not a Goodreads or StoryGraph export, so nothing was added.")</p>
    }
</section>

<p class="hint">@T("An admin can also keep a snapshot of the whole server, every reader included, from") <a href="/admin">@T("Readers")</a>.</p>

@code {
    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions = new(System.Text.Json.JsonSerializerDefaults.Web)
    {
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() },
    };

    // A backup holds every book, quote, and session, so a large shelf runs well past a megabyte.
    private const long MaxBackupBytes = 50L * 1024 * 1024;

    private List<BackupWithVerdict> nightly = [];
    private string? chosenBackup;
    private string? backupSearch;
    private BackupBook[]? gone;
    private string? backupNote;
    private bool backupProblem;
    private bool looking;

    protected override void OnInitialized()
    {
        nightly = [.. Backups.List()];
        chosenBackup = nightly.FirstOrDefault(backup => backup.Verdict is not { Ok: false })?.Name ?? nightly.FirstOrDefault()?.Name;
    }

    private async Task LookInBackup()
    {
        if (chosenBackup is null)
        {
            return;
        }

        looking = true;
        backupNote = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            gone = await Backups.GoneBooksAsync(db, chosenBackup, backupSearch);
            if (gone is null)
            {
                (backupProblem, backupNote) = (true, T("That backup cannot be looked in here. Only a backup of a shelf kept in SQLite can be."));
            }
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or Microsoft.Data.Sqlite.SqliteException)
        {
            (backupProblem, backupNote, gone) = (true, T("That backup could not be opened."), null);
        }
        finally
        {
            looking = false;
        }
    }

    private async Task BringBack(BackupBook book)
    {
        looking = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await Backups.RestoreBookAsync(db, chosenBackup!, book.Id);
            (backupProblem, backupNote) = result switch
            {
                { Restored: true } => (false, T("{0} is back on your shelf.", book.Title)),
                { Problem: { } why } => (true, why),
                _ => (true, T("That book is not in this backup.")),
            };
            gone = gone?.Where(item => item.Id != book.Id).ToArray();
        }
        finally
        {
            looking = false;
        }
    }

    private string? importMessage;
    private bool imported;

    [SupplyParameterFromQuery]
    public string? Restore { get; set; }

    [SupplyParameterFromQuery]
    public int Added { get; set; }

    [SupplyParameterFromQuery]
    public int Skipped { get; set; }

    [SupplyParameterFromQuery]
    public int Updated { get; set; }

    [SupplyParameterFromQuery]
    public int Damaged { get; set; }

    [SupplyParameterFromQuery]
    public int Lost { get; set; }

    [SupplyParameterFromQuery]
    public int Files { get; set; }

    [SupplyParameterFromQuery]
    public int Collections { get; set; }

    [SupplyParameterFromQuery]
    public int Loans { get; set; }

    [SupplyParameterFromQuery]
    public string? Csv { get; set; }

    [SupplyParameterFromQuery]
    public string? Source { get; set; }

    private async Task ImportBackup(InputFileChangeEventArgs change)
    {
        importMessage = null;
        imported = false;
        if (change.File.Size > MaxBackupBytes)
        {
            importMessage = T("That backup is larger than 50 MB, so nothing was added.");
            return;
        }

        try
        {
            await using var stream = change.File.OpenReadStream(MaxBackupBytes);
            var export = await System.Text.Json.JsonSerializer.DeserializeAsync<LibraryExport>(stream, JsonOptions);
            if (export?.Books is null)
            {
                importMessage = T("That file is not a shelf backup, so nothing was added.");
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await BookRules.ImportAsync(db, export);
            imported = true;
            importMessage = T("Restored. Added {0}, and skipped {1} already on your shelf.", Localization.Counts.Books(result.Added), result.Skipped);
        }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or IOException)
        {
            importMessage = T("That file is not a shelf backup, so nothing was added.");
        }
    }
}
