@implements IDisposable
@using Microsoft.JSInterop
<label>
    @T("Title")
    <InputText @bind-Value="Model.Title" maxlength="200" required />
    <ValidationMessage For="() => Model.Title" />
</label>
<label>
    @T("Subtitle")
    <InputText @bind-Value="Model.Subtitle" maxlength="200" />
</label>
<label>
    @T("Original title")
    <InputText @bind-Value="Model.OriginalTitle" maxlength="200" />
</label>
<label>
    @T("Author")
    <InputText @bind-Value="Model.Author" maxlength="200" required />
    <ValidationMessage For="() => Model.Author" />
</label>
<div class="pair">
    <label>
        @T("Year")
        <InputNumber @bind-Value="Model.Year" />
        <ValidationMessage For="() => Model.Year" />
    </label>
    <label>
        @T("Pages")
        <InputNumber @bind-Value="Model.Pages" />
        <ValidationMessage For="() => Model.Pages" />
    </label>
</div>
<div class="pair">
    <label>
        @T("Status")
        <InputSelect @bind-Value="Model.Status">
            @foreach (var status in Enum.GetValues<BookStatus>())
            {
                <option value="@status">@BookRules.StatusLabel(status)</option>
            }
        </InputSelect>
    </label>
    <label>
        @T("Rating")
        <InputNumber @bind-Value="Model.Rating" />
        <ValidationMessage For="() => Model.Rating" />
    </label>
</div>
<div class="pair">
    <label>
        @T("ISBN")
        <InputText @bind-Value="Model.Isbn" maxlength="32" spellcheck="false" />
    </label>
    <label>
        @T("Format")
        <InputSelect @bind-Value="Model.Format">
            <option value="">—</option>
            @foreach (var format in Enum.GetValues<BookFormat>())
            {
                <option value="@format">@BookRules.FormatLabel(format)</option>
            }
        </InputSelect>
    </label>
</div>
<div class="scan" @ref="scanArea">
    <button type="button" @onclick="LookUp" disabled="@looking">@(looking ? T("Looking…") : T("Look up"))</button>
    @* Shown, and handled, by scan.js once the page is live: a live camera where the page is secure, a photo elsewhere. *@
    <button type="button" class="quiet" data-scan hidden>@T("Scan the barcode")</button>
    <input type="file" accept="image/*" capture="environment" data-scan-photo hidden tabindex="-1" aria-hidden="true" />
    <span class="hint" data-scan-status role="status"></span>
</div>
@if (lookupNote is not null)
{
    <p class="hint">@lookupNote</p>
}
@if (Duplicate is Book existing)
{
    <p class="hint">@T("Already on the shelf:") <a href="/library/@existing.Id">@existing.Title</a>.</p>
}
else if (Borrowable.Length > 0)
{
    <p class="hint">@T("Another reader has this. You could borrow it instead of adding your own.")</p>
    <OpenCopies Copies="Borrowable" />
}
<div class="pair">
    <label>
        @T("Series")
        <InputText @bind-Value="Model.Series" maxlength="200" />
    </label>
    <label>
        @T("Number in series")
        <InputNumber @bind-Value="Model.SeriesNumber" />
        <ValidationMessage For="() => Model.SeriesNumber" />
    </label>
</div>
<div class="pair">
    <label>
        @T("Publisher")
        <InputText @bind-Value="Model.Publisher" maxlength="200" />
    </label>
    <label>
        @T("Language")
        <InputText @bind-Value="Model.Language" maxlength="40" />
    </label>
</div>
<label>
    @T("Tags")
    <InputText @bind-Value="Model.Tags" maxlength="400" />
    <span class="hint">@T("Comma separated. Stored in lowercase.")</span>
</label>
@if (Detailed)
{
    <div class="pair">
        <label>
            @T("Current page")
            <InputNumber @bind-Value="Model.CurrentPage" />
            <ValidationMessage For="() => Model.CurrentPage" />
        </label>
        <label>
            @T("Loaned to")
            <InputText @bind-Value="Model.LoanedTo" maxlength="120" />
        </label>
    </div>
    <div class="pair">
        <label>
            @T("Loaned on")
            <InputDate @bind-Value="Model.LoanedOn" />
        </label>
        <label>
            @T("Due back")
            <InputDate @bind-Value="Model.DueOn" />
        </label>
    </div>
    <label>
        @T("Cover address")
        <InputText @bind-Value="Model.CoverUrl" maxlength="500" spellcheck="false" />
    </label>
    <label class="check">
        <InputCheckbox @bind-Value="Model.Loved" />
        @T("Loved")
    </label>
    @if (Model.Status == BookStatus.Want)
    {
        <label class="check">
            <InputCheckbox @bind-Value="Model.Queued" />
            @T("Read next")
        </label>
    }
    <label>
        @T("Review")
        <InputTextArea @bind-Value="Model.Review" maxlength="4000" rows="4" />
    </label>
    <div class="pair">
        <label>
            @T("Started")
            <InputDate @bind-Value="Model.StartedOn" />
        </label>
        <label>
            @T("Finished")
            <InputDate @bind-Value="Model.FinishedOn" />
        </label>
    </div>
    <div class="pair">
        <label>
            @T("Where it sits")
            <InputText @bind-Value="Model.Location" maxlength="80" />
        </label>
        <label>
            @T("Acquired")
            <InputDate @bind-Value="Model.AcquiredOn" />
        </label>
    </div>
    <label>
        @T("How it arrived")
        <InputSelect @bind-Value="Model.Arrival">
            <option value="">—</option>
            @foreach (var arrived in Enum.GetValues<Acquisition>())
            {
                <option value="@arrived">@BookRules.AcquisitionLabel(arrived)</option>
            }
        </InputSelect>
    </label>
    <label>
        @T("Condition")
        <InputSelect @bind-Value="Model.Condition">
            <option value="">—</option>
            @foreach (var condition in Enum.GetValues<CopyCondition>())
            {
                <option value="@condition">@BookRules.ConditionLabel(condition)</option>
            }
        </InputSelect>
    </label>
    <div class="pair">
        <label>
            @T("Translator")
            <InputText @bind-Value="Model.Translator" maxlength="200" />
        </label>
        <label>
            @T("Recommended by")
            <InputText @bind-Value="Model.RecommendedBy" maxlength="120" />
        </label>
    </div>
    <label>
        @T("Narrator")
        <InputText @bind-Value="Model.Narrator" maxlength="200" />
    </label>
    <label>
        @T("Inscription")
        <InputTextArea @bind-Value="Model.Inscription" maxlength="500" rows="3" />
    </label>
}
<label>
    @T("Notes")
    <InputTextArea @bind-Value="Model.Notes" maxlength="4000" rows="4" />
    <ValidationMessage For="() => Model.Notes" />
</label>

@code {
    [Parameter, EditorRequired]
    public BookFormModel Model { get; set; } = default!;

    [Parameter]
    public bool Detailed { get; set; }

    // Looks the book up as soon as the form is on the page: for a book shared in with an ISBN or a title.
    [Parameter]
    public bool LookUpNow { get; set; }

    [Parameter]
    public IReadOnlyList<Book>? Shelf { get; set; }

    private Book? Duplicate => Shelf?.FirstOrDefault(book =>
        BookRules.IsSameCopy(Model.Isbn, Model.Title, Model.Author, book.Isbn, book.Title, book.Author));

    [Inject]
    public IDbContextFactory<ShelfDb> DbFactory { get; set; } = default!;

    // Adding a book (a Shelf is given only then): what other readers' open shelves hold, read once.
    private OpenCopy[] openCopies = [];

    private OpenCopy[] Borrowable => openCopies.Length == 0 ? [] : Asking.Matching(openCopies, Model.Isbn, Model.Title, Model.Author);

    protected override async Task OnInitializedAsync()
    {
        if (Shelf is not null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            openCopies = await Asking.OpenCopiesAsync(db);
        }
    }

    [Inject]
    public IBookLookup Lookup { get; set; } = default!;

    private bool looking;
    private string? lookupNote;

    [Inject]
    public IJSRuntime JS { get; set; } = default!;

    private ElementReference scanArea;
    private DotNetObjectReference<BookFields>? self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (LookUpNow && (!string.IsNullOrWhiteSpace(Model.Isbn) || (!string.IsNullOrWhiteSpace(Model.Title) && !string.IsNullOrWhiteSpace(Model.Author))))
        {
            await LookUp();
            StateHasChanged();
        }

        try
        {
            self = DotNetObjectReference.Create(this);
            var scan = await JS.InvokeAsync<IJSObjectReference>("import", "/scan.js");
            await scan.InvokeVoidAsync("attach", scanArea, self);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            // Without it, the ISBN is typed in as before.
        }
    }

    // A barcode read on the page: the ISBN goes in, and the rest is looked up from it.
    [JSInvokable]
    public async Task Scanned(string isbn)
    {
        Model.Isbn = isbn;
        await LookUp();
        StateHasChanged();
    }

    public void Dispose() => self?.Dispose();

    private async Task LookUp()
    {
        lookupNote = null;
        if (string.IsNullOrWhiteSpace(Model.Isbn)
            && (string.IsNullOrWhiteSpace(Model.Title) || string.IsNullOrWhiteSpace(Model.Author)))
        {
            lookupNote = T("Enter an ISBN, or a title and an author.");
            return;
        }

        looking = true;
        try
        {
            var match = await Lookup.FindAsync(Model.Isbn, Model.Title, Model.Author, CancellationToken.None);
            lookupNote = match is null
                ? T("Nothing matched.")
                : Model.FillBlanks(match) ? T("Filled the empty fields.") : T("Those fields are already filled.");
        }
        finally
        {
            looking = false;
        }
    }
}
