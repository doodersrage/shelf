<label>
    Title
    <InputText @bind-Value="Model.Title" maxlength="200" required />
    <ValidationMessage For="() => Model.Title" />
</label>
<label>
    Subtitle
    <InputText @bind-Value="Model.Subtitle" maxlength="200" />
</label>
<label>
    Original title
    <InputText @bind-Value="Model.OriginalTitle" maxlength="200" />
</label>
<label>
    Author
    <InputText @bind-Value="Model.Author" maxlength="200" required />
    <ValidationMessage For="() => Model.Author" />
</label>
<div class="pair">
    <label>
        Year
        <InputNumber @bind-Value="Model.Year" />
        <ValidationMessage For="() => Model.Year" />
    </label>
    <label>
        Pages
        <InputNumber @bind-Value="Model.Pages" />
        <ValidationMessage For="() => Model.Pages" />
    </label>
</div>
<div class="pair">
    <label>
        Status
        <InputSelect @bind-Value="Model.Status">
            @foreach (var status in Enum.GetValues<BookStatus>())
            {
                <option value="@status">@status</option>
            }
        </InputSelect>
    </label>
    <label>
        Rating
        <InputNumber @bind-Value="Model.Rating" />
        <ValidationMessage For="() => Model.Rating" />
    </label>
</div>
<div class="pair">
    <label>
        ISBN
        <InputText @bind-Value="Model.Isbn" maxlength="32" spellcheck="false" />
    </label>
    <label>
        Format
        <InputSelect @bind-Value="Model.Format">
            <option value="">—</option>
            @foreach (var format in Enum.GetValues<BookFormat>())
            {
                <option value="@format">@format</option>
            }
        </InputSelect>
    </label>
</div>
<button type="button" @onclick="LookUp" disabled="@looking">@(looking ? "Looking…" : "Look up")</button>
@if (lookupNote is not null)
{
    <p class="hint">@lookupNote</p>
}
@if (Duplicate is Book existing)
{
    <p class="hint">Already on the shelf: <a href="/library/@existing.Id">@existing.Title</a>.</p>
}
<div class="pair">
    <label>
        Series
        <InputText @bind-Value="Model.Series" maxlength="200" />
    </label>
    <label>
        Number in series
        <InputNumber @bind-Value="Model.SeriesNumber" />
        <ValidationMessage For="() => Model.SeriesNumber" />
    </label>
</div>
<div class="pair">
    <label>
        Publisher
        <InputText @bind-Value="Model.Publisher" maxlength="200" />
    </label>
    <label>
        Language
        <InputText @bind-Value="Model.Language" maxlength="40" />
    </label>
</div>
<label>
    Tags
    <InputText @bind-Value="Model.Tags" maxlength="400" />
    <span class="hint">Comma separated. Stored in lowercase.</span>
</label>
@if (Detailed)
{
    <div class="pair">
        <label>
            Current page
            <InputNumber @bind-Value="Model.CurrentPage" />
            <ValidationMessage For="() => Model.CurrentPage" />
        </label>
        <label>
            Loaned to
            <InputText @bind-Value="Model.LoanedTo" maxlength="120" />
        </label>
    </div>
    <div class="pair">
        <label>
            Loaned on
            <InputDate @bind-Value="Model.LoanedOn" />
        </label>
        <label>
            Cover address
            <InputText @bind-Value="Model.CoverUrl" maxlength="500" spellcheck="false" />
        </label>
    </div>
    <label class="check">
        <InputCheckbox @bind-Value="Model.Loved" />
        Loved
    </label>
    <label>
        Review
        <InputTextArea @bind-Value="Model.Review" maxlength="4000" rows="4" />
    </label>
    <div class="pair">
        <label>
            Started
            <InputDate @bind-Value="Model.StartedOn" />
        </label>
        <label>
            Finished
            <InputDate @bind-Value="Model.FinishedOn" />
        </label>
    </div>
    <div class="pair">
        <label>
            Where it sits
            <InputText @bind-Value="Model.Location" maxlength="80" />
        </label>
        <label>
            Acquired
            <InputDate @bind-Value="Model.AcquiredOn" />
        </label>
    </div>
    <div class="pair">
        <label>
            Translator
            <InputText @bind-Value="Model.Translator" maxlength="200" />
        </label>
        <label>
            Recommended by
            <InputText @bind-Value="Model.RecommendedBy" maxlength="120" />
        </label>
    </div>
}
<label>
    Notes
    <InputTextArea @bind-Value="Model.Notes" maxlength="4000" rows="4" />
    <ValidationMessage For="() => Model.Notes" />
</label>

@code {
    [Parameter, EditorRequired]
    public BookFormModel Model { get; set; } = default!;

    [Parameter]
    public bool Detailed { get; set; }

    [Parameter]
    public IReadOnlyList<Book>? Shelf { get; set; }

    private Book? Duplicate => Shelf?.FirstOrDefault(book =>
        BookRules.IsSameCopy(Model.Isbn, Model.Title, Model.Author, book.Isbn, book.Title, book.Author));

    [Inject]
    public IBookLookup Lookup { get; set; } = default!;

    private bool looking;
    private string? lookupNote;

    private async Task LookUp()
    {
        lookupNote = null;
        if (string.IsNullOrWhiteSpace(Model.Isbn)
            && (string.IsNullOrWhiteSpace(Model.Title) || string.IsNullOrWhiteSpace(Model.Author)))
        {
            lookupNote = "Enter an ISBN, or a title and an author.";
            return;
        }

        looking = true;
        try
        {
            var match = await Lookup.FindAsync(Model.Isbn, Model.Title, Model.Author, CancellationToken.None);
            lookupNote = match is null
                ? "Nothing matched."
                : Model.FillBlanks(match) ? "Filled the empty fields." : "Those fields are already filled.";
        }
        finally
        {
            looking = false;
        }
    }
}
