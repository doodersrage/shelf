@page "/library/{Id:int}/read"
@rendermode InteractiveServer
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IDbContextFactory<ShelfDb> DbFactory
@inject EbookStore Ebooks
@inject IJSRuntime Js

<PageTitle>@(book?.Title ?? "Shelf")</PageTitle>

@if (missing)
{
    <h1>Not on the shelf</h1>
    <p>That book is not here. <a href="/">Back to the library</a></p>
}
else if (book is not null)
{
    <div class="reader">
        @if (borrowed)
        {
            <p class="hint"><a href="/loans">Loans</a> · lent to you</p>
        }
        else
        {
            <p class="hint"><a href="/library/@book.Id">@book.Title</a></p>
        }
        <h1>@book.Title</h1>
        @if (string.IsNullOrWhiteSpace(book.EbookStoredName))
        {
            <p>This book has no e-book file.@if (!borrowed) { <text> <a href="/library/@book.Id">Add one</a></text> }</p>
        }
        else if (EbookStore.IsPdf(book.EbookStoredName))
        {
            <div class="reader-nav">
                <button type="button" @onclick="() => ShowPdfPage(pdfIndex - 1)" disabled="@(pdfIndex <= 0)">Previous</button>
                <span class="hint" aria-live="polite">@(pdfPages == 0 ? "Opening…" : $"Page {pdfIndex + 1} of {pdfPages}")</span>
                <button type="button" @onclick="() => ShowPdfPage(pdfIndex + 1)" disabled="@(pdfPages == 0 || pdfIndex >= pdfPages - 1)">Next</button>
                <label>
                    Text size
                    <select @bind="type.Size" @bind:after="SaveType">
                        <option value="85">Smaller</option>
                        <option value="100">Fit the width</option>
                        <option value="115">Larger</option>
                        <option value="130">Large</option>
                        <option value="150">Largest</option>
                    </select>
                </label>
            </div>
            @ReadAloud
            @Passage
            @if (ScanNote is string scanNote)
            {
                <p class="hint" role="status">@scanNote</p>
            }
            <div class="pdf-viewer" @ref="pdfHost" tabindex="0" role="region" aria-label="@($"{book.Title}, page {pdfIndex + 1}. Use the arrow keys to turn pages.")"></div>
            @if (pdfFailed)
            {
                <p class="validation-message" role="alert">This PDF could not be drawn here. <a href="/books/@book.Id/ebook/file">Open the file itself</a></p>
            }
            <p class="hint">A PDF keeps its own layout, so only its size changes. <a href="/books/@book.Id/ebook/file">Open the file itself</a></p>
            @MarkList("On this page")
        }
        else if (EbookStore.IsComic(book.EbookStoredName))
        {
            @if (comicPages == 0)
            {
                <p>This comic could not be opened. <a href="/books/@book.Id/ebook/file">Download the file</a></p>
            }
            else
            {
                <div class="reader-nav">
                    <button type="button" @onclick="PreviousPage" disabled="@(chapter == 0)">Previous</button>
                    <span class="hint" aria-live="polite">Page @(chapter + 1) of @comicPages</span>
                    <button type="button" @onclick="NextPage" disabled="@(chapter >= comicPages - 1)">Next</button>
                </div>
                <div class="comic-viewer" tabindex="0" role="region" @onkeydown="ComicKey"
                     aria-label="@($"{book.Title}, page {chapter + 1} of {comicPages}. Use the arrow keys to turn pages.")">
                    <img src="/books/@book.Id/ebook/pages/@chapter" alt="@($"Page {chapter + 1}")" />
                    @if (chapter < comicPages - 1)
                    {
                        <img src="/books/@book.Id/ebook/pages/@(chapter + 1)" alt="" hidden />
                    }
                </div>
                <p class="hint"><a href="/books/@book.Id/ebook/file">Download the comic</a></p>
            }
        }
        else if (chapters is null)
        {
            <p>This EPUB could not be opened.</p>
        }
        else if (chapters.Count == 0)
        {
            <p>This EPUB has no chapters.</p>
        }
        else
        {
            <div class="reader-nav">
                <button type="button" @onclick="Previous" disabled="@(chapter == 0)">Previous</button>
                <label>
                    Chapter
                    <select @bind="chapter" @bind:after="RememberChapter">
                        @foreach (var item in chapters)
                        {
                            <option value="@item.Index">@item.Title</option>
                        }
                    </select>
                </label>
                <button type="button" @onclick="Next" disabled="@(chapter >= chapters.Count - 1)">Next</button>
            </div>
            <details>
                <summary>Text settings</summary>
                <div class="reader-settings">
                    <label>
                        Text size
                        <select @bind="type.Size" @bind:after="SaveType">
                            <option value="85">Smaller</option>
                            <option value="100">Default</option>
                            <option value="115">Larger</option>
                            <option value="130">Large</option>
                            <option value="150">Largest</option>
                        </select>
                    </label>
                    <label>
                        Line spacing
                        <select @bind="type.Leading" @bind:after="SaveType">
                            <option value="140">Snug</option>
                            <option value="160">Comfortable</option>
                            <option value="190">Airy</option>
                        </select>
                    </label>
                    <label>
                        Reading width
                        <select @bind="type.Width" @bind:after="SaveType">
                            <option value="30">Narrow</option>
                            <option value="38">Medium</option>
                            <option value="50">Wide</option>
                        </select>
                    </label>
                </div>
            </details>
            @ReadAloud
            @Passage
            <iframe @key="@($"{chapter}:{markRevision}:{typeRevision}")" class="reader-frame" title="@chapters[chapter].Title" src="/books/@book.Id/ebook/chapters/@chapter?t=@typeRevision"></iframe>
            @MarkList("In this chapter")
        }
    </div>
}

@code {
    private Book? book;
    private OpenBook? open;
    private bool borrowed;
    private bool missing;
    private TypeForm type = new();
    private ElementReference pdfHost;
    private IJSObjectReference? pdf;
    private int pdfIndex;
    private int pdfPages;
    private bool pdfFailed;
    private string pdfKind = "text";

    private string? ScanNote => pdfKind switch
    {
        "read" => "This page is a scan. Shelf read its words, so you can select and highlight them.",
        "reading" => "This page is a scan. Shelf is reading its words, and they appear here when they are ready.",
        "unavailable" => "This page is a scan. To select its words, install Tesseract and Poppler on the server.",
        "scan" => "This page is a picture with no words Shelf could read.",
        _ => null,
    };
    private int typeRevision;
    private int chapter;
    private int markRevision;
    private IReadOnlyList<EpubChapter>? chapters;
    private List<Highlight> marks = [];
    private string selectedText = "";
    private string selectedPrefix = "";
    private string selectedSuffix = "";
    private string selectedNote = "";
    private int? editingId;
    private string? markError;
    private IJSObjectReference? reader;
    private DotNetObjectReference<Read>? self;
    // A highlight's ChapterIndex is the chapter of an EPUB, or the page of a PDF.
    private bool IsPdf => EbookStore.IsPdf(book?.EbookStoredName);

    private int Here => IsPdf ? pdfIndex : chapter;

    private List<Highlight> ChapterMarks => marks.Where(mark => mark.ChapterIndex == Here).ToList();

    private RenderFragment Passage => @<text>
        @if (!string.IsNullOrWhiteSpace(selectedText))
        {
            <blockquote class="passage"><p>@selectedText</p></blockquote>
            <label>
                Note
                <textarea @bind="selectedNote" @bind:event="oninput" maxlength="2000" rows="3"></textarea>
            </label>
            <p>
                <button type="button" class="primary" @onclick="SaveHighlight">@(editingId is null ? "Highlight" : "Save the note")</button>
                <button type="button" @onclick="ClearSelection">Cancel</button>
            </p>
            @if (markError is not null)
            {
                <p class="validation-message" role="alert">@markError</p>
            }
        }
        else
        {
            <p class="hint">Select a passage to highlight it and keep a note with it.</p>
        }
    </text>;

    private RenderFragment MarkList(string heading) => @<text>
        @if (ChapterMarks.Count > 0)
        {
            <h2>@heading</h2>
            <ul class="quotes">
                @foreach (var mark in ChapterMarks)
                {
                    <li>
                        <blockquote><p>@mark.Text</p></blockquote>
                        @if (!string.IsNullOrWhiteSpace(mark.Note))
                        {
                            <p>@mark.Note</p>
                        }
                        <button type="button" @onclick="() => Edit(mark)">Note</button>
                        <button type="button" @onclick="() => RemoveMark(mark.Id)">Remove</button>
                    </li>
                }
            </ul>
        }
    </text>;

    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "chapter")]
    public int? ChapterQuery { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        open = await Lending.OpenAsync(db, Id);
        book = open?.Book;
        borrowed = open?.Borrowed == true;
        missing = book is null;
        chapters = null;
        chapter = 0;
        if (open is not null)
        {
            var saved = await BookRules.GetReaderTypeAsync(db);
            type = new TypeForm { Size = saved.Size, Leading = saved.Leading, Width = saved.Width };
            pdfIndex = Math.Max(0, ChapterQuery ?? (await Lending.PlaceAsync(db, open)).EbookChapter ?? 0);
            marks = await Lending.Marks(db, open).AsNoTracking()
                .OrderBy(item => item.Id)
                .ToListAsync();
        }

        if (book is not null && EbookStore.IsComic(book.EbookStoredName))
        {
            comicPages = ComicFile.Pages(Ebooks.OpenPath(book.EbookStoredName)).Count;
            chapter = Math.Clamp(ChapterQuery ?? (await Lending.PlaceAsync(db, open!)).EbookChapter ?? 0, 0, Math.Max(0, comicPages - 1));
            return;
        }

        if (book is null || !EbookStore.IsEpub(book.EbookStoredName))
        {
            return;
        }

        var path = Ebooks.OpenPath(book.EbookStoredName);
        chapters = path is null ? null : EpubFile.Chapters(path);

        if (chapters is { Count: > 0 })
        {
            var place = ChapterQuery ?? (await Lending.PlaceAsync(db, open!)).EbookChapter ?? 0;
            chapter = place >= 0 && place < chapters.Count ? place : 0;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pdf is null && !pdfFailed && book is not null && EbookStore.IsPdf(book.EbookStoredName))
        {
            self ??= DotNetObjectReference.Create(this);
            try
            {
                pdf = await Js.InvokeAsync<IJSObjectReference>("import", "./pdf-reader.js");
                await pdf.InvokeAsync<int>("open", pdfHost, $"/books/{book.Id}/ebook/file", pdfIndex, type.Size, self, PdfMarks(), $"/books/{book.Id}/ebook/ocr/");
            }
            catch (JSException)
            {
                pdfFailed = true;
                StateHasChanged();
            }
        }

        if (!firstRender || reader is not null)
        {
            return;
        }

        self ??= DotNetObjectReference.Create(this);
        reader = await Js.InvokeAsync<IJSObjectReference>("import", "./reader.js");
        await reader.InvokeVoidAsync("listen", self);

        if (book is not null && (EbookStore.IsEpub(book.EbookStoredName) || IsPdf))
        {
            speech = await Js.InvokeAsync<IJSObjectReference>("import", "./speak.js");
            speechSupported = await speech.InvokeAsync<bool>("supported");
            if (speechSupported)
            {
                var prefs = await speech.InvokeAsync<SpeechPrefs>("prefs");
                speechRate = prefs.Rate.ToString(System.Globalization.CultureInfo.InvariantCulture);
                speechVoice = prefs.Voice;
                StateHasChanged();
                speechVoices = (await speech.InvokeAsync<List<SpeechVoice>>("voices"))
                    .OrderBy(voice => !voice.Lang.StartsWith(System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName, StringComparison.OrdinalIgnoreCase))
                    .ThenBy(voice => voice.Name)
                    .ToList();
                if (!new[] { "0.8", "1", "1.2", "1.5" }.Contains(speechRate))
                {
                    speechRate = "1";
                }

                StateHasChanged();
            }
        }
    }

    public sealed record SpeechPrefs(double Rate, string Voice);

    [JSInvokable]
    public void Selected(string text, string prefix, string suffix)
    {
        selectedText = text ?? "";
        selectedPrefix = prefix ?? "";
        selectedSuffix = suffix ?? "";
        selectedNote = "";
        editingId = null;
        markError = null;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OpenMark(int id)
    {
        var mark = marks.FirstOrDefault(item => item.Id == id);
        if (mark is null)
        {
            return;
        }

        Edit(mark);
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task Previous()
    {
        if (chapter == 0)
        {
            return;
        }

        chapter--;
        await RememberChapter();
    }

    private async Task Next()
    {
        if (chapters is null || chapter >= chapters.Count - 1)
        {
            return;
        }

        chapter++;
        await RememberChapter();
    }

    private int comicPages;

    // Read aloud, with the browser's voices.
    private IJSObjectReference? speech;
    private bool speechSupported;
    private string speechState = "idle";
    private string speechRate = "1";
    private string speechVoice = "";
    private List<SpeechVoice> speechVoices = [];
    private string? nowSpeaking;
    private bool advancing;

    public sealed record SpeechVoice(string Name, string Lang);

    private RenderFragment ReadAloud => @<text>
        @if (speechSupported)
        {
            <div class="read-aloud">
                @if (speechState == "idle")
                {
                    <button type="button" @onclick="StartReading">Read aloud</button>
                }
                else if (speechState == "speaking")
                {
                    <button type="button" @onclick="PauseReading">Pause</button>
                    <button type="button" class="quiet" @onclick="StopReading">Stop</button>
                }
                else
                {
                    <button type="button" @onclick="ResumeReading">Resume</button>
                    <button type="button" class="quiet" @onclick="StopReading">Stop</button>
                }
                <label>
                    Speed
                    <select @bind="speechRate" @bind:after="SpeechChanged">
                        <option value="0.8">Slower</option>
                        <option value="1">Normal</option>
                        <option value="1.2">Faster</option>
                        <option value="1.5">Fastest</option>
                    </select>
                </label>
                @if (speechVoices.Count > 0)
                {
                    <label>
                        Voice
                        <select @bind="speechVoice" @bind:after="SpeechChanged">
                            <option value="">The browser's choice</option>
                            @foreach (var voice in speechVoices)
                            {
                                <option value="@voice.Name">@voice.Name (@voice.Lang)</option>
                            }
                        </select>
                    </label>
                }
                @if (speechState != "idle" && nowSpeaking is not null)
                {
                    <p class="hint now-speaking">@nowSpeaking</p>
                }
            </div>
        }
    </text>;

    private object SpeechSource() => IsPdf
        ? new { page = true }
        : new { chapter = $"/books/{book!.Id}/ebook/chapters/{chapter}" };

    private async Task StartReading()
    {
        if (speech is null || book is null)
        {
            return;
        }

        speechState = "speaking";
        await speech.InvokeVoidAsync("start", self, SpeechSource(), new { rate = double.Parse(speechRate, System.Globalization.CultureInfo.InvariantCulture), voice = speechVoice });
    }

    private async Task PauseReading()
    {
        speechState = "paused";
        if (speech is not null)
        {
            await speech.InvokeVoidAsync("pause");
        }
    }

    private async Task ResumeReading()
    {
        speechState = "speaking";
        if (speech is not null)
        {
            await speech.InvokeVoidAsync("resume");
        }
    }

    private async Task StopReading()
    {
        speechState = "idle";
        nowSpeaking = null;
        if (speech is not null)
        {
            await speech.InvokeVoidAsync("stop");
        }
    }

    // A new speed or voice takes over from the next sentence on.
    private async Task SpeechChanged()
    {
        if (speech is null)
        {
            return;
        }

        await speech.InvokeVoidAsync("savePrefs", double.Parse(speechRate, System.Globalization.CultureInfo.InvariantCulture), speechVoice);
    }

    [JSInvokable]
    public Task Speaking(string text)
    {
        nowSpeaking = text;
        return InvokeAsync(StateHasChanged);
    }

    // The end of a chapter or page: go on to the next one, as an audiobook would.
    [JSInvokable]
    public Task SpokenToEnd() => InvokeAsync(async () =>
    {
        if (speechState != "speaking")
        {
            return;
        }

        if (IsPdf && pdfIndex < pdfPages - 1)
        {
            advancing = true;
            await ShowPdfPage(pdfIndex + 1);
        }
        else if (!IsPdf && chapters is not null && chapter < chapters.Count - 1)
        {
            advancing = true;
            chapter++;
            await RememberChapter();
            advancing = false;
            StateHasChanged();
            await StartReading();
        }
        else
        {
            speechState = "idle";
            nowSpeaking = null;
            StateHasChanged();
        }
    });

    private async Task PreviousPage()
    {
        if (chapter > 0)
        {
            chapter--;
            await RememberChapter();
        }
    }

    private async Task NextPage()
    {
        if (chapter < comicPages - 1)
        {
            chapter++;
            await RememberChapter();
        }
    }

    private async Task ComicKey(KeyboardEventArgs key)
    {
        switch (key.Key)
        {
            case "ArrowRight" or "PageDown" or " ":
                await NextPage();
                break;
            case "ArrowLeft" or "PageUp":
                await PreviousPage();
                break;
        }
    }

    private async Task RememberChapter()
    {
        if (!advancing && speechState != "idle")
        {
            await StopReading();
        }

        ClearSelection();
        if (open is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await Lending.KeepPlaceAsync(db, open, place => place.EbookChapter = chapter);
    }

    private void Edit(Highlight mark)
    {
        editingId = mark.Id;
        selectedText = mark.Text;
        selectedPrefix = mark.Prefix ?? "";
        selectedSuffix = mark.Suffix ?? "";
        selectedNote = mark.Note ?? "";
        markError = null;
    }

    private void ClearSelection()
    {
        selectedText = "";
        selectedPrefix = "";
        selectedSuffix = "";
        selectedNote = "";
        editingId = null;
        markError = null;
    }

    private async Task SaveHighlight()
    {
        markError = null;
        if (open is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (editingId is int id)
        {
            var existing = await Lending.Marks(db, open).FirstOrDefaultAsync(item => item.Id == id);
            if (existing is null)
            {
                return;
            }

            if (selectedNote.Trim().Length > 2000)
            {
                markError = "Keep the note to 2000 characters.";
                return;
            }

            existing.Note = string.IsNullOrWhiteSpace(selectedNote) ? null : selectedNote.Trim();
            await db.SaveChangesAsync();
        }
        else
        {
            var request = new CreateHighlightRequest(selectedText, Here, selectedNote, selectedPrefix, selectedSuffix);
            var problems = BookRules.ValidateHighlight(request);
            if (problems is not null)
            {
                markError = problems.Values.SelectMany(item => item).FirstOrDefault();
                return;
            }

            db.Highlights.Add(Lending.NewMark(
                db,
                open,
                Here,
                selectedText.Trim(),
                string.IsNullOrWhiteSpace(selectedNote) ? null : selectedNote.Trim(),
                selectedPrefix.Length <= 80 ? NullIfEmpty(selectedPrefix) : selectedPrefix[^80..],
                selectedSuffix.Length <= 80 ? NullIfEmpty(selectedSuffix) : selectedSuffix[..80]));
            await db.SaveChangesAsync();
        }

        ClearSelection();
        markRevision++;
        await ReloadMarks();
    }

    private async Task RemoveMark(int id)
    {
        if (open is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await Lending.Marks(db, open).FirstOrDefaultAsync(item => item.Id == id);
        if (existing is null)
        {
            return;
        }

        db.Highlights.Remove(existing);
        await db.SaveChangesAsync();
        if (editingId == id)
        {
            ClearSelection();
        }

        markRevision++;
        await ReloadMarks();
    }

    private async Task ReloadMarks()
    {
        if (open is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        marks = await Lending.Marks(db, open).AsNoTracking()
            .OrderBy(item => item.Id)
            .ToListAsync();
        if (pdf is not null)
        {
            await pdf.InvokeVoidAsync("marks", PdfMarks());
        }
    }

    // What the PDF viewer needs to find and paint each passage on its page. A list, not an array,
    // so the interop call passes it as one argument instead of spreading it into many.
    private List<object> PdfMarks() => marks
        .Select(mark => (object)new { id = mark.Id, page = mark.ChapterIndex, text = mark.Text, prefix = mark.Prefix ?? "", suffix = mark.Suffix ?? "", note = mark.Note ?? "" })
        .ToList();

    public async ValueTask DisposeAsync()
    {
        if (pdf is not null)
        {
            try
            {
                await pdf.InvokeVoidAsync("close");
                await pdf.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (reader is not null)
        {
            try
            {
                await reader.InvokeVoidAsync("stop");
                await reader.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (speech is not null)
        {
            try
            {
                await speech.InvokeVoidAsync("stop");
                await speech.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        self?.Dispose();
    }

    private static string? NullIfEmpty(string value) => string.IsNullOrEmpty(value) ? null : value;

    // Saved for the reader, so the next book and the next device open the same way.
    private async Task SaveType()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await BookRules.SetReaderTypeAsync(db, new ReaderType(type.Size, type.Leading, type.Width));
        typeRevision++;
        if (pdf is not null)
        {
            await pdf.InvokeVoidAsync("zoom", type.Size);
        }
    }

    private async Task ShowPdfPage(int index)
    {
        if (pdf is not null)
        {
            await pdf.InvokeVoidAsync("show", index);
        }
    }

    // Whether the page showing has its own text, words read from a scan, or neither yet.
    [JSInvokable]
    public Task PdfPageKind(string kind)
    {
        pdfKind = kind;
        return InvokeAsync(StateHasChanged);
    }

    // The PDF module reports each page it shows; the place is kept as for an EPUB chapter.
    [JSInvokable]
    public async Task PdfShown(int index, int total)
    {
        var moved = index != pdfIndex;
        pdfIndex = index;
        pdfPages = total;
        if (moved && open is not null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await Lending.KeepPlaceAsync(db, open, place => place.EbookChapter = index);
        }

        // Reading aloud goes on into the page it turned to; a page turned by hand stops it.
        if (advancing)
        {
            advancing = false;
            await InvokeAsync(StartReading);
        }
        else if (moved && speechState != "idle")
        {
            await InvokeAsync(StopReading);
        }

        await InvokeAsync(StateHasChanged);
    }

    private sealed class TypeForm
    {
        public int Size { get; set; } = ReaderType.DefaultSize;
        public int Leading { get; set; } = ReaderType.DefaultLeading;
        public int Width { get; set; } = ReaderType.DefaultWidth;
    }
}
