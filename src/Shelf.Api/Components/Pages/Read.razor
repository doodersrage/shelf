@page "/library/{Id:int}/read"
@rendermode InteractiveServer
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IDbContextFactory<ShelfDb> DbFactory
@inject EbookStore Ebooks
@inject IJSRuntime Js
@inject AudioStore Audio
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Caching.Memory.IMemoryCache Cache
@inject IWordLookup Dictionary
@inject IConfiguration Configuration
@inject ReadAlongService ReadAlongs

<PageTitle>@(book?.Title ?? "Shelf")</PageTitle>

@if (missing)
{
    <h1>@T("Not on the shelf")</h1>
    <p>@T("That book is not here.") <a href="/library">@T("Back to the library")</a></p>
}
else if (book is not null)
{
    @* The book's own title is the way back; the settings fold into a menu so the page starts with the text. *@
    <div class="reader" data-theme="@(type.Theme.Length > 0 ? type.Theme : null)">
        <div class="reader-head">
            @if (borrowed)
            {
                <p class="hint reader-back"><a href="/loans">@T("Loans")</a> · @T("lent to you")</p>
            }
            else
            {
                <p class="reader-back"><a href="/library/@book.Id">@book.Title</a></p>
            }
            @if (chapters is { Count: > 0 } && !IsPdf && !EbookStore.IsComic(book.EbookStoredName))
            {
                @if (!full)
                {
                    @TextSettings
                }
            }
        </div>
        <h1 class="visually-hidden">@book.Title</h1>
        @if (string.IsNullOrWhiteSpace(book.EbookStoredName))
        {
            <p>@T("This book has no e-book file.")@if (!borrowed) { <text> <a href="/library/@book.Id">@T("Add one")</a></text> }</p>
        }
        else if (EbookStore.IsPdf(book.EbookStoredName))
        {
            <div class="reader-nav">
                <button type="button" @onclick="() => ShowPdfPage(pdfIndex - 1)" disabled="@(pdfIndex <= 0)">@T("Previous")</button>
                <span class="hint" aria-live="polite">@(pdfPages == 0 ? T("Opening…") : T("Page {0} of {1}", pdfIndex + 1, pdfPages))</span>
                <button type="button" @onclick="() => ShowPdfPage(pdfIndex + 1)" disabled="@(pdfPages == 0 || pdfIndex >= pdfPages - 1)">@T("Next")</button>
                <label>
                    @T("Text size")
                    <select @bind="type.Size" @bind:after="SaveType">
                        <option value="85">@T("Smaller")</option>
                        <option value="100">@T("Fit the width")</option>
                        <option value="115">@T("Larger")</option>
                        <option value="130">@T("Large")</option>
                        <option value="150">@T("Largest")</option>
                    </select>
                </label>
            </div>
            @ReadAloud
            @Passage
            @if (ScanNote is string scanNote)
            {
                <p class="hint" role="status">@scanNote</p>
            }
            <div class="pdf-viewer" @ref="pdfHost" tabindex="0" role="region" aria-label="@T("{0}, page {1}. Use the arrow keys to turn pages.", book.Title, pdfIndex + 1)"></div>
            @if (pdfFailed)
            {
                <p class="validation-message" role="alert">@T("This PDF could not be drawn here.") <a href="/books/@book.Id/ebook/file">@T("Open the file itself")</a></p>
            }
            <p class="hint">@T("A PDF keeps its own layout, so only its size changes.") <a href="/books/@book.Id/ebook/file">@T("Open the file itself")</a></p>
            @MarkList(T("On this page"))
        }
        else if (EbookStore.IsComic(book.EbookStoredName))
        {
            @if (comicPages == 0)
            {
                <p>@T("This comic could not be opened.") <a href="/books/@book.Id/ebook/file">@T("Download the file")</a></p>
            }
            else
            {
                var (first, count) = ComicFile.Spread(chapter, comicPages, comicSpread);
                <div class="reader-nav @(comicRtl ? "rtl" : "")">
                    <button type="button" @onclick="PreviousPage" disabled="@(chapter == 0)">@T("Previous")</button>
                    <span class="hint" aria-live="polite">@(count == 2 ? T("Pages {0} and {1} of {2}", first + 1, first + 2, comicPages) : T("Page {0} of {1}", first + 1, comicPages))</span>
                    <button type="button" @onclick="NextPage" disabled="@(first + count >= comicPages)">@T("Next")</button>
                </div>
                <div class="comic-settings">
                    <label class="check"><input type="checkbox" checked="@comicRtl" @onchange="ChangeRtl" /> @T("Right to left, as manga")</label>
                    <label class="check"><input type="checkbox" checked="@comicSpread" @onchange="ChangeSpread" /> @T("Two pages at a time")</label>
                </div>
                <div class="comic-viewer @(count == 2 ? "spread" : "") @(comicRtl ? "rtl" : "")" tabindex="0" role="region" @onkeydown="ComicKey"
                     aria-label="@T("{0}, page {1} of {2}. Use the arrow keys to turn pages.", book.Title, first + 1, comicPages)">
                    @for (var shown = first; shown < first + count; shown++)
                    {
                        <img src="/books/@book.Id/ebook/pages/@shown" alt="@T("Page {0}", shown + 1)" />
                    }
                    @if (first + count < comicPages)
                    {
                        <img src="/books/@book.Id/ebook/pages/@(first + count)" alt="" hidden />
                    }
                </div>
                <p class="hint"><a href="/books/@book.Id/ebook/file">@T("Download the comic")</a></p>
            }
        }
        else if (chapters is null)
        {
            <p>@T("This EPUB could not be opened.")</p>
        }
        else if (chapters.Count == 0)
        {
            <p>@T("This EPUB has no chapters.")</p>
        }
        else
        {
            <div class="reader-nav">
                @if (UseEngine)
                {
                    <button type="button" @onclick="() => TurnPage(-1)" aria-label="@T("Previous page")">‹ @T("Previous")</button>
                }
                else
                {
                    <button type="button" @onclick="Previous" disabled="@(chapter == 0)">@T("Previous")</button>
                }
                <label>
                    @T("Chapter")
                    <select @bind="chapter" @bind:after="RememberChapter">
                        @foreach (var item in chapters)
                        {
                            <option value="@item.Index">@item.Title</option>
                        }
                    </select>
                </label>
                @if (UseEngine)
                {
                    <button type="button" @onclick="() => TurnPage(1)" aria-label="@T("Next page")">@T("Next") ›</button>
                    @* Handled in the browser, in the tap itself, so the browser allows its own full screen. *@
                    <button type="button" class="quiet" data-full-toggle>@T("Full screen")</button>
                }
                else
                {
                    <button type="button" @onclick="Next" disabled="@(chapter >= chapters.Count - 1)">@T("Next")</button>
                }
                <span class="hint reader-where" aria-live="polite">@Where</span>
                @if (!string.IsNullOrWhiteSpace(book.AudioStoredName))
                {
                    <button type="button" class="quiet" @onclick="ContinueInAudio">@T("Continue in the audiobook")</button>
                }
                @if (alongChapters.Length > 0)
                {
                    <button type="button" class="@(alongOn ? "primary" : "quiet")" @onclick="ToggleAlong" aria-pressed="@(alongOn ? "true" : "false")">@(alongOn ? T("Stop listening along") : T("Listen along"))</button>
                }
            </div>
            <RecapPanel BookId="book.Id" Place="() => Task.FromResult(new RecapRequest(chapter, chapterAt))" />
            @if (alongOn)
            {
                <p class="hint" role="status">@T("The audiobook plays from the first word on the screen, and the word being read is marked. Double-tap a word to go there.")</p>
            }
            @if (alongNote is not null)
            {
                <p class="validation-message" role="alert">@alongNote</p>
            }
            @ReadAloud
            @Passage
            @if (UseEngine)
            {
                @* The whole book in one view, a page at a time or scrolled; epub.js draws it and epub-reader.js drives it. *@
                @* Full screen (epub-reader.js sets data-full), the page fills the screen and these bars come and go with a
                   tap in its middle, as in Audiobookshelf's reader. *@
                <div class="epub-stage" data-theme="@(type.Theme.Length > 0 ? type.Theme : null)">
                    <div class="epub-bar epub-top">
                        @if (full)
                        {
                            <button type="button" class="icon-button" data-full-toggle aria-label="@T("Leave full screen")">✕</button>
                            <span class="epub-title">@book.Title</span>
                            <label class="epub-chapter">
                                <span class="visually-hidden">@T("Chapter")</span>
                                <select @bind="chapter" @bind:after="RememberChapter">
                                    @foreach (var item in chapters)
                                    {
                                        <option value="@item.Index">@item.Title</option>
                                    }
                                </select>
                            </label>
                            @TextSettings
                        }
                    </div>
                    <div class="shelf-epub@(type.Paged ? " paged" : "")" @ref="epubHost" role="region" aria-label="@book.Title" data-theme="@(type.Theme.Length > 0 ? type.Theme : null)"></div>
                    <div class="epub-bar epub-bottom">
                        @if (full)
                        {
                            <span class="epub-where">@Where</span>
                            <input type="range" min="0" max="1000" step="1" value="@((int)Math.Round((bookShare ?? 0) * 1000))" disabled="@(bookShare is null)"
                                   aria-label="@T("Where in the book")" @onchange="JumpInBook" />
                        }
                    </div>
                </div>
                @if (engineFailed)
                {
                    <p class="validation-message" role="alert">@T("This EPUB could not be opened in the reader.") <a href="/library/@book.Id/read?classic=1">@T("Open it in the classic reader")</a></p>
                }
                <p class="hint reader-pages">
                    @(type.Paged ? T("Tap the sides, swipe, or use the arrow keys to turn.") : T("Scroll to read; the arrow keys go on a screen at a time."))
                    @T("F, or Full screen, fills the screen; tap the middle of the page there for the controls.")
                    · <a href="/library/@book.Id/read?classic=1">@T("Classic reader")</a>
                </p>
            }
            else
            {
                <iframe @key="@($"{chapter}:{markRevision}:{typeRevision}")" class="reader-frame@(type.Paged ? " paged" : "")" title="@chapters[chapter].Title" src="@FrameSrc" data-paged="@(type.Paged ? "true" : "false")"></iframe>
                @if (type.Paged && pages > 0)
                {
                    <p class="hint reader-pages" aria-live="polite">@T("Page {0} of {1} in this chapter", page, pages) · @T("Tap the sides, swipe, or use the arrow keys to turn.")</p>
                }
                @if (Classic == "1")
                {
                    <p class="hint"><a href="/library/@book.Id/read">@T("Back to the page-turning reader")</a></p>
                }
            }
            @MarkList(T("In this chapter"))
        }
    </div>
}

@code {
    // The type and page settings: under the title, and in the bar at the top of the full-screen reader.
    private RenderFragment TextSettings => @<details class="menu reader-menu">
            <summary class="button quiet"><span aria-hidden="true">Aa</span> <span class="reader-menu-label">@T("Text settings")</span></summary>
            <div class="menu-items reader-settings">
                <label>
                    @T("Page")
                    <select @bind="type.Theme" @bind:after="SaveType">
                        <option value="">@T("As the device")</option>
                        <option value="light">@T("Light")</option>
                        <option value="sepia">@T("Sepia")</option>
                        <option value="dark">@T("Dark")</option>
                    </select>
                </label>
                <label>
                    @T("Typeface")
                    <select @bind="type.Font" @bind:after="SaveType">
                        <option value="">@T("The book's own")</option>
                        <option value="serif">@T("Serif")</option>
                        <option value="sans">@T("Sans serif")</option>
                    </select>
                </label>
                <label>
                    @T("Text size")
                    <select @bind="type.Size" @bind:after="SaveType">
                        <option value="85">@T("Smaller")</option>
                        <option value="100">@T("Default")</option>
                        <option value="115">@T("Larger")</option>
                        <option value="130">@T("Large")</option>
                        <option value="150">@T("Largest")</option>
                    </select>
                </label>
                <label>
                    @T("Line spacing")
                    <select @bind="type.Leading" @bind:after="SaveType">
                        <option value="140">@T("Snug")</option>
                        <option value="160">@T("Comfortable")</option>
                        <option value="190">@T("Airy")</option>
                    </select>
                </label>
                <label>
                    @T("Layout")
                    <select @bind="Layout" @bind:after="SaveType">
                        <option value="scroll">@T("Scroll")</option>
                        <option value="pages">@T("Pages")</option>
                    </select>
                </label>
                <label>
                    @T("Reading width")
                    <select @bind="type.Width" @bind:after="SaveType">
                        <option value="30">@T("Narrow")</option>
                        <option value="38">@T("Medium")</option>
                        <option value="50">@T("Wide")</option>
                    </select>
                </label>
            </div>
        </details>;

    private Book? book;
    private OpenBook? open;
    private bool borrowed;
    private bool missing;
    private TypeForm type = new();
    private ElementReference pdfHost;
    private IJSObjectReference? pdf;
    private int pdfIndex;
    private int pdfPages;
    private bool pdfFailed;
    private string pdfKind = "text";

    private string? ScanNote => pdfKind switch
    {
        "read" => T("This page is a scan. Shelf read its words, so you can select and highlight them."),
        "reading" => T("This page is a scan. Shelf is reading its words, and they appear here when they are ready."),
        "unavailable" => T("This page is a scan. To select its words, install Tesseract and Poppler on the server."),
        "scan" => T("This page is a picture with no words Shelf could read."),
        _ => null,
    };
    private int typeRevision;
    private int chapter;
    private int markRevision;
    private IReadOnlyList<EpubChapter>? chapters;
    private List<Highlight> marks = [];
    private string selectedText = "";
    private string selectedPrefix = "";
    private string selectedSuffix = "";
    private string selectedNote = "";
    private int? editingId;
    private string? markError;
    private IJSObjectReference? reader;
    private IJSObjectReference? readingTime;
    private DotNetObjectReference<Read>? self;
    // A highlight's ChapterIndex is the chapter of an EPUB, or the page of a PDF.
    private bool IsPdf => EbookStore.IsPdf(book?.EbookStoredName);

    private int Here => IsPdf ? pdfIndex : chapter;

    private List<Highlight> ChapterMarks => marks.Where(mark => mark.ChapterIndex == Here).ToList();

    private RenderFragment Passage => @<text>
        @if (!string.IsNullOrWhiteSpace(selectedText))
        {
            <blockquote class="passage"><p>@selectedText</p></blockquote>
            <label>
                @T("Note")
                <textarea @bind="selectedNote" @bind:event="oninput" maxlength="2000" rows="3"></textarea>
            </label>
            <p>
                <button type="button" class="primary" @onclick="SaveHighlight">@(editingId is null ? T("Highlight") : T("Save the note"))</button>
                <button type="button" @onclick="ClearSelection">@T("Cancel")</button>
                @if (editingId is null && CanLookUp)
                {
                    <button type="button" class="quiet" @onclick="LookUp" disabled="@lookingUp">@(lookingUp ? T("Looking…") : T("Look up"))</button>
                }
            </p>
            @if (markError is not null)
            {
                <p class="validation-message" role="alert">@markError</p>
            }
            @if (meaning is not null)
            {
                <section class="look-up" aria-live="polite">
                    @if (meaning.Senses.Length > 0)
                    {
                        <h3>@meaning.Word</h3>
                        <ol>
                            @foreach (var sense in meaning.Senses)
                            {
                                <li><em>@sense.PartOfSpeech</em> @sense.Definition</li>
                            }
                        </ol>
                        @if (meaning.DictionaryUrl is not null)
                        {
                            <p class="hint"><a href="@meaning.DictionaryUrl" target="_blank" rel="noopener">@T("More in Wiktionary")</a></p>
                        }
                    }
                    @if (meaning.Summary is not null)
                    {
                        <h3>@meaning.SummaryTitle</h3>
                        <p>@meaning.Summary</p>
                        @if (meaning.EncyclopediaUrl is not null)
                        {
                            <p class="hint"><a href="@meaning.EncyclopediaUrl" target="_blank" rel="noopener">@T("Read more in Wikipedia")</a></p>
                        }
                    }
                </section>
            }
            else if (lookUpNote is not null)
            {
                <p class="hint" role="status">@lookUpNote</p>
            }
        }
        else
        {
            <p class="hint">@T("Select a passage to highlight it and keep a note with it.")</p>
        }
    </text>;

    private RenderFragment MarkList(string heading) => @<text>
        @if (ChapterMarks.Count > 0)
        {
            <h2>@heading</h2>
            <ul class="quotes">
                @foreach (var mark in ChapterMarks)
                {
                    <li>
                        <blockquote><p>@mark.Text</p></blockquote>
                        @if (!string.IsNullOrWhiteSpace(mark.Note))
                        {
                            <p>@mark.Note</p>
                        }
                        <button type="button" @onclick="() => Edit(mark)">@T("Note")</button>
                        <button type="button" @onclick="() => RemoveMark(mark.Id)">@T("Remove")</button>
                    </li>
                }
            </ul>
        }
    </text>;

    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "chapter")]
    public int? ChapterQuery { get; set; }

    // ?classic=1 opens the chapter-at-a-time reader, as Listen along does too.
    [SupplyParameterFromQuery(Name = "classic")]
    public string? Classic { get; set; }

    // The page-turning reader, on epub.js: the whole book in one view, the place kept to the word as an EPUB CFI.
    private bool UseEngine => chapters is { Count: > 0 } && Classic != "1" && !alongOn && book is not null && EbookStore.IsEpub(book.EbookStoredName);
    private ElementReference epubHost;
    private IJSObjectReference? epub;
    private bool engineOpen;
    private bool engineFailed;
    private string? savedCfi;
    private double? bookShare;
    private int? selectedChapter;

    private object MarkData => marks.Select(mark => new { id = mark.Id, chapter = mark.ChapterIndex, text = mark.Text, prefix = mark.Prefix, suffix = mark.Suffix }).ToList();

    private string Where
    {
        get
        {
            var where = T("Chapter {0} of {1}", chapter + 1, chapters?.Count ?? 0);
            if (UseEngine && type.Paged && pages > 1)
            {
                where += " · " + T("page {0} of {1}", page, pages);
            }

            if (UseEngine && bookShare is double share)
            {
                where += " · " + T("{0}% of the book", (int)Math.Round(share * 100));
            }

            return where;
        }
    }

    private async Task OpenEngineAsync()
    {
        if (book is null || chapters is null)
        {
            return;
        }

        self ??= DotNetObjectReference.Create(this);
        engineOpen = true;
        try
        {
            epub ??= await Js.InvokeAsync<IJSObjectReference>("import", "./epub-reader.js");
            await epub.InvokeVoidAsync("open", epubHost, new
            {
                url = $"/books/{book.Id}/ebook/file",
                key = $"{book.Id}-{book.EbookStoredName}",
                cfi = savedCfi,
                chapter,
                at = chapterAt,
                flow = type.Paged ? "paginated" : "scrolled",
                theme = type.Theme,
                font = type.Font,
                size = type.Size,
                leading = type.Leading,
                width = type.Width,
                hrefs = chapters.Select(item => item.Href).ToList(),
                titles = chapters.Select(item => item.Title).ToList(),
                title = book.Title,
                marks = MarkData,
            }, self);
        }
        catch (JSException)
        {
            engineFailed = true;
            StateHasChanged();
        }
    }

    // Where the reader is now: kept on the server as it changes, so any device opens there.
    [JSInvokable]
    public Task Relocated(string cfi, int index, double at, double share, int shown, int count) => InvokeAsync(async () =>
    {
        (chapter, chapterAt, page, pages, savedCfi) = (Math.Clamp(index, 0, Math.Max(0, (chapters?.Count ?? 1) - 1)), Math.Clamp(at, 0, 1), shown, count, cfi);
        if (share >= 0)
        {
            bookShare = Math.Clamp(share, 0, 1);
        }

        if (open is not null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var kept = chapter;
            await Lending.KeepPlaceAsync(db, open, place =>
            {
                place.EbookChapter = kept;
                place.EbookCfi = cfi.Length <= 1000 ? cfi : null;
                if (share >= 0)
                {
                    place.EbookProgress = Math.Clamp(share, 0, 1);
                }
            });
        }

        StateHasChanged();
    });

    [JSInvokable]
    public void SelectedIn(string text, string prefix, string suffix, int section)
    {
        Selected(text, prefix, suffix);
        selectedChapter = section;
    }

    private bool full;

    // Told by epub-reader.js when the reader goes full screen and back.
    [JSInvokable]
    public void FullChanged(bool on)
    {
        full = on;
        StateHasChanged();
    }

    // The slider in the full-screen reader's bar: anywhere in the book, by how far through it.
    private async Task JumpInBook(ChangeEventArgs args)
    {
        if (epub is not null && double.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value))
        {
            await epub.InvokeVoidAsync("goToShare", value / 1000);
        }
    }

    private async Task TurnPage(int step)
    {
        if (epub is not null)
        {
            await epub.InvokeVoidAsync(step > 0 ? "next" : "prev");
        }
    }

    // How far down the chapter to open it, from 0 to 1: the way in from the audiobook.
    [SupplyParameterFromQuery(Name = "at")]
    public double? AtQuery { get; set; }

    // How far down the chapter the reader is now, and how far down the frame opened it.
    private double chapterAt;
    private double frameAt;

    private string FrameSrc => $"/books/{book!.Id}/ebook/chapters/{chapter}?t={typeRevision}"
        + (frameAt > 0 ? "&at=" + frameAt.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) : "");

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        open = await Lending.OpenAsync(db, Id);
        book = open?.Book;
        borrowed = open?.Borrowed == true;
        missing = book is null;
        chapters = null;
        chapter = 0;
        if (open is not null)
        {
            var saved = await BookRules.GetReaderTypeAsync(db);
            type = new TypeForm { Size = saved.Size, Leading = saved.Leading, Width = saved.Width, Paged = saved.Paged, Theme = saved.Theme ?? "", Font = saved.Font ?? "" };
            var kept = await Lending.PlaceAsync(db, open);
            pdfIndex = Math.Max(0, ChapterQuery ?? kept.EbookChapter ?? 0);
            // A link to a chapter (from search, the audiobook, a recap) wins over the place kept.
            savedCfi = ChapterQuery is null ? kept.EbookCfi : null;
            bookShare = kept.EbookProgress;
            marks = await Lending.Marks(db, open).AsNoTracking()
                .OrderBy(item => item.Id)
                .ToListAsync();
        }

        if (book is not null && EbookStore.IsComic(book.EbookStoredName))
        {
            comicPages = ComicFile.Pages(Ebooks.OpenPath(book.EbookStoredName)).Count;
            comicRtl = book.ComicRightToLeft ?? ComicFile.IsRightToLeft(Ebooks.OpenPath(book.EbookStoredName));
            comicSpread = await BookRules.GetComicSpreadAsync(db);
            chapter = Math.Clamp(ChapterQuery ?? (await Lending.PlaceAsync(db, open!)).EbookChapter ?? 0, 0, Math.Max(0, comicPages - 1));
            return;
        }

        if (book is null || !EbookStore.IsEpub(book.EbookStoredName))
        {
            return;
        }

        var path = Ebooks.OpenPath(book.EbookStoredName);
        chapters = path is null ? null : EpubFile.Chapters(path);

        if (chapters is { Count: > 0 })
        {
            var place = ChapterQuery ?? (await Lending.PlaceAsync(db, open!)).EbookChapter ?? 0;
            chapter = place >= 0 && place < chapters.Count ? place : 0;
            chapterAt = frameAt = ChapterQuery is not null && AtQuery is > 0 and <= 1 ? AtQuery.Value : 0;
            alongChapters = (await ReadAlongs.StatusAsync(db, Id)).Chapters;
        }
    }

    // Listening along: the audiobook plays and the word being read is marked, when the book has a read-along.
    private ReadAlongChapter[] alongChapters = [];
    private IJSObjectReference? along;
    private bool alongOn;
    private bool following;
    private string? alongNote;

    private async Task<int[]> AlongTimesAsync(int index)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        return (await ReadAlongService.TimesAsync(db, Id, index))?.Times ?? [];
    }

    private async Task ToggleAlong()
    {
        alongNote = null;
        along ??= await Js.InvokeAsync<IJSObjectReference>("import", "./readalong.js");
        if (alongOn)
        {
            await along.InvokeVoidAsync("stop");
            alongOn = false;
            return;
        }

        if (speechState != "idle")
        {
            await StopReading();
        }

        self ??= DotNetObjectReference.Create(this);
        alongOn = await along.InvokeAsync<bool>("start", self, Id, chapter, await AlongTimesAsync(chapter), alongChapters);
        alongNote = alongOn ? null : T("The audiobook could not be played here.");
    }

    // The recording moved on to another chapter: the page follows it.
    [JSInvokable]
    public Task AlongTo(int index) => InvokeAsync(async () =>
    {
        if (chapters is null || index < 0 || index >= chapters.Count || !alongOn)
        {
            return;
        }

        chapter = index;
        following = true;
        try
        {
            await RememberChapter();
        }
        finally
        {
            following = false;
        }

        if (along is not null)
        {
            await along.InvokeVoidAsync("chapter", index, await AlongTimesAsync(index));
        }

        StateHasChanged();
    });

    [JSInvokable]
    public Task AlongStopped() => InvokeAsync(() =>
    {
        alongOn = false;
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (UseEngine && !engineOpen)
        {
            await OpenEngineAsync();
        }
        else if (!UseEngine && engineOpen && epub is not null)
        {
            // Listening along goes to the chapter reader; coming back, the engine opens where it left off.
            engineOpen = false;
            savedCfi = null;
            await epub.InvokeVoidAsync("close");
        }

        if (pdf is null && !pdfFailed && book is not null && EbookStore.IsPdf(book.EbookStoredName))
        {
            self ??= DotNetObjectReference.Create(this);
            try
            {
                pdf = await Js.InvokeAsync<IJSObjectReference>("import", "./pdf-reader.js");
                await pdf.InvokeAsync<int>("open", pdfHost, $"/books/{book.Id}/ebook/file", pdfIndex, type.Size, self, PdfMarks(), $"/books/{book.Id}/ebook/ocr/");
            }
            catch (JSException)
            {
                pdfFailed = true;
                StateHasChanged();
            }
        }

        if (!firstRender || reader is not null)
        {
            return;
        }

        self ??= DotNetObjectReference.Create(this);
        reader = await Js.InvokeAsync<IJSObjectReference>("import", "./reader.js");
        await reader.InvokeVoidAsync("listen", self);
        if (book is not null && !string.IsNullOrWhiteSpace(book.EbookStoredName))
        {
            readingTime = await Js.InvokeAsync<IJSObjectReference>("import", "./reading-time.js");
            await readingTime.InvokeVoidAsync("start", book.Id);
        }

        if (book is not null && (EbookStore.IsEpub(book.EbookStoredName) || IsPdf))
        {
            speech = await Js.InvokeAsync<IJSObjectReference>("import", "./speak.js");
            speechSupported = await speech.InvokeAsync<bool>("supported");
            if (speechSupported)
            {
                var prefs = await speech.InvokeAsync<SpeechPrefs>("prefs");
                speechRate = prefs.Rate.ToString(System.Globalization.CultureInfo.InvariantCulture);
                speechVoice = prefs.Voice;
                StateHasChanged();
                speechVoices = (await speech.InvokeAsync<List<SpeechVoice>>("voices"))
                    .OrderBy(voice => !voice.Lang.StartsWith(System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName, StringComparison.OrdinalIgnoreCase))
                    .ThenBy(voice => voice.Name)
                    .ToList();
                if (!new[] { "0.8", "1", "1.2", "1.5" }.Contains(speechRate))
                {
                    speechRate = "1";
                }

                StateHasChanged();
            }
        }
    }

    public sealed record SpeechPrefs(double Rate, string Voice);

    public sealed record EngineText(int Chapter, string Text);

    [JSInvokable]
    public void Selected(string text, string prefix, string suffix)
    {
        meaning = null;
        lookUpNote = null;
        selectedText = text ?? "";
        selectedPrefix = prefix ?? "";
        selectedSuffix = suffix ?? "";
        selectedNote = "";
        editingId = null;
        markError = null;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OpenMark(int id)
    {
        var mark = marks.FirstOrDefault(item => item.Id == id);
        if (mark is null)
        {
            return;
        }

        Edit(mark);
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task Previous()
    {
        if (chapter == 0)
        {
            return;
        }

        chapter--;
        await RememberChapter();
    }

    private async Task Next()
    {
        if (chapters is null || chapter >= chapters.Count - 1)
        {
            return;
        }

        chapter++;
        await RememberChapter();
    }

    private int comicPages;

    // Read aloud, with the browser's voices.
    private IJSObjectReference? speech;
    private bool speechSupported;
    private string speechState = "idle";
    private string speechRate = "1";
    private string speechVoice = "";
    private List<SpeechVoice> speechVoices = [];
    private string? nowSpeaking;
    private bool advancing;

    public sealed record SpeechVoice(string Name, string Lang);

    private RenderFragment ReadAloud => @<text>
        @if (speechSupported)
        {
            <div class="read-aloud">
                @if (speechState == "idle")
                {
                    <button type="button" @onclick="StartReading">@T("Read aloud")</button>
                }
                else if (speechState == "speaking")
                {
                    <button type="button" @onclick="PauseReading">@T("Pause")</button>
                    <button type="button" class="quiet" @onclick="StopReading">@T("Stop")</button>
                }
                else
                {
                    <button type="button" @onclick="ResumeReading">@T("Resume")</button>
                    <button type="button" class="quiet" @onclick="StopReading">@T("Stop")</button>
                }
                <label>
                    @T("Speed")
                    <select @bind="speechRate" @bind:after="SpeechChanged">
                        <option value="0.8">@T("Slower")</option>
                        <option value="1">@T("Normal")</option>
                        <option value="1.2">@T("Faster")</option>
                        <option value="1.5">@T("Fastest")</option>
                    </select>
                </label>
                @if (speechVoices.Count > 0)
                {
                    <label>
                        @T("Voice")
                        <select @bind="speechVoice" @bind:after="SpeechChanged">
                            <option value="">@T("The browser's choice")</option>
                            @foreach (var voice in speechVoices)
                            {
                                <option value="@voice.Name">@voice.Name (@voice.Lang)</option>
                            }
                        </select>
                    </label>
                }
                @if (speechState != "idle" && nowSpeaking is not null)
                {
                    <p class="hint now-speaking">@nowSpeaking</p>
                }
            </div>
        }
    </text>;

    private object SpeechSource() => IsPdf
        ? new { page = true }
        : new { chapter = $"/books/{book!.Id}/ebook/chapters/{chapter}" };

    private async Task StartReading()
    {
        if (speech is null || book is null)
        {
            return;
        }

        speechState = "speaking";
        // In the page-turning reader, from the top of the page showing.
        object source = SpeechSource();
        if (UseEngine && epub is not null)
        {
            try
            {
                if (await epub.InvokeAsync<EngineText?>("textFromHere") is { } here)
                {
                    source = new { text = here.Text };
                }
            }
            catch (JSException)
            {
                // The chapter from its start, then.
            }
        }

        await speech.InvokeVoidAsync("start", self, source, new { rate = double.Parse(speechRate, System.Globalization.CultureInfo.InvariantCulture), voice = speechVoice });
    }

    private async Task PauseReading()
    {
        speechState = "paused";
        if (speech is not null)
        {
            await speech.InvokeVoidAsync("pause");
        }
    }

    private async Task ResumeReading()
    {
        speechState = "speaking";
        if (speech is not null)
        {
            await speech.InvokeVoidAsync("resume");
        }
    }

    private async Task StopReading()
    {
        speechState = "idle";
        nowSpeaking = null;
        if (speech is not null)
        {
            await speech.InvokeVoidAsync("stop");
        }
    }

    // A new speed or voice takes over from the next sentence on.
    private async Task SpeechChanged()
    {
        if (speech is null)
        {
            return;
        }

        await speech.InvokeVoidAsync("savePrefs", double.Parse(speechRate, System.Globalization.CultureInfo.InvariantCulture), speechVoice);
    }

    [JSInvokable]
    public Task Speaking(string text)
    {
        nowSpeaking = text;
        return InvokeAsync(StateHasChanged);
    }

    // The end of a chapter or page: go on to the next one, as an audiobook would.
    [JSInvokable]
    public Task SpokenToEnd() => InvokeAsync(async () =>
    {
        if (speechState != "speaking")
        {
            return;
        }

        if (IsPdf && pdfIndex < pdfPages - 1)
        {
            advancing = true;
            await ShowPdfPage(pdfIndex + 1);
        }
        else if (!IsPdf && chapters is not null && chapter < chapters.Count - 1)
        {
            advancing = true;
            chapter++;
            await RememberChapter();
            advancing = false;
            StateHasChanged();
            await StartReading();
        }
        else
        {
            speechState = "idle";
            nowSpeaking = null;
            StateHasChanged();
        }
    });

    private bool comicRtl;
    private bool comicSpread;

    private async Task PreviousPage()
    {
        var (first, _) = ComicFile.Spread(chapter, comicPages, comicSpread);
        if (first > 0)
        {
            chapter = comicSpread ? Math.Max(0, first - 2) : first - 1;
            await RememberChapter();
        }
    }

    private async Task NextPage()
    {
        var (first, count) = ComicFile.Spread(chapter, comicPages, comicSpread);
        if (first + count < comicPages)
        {
            chapter = first + count;
            await RememberChapter();
        }
    }

    // Right to left, the left arrow goes forward, as the pages do.
    private async Task ComicKey(KeyboardEventArgs key)
    {
        var forward = comicRtl ? "ArrowLeft" : "ArrowRight";
        var back = comicRtl ? "ArrowRight" : "ArrowLeft";
        if (key.Key == forward || key.Key is "PageDown" or " ")
        {
            await NextPage();
        }
        else if (key.Key == back || key.Key == "PageUp")
        {
            await PreviousPage();
        }
    }

    // Kept on the book for its owner; for a borrower, for this visit.
    private async Task ChangeRtl(ChangeEventArgs change)
    {
        comicRtl = change.Value is true;
        if (book is not null && !borrowed)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await db.Books.Where(item => item.Id == book.Id).ExecuteUpdateAsync(set => set.SetProperty(item => item.ComicRightToLeft, comicRtl));
        }
    }

    private async Task ChangeSpread(ChangeEventArgs change)
    {
        comicSpread = change.Value is true;
        await using var db = await DbFactory.CreateDbContextAsync();
        await BookRules.SetComicSpreadAsync(db, comicSpread);
    }

    private async Task RememberChapter()
    {
        if (!advancing && speechState != "idle")
        {
            await StopReading();
        }

        ClearSelection();
        chapterAt = frameAt = 0;
        if (open is null)
        {
            return;
        }

        if (UseEngine && epub is not null && engineOpen)
        {
            await epub.InvokeVoidAsync("goTo", chapter);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await Lending.KeepPlaceAsync(db, open, place => place.EbookChapter = chapter);

        // Chosen by hand while listening along, the recording goes to the chapter's start.
        if (alongOn && !following && along is not null && alongChapters.FirstOrDefault(item => item.Index == chapter) is { } range)
        {
            await along.InvokeVoidAsync("move", chapter, await AlongTimesAsync(chapter), range.Start);
        }
    }

    [JSInvokable]
    public void Scrolled(double at) => chapterAt = Math.Clamp(at, 0, 1);

    private int page;
    private int pages;

    private string Layout
    {
        get => type.Paged ? "pages" : "scroll";
        set => type.Paged = value == "pages";
    }

    // In pages, which page of the chapter is showing.
    [JSInvokable]
    public Task Paged(int shown, int count)
    {
        (page, pages) = (shown, count);
        return InvokeAsync(StateHasChanged);
    }

    // Turning past the last page opens the next chapter at its start; before the first, the one before at its end.
    [JSInvokable]
    public Task Turned(int step) => InvokeAsync(async () =>
    {
        if (chapters is null)
        {
            return;
        }

        if (step > 0 && chapter < chapters.Count - 1)
        {
            await Next();
        }
        else if (step < 0 && chapter > 0)
        {
            await Previous();
            chapterAt = frameAt = 1;
        }

        StateHasChanged();
    });

    // The same place in the audiobook: to the word, with a read-along; else by the chapters' titles where they agree,
    // and how far through otherwise.
    private async Task ContinueInAudio()
    {
        if (book is not null && alongChapters.Length > 0)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await ReadAlongService.SecondsAtAsync(db, book.Id, chapter, chapterAt) is double seconds)
            {
                Navigation.NavigateTo($"/library/{book.Id}/listen?t={seconds.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}");
                return;
            }
        }

        if (book is null || Crossover.EbookParts(Ebooks, book.EbookStoredName, Cache) is not { } text || Crossover.AudioParts(Audio, book.AudioStoredName) is not { Count: > 0 } recording)
        {
            return;
        }

        var spot = new Crossover(recording, text).ToAudio(new PartSpot(chapter, chapterAt));
        Navigation.NavigateTo($"/library/{book.Id}/listen?part={spot.Part}&at={spot.Within.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)}");
    }

    private void Edit(Highlight mark)
    {
        editingId = mark.Id;
        selectedText = mark.Text;
        selectedPrefix = mark.Prefix ?? "";
        selectedSuffix = mark.Suffix ?? "";
        selectedNote = mark.Note ?? "";
        markError = null;
    }

    private WordMeaning? meaning;
    private string? lookUpNote;
    private bool lookingUp;

    private bool CanLookUp => Configuration.GetValue("Lookup:Dictionary", true) && WordLookups.Clean(selectedText) is not null;

    // A word or a short phrase, in the book's language: its definitions, and what an encyclopedia says of it.
    private async Task LookUp()
    {
        if (book is null || WordLookups.Clean(selectedText) is not { } words)
        {
            return;
        }

        lookingUp = true;
        lookUpNote = null;
        try
        {
            meaning = await Dictionary.FindAsync(words, WordLookups.LanguageOf(book.Language), CancellationToken.None);
            lookUpNote = meaning is null ? T("Nothing found for “{0}”.", words) : null;
        }
        finally
        {
            lookingUp = false;
        }
    }

    private void ClearSelection()
    {
        selectedChapter = null;
        if (epub is not null && engineOpen)
        {
            _ = epub.InvokeVoidAsync("clearSelection").AsTask();
        }

        meaning = null;
        lookUpNote = null;
        selectedText = "";
        selectedPrefix = "";
        selectedSuffix = "";
        selectedNote = "";
        editingId = null;
        markError = null;
    }

    private async Task SaveHighlight()
    {
        markError = null;
        if (open is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (editingId is int id)
        {
            var existing = await Lending.Marks(db, open).FirstOrDefaultAsync(item => item.Id == id);
            if (existing is null)
            {
                return;
            }

            if (selectedNote.Trim().Length > 2000)
            {
                markError = T("Keep the note to 2000 characters.");
                return;
            }

            existing.Note = string.IsNullOrWhiteSpace(selectedNote) ? null : selectedNote.Trim();
            await db.SaveChangesAsync();
        }
        else
        {
            var markChapter = IsPdf ? pdfIndex : selectedChapter ?? chapter;
            var request = new CreateHighlightRequest(selectedText, markChapter, selectedNote, selectedPrefix, selectedSuffix);
            var problems = BookRules.ValidateHighlight(request);
            if (problems is not null)
            {
                markError = problems.Values.SelectMany(item => item).FirstOrDefault();
                return;
            }

            db.Highlights.Add(Lending.NewMark(
                db,
                open,
                markChapter,
                selectedText.Trim(),
                string.IsNullOrWhiteSpace(selectedNote) ? null : selectedNote.Trim(),
                selectedPrefix.Length <= 80 ? NullIfEmpty(selectedPrefix) : selectedPrefix[^80..],
                selectedSuffix.Length <= 80 ? NullIfEmpty(selectedSuffix) : selectedSuffix[..80]));
            await db.SaveChangesAsync();
        }

        ClearSelection();
        frameAt = chapterAt;
        markRevision++;
        await ReloadMarks();
    }

    private async Task RemoveMark(int id)
    {
        if (open is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await Lending.Marks(db, open).FirstOrDefaultAsync(item => item.Id == id);
        if (existing is null)
        {
            return;
        }

        db.Highlights.Remove(existing);
        await db.SaveChangesAsync();
        if (editingId == id)
        {
            ClearSelection();
        }

        frameAt = chapterAt;
        markRevision++;
        await ReloadMarks();
    }

    private async Task ReloadMarks()
    {
        if (open is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        marks = await Lending.Marks(db, open).AsNoTracking()
            .OrderBy(item => item.Id)
            .ToListAsync();
        if (epub is not null && engineOpen)
        {
            await epub.InvokeVoidAsync("setMarks", MarkData);
        }

        if (pdf is not null)
        {
            await pdf.InvokeVoidAsync("marks", PdfMarks());
        }
    }

    // What the PDF viewer needs to find and paint each passage on its page. A list, not an array,
    // so the interop call passes it as one argument instead of spreading it into many.
    private List<object> PdfMarks() => marks
        .Select(mark => (object)new { id = mark.Id, page = mark.ChapterIndex, text = mark.Text, prefix = mark.Prefix ?? "", suffix = mark.Suffix ?? "", note = mark.Note ?? "" })
        .ToList();

    public async ValueTask DisposeAsync()
    {
        if (epub is not null)
        {
            try
            {
                await epub.InvokeVoidAsync("close");
                await epub.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (along is not null)
        {
            try
            {
                await along.InvokeVoidAsync("stop", false);
                await along.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (pdf is not null)
        {
            try
            {
                await pdf.InvokeVoidAsync("close");
                await pdf.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (reader is not null)
        {
            try
            {
                await reader.InvokeVoidAsync("stop");
                await reader.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (speech is not null)
        {
            try
            {
                await speech.InvokeVoidAsync("stop");
                await speech.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (readingTime is not null)
        {
            try
            {
                await readingTime.InvokeVoidAsync("stop");
                await readingTime.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        self?.Dispose();
    }

    private static string? NullIfEmpty(string value) => string.IsNullOrEmpty(value) ? null : value;

    // Saved for the reader, so the next book and the next device open the same way.
    private async Task SaveType()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await BookRules.SetReaderTypeAsync(db, new ReaderType(type.Size, type.Leading, type.Width, type.Paged, type.Theme.Length > 0 ? type.Theme : null, type.Font.Length > 0 ? type.Font : null));
        if (epub is not null && engineOpen)
        {
            await epub.InvokeVoidAsync("setStyle", new { flow = type.Paged ? "paginated" : "scrolled", theme = type.Theme, font = type.Font, size = type.Size, leading = type.Leading, width = type.Width });
        }
        pages = 0;
        frameAt = chapterAt;
        typeRevision++;
        if (pdf is not null)
        {
            await pdf.InvokeVoidAsync("zoom", type.Size);
        }
    }

    private async Task ShowPdfPage(int index)
    {
        if (pdf is not null)
        {
            await pdf.InvokeVoidAsync("show", index);
        }
    }

    // Whether the page showing has its own text, words read from a scan, or neither yet.
    [JSInvokable]
    public Task PdfPageKind(string kind)
    {
        pdfKind = kind;
        return InvokeAsync(StateHasChanged);
    }

    // The PDF module reports each page it shows; the place is kept as for an EPUB chapter.
    [JSInvokable]
    public async Task PdfShown(int index, int total)
    {
        var moved = index != pdfIndex;
        pdfIndex = index;
        pdfPages = total;
        if (moved && open is not null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await Lending.KeepPlaceAsync(db, open, place => place.EbookChapter = index);
        }

        // Reading aloud goes on into the page it turned to; a page turned by hand stops it.
        if (advancing)
        {
            advancing = false;
            await InvokeAsync(StartReading);
        }
        else if (moved && speechState != "idle")
        {
            await InvokeAsync(StopReading);
        }

        await InvokeAsync(StateHasChanged);
    }

    private sealed class TypeForm
    {
        public int Size { get; set; } = ReaderType.DefaultSize;
        public int Leading { get; set; } = ReaderType.DefaultLeading;
        public int Width { get; set; } = ReaderType.DefaultWidth;
        public bool Paged { get; set; }
        public string Theme { get; set; } = "";
        public string Font { get; set; } = "";
    }
