@page "/quotes"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>@T("Quotes & highlights") · Shelf</PageTitle>

<h1>@T("Quotes & highlights")</h1>
<p class="hint"><a href="/books/notes.zip" download>@T("Download them all as Markdown")</a>@T(", one file a book, for Obsidian or any notes app.")</p>

@if (passages.Count == 0)
{
    <EmptyState Title="@T("No quotes or highlights yet")" Text="@T("Quotes saved on a book's page, and passages highlighted in the reader, gather here, where you can search their words, your notes, the book, or the author.")" ActionHref="/" ActionLabel="@T("Open the library")" />
}
else
{
    <div class="filters">
        <label>
            @T("Search")
            <input type="search" @bind="query" @bind:event="oninput" placeholder="@T("Words, notes, titles, authors")" />
        </label>
    </div>
    <div class="segmented" role="group" aria-label="@T("Show")">
        <button type="button" aria-pressed="@(kind == "" ? "true" : "false")" @onclick="@(() => kind = "")">@T("Both")</button>
        <button type="button" aria-pressed="@(kind == "quote" ? "true" : "false")" @onclick="@(() => kind = "quote")">@T("Quotes")</button>
        <button type="button" aria-pressed="@(kind == "highlight" ? "true" : "false")" @onclick="@(() => kind = "highlight")">@T("Highlights")</button>
    </div>
    @if (!Visible.Any())
    {
        <p class="hint">@T("Nothing matches that search.")</p>
    }
    else
    {
    <ul class="quotes">
        @foreach (var passage in Visible)
        {
            <li>
                <blockquote>
                    <p>@passage.Text</p>
                    <span class="hint">@passage.Where</span>
                </blockquote>
                @if (!string.IsNullOrWhiteSpace(passage.Note))
                {
                    <p>@passage.Note</p>
                }
                <p class="hint">
                    <span class="badge plain">@(passage.Highlight ? T("Highlight") : T("Quote"))</span>
                    <a href="/library/@passage.BookId">@passage.Title</a>
                    · <a href="@($"/?author={Uri.EscapeDataString(passage.Author)}")">@passage.Author</a>
                    @if (passage.Open is string open)
                    {
                        <span> · <a href="@open">@T("Open in the reader")</a></span>
                    }
                </p>
            </li>
        }
    </ul>
    }
}

@code {
    private List<Passage> passages = [];
    private string query = "";
    private string kind = "";

    private IEnumerable<Passage> Visible
    {
        get
        {
            var term = query.Trim();
            return passages.Where(passage =>
                (kind == "" || (kind == "highlight") == passage.Highlight)
                && (term.Length == 0
                    || passage.Text.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (passage.Note?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || passage.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || passage.Author.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var quotes = await db.Quotes.AsNoTracking()
            .Join(
                db.Books.AsNoTracking(),
                quote => quote.BookId,
                book => book.Id,
                (quote, book) => new { quote.BookId, book.Title, book.Author, quote.Text, quote.Page, quote.NotedAt })
            .ToListAsync();
        var marks = await db.Highlights.AsNoTracking()
            .Join(
                db.Books.AsNoTracking(),
                mark => mark.BookId,
                book => book.Id,
                (mark, book) => new { mark.BookId, book.Title, book.Author, mark.Text, mark.Note, mark.ChapterIndex, mark.NotedAt, book.EbookStoredName })
            .ToListAsync();
        passages = quotes
            .Select(quote => new Passage(false, quote.BookId, quote.Title, quote.Author, quote.Text, null, quote.Page is int page ? T("p. {0}", page) : "", quote.NotedAt, null))
            .Concat(marks.Select(mark => new Passage(
                true,
                mark.BookId,
                mark.Title,
                mark.Author,
                mark.Text,
                mark.Note,
                EbookStore.IsPdf(mark.EbookStoredName) ? T("Page {0}", mark.ChapterIndex + 1) : T("Chapter {0}", mark.ChapterIndex + 1),
                mark.NotedAt,
                $"/library/{mark.BookId}/read?chapter={mark.ChapterIndex}")))
            .OrderByDescending(passage => passage.NotedAt)
            .ToList();
    }

    private sealed record Passage(bool Highlight, int BookId, string Title, string Author, string Text, string? Note, string Where, DateTimeOffset NotedAt, string? Open);
}
