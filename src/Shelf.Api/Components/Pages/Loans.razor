@page "/loans"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory
@inject Federation Federation
@inject ReaderTime Clock

<PageTitle>@T("Loans") · Shelf</PageTitle>

<div class="titled"><h1>@T("Loans")</h1><HelpLink Page="lending" Section="lending-to-another-reader" /></div>

@if (Quiet)
{
    <EmptyState Title="@T("Nothing is on loan")" Text="@T("Books you lend, to a reader here or to anyone else, are listed by who has them. Books other readers lend you, and the ones you ask for, show here too.")" ActionHref="/shelves" ActionLabel="@T("Browse the open shelves")" />
}
else
{
<h2>@T("Lent out")</h2>
@if (people.Count == 0)
{
    <p class="hint">@T("Nothing of yours is on loan.")</p>
}
else
{
    <ul class="tag-counts">
        @foreach (var person in people)
        {
            <li>
                <a href="@($"/library?loanedTo={Uri.EscapeDataString(person.Name)}")">@person.Name</a>
                <span class="hint">@Localization.Counts.Books(person.Count)</span>
                @if (person.Overdue > 0)
                {
                    <span class="late">@T("{0} overdue", person.Overdue)</span>
                }
            </li>
        }
    </ul>
}

<p class="hint"><a href="/labels">@T("Print QR labels")</a> @T("for your copies: scanning one opens a page to lend it or mark it back.")</p>

@if (waiting.Length > 0)
{
    <h2>@T("Waiting for your books")</h2>
    <ul class="plain-list">
        @foreach (var line in waiting)
        {
            <li>
                <a href="/library/@line.BookId">@line.Title</a>
                <span class="hint">@(line.OnLoan ? T("on loan; then ") : "")@string.Join(", ", line.Readers.Select((name, at) => $"{at + 1}. {name}"))</span>
            </li>
        }
    </ul>
}

@if (asks.Incoming.Length > 0)
{
    <h2>@T("Asked of you")</h2>
    <ul class="quotes">
        @foreach (var ask in asks.Incoming)
        {
            <li>
                <strong>@ask.Title</strong>
                <span class="hint"> · @ask.Author</span>
                <p class="hint">@T("{0} asked on {1}", ask.Reader, ask.AskedAt.Medium())@(ask.OnLoan ? T(". It is on loan now.") : "")</p>
                @if (!ask.OnLoan)
                {
                    <label class="inline-date">
                        @T("Due back")
                        <input type="date" @bind="dueDates[ask.Id]" />
                    </label>
                    <button type="button" class="primary" @onclick="() => LendAsk(ask.Id)">@T("Lend it")</button>
                }
                <button type="button" @onclick="() => DropAsk(ask.Id)">@T("Decline")</button>
            </li>
        }
    </ul>
    @if (askProblem is not null)
    {
        <p class="validation-message" role="alert">@askProblem</p>
    }
}

@if (remoteAsks.Length > 0)
{
    <h2>@T("Asked of you from linked shelves")</h2>
    <ul class="quotes">
        @foreach (var ask in remoteAsks)
        {
            <li>
                <strong>@ask.Title</strong>
                <span class="hint"> · @ask.Author</span>
                <p class="hint">@T("{0} on {1} asked on {2}", ask.Reader, ask.Server, ask.AskedAt.Medium())@(ask.OnLoan ? T(". It is on loan now.") : "")</p>
                @if (!ask.OnLoan)
                {
                    <label class="inline-date">
                        @T("Due back")
                        <input type="date" @bind="remoteDue[ask.Id]" />
                    </label>
                    <button type="button" class="primary" @onclick="() => LendRemote(ask.Id)">@T("Lend it")</button>
                }
                <button type="button" @onclick="() => DropRemote(ask.Id)">@T("Decline")</button>
            </li>
        }
    </ul>
}

<h2>@T("Borrowed")</h2>
@if (borrowed.Count == 0)
{
    <p class="hint">@T("No other reader has lent you a book.") <a href="/shelves">@T("Browse the open shelves to ask for one.")</a></p>
}
else
{
    <ul class="quotes">
        @foreach (var book in borrowed)
        {
            <li>
                <strong>@book.Title</strong>
                <span class="hint"> · @book.Author</span>
                <p class="hint">
                    @T("From {0}", book.Owner)
                    @if (book.LoanedOn is DateOnly since)
                    {
                        <span> @T("since {0}", since.Medium())</span>
                    }
                    @if (book.DueOn is DateOnly due)
                    {
                        <span class="@(due < Today ? "late" : null)"> · @T("due {0}", due.Medium())@(due < Today ? T(", overdue") : "")</span>
                    }
                </p>
                @if (book.HasEbook)
                {
                    <a href="/library/@book.Id/read">@T("Read")</a>
                }
                @if (book.HasAudio)
                {
                    <a href="/library/@book.Id/listen">@T("Listen")</a>
                }
                <button type="button" @onclick="() => GiveBack(book)">@T("Give it back")</button>
            </li>
        }
    </ul>
}

@if (linkedAsks.Length > 0)
{
    <h2>@T("You asked on linked shelves")</h2>
    <ul class="quotes">
        @foreach (var ask in linkedAsks)
        {
            <li>
                <strong>@ask.Title</strong>
                <span class="hint"> · @T("from {0}, asked {1}", ask.Owner, ask.AskedAt.Medium())</span>
                <button type="button" @onclick="() => Withdraw(ask.Id)">@T("Take it back")</button>
            </li>
        }
    </ul>
}

@if (asks.Outgoing.Length > 0)
{
    <h2>@T("You asked")</h2>
    <ul class="quotes">
        @foreach (var ask in asks.Outgoing)
        {
            <li>
                <strong>@ask.Title</strong>
                <span class="hint"> · @T("from {0}, asked {1}", ask.Reader, ask.AskedAt.Medium())</span>
                @if (places.GetValueOrDefault(ask.BookId) is int place)
                {
                    <span class="hint"> · @LoanHistory.Ordinal(place)</span>
                }
                <button type="button" @onclick="() => DropAsk(ask.Id)">@T("Take it back")</button>
            </li>
        }
    </ul>
}
}

@if (returned.Length > 0)
{
    <details class="panel">
        <summary>@T("Loans that have ended") (@returned.Length)</summary>
        <ul class="plain-list">
            @foreach (var loan in returned)
            {
                <li>
                    <a href="/library/@loan.BookId">@loan.Title</a>
                    <span class="hint">
                        @loan.Borrower · @loan.LentOn.Medium() – @(loan.ReturnedOn?.Medium())
                        @if (loan.Renewals > 0)
                        {
                            <span> · @(loan.Renewals == 1 ? T("renewed once") : T("renewed {0} times", loan.Renewals))</span>
                        }
                        @if (loan.ConditionBack is CopyCondition back && back != loan.ConditionOut)
                        {
                            <span> · @T("came back {0}", BookRules.ConditionLabel(back).ToLowerInvariant())</span>
                        }
                    </span>
                    @if (loan.Note is { } said)
                    {
                        <p class="hint">@said</p>
                    }
                </li>
            }
        </ul>
    </details>
}

@code {
    private DateOnly Today => Clock.Today;

    private LoanAsks asks = new([], []);
    private readonly Dictionary<int, DateOnly?> dueDates = [];
    private string? askProblem;

    private bool Quiet => returned.Length == 0 && people.Count == 0 && borrowed.Count == 0 && asks.Incoming.Length == 0 && asks.Outgoing.Length == 0 && remoteAsks.Length == 0 && linkedAsks.Length == 0;

    private RemoteAskRow[] remoteAsks = [];
    private LinkedAskRow[] linkedAsks = [];
    private readonly Dictionary<int, DateOnly?> remoteDue = [];
    private bool synced;

    private List<LoanCount> people = [];
    private WaitingLine[] waiting = [];
    private LoanRecordItem[] returned = [];
    private Dictionary<int, int?> places = [];
    private List<BorrowedBook> borrowed = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        // Loans from linked shelves are brought up to date when the page opens.
        if (!synced)
        {
            synced = true;
            await Federation.SyncAsync(db);
        }

        remoteAsks = await Federation.RemoteAsksAsync(db);
        linkedAsks = await Federation.LinkedAsksAsync(db);
        foreach (var ask in remoteAsks)
        {
            remoteDue.TryAdd(ask.Id, null);
        }

        var loans = await db.Books.AsNoTracking()
            .Select(book => new { book.LoanedTo, book.DueOn })
            .ToListAsync();
        people = BookRules.Loans(
            loans.Select(loan => (loan.LoanedTo, loan.DueOn)),
            Today).ToList();
        borrowed = (await Lending.BorrowedAsync(db)).ToList();
        asks = await Asking.AsksAsync(db);
        waiting = await LoanHistory.WaitingAsync(db);
        returned = await LoanHistory.ReturnedAsync(db, take: 100);
        places = [];
        foreach (var ask in asks.Outgoing)
        {
            places[ask.BookId] = await LoanHistory.PlaceInLineAsync(db, ask.BookId);
        }
        foreach (var ask in asks.Incoming)
        {
            dueDates.TryAdd(ask.Id, null);
        }
    }

    private async Task LendAsk(int id)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var result = await Asking.LendAskAsync(db, id, dueDates.GetValueOrDefault(id));
            askProblem = result == LendResult.Lent ? null : Lending.Describe(result);
        }

        await LoadAsync();
    }

    private async Task DropAsk(int id)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await Asking.DropAskAsync(db, id);
        }

        askProblem = null;
        await LoadAsync();
    }

    private async Task GiveBack(BorrowedBook book)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            if (book.Linked)
            {
                askProblem = await Federation.GiveBackAsync(db, book.Id) ? null : T("The shelf it came from could not be reached. Try again later.");
            }
            else
            {
                await Lending.GiveBackAsync(db, book.Id);
            }
        }

        await LoadAsync();
    }

    private async Task LendRemote(int id)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var result = await Federation.LendRemoteAskAsync(db, id, remoteDue.GetValueOrDefault(id));
            askProblem = result == LendResult.Lent ? null : Lending.Describe(result);
        }

        await LoadAsync();
    }

    private async Task DropRemote(int id)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await Federation.DropRemoteAskAsync(db, id);
        }

        await LoadAsync();
    }

    private async Task Withdraw(int id)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await Federation.WithdrawAsync(db, id);
        }

        await LoadAsync();
    }
}
