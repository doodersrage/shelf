@page "/loans"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>Loans · Shelf</PageTitle>

<h1>Loans</h1>

@if (Quiet)
{
    <EmptyState Title="Nothing is on loan" Text="Books you lend, to a reader here or to anyone else, are listed by who has them. Books other readers lend you, and the ones you ask for, show here too." ActionHref="/shelves" ActionLabel="Browse the open shelves" />
}
else
{
<h2>Lent out</h2>
@if (people.Count == 0)
{
    <p class="hint">Nothing of yours is on loan.</p>
}
else
{
    <ul class="tag-counts">
        @foreach (var person in people)
        {
            <li>
                <a href="@($"/?loanedTo={Uri.EscapeDataString(person.Name)}")">@person.Name</a>
                <span class="hint">@person.Count @(person.Count == 1 ? "book" : "books")</span>
                @if (person.Overdue > 0)
                {
                    <span class="late">@person.Overdue overdue</span>
                }
            </li>
        }
    </ul>
}

@if (asks.Incoming.Length > 0)
{
    <h2>Asked of you</h2>
    <ul class="quotes">
        @foreach (var ask in asks.Incoming)
        {
            <li>
                <strong>@ask.Title</strong>
                <span class="hint"> · @ask.Author</span>
                <p class="hint">@ask.Reader asked on @ask.AskedAt.Medium()@(ask.OnLoan ? ". It is on loan now." : "")</p>
                @if (!ask.OnLoan)
                {
                    <label class="inline-date">
                        Due back
                        <input type="date" @bind="dueDates[ask.Id]" />
                    </label>
                    <button type="button" class="primary" @onclick="() => LendAsk(ask.Id)">Lend it</button>
                }
                <button type="button" @onclick="() => DropAsk(ask.Id)">Decline</button>
            </li>
        }
    </ul>
    @if (askProblem is not null)
    {
        <p class="validation-message" role="alert">@askProblem</p>
    }
}

<h2>Borrowed</h2>
@if (borrowed.Count == 0)
{
    <p class="hint">No other reader has lent you a book. <a href="/shelves">Browse the open shelves</a> to ask for one.</p>
}
else
{
    <ul class="quotes">
        @foreach (var book in borrowed)
        {
            <li>
                <strong>@book.Title</strong>
                <span class="hint"> · @book.Author</span>
                <p class="hint">
                    From @book.Owner
                    @if (book.LoanedOn is DateOnly since)
                    {
                        <span> since @since.Medium()</span>
                    }
                    @if (book.DueOn is DateOnly due)
                    {
                        <span class="@(due < Today ? "late" : null)"> · due @due.Medium()@(due < Today ? ", overdue" : "")</span>
                    }
                </p>
                @if (book.HasEbook)
                {
                    <a href="/library/@book.Id/read">Read</a>
                }
                @if (book.HasAudio)
                {
                    <a href="/library/@book.Id/listen">Listen</a>
                }
                <button type="button" @onclick="() => GiveBack(book.Id)">Give it back</button>
            </li>
        }
    </ul>
}

@if (asks.Outgoing.Length > 0)
{
    <h2>You asked</h2>
    <ul class="quotes">
        @foreach (var ask in asks.Outgoing)
        {
            <li>
                <strong>@ask.Title</strong>
                <span class="hint"> · from @ask.Reader, asked @ask.AskedAt.Medium()</span>
                <button type="button" @onclick="() => DropAsk(ask.Id)">Take it back</button>
            </li>
        }
    </ul>
}
}

@code {
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);

    private LoanAsks asks = new([], []);
    private readonly Dictionary<int, DateOnly?> dueDates = [];
    private string? askProblem;

    private bool Quiet => people.Count == 0 && borrowed.Count == 0 && asks.Incoming.Length == 0 && asks.Outgoing.Length == 0;

    private List<LoanCount> people = [];
    private List<BorrowedBook> borrowed = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var loans = await db.Books.AsNoTracking()
            .Select(book => new { book.LoanedTo, book.DueOn })
            .ToListAsync();
        people = BookRules.Loans(
            loans.Select(loan => (loan.LoanedTo, loan.DueOn)),
            Today).ToList();
        borrowed = (await Lending.BorrowedAsync(db)).ToList();
        asks = await Asking.AsksAsync(db);
        foreach (var ask in asks.Incoming)
        {
            dueDates.TryAdd(ask.Id, null);
        }
    }

    private async Task LendAsk(int id)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var result = await Asking.LendAskAsync(db, id, dueDates.GetValueOrDefault(id));
            askProblem = result == LendResult.Lent ? null : Lending.Describe(result);
        }

        await LoadAsync();
    }

    private async Task DropAsk(int id)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await Asking.DropAskAsync(db, id);
        }

        askProblem = null;
        await LoadAsync();
    }

    private async Task GiveBack(int id)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await Lending.GiveBackAsync(db, id);
        }

        await LoadAsync();
    }
}
