@page "/loans"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>Loans · Shelf</PageTitle>

<h1>Loans</h1>

@if (people.Count == 0)
{
    <p>Nothing is on loan.</p>
}
else
{
    <ul class="tag-counts">
        @foreach (var person in people)
        {
            <li>
                <a href="@($"/?loanedTo={Uri.EscapeDataString(person.Name)}")">@person.Name</a>
                <span class="hint">@person.Count @(person.Count == 1 ? "book" : "books")</span>
            </li>
        }
    </ul>
}

@code {
    private List<LoanCount> people = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var names = await db.Books.AsNoTracking().Select(book => book.LoanedTo).ToListAsync();
        people = BookRules.Loans(names).ToList();
    }
}
