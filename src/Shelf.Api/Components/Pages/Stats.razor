@page "/stats"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>Stats · Shelf</PageTitle>

<h1>Stats</h1>

@if (stats is null)
{
    <p class="hint">Counting the shelf…</p>
}
else if (stats.Total == 0)
{
    <EmptyState Title="Nothing to count yet" Text="Stats fill in as you add books and log reading sessions." ActionHref="/?add=1" ActionLabel="Add a book" />
}
else
{
    <section class="panel" aria-labelledby="goal-heading">
        <h2 id="goal-heading">@Today.Year</h2>
        @if (stats.YearlyGoal > 0)
        {
            <p><strong>@stats.FinishedThisYear</strong> of @stats.YearlyGoal books finished this year</p>
            <progress class="goal" max="@stats.YearlyGoal" value="@Math.Min(stats.FinishedThisYear, stats.YearlyGoal)" aria-label="@($"{stats.FinishedThisYear} of {stats.YearlyGoal} books finished")"></progress>
            @if (stats.FinishedThisYear >= stats.YearlyGoal)
            {
                <p class="milestone">You reached this year's goal.</p>
            }
        }
        else
        {
            <p>@stats.FinishedThisYear @(stats.FinishedThisYear == 1 ? "book" : "books") finished this year. Set a goal below if you would like one.</p>
        }
        @if (streak > 1)
        {
            <p class="hint">@streak days of reading in a row.</p>
        }
        else if (streak == 1)
        {
            <p class="hint">You read today or yesterday.</p>
        }

        <h3>Finished each month</h3>
        <ul class="month-bars" aria-label="Books finished each month this year">
            @for (var month = 1; month <= 12; month++)
            {
                var count = FinishedIn(month);
                <li>
                    <span class="label">@(new DateOnly(Today.Year, month, 1).ToString("MMM"))</span>
                    <span class="bar"><span style="width:@(BarWidth(count))%"></span></span>
                    <span class="value">@count</span>
                </li>
            }
        </ul>

        <EditForm Model="goal" OnValidSubmit="SaveGoal">
            <DataAnnotationsValidator />
            <label class="inline-date">
                Books to finish this year
                <InputNumber @bind-Value="goal.YearlyGoal" min="0" max="1000" />
            </label>
            <button type="submit">Save goal</button>
            <ValidationMessage For="() => goal.YearlyGoal" />
            @if (goalSaved)
            {
                <span class="saved" role="status">Saved.</span>
            }
        </EditForm>
    </section>

    <div class="stats">
        <p><strong>@stats.Total</strong><span>Books</span></p>
        <p><strong>@stats.Reading</strong><span>Reading</span></p>
        <p><strong>@stats.Want</strong><span>Want to read</span></p>
        <p><strong>@stats.Finished</strong><span>Finished</span></p>
        <p><strong>@stats.Abandoned</strong><span>Abandoned</span></p>
        <p><strong>@stats.PagesRead</strong><span>Pages read</span></p>
        <p><strong>@stats.FinishedThisYear</strong><span>Finished this year</span></p>
        <p><strong>@(stats.AverageRating?.ToString("0.##") ?? "—")</strong><span>Average rating</span></p>
        <p><strong>@stats.Loved</strong><span>Loved</span></p>
        <p><strong>@stats.OnLoan</strong><span>On loan</span></p>
    </div>

    <section class="panel" aria-labelledby="month-heading">
        <h2 id="month-heading">@shown.ToString("MMMM yyyy")</h2>
        <p>
            <button type="button" class="quiet" @onclick="Earlier">Earlier</button>
            @if (shown < ThisMonth)
            {
                <button type="button" class="quiet" @onclick="Later">Later</button>
            }
        </p>
        <div class="month">
            @foreach (var name in Weekdays)
            {
                <span class="weekday">@name</span>
            }
            @for (var blank = 0; blank < LeadingBlanks; blank++)
            {
                <span></span>
            }
            @for (var day = 1; day <= DateTime.DaysInMonth(shown.Year, shown.Month); day++)
            {
                var current = day;
                if (Marked.Contains(current))
                {
                    <button type="button" class="@DayClass(current)" aria-pressed="@(chosen == new DateOnly(shown.Year, shown.Month, current) ? "true" : "false")" aria-label="@($"{new DateOnly(shown.Year, shown.Month, current):MMMM d}, read")" @onclick="() => ChooseDay(current)">@current</button>
                }
                else
                {
                    <span class="@DayClass(current)">@current</span>
                }
            }
        </div>
        @if (Marked.Count == 0)
        {
            <p class="hint">Nothing logged this month. Reading sessions logged on a book's page show here.</p>
        }
        else
        {
            <p class="hint">Days with a reading session are filled. Choose one to see what you read.</p>
        }
        @if (chosen is DateOnly selected)
        {
            <h3>@selected.ToString("MMMM d")</h3>
            <ul class="tag-counts">
                @foreach (var reading in BookRules.ReadingsOn(shelf, selected))
                {
                    <li>
                        <a href="/library/@reading.BookId">@reading.Title</a>
                        @if (reading.FromPage is int from && reading.ToPage is int to)
                        {
                            <span class="hint"> · @from–@to</span>
                        }
                        else if (reading.ToPage is int end)
                        {
                            <span class="hint"> · to @end</span>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    @if (finished.Count > 0)
    {
        <h2>Finished this year</h2>
        <ul class="tag-counts">
            @foreach (var book in finished)
            {
                <li>
                    <a href="/library/@book.Id">@book.Title</a>
                    <span class="hint">@book.FinishedOn.ToString("MMM d")</span>
                </li>
            }
        </ul>
    }

    @if (lately.Count > 0)
    {
        <h2>Lately</h2>
        <ul class="tag-counts">
            @foreach (var session in lately)
            {
                <li>
                    <span>
                        <a href="/library/@session.BookId">@session.Title</a>
                        @if (session.FromPage is int from && session.ToPage is int to)
                        {
                            <span class="hint"> · @from–@to</span>
                        }
                        else if (session.ToPage is int end)
                        {
                            <span class="hint"> · to @end</span>
                        }
                    </span>
                    <span class="hint">@session.Date.ToString("MMM d")</span>
                </li>
            }
        </ul>
    }

    <h2>Tags</h2>
    @if (stats.Tags.Length == 0)
    {
        <p class="hint">No tags yet. Tags added to a book's details gather here.</p>
    }
    else
    {
        <ul class="tag-counts">
            @foreach (var tag in stats.Tags)
            {
                <li>
                    <a href="@($"/?tag={Uri.EscapeDataString(tag.Name)}")">@tag.Name</a>
                    <span class="hint">@tag.Count</span>
                </li>
            }
        </ul>
    }
}

@code {
    private static readonly string[] Weekdays = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    private ShelfStatsResponse? stats;
    private List<Book> shelf = [];
    private List<FinishedBook> finished = [];
    private List<RecentSession> lately = [];
    private int streak;
    private DateOnly shown = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
    private DateOnly? chosen;
    private readonly GoalFormModel goal = new();
    private bool goalSaved;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        stats = await BookRules.SummarizeAsync(db);
        goal.YearlyGoal = stats.YearlyGoal;
        shelf = await db.Books.AsNoTracking().Include(book => book.Sessions).ToListAsync();
        var year = DateOnly.FromDateTime(DateTime.UtcNow).Year;
        finished = BookRules.FinishedInYear(shelf, year).ToList();
        lately = BookRules.RecentSessions(shelf).ToList();
        streak = BookRules.ReadingStreak(shelf.SelectMany(book => book.Sessions).Select(session => session.Date), DateOnly.FromDateTime(DateTime.UtcNow));
    }

    private DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);

    private DateOnly ThisMonth => new(Today.Year, Today.Month, 1);

    private int LeadingBlanks => ((int)shown.DayOfWeek + 6) % 7;

    private HashSet<int> Marked => BookRules.ReadingDays(
        shelf.SelectMany(book => book.Sessions).Select(session => session.Date),
        shown.Year,
        shown.Month).ToHashSet();

    private string DayClass(int day)
    {
        var date = new DateOnly(shown.Year, shown.Month, day);
        var classes = new List<string>();
        if (date == Today)
        {
            classes.Add("today");
        }

        if (Marked.Contains(day))
        {
            classes.Add("read");
        }

        if (chosen == date)
        {
            classes.Add("chosen");
        }

        return string.Join(' ', classes);
    }

    private void ChooseDay(int day)
    {
        var date = new DateOnly(shown.Year, shown.Month, day);
        chosen = chosen == date ? null : date;
    }

    private void Earlier()
    {
        shown = shown.AddMonths(-1);
        chosen = null;
    }

    private void Later()
    {
        if (shown >= ThisMonth)
        {
            return;
        }

        shown = shown.AddMonths(1);
        chosen = null;
    }

    private int FinishedIn(int month) =>
        shelf.Count(book => book.Status == BookStatus.Finished && book.FinishedOn is DateOnly done && done.Year == Today.Year && done.Month == month);

    private int BarWidth(int count)
    {
        var most = Enumerable.Range(1, 12).Max(FinishedIn);
        return most == 0 ? 0 : (int)Math.Round(100.0 * count / most);
    }

    private async Task SaveGoal()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await BookRules.SetGoalAsync(db, goal.YearlyGoal);
        goalSaved = true;
        await LoadAsync();
    }
}
