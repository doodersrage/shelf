@page "/stats"
@page "/insights"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>@T("Insights") · Shelf</PageTitle>

<h1>@T("Insights")</h1>

@if (stats is null)
{
    <p class="hint">@T("Counting the shelf…")</p>
}
else if (stats.Total == 0)
{
    <EmptyState Title="@T("Nothing to count yet")" Text="@T("Stats fill in as you add books and log reading sessions.")" ActionHref="/library?add=1" ActionLabel="@T("Add a book")" />
}
else
{
    <section class="panel" aria-labelledby="goal-heading">
        <h2 id="goal-heading">@Today.Year</h2>
        <p class="hint"><a href="/years/@Today.Year">@T("Your {0} in books", Today.Year)</a></p>
        @if (stats.YearlyGoal > 0)
        {
            <p>@((MarkupString)T("<strong>{0}</strong> of {1} books finished this year", stats.FinishedThisYear, stats.YearlyGoal))</p>
            <progress class="goal" max="@stats.YearlyGoal" value="@Math.Min(stats.FinishedThisYear, stats.YearlyGoal)" aria-label="@T("{0} of {1} books finished", stats.FinishedThisYear, stats.YearlyGoal)"></progress>
            @if (stats.FinishedThisYear >= stats.YearlyGoal)
            {
                <p class="milestone">@T("You reached this year's goal.")</p>
            }
        }
        else
        {
            <p>@T("Finished this year: {0}. Set a goal below if you would like one.", Localization.Counts.Books(stats.FinishedThisYear))</p>
        }
        @if (streak > 1)
        {
            <p class="hint">@T("{0} days of reading in a row.", streak)</p>
        }
        else if (streak == 1)
        {
            <p class="hint">@T("You read today or yesterday.")</p>
        }

        @if (goals.Pages > 0)
        {
            <p>@((MarkupString)T("<strong>{0}</strong> of {1} pages read this year", PagesThisYear.ToString("N0"), goals.Pages.ToString("N0")))</p>
            <progress class="goal" max="@goals.Pages" value="@Math.Min(PagesThisYear, goals.Pages)" aria-label="@T("{0} of {1} pages read", PagesThisYear, goals.Pages)"></progress>
        }
        @if (goals.Hours > 0)
        {
            <p>@((MarkupString)T("<strong>{0}</strong> of {1} hours reading and listening this year", HoursThisYear, goals.Hours))</p>
            <progress class="goal" max="@goals.Hours" value="@Math.Min(HoursThisYear, goals.Hours)" aria-label="@T("{0} of {1} hours", HoursThisYear, goals.Hours)"></progress>
        }

        <h3>@T("Finished each month")</h3>
        <ul class="month-bars" aria-label="@T("Books finished each month this year")">
            @for (var month = 1; month <= 12; month++)
            {
                var count = FinishedIn(month);
                <li>
                    <span class="label">@(new DateOnly(Today.Year, month, 1).ToString("MMM"))</span>
                    <span class="bar"><span style="width:@(BarWidth(count))%"></span></span>
                    <span class="value">@count</span>
                </li>
            }
        </ul>

        <details class="edit" open="@(goalSaved || (stats.YearlyGoal == 0 && goals.Pages == 0 && goals.Hours == 0))">
        <summary>@T("Set goals")</summary>
        <EditForm Model="goal" OnValidSubmit="SaveGoal">
            <DataAnnotationsValidator />
            <div class="goal-fields">
                <label class="inline-date">
                    @T("Books to finish this year")
                    <InputNumber @bind-Value="goal.YearlyGoal" min="0" max="1000" />
                </label>
                <label class="inline-date">
                    @T("Pages to read this year")
                    <InputNumber @bind-Value="goal.PagesGoal" min="0" max="1000000" />
                </label>
                <label class="inline-date">
                    @T("Hours to spend reading and listening")
                    <InputNumber @bind-Value="goal.HoursGoal" min="0" max="10000" />
                </label>
            </div>
            <p class="hint">@T("Leave a goal at 0 to go without it.")</p>
            <button type="submit">@T("Save goals")</button>
            <ValidationMessage For="() => goal.YearlyGoal" />
            <ValidationMessage For="() => goal.PagesGoal" />
            <ValidationMessage For="() => goal.HoursGoal" />
            @if (goalSaved)
            {
                <span class="saved" role="status">@T("Saved.")</span>
            }
        </EditForm>
        </details>
    </section>

    @if (yearOfReading is { ActiveDays: > 0 } year)
    {
        <section class="panel" aria-labelledby="year-heading">
            <h2 id="year-heading">@T("A year of reading")</h2>
            <p>
                @T("Read or listened on {0} days in the last year.", year.ActiveDays)
                @if (year.LongestRun > 1)
                {
                    @(" " + T("The longest run was {0} days.", year.LongestRun))
                }
                @if (year.BusiestMonth is { } busiest)
                {
                    @(" " + T("The fullest month was {0}.", busiest))
                }
            </p>
            @* The grid is a picture of the sentence above; each day's own count is in its title for a pointer. *@
            <div class="year-grid" aria-hidden="true">
                @foreach (var day in year.Days)
                {
                    <span class="@YearDayClass(day)" title="@DayTitle(day)"></span>
                }
            </div>
            <p class="year-key hint" aria-hidden="true">
                @T("Less") <span class="day l0"></span><span class="day l1"></span><span class="day l2"></span><span class="day l3"></span><span class="day l4"></span> @T("More")
            </p>
        </section>
    }

    @if (favouriteAuthors.Length > 0 || favouriteKinds.Length > 0 || favouriteSeries.Length > 0)
    {
        <section aria-labelledby="favourites-heading">
            <h2 id="favourites-heading">@T("What you return to")</h2>
            <div class="favourites">
                @foreach (var (title, items) in FavouriteLists)
                {
                    @if (items.Length > 0)
                    {
                        <div class="panel">
                            <h3>@title</h3>
                            <ol class="ranked">
                                @foreach (var item in items)
                                {
                                    <li><a href="@item.Href">@item.Name</a> <span class="hint">@Localization.Counts.Books(item.Count)</span></li>
                                }
                            </ol>
                        </div>
                    }
                }
            </div>
        </section>
    }

    @if (milestones.Length > 0)
    {
        <section class="panel" aria-labelledby="milestones-heading">
            <h2 id="milestones-heading">@T("Milestones")</h2>
            <ol class="milestones">
                @foreach (var milestone in milestones.Take(showAllMilestones ? milestones.Length : 6))
                {
                    <li>
                        <span class="hint">@milestone.Day.Medium()</span>
                        @if (milestone.BookId is int bookId)
                        {
                            <a href="/library/@bookId">@milestone.Text</a>
                        }
                        else
                        {
                            <span>@milestone.Text</span>
                        }
                    </li>
                }
            </ol>
            @if (milestones.Length > 6 && !showAllMilestones)
            {
                <button type="button" class="quiet" @onclick="() => showAllMilestones = true">@T("All {0} milestones", milestones.Length)</button>
            }
        </section>
    }

    <div class="stats">
        <p><strong>@stats.Total</strong><span>@T("Books")</span></p>
        <p><strong>@stats.Reading</strong><span>@T("Reading")</span></p>
        <p><strong>@stats.Want</strong><span>@T("Want to read")</span></p>
        <p><strong>@stats.Finished</strong><span>@T("Finished")</span></p>
        <p><strong>@stats.Abandoned</strong><span>@T("Abandoned")</span></p>
        <p><strong>@stats.PagesRead</strong><span>@T("Pages read")</span></p>
        <p><strong>@stats.FinishedThisYear</strong><span>@T("Finished this year")</span></p>
        <p><strong>@(stats.AverageRating?.ToString("0.##") ?? "—")</strong><span>@T("Average rating")</span></p>
        <p><strong>@stats.Loved</strong><span>@T("Loved")</span></p>
        <p><strong>@stats.OnLoan</strong><span>@T("On loan")</span></p>
    </div>

    <section class="panel" aria-labelledby="month-heading">
        <h2 id="month-heading">@shown.MonthYear()</h2>
        <p>
            <button type="button" class="quiet" @onclick="Earlier">@T("Earlier")</button>
            @if (shown < ThisMonth)
            {
                <button type="button" class="quiet" @onclick="Later">@T("Later")</button>
            }
        </p>
        <div class="month">
            @foreach (var name in Weekdays)
            {
                <span class="weekday">@name</span>
            }
            @for (var blank = 0; blank < LeadingBlanks; blank++)
            {
                <span></span>
            }
            @for (var day = 1; day <= DateTime.DaysInMonth(shown.Year, shown.Month); day++)
            {
                var current = day;
                if (Marked.Contains(current))
                {
                    <button type="button" class="@DayClass(current)" aria-pressed="@(chosen == new DateOnly(shown.Year, shown.Month, current) ? "true" : "false")" aria-label="@T("{0}, read", new DateOnly(shown.Year, shown.Month, current).FullMonthDay())" @onclick="() => ChooseDay(current)">@current</button>
                }
                else
                {
                    <span class="@DayClass(current)">@current</span>
                }
            }
        </div>
        @if (Marked.Count == 0)
        {
            <p class="hint">@T("Nothing logged this month. Reading sessions logged on a book's page show here.")</p>
        }
        else
        {
            <p class="hint">@T("Days with a reading session are filled. Choose one to see what you read.")</p>
        }
        @if (chosen is DateOnly selected)
        {
            <h3>@selected.FullMonthDay()</h3>
            <ul class="tag-counts">
                @foreach (var reading in BookRules.ReadingsOn(shelf, selected))
                {
                    <li>
                        <a href="/library/@reading.BookId">@reading.Title</a>
                        @if (reading.FromPage is int from && reading.ToPage is int to)
                        {
                            <span class="hint"> · @from–@to</span>
                        }
                        else if (reading.ToPage is int end)
                        {
                            <span class="hint"> · @T("to {0}", end)</span>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    @if (reading is { TotalSeconds: > 0 })
    {
        <TimePanel Id="reading-heading" Title="@T("Reading time")" Summary="reading" BarsLabel="@T("Time spent reading each day for the last two weeks")" TopTitle="@T("Most read this year")" />
    }

    @if (listening is { TotalSeconds: > 0 })
    {
        <TimePanel Id="listening-heading" Title="@T("Listening")" Summary="listening" BarsLabel="@T("Time spent listening each day for the last two weeks")" TopTitle="@T("Most listened this year")" />
    }

    @if (finished.Count > 0)
    {
        <h2>@T("Finished this year")</h2>
        <ul class="tag-counts">
            @foreach (var book in finished)
            {
                <li>
                    <a href="/library/@book.Id">@book.Title</a>
                    <span class="hint">@book.FinishedOn.MonthDay()</span>
                </li>
            }
        </ul>
    }

    @if (lately.Count > 0)
    {
        <h2>@T("Lately")</h2>
        <ul class="tag-counts">
            @foreach (var session in lately)
            {
                <li>
                    <span>
                        <a href="/library/@session.BookId">@session.Title</a>
                        @if (session.FromPage is int from && session.ToPage is int to)
                        {
                            <span class="hint"> · @from–@to</span>
                        }
                        else if (session.ToPage is int end)
                        {
                            <span class="hint"> · @T("to {0}", end)</span>
                        }
                    </span>
                    <span class="hint">@session.Date.MonthDay()</span>
                </li>
            }
        </ul>
    }

    <h2>@T("Tags")</h2>
    @if (stats.Tags.Length == 0)
    {
        <p class="hint">@T("No tags yet. Tags added to a book's details gather here.")</p>
    }
    else
    {
        <ul class="tag-counts">
            @foreach (var tag in stats.Tags)
            {
                <li>
                    <a href="@($"/library?tag={Uri.EscapeDataString(tag.Name)}")">@tag.Name</a>
                    <span class="hint">@tag.Count</span>
                </li>
            }
        </ul>
    }
}

@code {
    // Monday first, in the reader's own day names.
    private static string[] Weekdays
    {
        get
        {
            var names = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedDayNames;
            return [.. names.Skip(1), names[0]];
        }
    }

    private ShelfStatsResponse? stats;
    private List<Book> shelf = [];
    private List<FinishedBook> finished = [];
    private List<RecentSession> lately = [];
    private int streak;
    private ListeningSummary? listening;
    private ListeningSummary? reading;
    private DateOnly shown = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
    private DateOnly? chosen;
    private readonly GoalFormModel goal = new();
    private bool goalSaved;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        stats = await BookRules.SummarizeAsync(db);
        goal.YearlyGoal = stats.YearlyGoal;
        goals = await BookRules.GetGoalsAsync(db);
        (goal.PagesGoal, goal.HoursGoal) = (goals.Pages, goals.Hours);
        // One load of the shelf, and only what the figures below need: a big shelf's books carry chapter lists, notes,
        // and reviews that would take far longer to read than the figures take to work out.
        shelf = await db.Books.AsNoTracking()
            .Select(book => new Book
            {
                Id = book.Id,
                Title = book.Title,
                Author = book.Author,
                Status = book.Status,
                FinishedOn = book.FinishedOn,
                Pages = book.Pages,
                Series = book.Series,
                Tags = book.Tags.ToList(),
                Sessions = book.Sessions.ToList(),
            })
            .ToListAsync();
        var year = DateOnly.FromDateTime(DateTime.UtcNow).Year;
        finished = BookRules.FinishedInYear(shelf, year).ToList();
        lately = BookRules.RecentSessions(shelf).ToList();
        listening = await AudioPlayback.SummaryAsync(db);
        reading = await ReadingTime.SummaryAsync(db);
        // A day spent listening, or with a book open in the reader, is a day of reading too.
        var listenedOn = await db.ListeningDays.AsNoTracking().Select(day => day.Day).ToListAsync();
        var readOn = await db.ReadingDays.AsNoTracking().Select(day => day.Day).ToListAsync();
        yearOfReading = await Insights.YearAsync(db, Today);
        (favouriteAuthors, favouriteKinds, favouriteSeries) = Insights.Favourites(shelf);
        milestones = Insights.Milestones(shelf, stats.YearlyGoal, Today);
        sessionDays = [.. shelf.SelectMany(book => book.Sessions).Select(session => session.Date)];
        finishedByMonth = new int[12];
        foreach (var book in shelf)
        {
            if (book.Status == BookStatus.Finished && book.FinishedOn is DateOnly done && done.Year == Today.Year)
            {
                finishedByMonth[done.Month - 1]++;
            }
        }

        var pages = shelf.ToDictionary(book => book.Id, book => book.Pages ?? 0);
        pagesThisYear = finished.Sum(book => pages.GetValueOrDefault(book.Id));
        marked = null;
        streak = BookRules.ReadingStreak(shelf.SelectMany(book => book.Sessions).Select(session => session.Date).Concat(listenedOn).Concat(readOn), DateOnly.FromDateTime(DateTime.UtcNow));
    }

    private DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);


    private DateOnly ThisMonth => new(Today.Year, Today.Month, 1);

    private int LeadingBlanks => ((int)shown.DayOfWeek + 6) % 7;

    // Worked out once, not on every drawing: the days with a session logged, the month whose days are marked, and
    // the books finished each month and the pages in those finished this year.
    private List<DateOnly> sessionDays = [];
    private (DateOnly Month, HashSet<int> Days)? marked;
    private int[] finishedByMonth = new int[12];
    private int pagesThisYear;

    private HashSet<int> Marked
    {
        get
        {
            if (marked is not var (month, days) || month != shown)
            {
                days = BookRules.ReadingDays(sessionDays, shown.Year, shown.Month).ToHashSet();
                marked = (shown, days);
            }

            return days;
        }
    }

    private string DayClass(int day)
    {
        var date = new DateOnly(shown.Year, shown.Month, day);
        var classes = new List<string>();
        if (date == Today)
        {
            classes.Add("today");
        }

        if (Marked.Contains(day))
        {
            classes.Add("read");
        }

        if (chosen == date)
        {
            classes.Add("chosen");
        }

        return string.Join(' ', classes);
    }

    private void ChooseDay(int day)
    {
        var date = new DateOnly(shown.Year, shown.Month, day);
        chosen = chosen == date ? null : date;
    }

    private void Earlier()
    {
        shown = shown.AddMonths(-1);
        chosen = null;
    }

    private void Later()
    {
        if (shown >= ThisMonth)
        {
            return;
        }

        shown = shown.AddMonths(1);
        chosen = null;
    }

    private int FinishedIn(int month) => finishedByMonth[month - 1];

    private int BarWidth(int count)
    {
        var most = finishedByMonth.Max();
        return most == 0 ? 0 : (int)Math.Round(100.0 * count / most);
    }

    private BookRules.Goals goals = new(0, 0, 0);
    private YearOfReading? yearOfReading;
    private Favourite[] favouriteAuthors = [];
    private Favourite[] favouriteKinds = [];
    private Favourite[] favouriteSeries = [];
    private Milestone[] milestones = [];

    private (string Title, Favourite[] Items)[] FavouriteLists => [(T("Authors"), favouriteAuthors), (T("Kinds of book"), favouriteKinds), (T("Series"), favouriteSeries)];
    private bool showAllMilestones;

    private static string YearDayClass(ActivityDay day) => day.Level < 0 ? "day l0 future" : $"day l{day.Level}";

    private static string DayTitle(ActivityDay day) => day.Level <= 0
        ? day.Day.Medium()
        : day.Day.Medium() + " · " + string.Join(", ", new[] { day.Minutes > 0 ? BookProgress.Span(day.Minutes * 60) : null, day.Pages > 0 ? T("{0} pages", day.Pages) : null }.OfType<string>().DefaultIfEmpty(T("read")));

    // Pages of the books finished this year, and whole hours spent with books this year.
    private int PagesThisYear => pagesThisYear;

    private int HoursThisYear => (int)(((reading?.YearSeconds ?? 0) + (listening?.YearSeconds ?? 0)) / 3600);

    private async Task SaveGoal()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await BookRules.SetGoalsAsync(db, goal.YearlyGoal, goal.PagesGoal, goal.HoursGoal);
        goalSaved = true;
        await LoadAsync();
    }
}
