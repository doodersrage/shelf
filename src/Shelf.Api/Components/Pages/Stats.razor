@page "/stats"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>@T("Stats") · Shelf</PageTitle>

<h1>@T("Stats")</h1>

@if (stats is null)
{
    <p class="hint">@T("Counting the shelf…")</p>
}
else if (stats.Total == 0)
{
    <EmptyState Title="@T("Nothing to count yet")" Text="@T("Stats fill in as you add books and log reading sessions.")" ActionHref="/?add=1" ActionLabel="@T("Add a book")" />
}
else
{
    <section class="panel" aria-labelledby="goal-heading">
        <h2 id="goal-heading">@Today.Year</h2>
        <p class="hint"><a href="/years/@Today.Year">@T("Your {0} in books", Today.Year)</a></p>
        @if (stats.YearlyGoal > 0)
        {
            <p>@((MarkupString)T("<strong>{0}</strong> of {1} books finished this year", stats.FinishedThisYear, stats.YearlyGoal))</p>
            <progress class="goal" max="@stats.YearlyGoal" value="@Math.Min(stats.FinishedThisYear, stats.YearlyGoal)" aria-label="@T("{0} of {1} books finished", stats.FinishedThisYear, stats.YearlyGoal)"></progress>
            @if (stats.FinishedThisYear >= stats.YearlyGoal)
            {
                <p class="milestone">@T("You reached this year's goal.")</p>
            }
        }
        else
        {
            <p>@T("Finished this year: {0}. Set a goal below if you would like one.", Localization.Counts.Books(stats.FinishedThisYear))</p>
        }
        @if (streak > 1)
        {
            <p class="hint">@T("{0} days of reading in a row.", streak)</p>
        }
        else if (streak == 1)
        {
            <p class="hint">@T("You read today or yesterday.")</p>
        }

        <h3>@T("Finished each month")</h3>
        <ul class="month-bars" aria-label="@T("Books finished each month this year")">
            @for (var month = 1; month <= 12; month++)
            {
                var count = FinishedIn(month);
                <li>
                    <span class="label">@(new DateOnly(Today.Year, month, 1).ToString("MMM"))</span>
                    <span class="bar"><span style="width:@(BarWidth(count))%"></span></span>
                    <span class="value">@count</span>
                </li>
            }
        </ul>

        <EditForm Model="goal" OnValidSubmit="SaveGoal">
            <DataAnnotationsValidator />
            <label class="inline-date">
                @T("Books to finish this year")
                <InputNumber @bind-Value="goal.YearlyGoal" min="0" max="1000" />
            </label>
            <button type="submit">@T("Save goal")</button>
            <ValidationMessage For="() => goal.YearlyGoal" />
            @if (goalSaved)
            {
                <span class="saved" role="status">@T("Saved.")</span>
            }
        </EditForm>
    </section>

    <div class="stats">
        <p><strong>@stats.Total</strong><span>@T("Books")</span></p>
        <p><strong>@stats.Reading</strong><span>@T("Reading")</span></p>
        <p><strong>@stats.Want</strong><span>@T("Want to read")</span></p>
        <p><strong>@stats.Finished</strong><span>@T("Finished")</span></p>
        <p><strong>@stats.Abandoned</strong><span>@T("Abandoned")</span></p>
        <p><strong>@stats.PagesRead</strong><span>@T("Pages read")</span></p>
        <p><strong>@stats.FinishedThisYear</strong><span>@T("Finished this year")</span></p>
        <p><strong>@(stats.AverageRating?.ToString("0.##") ?? "—")</strong><span>@T("Average rating")</span></p>
        <p><strong>@stats.Loved</strong><span>@T("Loved")</span></p>
        <p><strong>@stats.OnLoan</strong><span>@T("On loan")</span></p>
    </div>

    <section class="panel" aria-labelledby="month-heading">
        <h2 id="month-heading">@shown.MonthYear()</h2>
        <p>
            <button type="button" class="quiet" @onclick="Earlier">@T("Earlier")</button>
            @if (shown < ThisMonth)
            {
                <button type="button" class="quiet" @onclick="Later">@T("Later")</button>
            }
        </p>
        <div class="month">
            @foreach (var name in Weekdays)
            {
                <span class="weekday">@name</span>
            }
            @for (var blank = 0; blank < LeadingBlanks; blank++)
            {
                <span></span>
            }
            @for (var day = 1; day <= DateTime.DaysInMonth(shown.Year, shown.Month); day++)
            {
                var current = day;
                if (Marked.Contains(current))
                {
                    <button type="button" class="@DayClass(current)" aria-pressed="@(chosen == new DateOnly(shown.Year, shown.Month, current) ? "true" : "false")" aria-label="@T("{0}, read", new DateOnly(shown.Year, shown.Month, current).FullMonthDay())" @onclick="() => ChooseDay(current)">@current</button>
                }
                else
                {
                    <span class="@DayClass(current)">@current</span>
                }
            }
        </div>
        @if (Marked.Count == 0)
        {
            <p class="hint">@T("Nothing logged this month. Reading sessions logged on a book's page show here.")</p>
        }
        else
        {
            <p class="hint">@T("Days with a reading session are filled. Choose one to see what you read.")</p>
        }
        @if (chosen is DateOnly selected)
        {
            <h3>@selected.FullMonthDay()</h3>
            <ul class="tag-counts">
                @foreach (var reading in BookRules.ReadingsOn(shelf, selected))
                {
                    <li>
                        <a href="/library/@reading.BookId">@reading.Title</a>
                        @if (reading.FromPage is int from && reading.ToPage is int to)
                        {
                            <span class="hint"> · @from–@to</span>
                        }
                        else if (reading.ToPage is int end)
                        {
                            <span class="hint"> · @T("to {0}", end)</span>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    @if (reading is { TotalSeconds: > 0 })
    {
        <TimePanel Id="reading-heading" Title="@T("Reading time")" Summary="reading" BarsLabel="@T("Time spent reading each day for the last two weeks")" TopTitle="@T("Most read this year")" />
    }

    @if (listening is { TotalSeconds: > 0 })
    {
        <TimePanel Id="listening-heading" Title="@T("Listening")" Summary="listening" BarsLabel="@T("Time spent listening each day for the last two weeks")" TopTitle="@T("Most listened this year")" />
    }

    @if (finished.Count > 0)
    {
        <h2>@T("Finished this year")</h2>
        <ul class="tag-counts">
            @foreach (var book in finished)
            {
                <li>
                    <a href="/library/@book.Id">@book.Title</a>
                    <span class="hint">@book.FinishedOn.MonthDay()</span>
                </li>
            }
        </ul>
    }

    @if (lately.Count > 0)
    {
        <h2>@T("Lately")</h2>
        <ul class="tag-counts">
            @foreach (var session in lately)
            {
                <li>
                    <span>
                        <a href="/library/@session.BookId">@session.Title</a>
                        @if (session.FromPage is int from && session.ToPage is int to)
                        {
                            <span class="hint"> · @from–@to</span>
                        }
                        else if (session.ToPage is int end)
                        {
                            <span class="hint"> · @T("to {0}", end)</span>
                        }
                    </span>
                    <span class="hint">@session.Date.MonthDay()</span>
                </li>
            }
        </ul>
    }

    <h2>@T("Tags")</h2>
    @if (stats.Tags.Length == 0)
    {
        <p class="hint">@T("No tags yet. Tags added to a book's details gather here.")</p>
    }
    else
    {
        <ul class="tag-counts">
            @foreach (var tag in stats.Tags)
            {
                <li>
                    <a href="@($"/?tag={Uri.EscapeDataString(tag.Name)}")">@tag.Name</a>
                    <span class="hint">@tag.Count</span>
                </li>
            }
        </ul>
    }
}

@code {
    // Monday first, in the reader's own day names.
    private static string[] Weekdays
    {
        get
        {
            var names = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedDayNames;
            return [.. names.Skip(1), names[0]];
        }
    }

    private ShelfStatsResponse? stats;
    private List<Book> shelf = [];
    private List<FinishedBook> finished = [];
    private List<RecentSession> lately = [];
    private int streak;
    private ListeningSummary? listening;
    private ListeningSummary? reading;
    private DateOnly shown = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
    private DateOnly? chosen;
    private readonly GoalFormModel goal = new();
    private bool goalSaved;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        stats = await BookRules.SummarizeAsync(db);
        goal.YearlyGoal = stats.YearlyGoal;
        shelf = await db.Books.AsNoTracking().Include(book => book.Sessions).ToListAsync();
        var year = DateOnly.FromDateTime(DateTime.UtcNow).Year;
        finished = BookRules.FinishedInYear(shelf, year).ToList();
        lately = BookRules.RecentSessions(shelf).ToList();
        listening = await AudioPlayback.SummaryAsync(db);
        reading = await ReadingTime.SummaryAsync(db);
        // A day spent listening, or with a book open in the reader, is a day of reading too.
        var listenedOn = await db.ListeningDays.AsNoTracking().Select(day => day.Day).ToListAsync();
        var readOn = await db.ReadingDays.AsNoTracking().Select(day => day.Day).ToListAsync();
        streak = BookRules.ReadingStreak(shelf.SelectMany(book => book.Sessions).Select(session => session.Date).Concat(listenedOn).Concat(readOn), DateOnly.FromDateTime(DateTime.UtcNow));
    }

    private DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);


    private DateOnly ThisMonth => new(Today.Year, Today.Month, 1);

    private int LeadingBlanks => ((int)shown.DayOfWeek + 6) % 7;

    private HashSet<int> Marked => BookRules.ReadingDays(
        shelf.SelectMany(book => book.Sessions).Select(session => session.Date),
        shown.Year,
        shown.Month).ToHashSet();

    private string DayClass(int day)
    {
        var date = new DateOnly(shown.Year, shown.Month, day);
        var classes = new List<string>();
        if (date == Today)
        {
            classes.Add("today");
        }

        if (Marked.Contains(day))
        {
            classes.Add("read");
        }

        if (chosen == date)
        {
            classes.Add("chosen");
        }

        return string.Join(' ', classes);
    }

    private void ChooseDay(int day)
    {
        var date = new DateOnly(shown.Year, shown.Month, day);
        chosen = chosen == date ? null : date;
    }

    private void Earlier()
    {
        shown = shown.AddMonths(-1);
        chosen = null;
    }

    private void Later()
    {
        if (shown >= ThisMonth)
        {
            return;
        }

        shown = shown.AddMonths(1);
        chosen = null;
    }

    private int FinishedIn(int month) =>
        shelf.Count(book => book.Status == BookStatus.Finished && book.FinishedOn is DateOnly done && done.Year == Today.Year && done.Month == month);

    private int BarWidth(int count)
    {
        var most = Enumerable.Range(1, 12).Max(FinishedIn);
        return most == 0 ? 0 : (int)Math.Round(100.0 * count / most);
    }

    private async Task SaveGoal()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await BookRules.SetGoalAsync(db, goal.YearlyGoal);
        goalSaved = true;
        await LoadAsync();
    }
}
