@page "/clubs/{Id:int}"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory
@inject NavigationManager Navigation
@using Microsoft.JSInterop
@inject IJSRuntime Js

<PageTitle>@(club?.Name ?? T("Book clubs")) · Shelf</PageTitle>

@if (club is null)
{
    <h1>@T("Not on the shelf")</h1>
    <p>@T("That club is not here, or you are not in it.") <a href="/clubs">@T("Book clubs")</a></p>
}
else
{
    <p class="hint"><a href="/clubs">@T("Book clubs")</a></p>
    <h1>@club.Name</h1>
    @if (club.Description is not null)
    {
        <p class="collection-description">@club.Description</p>
    }
    <p class="hint">@string.Join(", ", club.Members.Select(member => member.Owner ? T("{0} (started it)", member.Name) : member.Name))</p>

    <div class="club-layout">
        <section class="panel">
            <h2>@T("Books")</h2>
            @if (club.Books.Length == 0)
            {
                <p class="hint">@T("No books yet. Add the first below.")</p>
            }
            else
            {
                <ul class="club-books">
                    @foreach (var book in club.Books)
                    {
                        <li class="@(book.Id == Chosen ? "chosen" : null)">
                            <button type="button" class="link" @onclick="() => Choose(book.Id)" aria-pressed="@(book.Id == Chosen ? "true" : "false")">
                                <strong>@book.Title</strong>
                            </button>
                            <span class="hint">@book.Author @(book.Id == club.CurrentBookId ? " · " + T("reading now") : "") · @T("{0} posts", book.Posts)</span>
                        </li>
                    }
                </ul>
            }
            <details>
                <summary>@T("Add a book")</summary>
                @if (shelf.Count > 0)
                {
                    <div class="save-search">
                        <label>
                            @T("From your shelf")
                            <select @bind="fromShelf">
                                <option value="0">—</option>
                                @foreach (var own in shelf)
                                {
                                    <option value="@own.Id">@own.Title · @own.Author</option>
                                }
                            </select>
                        </label>
                        <button type="button" @onclick="AddFromShelf" disabled="@(fromShelf == 0)">@T("Add")</button>
                    </div>
                }
                <div class="save-search">
                    <label>
                        @T("Title")
                        <input @bind="newTitle" @bind:event="oninput" maxlength="@ClubBook.MaxTitleLength" />
                    </label>
                    <label>
                        @T("Author")
                        <input @bind="newAuthor" @bind:event="oninput" maxlength="@ClubBook.MaxTitleLength" />
                    </label>
                    <button type="button" @onclick="AddByTitle" disabled="@(string.IsNullOrWhiteSpace(newTitle) || string.IsNullOrWhiteSpace(newAuthor))">@T("Add")</button>
                </div>
            </details>
        </section>

        @if (ChosenBook is { } chosen)
        {
            <section class="panel club-talk" aria-labelledby="talk-heading">
                <h2 id="talk-heading">@chosen.Title</h2>
                <p class="hint">@chosen.Author · @T("added by {0}", chosen.AddedBy)</p>
                <p>
                    @if (chosen.Id != club.CurrentBookId)
                    {
                        <button type="button" class="quiet" @onclick="() => MakeCurrent(chosen.Id)">@T("Read this one now")</button>
                    }
                    @if (chosen.OnMyShelf is int mine)
                    {
                        <a class="button quiet" href="/library/@mine">@T("Your copy")</a>
                    }
                    else
                    {
                        <button type="button" class="quiet" @onclick="() => Shelve(chosen.Id)">@T("Put it on my shelf")</button>
                    }
                </p>
                @if (posts.Length == 0)
                {
                    <p class="hint">@T("Nobody has said anything yet.")</p>
                }
                else
                {
                    <ol class="club-posts">
                        @foreach (var post in posts)
                        {
                            <li class="@(post.Mine ? "mine" : null)">
                                <p class="hint"><strong>@post.Reader</strong> · @post.PostedAt.Medium()</p>
                                @if (post.Spoiler && !post.Mine)
                                {
                                    <details class="spoiler">
                                        <summary>@T("A spoiler: open it when you've read further")</summary>
                                        <p class="collection-description">@post.Text</p>
                                    </details>
                                }
                                else
                                {
                                    <p class="collection-description">@post.Text</p>
                                    @if (post.Spoiler)
                                    {
                                        <p class="hint">@T("Folded away for the others as a spoiler.")</p>
                                    }
                                }
                            </li>
                        }
                    </ol>
                }
                <form @onsubmit="Post" @onsubmit:preventDefault>
                    <label>
                        @T("Say something about it")
                        <textarea @bind="postText" @bind:event="oninput" maxlength="@ClubPost.MaxLength" rows="3"></textarea>
                    </label>
                    <label class="check">
                        <input type="checkbox" @bind="postSpoiler" />
                        @T("It gives something away: fold it until opened")
                    </label>
                    <button type="submit" class="primary" disabled="@string.IsNullOrWhiteSpace(postText)">@T("Post")</button>
                </form>
            </section>
        }
    </div>

    <section class="panel club-meetings" aria-labelledby="meetings-heading">
        <h2 id="meetings-heading">@T("Meetings")</h2>
        @if (meetings.Length == 0)
        {
            <p class="hint">@(club.Mine ? T("No meetings yet. Arrange the first below.") : T("No meetings yet. The reader who started the club arranges them."))</p>
        }
        else
        {
            <ol class="meetings">
                @foreach (var meeting in meetings)
                {
                    <li class="meeting @(meeting.Begun ? "past" : "coming")">
                        <h3>@When(meeting) · @meeting.BookTitle</h3>
                        @if (meeting.Through is not null)
                        {
                            <p>@T("Read through: {0}", meeting.Through)</p>
                        }
                        @if (meeting.Agenda is not null)
                        {
                            <p class="collection-description">@meeting.Agenda</p>
                        }
                        @if (meeting.Questions.Length > 0)
                        {
                            <h4>@T("Questions")</h4>
                            <ul class="tag-counts">
                                @foreach (var question in meeting.Questions)
                                {
                                    <li><span>@question.Text <span class="hint">· @question.Reader</span></span></li>
                                }
                            </ul>
                        }
                        @if (meeting.Waiting > 0)
                        {
                            <p class="hint">@(meeting.Waiting == 1 ? T("1 question from another member, shown when the meeting begins.") : T("{0} questions from other members, shown when the meeting begins.", meeting.Waiting))</p>
                        }
                        @if (!meeting.Begun)
                        {
                            <form class="save-search" @onsubmit="() => Ask(meeting.Id)" @onsubmit:preventDefault>
                                <label>
                                    @T("A question for the meeting")
                                    <input @bind="questionText[meeting.Id]" maxlength="@ClubQuestion.MaxLength" />
                                </label>
                                <button type="submit">@T("Send")</button>
                            </form>
                            <p class="hint">@(club.Mine ? T("Members' questions are seen by you, to plan, and by everyone once the meeting begins.") : T("Only you and whoever runs the meeting see your question until it begins."))</p>
                        }
                        @if (meeting.Summary is not null && summarizing != meeting.Id)
                        {
                            <h4>@T("What was said")</h4>
                            <p class="collection-description">@meeting.Summary</p>
                        }
                        @if (club.Mine)
                        {
                            @if (summarizing == meeting.Id)
                            {
                                <form @onsubmit="() => SaveSummary(meeting.Id)" @onsubmit:preventDefault>
                                    <label>
                                        @T("What was said")
                                        <textarea @bind="summaryText" maxlength="@ClubMeeting.MaxSummaryLength" rows="4"></textarea>
                                    </label>
                                    <button type="submit">@T("Save")</button>
                                    <button type="button" class="quiet" @onclick="() => summarizing = null">@T("Cancel")</button>
                                </form>
                            }
                            else
                            {
                                <p class="toolbar-actions">
                                    @if (meeting.Begun)
                                    {
                                        <button type="button" class="quiet" @onclick="() => StartSummary(meeting)">@(meeting.Summary is null ? T("Write what was said") : T("Change what was said"))</button>
                                    }
                                    <button type="button" class="quiet" @onclick="() => Cancel(meeting.Id)">@(meeting.Begun ? T("Take it off the list") : T("Call it off"))</button>
                                </p>
                            }
                        }
                    </li>
                }
            </ol>
        }
        @if (club.Mine && club.Books.Length > 0)
        {
            <details>
                <summary>@T("Arrange a meeting")</summary>
                <form @onsubmit="Arrange" @onsubmit:preventDefault>
                    <div class="pair">
                        <label>
                            @T("When")
                            <input type="datetime-local" @bind="meetingAt" required />
                        </label>
                        <label>
                            @T("About")
                            <select @bind="meetingBook">
                                @foreach (var book in club.Books)
                                {
                                    <option value="@book.Id">@book.Title</option>
                                }
                            </select>
                        </label>
                    </div>
                    <label>
                        @T("How far everyone reads by then")
                        <input @bind="meetingThrough" maxlength="@ClubMeeting.MaxThroughLength" placeholder="@T("Chapters 1–8, or to page 120")" />
                    </label>
                    <label>
                        @T("What to talk about")
                        <textarea @bind="meetingAgenda" maxlength="@ClubMeeting.MaxAgendaLength" rows="3"></textarea>
                    </label>
                    <button type="submit" class="primary">@T("Arrange it")</button>
                </form>
            </details>
        }
    </section>

    <section class="panel">
        <h2>@T("Members")</h2>
        <ul class="tag-counts">
            @foreach (var member in club.Members)
            {
                <li>
                    <span>@member.Name@(member.Owner ? " · " + T("started it") : "")</span>
                    @if (club.Mine && !member.Owner)
                    {
                        <button type="button" class="quiet" @onclick="() => Remove(member.Id)" aria-label="@T("Remove {0} from the club", member.Name)">@T("Remove")</button>
                    }
                </li>
            }
        </ul>
        @if (club.Mine)
        {
            @if (others.Count > 0)
            {
                <div class="save-search">
                    <label>
                        @T("Invite a reader")
                        <select @bind="invite">
                            <option value="0">—</option>
                            @foreach (var reader in others)
                            {
                                <option value="@reader.Id">@reader.Name</option>
                            }
                        </select>
                    </label>
                    <button type="button" @onclick="Invite" disabled="@(invite == 0)">@T("Invite")</button>
                </div>
            }
            @if (confirmingEnd)
            {
                <button type="button" class="danger" @onclick="End">@T("Yes, end the club")</button>
                <button type="button" class="quiet" @onclick="() => confirmingEnd = false">@T("Cancel")</button>
            }
            else
            {
                <button type="button" class="quiet" @onclick="() => confirmingEnd = true">@T("End the club")</button>
            }
        }
        else
        {
            <button type="button" class="quiet" @onclick="Leave">@T("Leave the club")</button>
        }
    </section>
}

@code {
    private ClubResponse? club;
    private ClubPostResponse[] posts = [];
    private List<Book> shelf = [];
    private List<ReaderResponse> others = [];
    private int chosenId;
    private int fromShelf;
    private int invite;
    private string newTitle = "";
    private string newAuthor = "";
    private string postText = "";
    private bool confirmingEnd;
    private int me;
    private bool postSpoiler;
    private ClubMeetingResponse[] meetings = [];
    private readonly Dictionary<int, string> questionText = [];
    private DateTime? meetingAt;
    private int meetingBook;
    private string meetingThrough = "";
    private string meetingAgenda = "";
    private int? summarizing;
    private string summaryText = "";

    // The browser's time zone, once the page is live: meetings are shown, and arranged, in it. Until then, a
    // meeting is shown in the zone it was arranged in, named.
    private string? viewerZone;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await using var clock = await Js.InvokeAsync<IJSObjectReference>("import", "./clock.js");
            viewerZone = await clock.InvokeAsync<string>("zone");
            StateHasChanged();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
        }
    }

    private string When(ClubMeetingResponse meeting) =>
        ClubMeetings.Zone(viewerZone) is not null ? ClubMeetings.Say(meeting.At, viewerZone, nameZone: false) : ClubMeetings.Say(meeting.At, meeting.TimeZone);

    private async Task Ask(int meetingId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await ClubMeetings.AskAsync(db, Id, meetingId, questionText.GetValueOrDefault(meetingId)) == ClubProblem.None)
        {
            questionText[meetingId] = "";
        }

        await LoadAsync();
    }

    private async Task Arrange()
    {
        if (meetingAt is not DateTime at)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var request = new ClubMeetingRequest(meetingBook == 0 ? Chosen : meetingBook, ClubMeetings.FromLocal(at, viewerZone), meetingThrough, meetingAgenda, viewerZone);
        if ((await ClubMeetings.ArrangeAsync(db, Id, request)).Problem == ClubProblem.None)
        {
            (meetingAt, meetingThrough, meetingAgenda) = (null, "", "");
        }

        await LoadAsync();
    }

    private void StartSummary(ClubMeetingResponse meeting)
    {
        summarizing = meeting.Id;
        summaryText = meeting.Summary ?? "";
    }

    private async Task SaveSummary(int meetingId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await ClubMeetings.SummarizeAsync(db, Id, meetingId, summaryText);
        summarizing = null;
        await LoadAsync();
    }

    private async Task Cancel(int meetingId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await ClubMeetings.CancelAsync(db, Id, meetingId);
        await LoadAsync();
    }

    [Parameter]
    public int Id { get; set; }

    private int Chosen => chosenId != 0 ? chosenId : club?.CurrentBookId ?? 0;

    private ClubBookResponse? ChosenBook => club?.Books.FirstOrDefault(book => book.Id == Chosen);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        me = db.ReaderId;
        club = await Clubs.FindAsync(db, Id);
        if (club is null)
        {
            return;
        }

        shelf = await db.Books.AsNoTracking().OrderBy(book => book.Title).Select(book => new Book { Id = book.Id, Title = book.Title, Author = book.Author }).ToListAsync();
        var members = club.Members.Select(member => member.Id).ToHashSet();
        others = (await ReaderRules.OthersAsync(db, me)).Where(reader => !members.Contains(reader.Id)).ToList();
        posts = Chosen == 0 ? [] : await Clubs.PostsAsync(db, Id, Chosen) ?? [];
        meetings = await ClubMeetings.ListAsync(db, Id) ?? [];
        foreach (var meeting in meetings)
        {
            questionText.TryAdd(meeting.Id, "");
        }

        meetingBook = meetingBook == 0 ? club.CurrentBookId ?? 0 : meetingBook;
    }

    private async Task Choose(int bookId)
    {
        chosenId = bookId;
        await LoadAsync();
    }

    private async Task AddFromShelf()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var (added, _) = await Clubs.AddBookAsync(db, Id, new ClubBookRequest(BookId: fromShelf));
        fromShelf = 0;
        chosenId = added ?? chosenId;
        await LoadAsync();
    }

    private async Task AddByTitle()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var (added, _) = await Clubs.AddBookAsync(db, Id, new ClubBookRequest(Title: newTitle, Author: newAuthor));
        (newTitle, newAuthor) = ("", "");
        chosenId = added ?? chosenId;
        await LoadAsync();
    }

    private async Task MakeCurrent(int bookId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await Clubs.SetCurrentAsync(db, Id, bookId);
        await LoadAsync();
    }

    private async Task Shelve(int bookId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await Clubs.ShelveAsync(db, Id, bookId);
        await LoadAsync();
    }

    private async Task Post()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await Clubs.PostAsync(db, Id, Chosen, postText, spoiler: postSpoiler) == ClubProblem.None)
        {
            (postText, postSpoiler) = ("", false);
        }

        await LoadAsync();
    }

    private async Task Invite()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await Clubs.InviteAsync(db, Id, invite);
        invite = 0;
        await LoadAsync();
    }

    private async Task Remove(int readerId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await Clubs.RemoveMemberAsync(db, Id, readerId);
        await LoadAsync();
    }

    private async Task Leave()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await Clubs.RemoveMemberAsync(db, Id, me);
        Navigation.NavigateTo("/clubs");
    }

    private async Task End()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await Clubs.DeleteAsync(db, Id);
        Navigation.NavigateTo("/clubs");
    }
}
