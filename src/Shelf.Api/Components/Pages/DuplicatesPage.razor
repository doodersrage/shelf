@page "/duplicates"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory
@inject EbookStore Ebooks
@inject AudioStore Audio
@inject CoverStore Covers
@inject IConfiguration Configuration

<PageTitle>@T("Duplicates") · Shelf</PageTitle>

<h1>@T("Duplicates")</h1>
<p class="hint">@T("Books that look like the same book: the same ISBN, the same title and author, or titles alike but for a subtitle or an edition, by the same author. The surest come first. Keep one, and the other's details, notes, quotes, highlights, reading log, and files it lacks come across to it before the other goes.") @T("You'll see what moves and what goes before anything changes.")</p>

<StatusNote Text="@note" Problem="problem" />

@if (groups is null)
{
}
else if (groups.Length == 0)
{
    <EmptyState Title="@T("No duplicates")" Text="@T("No two books on your shelf look like the same book.")" ActionHref="/" ActionLabel="@T("Open the library")" />
}
else
{
    @foreach (var group in groups)
    {
        <section class="panel duplicate-group">
            <h2>@group.Books[0].Title</h2>
            <p class="hint">
                @(group.Reason switch
                {
                    "isbn" => T("The same ISBN, {0}.", group.Books[0].Isbn ?? ""),
                    "title" => T("The same title and author."),
                    _ => T("Titles alike, by the same author."),
                })
                <span class="badge">@T("{0}% sure", group.Score)</span>
            </p>
            <ul class="duplicate-books">
                @foreach (var book in group.Books)
                {
                    <li class="strip-card">
                        <BookCover Title="@book.Title" Url="@book.CoverUrl" />
                        <div>
                            <p class="title"><a href="/library/@book.Id">@book.Title</a></p>
                            <p class="by">@book.Author@(book.Year is int year ? $" · {year}" : "")</p>
                            <p class="hint">
                                @BookRules.StatusLabel(book.Status)@(book.Format is BookFormat format ? " · " + BookRules.FormatLabel(format) : "")@(book.HasEbook ? " · " + T("e-book") : "")@(book.HasAudio ? " · " + T("audiobook") : "")
                                · @T("added {0}", book.AddedAt.Medium())
                            </p>
                        </div>
                        <button type="button" class="strip-action" @onclick="() => choice = (group, book.Id)" disabled="@busy" aria-pressed="@(choice?.Group == group && choice?.KeepId == book.Id ? "true" : "false")">@T("Keep this one")</button>
                    </li>
                }
            </ul>
            @if (choice?.Group != group)
            {
                <button type="button" class="quiet" @onclick="() => NotSame(group)" disabled="@busy">@T("These are different books")</button>
            }
            @* What a merge would do, said before it is done. *@
            @if (choice is var (chosenGroup, keepId) && chosenGroup == group)
            {
                var kept = group.Books.First(book => book.Id == keepId);
                <div class="merge-preview" role="region" aria-label="@T("What merging does")">
                    <p><strong>@T("Keeping the copy added {0}.", kept.AddedAt.Medium())</strong></p>
                    <ul>
                        @foreach (var line in Preview(group, keepId))
                        {
                            <li>@line</li>
                        }
                    </ul>
                    <p class="hint">@T("The other entry then goes to the trash, where it can be brought back for {0} days.", Trash.Days(Configuration))</p>
                    <button type="button" class="primary" @onclick="() => Keep(group, keepId)" disabled="@busy">@T("Merge")</button>
                    <button type="button" class="quiet" @onclick="() => choice = null" disabled="@busy">@T("Cancel")</button>
                </div>
            }
        </section>
    }
}

@code {
    private DuplicateGroup[]? groups;
    private string? note;
    private bool problem;
    private bool busy;
    private (DuplicateGroup Group, int KeepId)? choice;

    // What each other entry brings to the one kept, and what of it is deleted, in the order the merge takes them:
    // a file of a kind the kept one lacks comes across from the first that has one; any other such file goes.
    private static IEnumerable<string> Preview(DuplicateGroup group, int keepId)
    {
        var kept = group.Books.First(book => book.Id == keepId);
        var (hasEbook, hasAudio) = (kept.HasEbook, kept.HasAudio);
        foreach (var other in group.Books.Where(book => book.Id != keepId))
        {
            var comes = new List<string>();
            var goes = new List<string>();
            if (other.HasEbook)
            {
                (hasEbook ? goes : comes).Add(T("its e-book"));
                hasEbook = true;
            }

            if (other.HasAudio)
            {
                (hasAudio ? goes : comes).Add(T("its audiobook"));
                hasAudio = true;
            }

            if (other.Quotes > 0)
            {
                comes.Add(other.Quotes == 1 ? T("1 quote") : T("{0} quotes", other.Quotes));
            }

            if (other.Sessions > 0)
            {
                comes.Add(other.Sessions == 1 ? T("1 reading session") : T("{0} reading sessions", other.Sessions));
            }

            comes.Add(T("its highlights, notes, tags, and collections, and any details the one kept lacks"));
            yield return T("From the copy added {0}: {1}.", other.AddedAt.Medium(), string.Join(", ", comes));
            if (goes.Count > 0)
            {
                yield return T("Kept with the other entry in the trash, as the one kept has its own: {0}.", string.Join(", ", goes));
            }
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        groups = await Merging.FindAsync(db);
    }

    // Not the same book after all: the pair is not shown together again.
    private async Task NotSame(DuplicateGroup group)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await Merging.DismissAsync(db, [.. group.Books.Select(book => book.Id)]);
        (problem, note) = (false, T("They won't be shown together again."));
        await LoadAsync();
    }

    // The others in the group merge into the one chosen.
    private async Task Keep(DuplicateGroup group, int keepId)
    {
        busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            foreach (var other in group.Books.Where(book => book.Id != keepId))
            {
                var trouble = await Merging.MergeAsync(db, Ebooks, Audio, Covers, keepId, other.Id);
                if (trouble != MergeProblem.None)
                {
                    problem = true;
                    note = Merging.Describe(trouble);
                    await LoadAsync();
                    return;
                }
            }

            problem = false;
            choice = null;
            note = T("Merged into one book.");
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
