    private static string Bytes(long bytes) => bytes switch
    {
        >= 1024L * 1024 * 1024 => T("{0} GB", (bytes / (1024.0 * 1024 * 1024)).ToString("0.0", System.Globalization.CultureInfo.CurrentCulture)),
        >= 1024 * 1024 => T("{0} MB", (bytes / (1024.0 * 1024)).ToString("0", System.Globalization.CultureInfo.CurrentCulture)),
        _ => T("{0} KB", (bytes / 1024.0).ToString("0", System.Globalization.CultureInfo.CurrentCulture)),
    };

    private ShelfLinkSummary[] links = [];
    private string? linkCode;
    private string joinCode = "";
    private bool joining;
    private bool linkProblem;
    private string? linkNote;

    private string Address => EmailRules.PublicAddress(Configuration, null) is { Length: > 0 } configured ? configured : Navigation.BaseUri.TrimEnd('/');

    private async Task MakeLinkCode()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (!await StillAdminAsync(db))
        {
            return;
        }

        var (code, problem) = await Federation.InviteAsync(db, Address);
        (linkCode, linkProblem, linkNote) = (code, problem is not null, problem);
        links = await Federation.ListAsync(db);
    }

    private async Task Join()
    {
        joining = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (!await StillAdminAsync(db))
            {
                return;
            }

            var (link, problem) = await Federation.JoinAsync(db, joinCode, Address);
            (linkProblem, linkNote) = link is null ? (true, problem) : (false, T("Linked to {0}.", link.Name));
            joinCode = link is null ? joinCode : "";
            links = await Federation.ListAsync(db);
        }
        finally
        {
            joining = false;
        }
    }

    private async Task Unlink(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await StillAdminAsync(db))
        {
            await Federation.RemoveAsync(db, id);
            links = await Federation.ListAsync(db);
        }
    }

