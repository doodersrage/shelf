@page "/admin"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory
@inject EbookStore Ebooks
@inject AudioStore Audio
@inject CoverStore Covers
@inject BackupSchedule Schedule
@inject BackupCheck Checks
@inject FolderImport ImportFolder
@inject OffsiteBackup Offsite
@inject Federation Federation
@inject Storage Storage
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject IEmailSender Email
@inject IServiceProvider Services
@inject Microsoft.Extensions.Caching.Memory.IMemoryCache Cache

<PageTitle>@T("Shelf admin") · Shelf</PageTitle>

<div class="titled"><h1>@T("Shelf admin")</h1><HelpLink Page="security" Section="admins" /></div>

@if (!allowed)
{
    <p>@T("Only an admin of this shelf can manage readers.")</p>
}
else
{
    <p class="hint">@T("Readers and invitations, backups, and the shelf's own work.") <a href="/admin/health">@T("Server health")</a></p>

    <SectionTabs Label="@T("Shelf admin")" Tabs="AdminTabs" Sections="AdminSections" @bind-Active="tab" />

    @if (tab == "tab-readers")
    {
    <section class="panel" id="signup">
    <h2>@T("Who may sign up")</h2>
    <fieldset class="audible-take">
        <legend class="visually-hidden">@T("Who may sign up")</legend>
        @foreach (var (choice, label) in SignUpChoices)
        {
            <label class="check">
                <input type="radio" name="signup" checked="@(signUp == choice)" @onchange="() => SetSignUp(choice)" />
                @T(label)
            </label>
        }
    </fieldset>
    </section>

    <section class="panel" id="invites">
    <h2>@T("Invitations")</h2>
    <p class="hint">@T("Each address gets an email with a link to make an account, which works for a week, even when sign-up is closed. The account signs in with that address, already confirmed.")</p>
    @if (!Email.Enabled)
    {
        <p class="hint">@T("This shelf cannot send email, so pass each link on yourself.")</p>
    }
    <label>
        @T("Email addresses, separated by commas or one to a line, up to {0} at once", Management.MaxInvitesAtOnce)
        <textarea rows="3" @bind="inviteAddresses" @bind:event="oninput" autocomplete="off"></textarea>
    </label>
    <button type="button" class="primary" @onclick="Invite" disabled="@(inviting || string.IsNullOrWhiteSpace(inviteAddresses))">@(inviting ? T("Inviting…") : T("Invite"))</button>
    @if (invited.Count > 0)
    {
        <ul class="tag-counts" role="status">
            @foreach (var made in invited)
            {
                <li>
                    <span>@made.Email <span class="@(made.Problem is null ? "hint" : "late")">@(made.Problem ?? (made.Sent ? T("Sent.") : T("Pass this link on:")))</span></span>
                    @if (made.Link is not null && !made.Sent)
                    {
                        <code class="key">@made.Link</code>
                    }
                </li>
            }
        </ul>
    }
    @if (invitations.Length > 0)
    {
        <h3>@T("Sent")</h3>
        <ul class="tag-counts">
            @foreach (var invitation in invitations.Take(50))
            {
                <li>
                    <span>@invitation.Email
                        <span class="hint">
                            @if (invitation.AcceptedAt is { } accepted)
                            {
                                @T("joined {0} as {1}", accepted.Medium(), invitation.Reader ?? "")
                            }
                            else if (invitation.ExpiresAt < DateTimeOffset.UtcNow)
                            {
                                @T("expired {0}", invitation.ExpiresAt.Medium())
                            }
                            else
                            {
                                @T("by {0}, until {1}", invitation.InvitedBy, invitation.ExpiresAt.Medium())
                            }
                        </span>
                    </span>
                    @if (invitation.AcceptedAt is null)
                    {
                        <span>
                            <button type="button" class="quiet" @onclick="() => Resend(invitation.Id)">@T("Send again")</button>
                            <button type="button" class="quiet" @onclick="() => Revoke(invitation.Id)">@T("Withdraw")</button>
                        </span>
                    }
                </li>
            }
        </ul>
    }
    </section>

    <section class="panel" id="readers">
    <h2>@T("Readers")</h2>
    @if (problem is AccountProblem shown)
    {
        <p class="validation-message" role="alert">@ReaderRules.Describe(shown)</p>
    }
    <div class="reader-tools">
        <label>
            <span class="visually-hidden">@T("Find a reader")</span>
            <input type="search" @bind="readerFilter" @bind:event="oninput" placeholder="@T("Find a reader by name or email")" autocomplete="off" />
        </label>
        <label>
            <span class="visually-hidden">@T("Order")</span>
            <select @bind="readerOrder">
                <option value="name">@T("By name")</option>
                <option value="joined">@T("Newest first")</option>
                <option value="seen">@T("Last seen first")</option>
            </select>
        </label>
    </div>
    <p class="hint">@Localization.Counts.Readers(ShownReaders.Count)</p>
    <ul class="reader-rows">
        @foreach (var reader in ShownReaders)
        {
            <li>
                <details>
                    <summary>
                        <strong>@reader.Name</strong>
                        <span class="hint">@(reader.Email ?? reader.PendingEmail ?? T("no email address"))@(reader.Email is null && reader.PendingEmail is not null ? " · " + T("not confirmed") : "")</span>
                        <span class="reader-badges">
                            @if (reader.Id == me) { <span class="badge plain">@T("you")</span> }
                            @if (reader.IsAdmin) { <span class="badge plain">@T("admin")</span> }
                            @if (reader.Child) { <span class="badge plain">@T("a child's account")</span> }
                            @if (reader.Suspended) { <span class="badge">@T("suspended")</span> }
                            @if (reader.TwoStep) { <span class="badge plain">@T("two-step")</span> }
                        </span>
                        <span class="hint">@Localization.Counts.Books(reader.Books) · @T("since {0}", reader.CreatedAt.Medium()) · @(reader.LastSeenAt is { } seen ? T("last seen {0}", seen.Medium()) : T("not signed in now"))</span>
                    </summary>
                    <div class="reader-actions">
                        @if (passwords.TryGetValue(reader.Id, out var password))
                        {
                            <p>@T("New password:") <code class="key">@password</code></p>
                            <p class="hint">@T("It is not shown again. Every session {0} had is signed out.", reader.Name)</p>
                        }
                        @if (rowNotes.TryGetValue(reader.Id, out var rowNote))
                        {
                            <p class="@(rowNote.Problem ? "validation-message" : "saved")" role="status">@rowNote.Text</p>
                        }
                        <div class="reader-edit">
                            <label>
                                @T("Name")
                                <input value="@reader.Name" maxlength="@ReaderRules.MaxNameLength" @onchange="change => editNames[reader.Id] = change.Value?.ToString() ?? reader.Name" />
                            </label>
                            <button type="button" @onclick="() => Rename(reader.Id)">@T("Rename")</button>
                        </div>
                        <div class="reader-edit">
                            <label>
                                @T("Email address")
                                <input type="email" value="@reader.Email" maxlength="@EmailRules.MaxAddressLength" @onchange="change => editEmails[reader.Id] = change.Value?.ToString() ?? reader.Email ?? reader.PendingEmail" />
                            </label>
                            <button type="button" @onclick="() => SetEmail(reader.Id)">@T("Change it")</button>
                            @if (reader.PendingEmail is not null)
                            {
                                <button type="button" class="quiet" @onclick="() => ResendConfirmation(reader.Id)">@T("Send the confirmation link again")</button>
                            }
                        </div>
                        <p>
                            @if (reader.Id != me)
                            {
                                <button type="button" @onclick="() => Reset(reader.Id)">@T("New password")</button>
                                <button type="button" @onclick="() => SignOut(reader.Id)">@T("Sign out everywhere")</button>
                                <button type="button" @onclick="() => Suspend(reader.Id, !reader.Suspended)">@(reader.Suspended ? T("Restore") : T("Suspend"))</button>
                            }
                            @if (reader.Child)
                            {
                                <button type="button" @onclick="() => Release(reader.Id)">@T("Make it an ordinary account")</button>
                            }
                            else
                            {
                                <button type="button" @onclick="() => SetAdmin(reader.Id, !reader.IsAdmin)">@(reader.IsAdmin ? T("No longer admin") : T("Make admin"))</button>
                            }
                            @if (reader.Id != me)
                            {
                                @if (removing == reader.Id)
                                {
                                    <span class="hint">@T("Delete {0}, their {1}, and their files?", reader.Name, Localization.Counts.Books(reader.Books))</span>
                                    <button type="button" class="danger" @onclick="() => Remove(reader.Id)">@T("Yes, delete")</button>
                                    <button type="button" @onclick="() => removing = null">@T("Cancel")</button>
                                }
                                else
                                {
                                    <button type="button" class="danger" @onclick="() => removing = reader.Id">@T("Delete")</button>
                                }
                            }
                        </p>
                        <p class="hint">@T("Suspending keeps the shelf as it is and signs the reader out; no way of signing in works until they are restored.")</p>
                    </div>
                </details>
            </li>
        }
    </ul>
    </section>
    }

    @if (tab == "tab-backups")
    {
    <section class="panel" id="snapshot">
    <h2>@T("Snapshot")</h2>
    <p class="hint">@((MarkupString)T("Everything on this server in one zip: the database with every reader, and every e-book, audiobook, and cover picture. To restore it, stop the shelf and unpack it into a new data folder: <code>shelf.db</code> beside the app, and the <code>ebooks</code>, <code>audio</code>, and <code>covers</code> folders where they were."))</p>
    <a class="button primary" href="/admin/snapshot">@T("Download a snapshot")</a>
    </section>

    <section class="panel" id="backups">
    <h2>@T("Nightly backups")</h2>
    <p class="hint">@T("Each is proved after it is taken: read through, its database opened and checked, and brought up to this version, as a restore would.")</p>
    @if (!Schedule.Enabled)
    {
        <p class="hint">@T("Nightly backups are off (Backup:Enabled is false).")</p>
    }
    else
    {
        <p class="hint">@(Schedule.IncludeFiles
            ? T("Each night after {0}:00 UTC the shelf saves a snapshot of the database, with every e-book and audiobook, in {1}, keeping the last {2}.", Schedule.Hour.ToString("00"), Schedule.Folder, Schedule.Keep)
            : T("Each night after {0}:00 UTC the shelf saves a snapshot of the database in {1}, keeping the last {2}. E-books and audiobooks never change once saved; copy their folders along with these to keep everything.", Schedule.Hour.ToString("00"), Schedule.Folder, Schedule.Keep))</p>
    }
    @if (backups.Count == 0)
    {
        <p class="hint">@T("None yet.")</p>
    }
    else
    {
        <ul class="tag-counts">
            @foreach (var backup in backups)
            {
                <li>
                    <a href="/admin/backups/@backup.Name">@backup.TakenAt.Stamp() UTC</a>
                    <span class="hint">@Localization.Counts.Size(backup.Bytes)</span>
                    @switch (backup.Verdict)
                    {
                        case { Ok: true } proved:
                            <span class="hint">@T("Restores: {0} books, {1} readers, checked {2}", proved.Books.ToString("N0"), proved.Readers, proved.CheckedAt.Medium())</span>
                            break;
                        case { } failed:
                            <span class="late">@T("Would not restore: {0}", failed.Problem ?? "")</span>
                            break;
                        default:
                            <button type="button" class="quiet" @onclick="() => Drill(backup.Name)" disabled="@backingUp">@T("Check it restores")</button>
                            break;
                    }
                </li>
            }
        </ul>
    }
    @if (Offsite.CopyFolder is null && Offsite.S3Description is null)
    {
        <p class="hint">@((MarkupString)T("Kept on this server's disk only. <code>Backup:CopyTo</code> or <code>Backup:S3</code> settings send a copy of each somewhere else as well."))</p>
    }
    else
    {
        <p class="hint">@T("Each is copied to: {0}.", string.Join(", ", new[] { Offsite.CopyFolder, Offsite.S3Description }.OfType<string>()))</p>
        @foreach (var result in Offsite.Last)
        {
            <p class="@(result.Sent ? "hint" : "validation-message")">@(result.Sent ? T("Copied to {0} at {1} UTC.", result.Where, result.At.Stamp()) : T("Could not copy to {0}: {1}", result.Where, result.Problem ?? ""))</p>
        }
    }
    <button type="button" @onclick="BackUpNow" disabled="@backingUp">@(backingUp ? T("Backing up…") : T("Back up now"))</button>
    </section>

    }

    @if (tab == "tab-system")
    {
    <section class="panel" id="jobs">
    <h2>@T("Background work")</h2>
    <p class="hint">@T("Shelf does these on its own, on a schedule. Run one now rather than wait its turn.")</p>
    <ul class="tag-counts">
        @foreach (var job in Management.Jobs)
        {
            var beat = Heartbeats.All.FirstOrDefault(item => item.Job == job.Beat);
            <li>
                <span>@T(job.Label)
                    <span class="@(beat?.Problem is null ? "hint" : "late")">@(beat is null ? "" : beat.Problem is { } trouble ? T("went wrong {0}: {1}", beat.At.Medium(), trouble) : T("last ran {0}", beat.At.Medium()))</span>
                </span>
                <button type="button" class="quiet" @onclick="() => RunJob(job.Key)" disabled="@(running is not null)">@(running == job.Key ? T("Running…") : T("Run now"))</button>
            </li>
        }
    </ul>
    @if (jobNote is not null)
    {
        <p class="saved" role="status">@jobNote</p>
    }
    </section>

    <section class="panel" id="email">
    <h2>@T("Email")</h2>
    @if (!Email.Enabled)
    {
        <p class="hint">@((MarkupString)T("Off. Set <code>Email:Host</code> and <code>Email:From</code> for password resets, confirmations, invitations, and notifications by email."))</p>
    }
    else
    {
        <p class="hint">@T("Sent through {0} as {1}.", Configuration["Email:Host"] ?? "", Configuration["Email:From"] ?? "")</p>
        @if (Email.Problem is { } mailProblem)
        {
            <p class="validation-message">@T("The last email did not go: {0}", mailProblem)</p>
        }
        <button type="button" @onclick="TestEmail" disabled="@testingEmail">@T("Send me a test email")</button>
        @if (emailNote is not null)
        {
            <p class="@(emailProblem ? "validation-message" : "saved")" role="status">@emailNote</p>
        }
    }
    </section>

    <section class="panel" id="announcement">
    <h2>@T("Announcement")</h2>
    <p class="hint">@T("A note at the top of every page for every reader, until you take it down. Each reader can hide it for themselves.")</p>
    <label>
        @T("Announcement")
        <textarea rows="3" maxlength="@SiteSetting.MaxAnnouncementLength" @bind="announcementText" @bind:event="oninput"></textarea>
    </label>
    @if (Email.Enabled)
    {
        <label class="check">
            <input type="checkbox" @bind="announceByEmail" />
            @T("Email it to every reader too")
        </label>
    }
    <button type="button" class="primary" @onclick="Announce" disabled="@(string.IsNullOrWhiteSpace(announcementText) || announcing)">@T("Put it up")</button>
    @if (announced)
    {
        <button type="button" @onclick="TakeDown" disabled="@announcing">@T("Take it down")</button>
    }
    @if (announcementNote is not null)
    {
        <p class="saved" role="status">@announcementNote</p>
    }
    </section>

    <section class="panel" id="import">
    <h2>@T("Import folder")</h2>
    @if (ImportFolder.Folder is not { } watched)
    {
        <p class="hint">@((MarkupString)T("Off. Set <code>Import:Folder</code> to a folder, and books dropped into it are added on their own."))</p>
    }
    else
    {
        <p class="hint">@T("Shelf looks in {0} every minute. Each reader has a folder there named after them; a file in it becomes a book on their shelf, and a folder of tracks one audiobook. Files at the top go to the first admin. Once added, a file moves into .imported, and one Shelf cannot take into .not-added.", watched)</p>
        <button type="button" @onclick="MakeReaderFolders">@T("Make a folder for each reader")</button>
        @if (madeFolders is not null)
        {
            <p class="saved" role="status">@T("Ready: {0}", string.Join(", ", madeFolders.Select(Path.GetFileName)))</p>
        }
    }
    </section>

    <section class="panel" id="storage">
    <h2>@T("Storage")</h2>
    @if (storage is null)
    {
        <button type="button" @onclick="MeasureStorage" disabled="@measuring">@(measuring ? T("Measuring…") : T("Measure the space files take"))</button>
    }
    else
    {
        @if (storage.Free is long free && storage.Size is long size)
        {
            <p>@T("{0} free of {1} on the disk the files are on.", Bytes(free), Bytes(size))</p>
        }
        <div class="table-scroll">
        <table class="storage">
            <thead>
                <tr><th scope="col">@T("Reader")</th><th scope="col">@T("E-books")</th><th scope="col">@T("Audiobooks")</th><th scope="col">@T("Covers")</th><th scope="col">@T("Podcasts")</th><th scope="col">@T("In all")</th><th scope="col">@T("Limit, in MB")</th></tr>
            </thead>
            <tbody>
                @foreach (var use in storage.Readers)
                {
                    <tr>
                        <th scope="row">@use.Name</th>
                        <td>@Bytes(use.Ebooks)</td>
                        <td>@Bytes(use.Audio)</td>
                        <td>@Bytes(use.Covers)</td>
                        <td>@Bytes(use.Podcasts)</td>
                        <td class="@(use.LimitMegabytes is int limit && use.Total > Storage.Megabytes(limit) ? "late" : "")">@Bytes(use.Total)</td>
                        <td><input type="number" min="0" step="100" value="@use.LimitMegabytes" @onchange="change => SetLimit(use.ReaderId, change)" aria-label="@T("Storage limit for {0}, in megabytes", use.Name)" placeholder="@T("None")" /></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <p class="hint">@T("Shared by the shelf, not any one reader (Kobo copies, uploads waiting on a choice): {0}.", Bytes(storage.Shared)) @T("A reader past their limit can still read and listen; new files are refused until there is room.")</p>
    }
    </section>

    <section class="panel" id="links">
    <h2>@T("Linked shelves")</h2>
    <p class="hint">@T("Link this shelf to a friend's Shelf, and the readers of each can see the other's open shelves and borrow from them. A book lent across goes as a copy while it is out. Make a code here and send it to the other shelf's admin, or enter the code they sent you.")</p>
    @if (links.Length > 0)
    {
        <ul class="tag-counts">
            @foreach (var link in links)
            {
                <li>
                    <span>@link.Name <span class="hint">@(link.Active ? link.Address : T("waiting for the other shelf"))@(link.LastSeenAt is { } seen ? " · " + T("last heard from {0}", seen.Medium()) : "")</span></span>
                    <button type="button" class="quiet" @onclick="() => Unlink(link.Id)" aria-label="@T("Unlink {0}", link.Name)">@T("Unlink")</button>
                </li>
            }
        </ul>
    }
    <p>
        <button type="button" @onclick="MakeLinkCode">@T("Make a link code")</button>
    </p>
    @if (linkCode is not null)
    {
        <p role="status">@T("Send this code to the other shelf's admin. It works once, for a day:") <code class="link-code">@linkCode</code></p>
    }
    <label>
        @T("A code from another shelf")
        <input type="text" @bind="joinCode" @bind:event="oninput" autocomplete="off" />
    </label>
    <button type="button" class="primary" @onclick="Join" disabled="@(string.IsNullOrWhiteSpace(joinCode) || joining)">@(joining ? T("Linking…") : T("Link"))</button>
    @if (linkNote is not null)
    {
        <p class="@(linkProblem ? "validation-message" : "saved")" role="status">@linkNote</p>
    }
    </section>

    }

    @if (tab == "tab-activity")
    {
    <section class="panel" id="activity">
    <h2>@T("Activity")</h2>
    <p class="hint">@T("Sign-ups, failed sign-ins, passwords, admin rights, two-step sign-in, passkeys, devices signed out, keys, restores, and backups, newest first. The last {0} are kept.", Audit.Keep) <a href="/admin/audit">@T("The newest 500 as JSON")</a></p>
    <AuditList Lines="activity" />
    </section>
    }
}

@code {
    private bool allowed;
    private int me;
    private List<ReaderRow> readers = [];
    private string tab = "tab-readers";

    private static readonly IReadOnlyList<(string Key, string Label)> AdminTabs =
    [
        ("tab-readers", T("Readers")),
        ("tab-backups", T("Backups")),
        ("tab-system", T("System")),
        ("tab-activity", T("Activity")),
    ];

    // Where each part of the page is, so links to it from elsewhere still find it.
    private static readonly Dictionary<string, string> AdminSections = new()
    {
        ["signup"] = "tab-readers",
        ["invites"] = "tab-readers",
        ["readers"] = "tab-readers",
        ["snapshot"] = "tab-backups",
        ["backups"] = "tab-backups",
        ["jobs"] = "tab-system",
        ["email"] = "tab-system",
        ["announcement"] = "tab-system",
        ["import"] = "tab-system",
        ["storage"] = "tab-system",
        ["links"] = "tab-system",
        ["activity"] = "tab-activity",
    };

    private static readonly (SignUpMode Mode, string Label)[] SignUpChoices =
    [
        (SignUpMode.Open, Say("Anyone who finds the shelf can make an account")),
        (SignUpMode.Invites, Say("Only people invited")),
        (SignUpMode.Closed, Say("No one new")),
    ];

    private SignUpMode signUp;
    private string readerFilter = "";
    private string readerOrder = "name";
    private readonly Dictionary<int, string?> editNames = [];
    private readonly Dictionary<int, string?> editEmails = [];
    private readonly Dictionary<int, (string Text, bool Problem)> rowNotes = [];

    private List<ReaderRow> ShownReaders
    {
        get
        {
            var wanted = readerFilter.Trim();
            var found = readers.Where(reader => wanted.Length == 0
                || reader.Name.Contains(wanted, StringComparison.OrdinalIgnoreCase)
                || (reader.Email ?? reader.PendingEmail ?? "").Contains(wanted, StringComparison.OrdinalIgnoreCase));
            return (readerOrder switch
            {
                "joined" => found.OrderByDescending(reader => reader.CreatedAt),
                "seen" => found.OrderByDescending(reader => reader.LastSeenAt ?? DateTimeOffset.MinValue),
                _ => found.OrderBy(reader => reader.Name, StringComparer.OrdinalIgnoreCase),
            }).ToList();
        }
    }

    private InvitationSummary[] invitations = [];
    private string inviteAddresses = "";
    private bool inviting;
    private List<InvitationMade> invited = [];

    private string? running;
    private string? jobNote;
    private bool testingEmail;
    private string? emailNote;
    private bool emailProblem;
    private string announcementText = "";
    private bool announceByEmail;
    private bool announced;
    private bool announcing;
    private string? announcementNote;

    private async Task SetSignUp(SignUpMode mode)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await StillAdminAsync(db))
        {
            await Management.SetSignUpModeAsync(db, mode);
            signUp = mode;
        }
    }

    private async Task Invite()
    {
        inviting = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await StillAdminAsync(db))
            {
                invited = [.. await Management.InviteAsync(db, Email, inviteAddresses, Address)];
                inviteAddresses = string.Join("\n", invited.Where(made => made.Problem is not null).Select(made => made.Email));
                invitations = await Management.InvitationsAsync(db);
            }
        }
        finally
        {
            inviting = false;
        }
    }

    private async Task Resend(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await StillAdminAsync(db) && await Management.ResendAsync(db, Email, id, Address) is { } made)
        {
            invited = [made];
            invitations = await Management.InvitationsAsync(db);
        }
    }

    private async Task Revoke(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await StillAdminAsync(db))
        {
            await Management.RevokeAsync(db, id);
            invitations = await Management.InvitationsAsync(db);
        }
    }

    private async Task Rename(int id)
    {
        if (!editNames.TryGetValue(id, out var name))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (await StillAdminAsync(db))
        {
            var trouble = await Management.RenameAsync(db, id, name);
            rowNotes[id] = trouble is { } shown ? (ReaderRules.Describe(shown), true) : (T("Saved."), false);
            readers = [.. await Management.ReadersAsync(db)];
        }
    }

    private async Task SetEmail(int id)
    {
        if (!editEmails.TryGetValue(id, out var address))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (await StillAdminAsync(db) && readers.FirstOrDefault(reader => reader.Id == id) is not null)
        {
            var notices = await db.Readers.Where(reader => reader.Id == id).Select(reader => reader.EmailNotices).FirstAsync();
            var trouble = await ReaderRules.SetEmailAsync(db, id, address, notices);
            rowNotes[id] = trouble is { } shown ? (ReaderRules.Describe(shown), true) : (T("Saved."), false);
            readers = [.. await Management.ReadersAsync(db)];
        }
    }

    private async Task ResendConfirmation(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (!await StillAdminAsync(db) || await db.Readers.FirstOrDefaultAsync(reader => reader.Id == id) is not { PendingEmail: { } pending } reader)
        {
            return;
        }

        try
        {
            rowNotes[id] = await EmailRules.SendConfirmationAsync(db, Email, reader, Address)
                ? (T("Sent to {0}.", pending), false)
                : (T("A link went a moment ago. Wait a minute before asking again."), true);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            rowNotes[id] = (T("The mail server did not take it: {0}", ex.Message), true);
        }
    }

    private async Task SignOut(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await StillAdminAsync(db) && await Management.SignOutEverywhereAsync(db, id))
        {
            rowNotes[id] = (T("Signed out everywhere."), false);
            readers = [.. await Management.ReadersAsync(db)];
        }
    }

    private async Task Suspend(int id, bool suspended)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await StillAdminAsync(db))
        {
            var trouble = await Management.SuspendAsync(db, id, suspended);
            rowNotes[id] = trouble is { } shown ? (ReaderRules.Describe(shown), true) : (suspended ? T("Suspended.") : T("Restored."), false);
