@page "/admin"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory
@inject EbookStore Ebooks
@inject AudioStore Audio
@inject CoverStore Covers
@inject BackupSchedule Schedule
@inject FolderImport ImportFolder
@inject OffsiteBackup Offsite

<PageTitle>@T("Readers") · Shelf</PageTitle>

<h1>@T("Readers")</h1>

@if (!allowed)
{
    <p>@T("Only an admin of this shelf can manage readers.")</p>
}
else
{
    <p class="hint">@T("A reader who forgets their password gets a new one here. Hand it to them, and they can change it from their account.")</p>

    @if (problem is AccountProblem shown)
    {
        <p class="validation-message" role="alert">@ReaderRules.Describe(shown)</p>
    }

    <section class="panel">
    <ul class="quotes">
        @foreach (var reader in readers)
        {
            <li>
                <strong>@reader.Name</strong>
                <span class="hint"> · @Localization.Counts.Books(reader.Books) · @T("since {0}", reader.CreatedAt.Medium())@(reader.IsAdmin ? " · " + T("admin") : "")@(reader.Id == me ? " · " + T("you") : "")</span>
                @if (passwords.TryGetValue(reader.Id, out var password))
                {
                    <p>@T("New password:") <code class="key">@password</code></p>
                    <p class="hint">@T("It is not shown again. Every session {0} had is signed out.", reader.Name)</p>
                }
                <p>
                    @if (reader.Id != me)
                    {
                        <button type="button" @onclick="() => Reset(reader.Id)">@T("New password")</button>
                    }
                    <button type="button" @onclick="() => SetAdmin(reader.Id, !reader.IsAdmin)">@(reader.IsAdmin ? T("No longer admin") : T("Make admin"))</button>
                    @if (reader.Id != me)
                    {
                        @if (removing == reader.Id)
                        {
                            <span class="hint">@T("Delete {0}, their {1}, and their files?", reader.Name, Localization.Counts.Books(reader.Books))</span>
                            <button type="button" class="danger" @onclick="() => Remove(reader.Id)">@T("Yes, delete")</button>
                            <button type="button" @onclick="() => removing = null">@T("Cancel")</button>
                        }
                        else
                        {
                            <button type="button" class="danger" @onclick="() => removing = reader.Id">@T("Delete")</button>
                        }
                    }
                </p>
            </li>
        }
    </ul>
    </section>

    <section class="panel">
    <h2>@T("Snapshot")</h2>
    <p class="hint">@((MarkupString)T("Everything on this server in one zip: the database with every reader, and every e-book, audiobook, and cover picture. To restore it, stop the shelf and unpack it into a new data folder: <code>shelf.db</code> beside the app, and the <code>ebooks</code>, <code>audio</code>, and <code>covers</code> folders where they were."))</p>
    <a class="button primary" href="/admin/snapshot">@T("Download a snapshot")</a>
    </section>

    <section class="panel">
    <h2>@T("Nightly backups")</h2>
    @if (!Schedule.Enabled)
    {
        <p class="hint">@T("Nightly backups are off (Backup:Enabled is false).")</p>
    }
    else
    {
        <p class="hint">@(Schedule.IncludeFiles
            ? T("Each night after {0}:00 UTC the shelf saves a snapshot of the database, with every e-book and audiobook, in {1}, keeping the last {2}.", Schedule.Hour.ToString("00"), Schedule.Folder, Schedule.Keep)
            : T("Each night after {0}:00 UTC the shelf saves a snapshot of the database in {1}, keeping the last {2}. E-books and audiobooks never change once saved; copy their folders along with these to keep everything.", Schedule.Hour.ToString("00"), Schedule.Folder, Schedule.Keep))</p>
    }
    @if (backups.Count == 0)
    {
        <p class="hint">@T("None yet.")</p>
    }
    else
    {
        <ul class="tag-counts">
            @foreach (var backup in backups)
            {
                <li>
                    <a href="/admin/backups/@backup.Name">@backup.TakenAt.Stamp() UTC</a>
                    <span class="hint">@Localization.Counts.Size(backup.Bytes)</span>
                </li>
            }
        </ul>
    }
    @if (Offsite.CopyFolder is null && Offsite.S3Description is null)
    {
        <p class="hint">@((MarkupString)T("Kept on this server's disk only. <code>Backup:CopyTo</code> or <code>Backup:S3</code> settings send a copy of each somewhere else as well."))</p>
    }
    else
    {
        <p class="hint">@T("Each is copied to: {0}.", string.Join(", ", new[] { Offsite.CopyFolder, Offsite.S3Description }.OfType<string>()))</p>
        @foreach (var result in Offsite.Last)
        {
            <p class="@(result.Sent ? "hint" : "validation-message")">@(result.Sent ? T("Copied to {0} at {1} UTC.", result.Where, result.At.Stamp()) : T("Could not copy to {0}: {1}", result.Where, result.Problem ?? ""))</p>
        }
    }
    <button type="button" @onclick="BackUpNow" disabled="@backingUp">@(backingUp ? T("Backing up…") : T("Back up now"))</button>
    </section>

    <section class="panel">
    <h2>@T("Import folder")</h2>
    @if (ImportFolder.Folder is not { } watched)
    {
        <p class="hint">@((MarkupString)T("Off. Set <code>Import:Folder</code> to a folder, and books dropped into it are added on their own."))</p>
    }
    else
    {
        <p class="hint">@T("Shelf looks in {0} every minute. Each reader has a folder there named after them; a file in it becomes a book on their shelf, and a folder of tracks one audiobook. Files at the top go to the first admin. Once added, a file moves into .imported, and one Shelf cannot take into .not-added.", watched)</p>
        <button type="button" @onclick="MakeReaderFolders">@T("Make a folder for each reader")</button>
        @if (madeFolders is not null)
        {
            <p class="saved" role="status">@T("Ready: {0}", string.Join(", ", madeFolders.Select(Path.GetFileName)))</p>
        }
    }
    </section>

    <section class="panel">
    <h2>@T("Activity")</h2>
    <p class="hint">@T("Sign-ups, failed sign-ins, passwords, admin rights, two-step sign-in, passkeys, devices signed out, keys, restores, and backups, newest first. The last {0} are kept.", Audit.Keep) <a href="/admin/audit">@T("The newest 500 as JSON")</a></p>
    <AuditList Lines="activity" />
    </section>
}

@code {
    private bool allowed;
    private int me;
    private List<ReaderSummary> readers = [];
    private readonly Dictionary<int, string> passwords = [];
    private AccountProblem? problem;
    private int? removing;
    private IReadOnlyList<AutomaticBackup> backups = [];
    private bool backingUp;

    private async Task BackUpNow()
    {
        backingUp = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await StillAdminAsync(db))
            {
                var taken = await Schedule.TakeAsync(CancellationToken.None);
                await Audit.NoteAsync(db, Say("Took a backup"), detail: taken.Name);
                activity = await Audit.RecentAsync(db, take: 100);
            }
        }
        finally
        {
            backingUp = false;
            backups = Schedule.List();
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        me = db.ReaderId;
        allowed = await ReaderRules.IsAdminAsync(db, me);
        readers = allowed ? (await ReaderRules.SummariesAsync(db)).ToList() : [];
        backups = allowed ? Schedule.List() : [];
        activity = allowed ? await Audit.RecentAsync(db, take: 100) : [];
    }

    private IReadOnlyList<AuditLine> activity = [];
    private IReadOnlyList<string>? madeFolders;

    private async Task MakeReaderFolders()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await StillAdminAsync(db))
        {
            madeFolders = ImportFolder.PrepareReaderFolders(readers.Select(reader => reader.Name));
        }
    }

    private async Task<bool> StillAdminAsync(ShelfDb db) => allowed = await ReaderRules.IsAdminAsync(db, db.ReaderId);

    private async Task Reset(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (!await StillAdminAsync(db))
        {
            return;
        }

        if (await ReaderRules.ResetPasswordAsync(db, id) is { } password)
        {
            passwords[id] = password;
        }

        problem = null;
    }

    private async Task SetAdmin(int id, bool isAdmin)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            if (!await StillAdminAsync(db))
            {
                return;
            }

            problem = await ReaderRules.SetAdminAsync(db, id, isAdmin);
        }

        await LoadAsync();
    }

    private async Task Remove(int id)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            if (!await StillAdminAsync(db))
            {
                return;
            }

            problem = await ReaderRules.RemoveAsync(db, Ebooks, Audio, Covers, id);
        }

        removing = null;
        passwords.Remove(id);
        await LoadAsync();
    }
}
