    }

    private async Task RunJob(string key)
    {
        running = key;
        jobNote = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await StillAdminAsync(db) && await Management.RunAsync(Services, key))
            {
                await Audit.NoteAsync(db, Say("Ran a job by hand"), detail: key);
                jobNote = T("Done.");
            }
        }
        finally
        {
            running = null;
        }
    }

    private async Task TestEmail()
    {
        testingEmail = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var mine = await db.Readers.AsNoTracking().FirstAsync(reader => reader.Id == db.ReaderId);
            if (mine.Email is null)
            {
                (emailProblem, emailNote) = (true, T("Add an address, and an admin has to set up a mail server, first."));
                return;
            }

            await Email.SendAsync(new EmailMessage(mine.Email, T("Shelf can reach you"), T("Hello {0},\n\nThis is a test from your shelf. Email works.", mine.Name)), CancellationToken.None);
            (emailProblem, emailNote) = (false, T("Sent to {0}.", mine.Email));
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            (emailProblem, emailNote) = (true, T("The mail server did not take it: {0}", ex.Message));
        }
        finally
        {
            testingEmail = false;
        }
    }

    private async Task Announce()
    {
        announcing = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await StillAdminAsync(db))
            {
                var emailed = await Management.AnnounceAsync(db, Cache, Email, announcementText, announceByEmail, Address);
                announced = true;
                announcementNote = announceByEmail && Email.Enabled ? T("It is up, and went to {0}.", Localization.Counts.Readers(emailed)) : T("It is up.");
                announceByEmail = false;
            }
        }
        finally
        {
            announcing = false;
        }
    }

    private async Task TakeDown()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await StillAdminAsync(db))
        {
            await Management.AnnounceAsync(db, Cache, Email, null, false, Address);
            (announced, announcementText, announcementNote) = (false, "", T("Taken down."));
        }
    }
    private readonly Dictionary<int, string> passwords = [];
    private AccountProblem? problem;
    private int? removing;
    private IReadOnlyList<BackupWithVerdict> backups = [];

    // A restore drill, for a backup taken before drills were made after each one.
    private async Task Drill(string name)
    {
        backingUp = true;
        try
        {
            await Checks.DrillAsync(name);
        }
        finally
        {
            backingUp = false;
            backups = Checks.List();
        }
    }
    private bool backingUp;

    private async Task BackUpNow()
    {
        backingUp = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await StillAdminAsync(db))
            {
                var taken = await Schedule.TakeAsync(CancellationToken.None);
                await Audit.NoteAsync(db, Say("Took a backup"), detail: taken.Name);
                activity = await Audit.RecentAsync(db, take: 100);
            }
        }
        finally
        {
            backingUp = false;
            backups = Checks.List();
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        me = db.ReaderId;
        allowed = await ReaderRules.IsAdminAsync(db, me);
        readers = allowed ? [.. await Management.ReadersAsync(db)] : [];
        invitations = allowed ? await Management.InvitationsAsync(db) : [];
        signUp = await Management.SignUpModeAsync(db, Configuration);
        if (allowed && await Management.AnnouncementAsync(db, Cache) is { } current)
        {
            (announced, announcementText) = (true, current.Text);
        }
        backups = allowed ? Checks.List() : [];
        activity = allowed ? await Audit.RecentAsync(db, take: 100) : [];
        links = allowed ? await Federation.ListAsync(db) : [];
    }

