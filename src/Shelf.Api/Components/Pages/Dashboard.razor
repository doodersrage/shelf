@page "/"
@inject IDbContextFactory<ShelfDb> DbFactory
@inject AudioStore Audio

<PageTitle>@T("Home") · Shelf</PageTitle>

@* Home: where a reader picks up again. What wants them now, if anything; the book they were last in, with a way
   straight back into it; then what else is open, what comes next, and the year so far, in the order they like, any
   of it hidden. The whole library, with its filters, is on its own page. *@
<div class="page-head">
    <h1>@T("Home")</h1>
    <a class="button primary add-action" href="/library?add=1">@T("Add a book")</a>
</div>

@if (attention.Count > 0)
{
    <section class="panel needs-you" aria-labelledby="needs-heading">
        <h2 id="needs-heading">@T("Needs you")</h2>
        <ul>
            @foreach (var item in attention)
            {
                <li><a href="@item.Href">@item.Text</a></li>
            }
        </ul>
    </section>
}

@if (family is { Books.Length: > 0 } shared)
{
    <section class="panel family" aria-labelledby="family-heading">
        <h2 id="family-heading">@T("From {0}'s shelf", shared.Guardian)</h2>
        <ul class="family-books">
            @foreach (var book in shared.Books)
            {
                <li>
                    <BookCover Title="@book.Title" Url="@book.Cover" Width="5rem" />
                    <span>
                        <strong>@book.Title</strong>
                        <span class="hint">@book.Author</span>
                        <span>
                            @if (book.HasEbook)
                            {
                                <a href="/library/@book.Id/read">@T("Read")</a>
                            }
                            @if (book.HasAudio)
                            {
                                <a href="/library/@book.Id/listen">@T("Listen")</a>
                            }
                            @if (!book.HasEbook && !book.HasAudio)
                            {
                                <span class="hint">@T("On the shelf at home")</span>
                            }
                        </span>
                    </span>
                </li>
            }
        </ul>
    </section>
}

@if (books.Count == 0)
{
    @* A new shelf: most people arrive with a library somewhere already, so the ways to bring it lead. *@
    <section class="welcome" aria-labelledby="welcome-heading">
        <h2 id="welcome-heading">@T("Welcome. Where are your books now?")</h2>
        <p class="hint">@T("Bring them across from wherever they are; nothing there changes. You can do more than one, and Shelf skips books it already has.")</p>
        <ul class="welcome-ways">
            <li>
                <a href="/import/audiobookshelf">
                    <strong>Audiobookshelf</strong>
                    <span>@T("Audiobooks and e-books from your server, with covers, series, and where you stopped. It can keep in step every day.")</span>
                </a>
            </li>
            <li>
                <a href="/import/calibre">
                    <strong>Calibre</strong>
                    <span>@T("A Calibre library on this server, with its files, covers, series, tags, and ratings.")</span>
                </a>
            </li>
            <li>
                <a href="/backup#csv">
                    <strong>Goodreads · StoryGraph</strong>
                    <span>@T("Your shelves, ratings, dates, and reviews from an exported CSV file.")</span>
                </a>
            </li>
            <li>
                <a href="/library?add=1#add">
                    <strong>@T("Files")</strong>
                    <span>@T("E-books, PDFs, comics, and audiobooks from your computer or phone, as many at once as you like.")</span>
                </a>
            </li>
            <li>
                <a href="/library?add=1">
                    <strong>@T("By hand")</strong>
                    <span>@T("A paper book: type its ISBN, or scan the barcode, and Shelf fills in the rest.")</span>
                </a>
            </li>
            <li>
                <a href="/free">
                    <strong>@T("Free books")</strong>
                    <span>@T("Public-domain e-books from Project Gutenberg and audiobooks from LibriVox, to start with something to read.")</span>
                </a>
            </li>
        </ul>
        <p class="hint">@T("Brought in a big library? Tidy up, under Your copies, finds covers and puts authors and series in order.")</p>
    </section>
}
else
{
    @if (current is { } book)
    {
        var fraction = BookProgress.Fraction(book, Audio);
        <section class="continue" aria-labelledby="continue-heading">
            <a class="continue-cover" href="/library/@book.Id" tabindex="-1" aria-hidden="true"><BookCover Title="@book.Title" Url="@book.CoverShown" /></a>
            <div class="continue-body">
                <p class="eyebrow" id="continue-heading">@T("Continue")</p>
                <h2 class="continue-title"><a href="/library/@book.Id">@book.Title</a></h2>
                <p class="by">@book.Author</p>
                @if (fraction is double done)
                {
                    <progress max="1000" value="@((int)(done * 1000))" aria-label="@ProgressText(book)"></progress>
                }
                <p class="hint">@ProgressText(book)</p>
                <div class="actions">
                    @if (!string.IsNullOrWhiteSpace(book.EbookStoredName))
                    {
                        <a class="button primary" href="/library/@book.Id/read">@T("Resume reading")</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(book.AudioStoredName))
                    {
                        <a class="button @(string.IsNullOrWhiteSpace(book.EbookStoredName) ? "primary" : null)" href="/library/@book.Id/listen">@T("Resume listening")</a>
                        <button type="button" class="icon-button play" data-play-book="@book.Id" aria-label="@T("Play {0} while you browse", book.Title)"><PlayerIcon Name="play" /></button>
                    }
                    @if (string.IsNullOrWhiteSpace(book.EbookStoredName) && string.IsNullOrWhiteSpace(book.AudioStoredName))
                    {
                        <a class="button primary" href="/library/@book.Id#reading">@T("Update progress")</a>
                    }
                </div>
            </div>
        </section>
    }

    @foreach (var (name, _) in sections.Where(section => section.Shown))
    {
        switch (name)
        {
            case "glance":
                <ul class="tiles" aria-label="@T("Your shelf at a glance")">
                    <li><a href="/library?status=Reading"><strong>@reading.Count</strong> <span>@T("Reading")</span></a></li>
                    <li><a href="/library?status=Want"><strong>@books.Count(item => item.Status == BookStatus.Want)</strong> <span>@T("Want to read")</span></a></li>
                    <li>
                        <a href="/stats">
                            <strong>@finishedThisYear</strong>
                            <span>@(goal > 0 ? T("of {0} finished this year", goal) : T("Finished this year"))</span>
                            @if (goal > 0)
                            {
                                <progress class="goal" max="@goal" value="@Math.Min(finishedThisYear, goal)" aria-label="@T("{0} of {1} books finished", finishedThisYear, goal)"></progress>
                            }
                        </a>
                    </li>
                    <li><a href="/loans"><strong>@books.Count(item => !string.IsNullOrWhiteSpace(item.LoanedTo))</strong> <span>@T("On loan")</span></a></li>
                </ul>
                break;
            case "reading":
                if (others.Count > 0)
                {
                    <h2>@T("Also reading")</h2>
                    <ul class="shelf-strip">
                        @foreach (var open in others)
                        {
                            <li class="strip-card">
                                <BookCover Title="@open.Title" Url="@open.CoverShown" />
                                <div>
                                    <p class="title"><a href="/library/@open.Id">@open.Title</a></p>
                                    <p class="by">@open.Author</p>
                                    @if (BookProgress.Fraction(open, Audio) is double done)
                                    {
                                        <progress max="1000" value="@((int)(done * 1000))" aria-label="@ProgressText(open)"></progress>
                                    }
                                    <p class="hint">@ProgressText(open)</p>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(open.AudioStoredName))
                                {
                                    <button type="button" class="icon-button play strip-play" data-play-book="@open.Id" aria-label="@T("Play {0}", open.Title)"><PlayerIcon Name="play" /></button>
                                }
                            </li>
                        }
                    </ul>
                    @if (reading.Count > StripSize + 1)
                    {
                        <p class="hint"><a href="/library?status=Reading">@T("All {0} you are reading", reading.Count)</a></p>
                    }
                }
                break;
            case "next":
                if (next.Count > 0)
                {
                    <h2 class="read-next">@(queued ? T("Read next") : T("From the want list"))</h2>
                    <ul class="shelf-strip">
                        @foreach (var item in next)
                        {
                            <li class="strip-card">
                                <BookCover Title="@item.Title" Url="@item.CoverShown" />
                                <div>
                                    <p class="title"><a href="/library/@item.Id">@item.Title</a></p>
                                    <p class="by">@item.Author</p>
                                </div>
                            </li>
                        }
                    </ul>
                    @if (queued && queuedCount > StripSize)
                    {
                        <p class="hint"><a href="/library?status=Want&amp;queued=1">@T("All {0} to read next", queuedCount)</a></p>
                    }
                }
                break;
            case "added":
                if (added.Count > 0)
                {
                    <h2>@T("Recently added")</h2>
                    <ul class="cover-row">
                        @foreach (var item in added)
                        {
                            <li>
                                <a href="/library/@item.Id">
                                    <BookCover Title="@item.Title" Url="@item.CoverShown" />
                                    <span class="title">@item.Title</span>
                                    <span class="hint">@item.Author</span>
                                </a>
                            </li>
                        }
                    </ul>
                    <p class="hint"><a href="/library?sort=added">@T("The whole library, newest first")</a></p>
                }
                break;
            case "finished":
                if (finished.Count > 0)
                {
                    <h2>@T("Recently finished")</h2>
                    <ul class="shelf-strip">
                        @foreach (var done in finished)
                        {
                            <li class="strip-card">
                                <BookCover Title="@done.Title" Url="@done.CoverShown" />
                                <div>
                                    <p class="title"><a href="/library/@done.Id">@done.Title</a></p>
                                    <p class="by">@done.Author</p>
                                    <p class="hint">@done.FinishedOn?.Medium()@(done.Rating is int stars ? $" · {new string('★', stars)}" : "")</p>
                                </div>
                            </li>
                        }
                    </ul>
                }
                break;
        }
    }

    @* Which of Home's sections show, and in what order, kept for the reader on every device. A plain form, so Home
       stays a page that holds no connection open. *@
    <details class="arrange-home" id="arrange-home" open="@(Arranged == 1)">
        <summary>@T("Arrange Home")</summary>
        <form method="post" action="/books/home">
            <AntiforgeryToken />
            <ol class="arrange-list">
                @for (var index = 0; index < sections.Count; index++)
                {
                    var (name, shown) = sections[index];
                    <li>
                        <label class="check">
                            <input type="checkbox" name="shown" value="@name" checked="@shown" />
                            @SectionLabel(name)
                        </label>
                        <span class="arrange-moves">
                            <button type="submit" class="quiet" name="move" value="@($"{name}:up")" disabled="@(index == 0)" aria-label="@T("Move {0} up", SectionLabel(name))">↑</button>
                            <button type="submit" class="quiet" name="move" value="@($"{name}:down")" disabled="@(index == sections.Count - 1)" aria-label="@T("Move {0} down", SectionLabel(name))">↓</button>
                        </span>
                    </li>
                }
            </ol>
            <button type="submit">@T("Save")</button>
        </form>
    </details>
}

@code {
    private const int StripSize = 6;
    private List<Book> books = [];
    private List<Book> reading = [];
    private Book? current;
    private List<Book> others = [];
    private List<Book> next = [];
    private bool queued;
    private int queuedCount;
    private List<Book> added = [];
    private List<Book> finished = [];
    private int finishedThisYear;
    private int goal;
    private (string Guardian, FamilyBook[] Books)? family;
    private List<AttentionItem> attention = [];
    private List<(string Name, bool Shown)> sections = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        family = await Family.SharedBooksAsync(db);
        // Only what Home shows and measures progress by; a big shelf's chapter lists and notes are slow to read.
        books = await db.Books.AsNoTracking()
            .Select(book => new Book
            {
                Id = book.Id,
                Title = book.Title,
                Author = book.Author,
                Status = book.Status,
                Rating = book.Rating,
                Queued = book.Queued,
                AddedAt = book.AddedAt,
                StartedOn = book.StartedOn,
                FinishedOn = book.FinishedOn,
                LoanedTo = book.LoanedTo,
                Pages = book.Pages,
                CurrentPage = book.CurrentPage,
                Format = book.Format,
                EbookStoredName = book.EbookStoredName,
                AudioStoredName = book.AudioStoredName,
                AudioTrack = book.AudioTrack,
                AudioSeconds = book.AudioSeconds,
                CoverUrl = book.CoverUrl,
                FileCover = book.FileCover,
                CoverImage = book.CoverImage,
            })
            .ToListAsync();
        attention = await Attention.ForHomeAsync(db);
        sections = await BookRules.GetHomeSectionsAsync(db);
        goal = await BookRules.GetGoalAsync(db);
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        finishedThisYear = books.Count(book => book.Status == BookStatus.Finished && book.FinishedOn?.Year == today.Year);

        // The book last read or listened to leads.
        reading = await BookProgress.LatestFirstAsync(db, books.Where(book => book.Status == BookStatus.Reading));
        current = reading.FirstOrDefault();
        others = reading.Skip(1).Take(StripSize).ToList();

        var queue = books.Where(book => book.Status == BookStatus.Want && book.Queued).OrderBy(book => book.Title, StringComparer.CurrentCultureIgnoreCase).ToList();
        queued = queue.Count > 0;
        queuedCount = queue.Count;
        next = queued ? queue.Take(StripSize).ToList() : BookRules.Pick(books, BookStatus.Want, today) is { } pick ? [pick] : [];
        added = books.OrderByDescending(book => book.AddedAt).Take(8).ToList();
        finished = books.Where(book => book.Status == BookStatus.Finished && book.FinishedOn is not null)
            .OrderByDescending(book => book.FinishedOn).ThenBy(book => book.Title, StringComparer.CurrentCultureIgnoreCase).Take(3).ToList();
    }

    private static string SectionLabel(string name) => name switch
    {
        "glance" => T("Your shelf at a glance"),
        "reading" => T("Also reading"),
        "next" => T("Read next"),
        "added" => T("Recently added"),
        _ => T("Recently finished"),
    };

    [SupplyParameterFromQuery(Name = "arranged")]
    public int? Arranged { get; set; }

    private string ProgressText(Book book)
    {
        if (BookProgress.ByRecording(book) && BookProgress.Listened(book, Audio) is var (heard, length))
        {
            return T("{0} left · {1}%", BookProgress.Span(length - heard), (int)Math.Round(heard * 100 / length));
        }

        return book switch
        {
            { Pages: int pages and > 0 } => T("{0} of {1} pages · {2}%", book.CurrentPage ?? 0, pages, (int)Math.Round((book.CurrentPage ?? 0) * 100.0 / pages)),
            { CurrentPage: int at } => T("Page {0}", at),
            _ => T("Not started"),
        };
    }
}
