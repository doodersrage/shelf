@inject IDbContextFactory<ShelfDb> DbFactory

@* Copies of this book on other readers' open shelves, each with a way to ask to borrow it. *@
@if (Copies.Count > 0)
{
    <ul class="open-copies">
        @foreach (var copy in Copies)
        {
            <li>
                <span>
                    <a href="/shelves/@copy.OwnerId">@T("{0}'s open shelf", copy.Owner)</a>@Has(copy)@(copy.OnLoan ? T(", on loan just now") : "").
                </span>
                @if (copy.Asked || asked.Contains(copy.Id))
                {
                    <span class="saved">@T("Asked")</span>
                }
                else
                {
                    <button type="button" class="quiet" @onclick="() => Ask(copy)" aria-label="@T("Ask {0} to borrow {1}", copy.Owner, copy.Title)">@T("Ask to borrow")</button>
                }
            </li>
        }
    </ul>
    @if (message is not null)
    {
        <p class="validation-message" role="alert">@message</p>
    }
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<OpenCopy> Copies { get; set; } = [];

    private readonly HashSet<int> asked = [];
    private string? message;

    private static string Has(OpenCopy copy) => (copy.HasEbook, copy.HasAudio) switch
    {
        (true, true) => T(", with an e-book and an audiobook"),
        (true, false) => T(", with an e-book"),
        (false, true) => T(", with an audiobook"),
        _ => "",
    };

    private async Task Ask(OpenCopy copy)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var result = await Asking.AskAsync(db, copy.Id);
        message = result switch
        {
            AskResult.Asked => null,
            AskResult.AlreadyYours => T("That book is already lent to you."),
            _ => T("That book is no longer on an open shelf."),
        };
        if (result == AskResult.Asked)
        {
            asked.Add(copy.Id);
        }
    }
}
