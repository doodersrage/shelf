    // Want to read, then Reading, then Finished: one press each, with the dates filled as the edit form would.
    private async Task MoveTo(BookStatus status)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.Books.FirstOrDefaultAsync(item => item.Id == Id);
        if (existing is null)
        {
            missing = true;
            book = null;
            return;
        }

        BookRules.ChangeStatus(existing, status, db.Today);
        await db.SaveChangesAsync();
        saved = false;
        if (status == BookStatus.Finished)
        {
            // A few to choose from next: the next in its series, then the queue in its order, else what the shelf would pick.
            var queue = await ReadingQueue.UpNextAsync(db, existing);
            nextChoices = queue.Count > 0 ? queue
                : BookRules.Pick(await db.Books.AsNoTracking().Where(item => item.Status == BookStatus.Want && item.LeftOn == null && item.Id != Id).ToListAsync(), BookStatus.Want, Clock.Today) is { } pick ? [pick] : [];
            justFinished = true;
        }
        else
        {
            justFinished = false;
        }

        await LoadAsync();
    }

