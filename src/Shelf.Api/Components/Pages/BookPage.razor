@page "/library/{Id:int}"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory
@inject NavigationManager Navigation
@inject EbookStore Ebooks
@inject EpubDetailsStore WithDetails
@inject Storage Storage
@inject AudioStore Audio
@inject CoverStore Covers
@inject OcrService Ocr
@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider Protection
@using Microsoft.JSInterop
@inject IJSRuntime Js
@inject IEmailSender Email
@inject IAvailability Availability
@inject Fetcher Fetcher
@inject FreeBooks Free
@inject IConfiguration Configuration
@inject ReaderTime Clock
@implements IAsyncDisposable

<PageTitle>@(book?.Title ?? "Shelf")</PageTitle>

@if (missing)
{
    <h1>@T("Not on the shelf")</h1>
    <p>@T("That book is not here.") <a href="/library">@T("Back to the library")</a></p>
}
else if (book is not null)
{
    <p class="hint"><a href="/library">@T("Library")</a></p>
    <header class="book-hero">
        <BookCover Title="@book.Title" Url="@book.CoverShown" Decorative="false" />
        <div>
            <h1>@book.Title</h1>
            @if (!string.IsNullOrWhiteSpace(book.Subtitle))
            {
                <p class="hint">@book.Subtitle</p>
            }
            @if (book.VisitingLinkId is not null)
            {
                <p class="hint">@T("Lent to you by {0}.", book.VisitingOwner ?? "")@(book.VisitingDueOn is DateOnly due ? " " + T("Due back {0}.", due.Medium()) : "") <a href="/loans">@T("Loans")</a></p>
            }
            <p class="by">
                <a href="@($"/library?author={Uri.EscapeDataString(book.Author)}")">@book.Author</a>
                @if (!string.IsNullOrWhiteSpace(book.Translator))
                {
                    <span class="hint"> · @T("translated by {0}", book.Translator)</span>
                }
                @if (!string.IsNullOrWhiteSpace(book.Narrator))
                {
                    <span class="hint"> · @T("read by") @foreach (var (voice, at) in Narrators.Names(book.Narrator).Select((voice, at) => (voice, at)))
                    {
                        @(at > 0 ? " & " : "")<a href="@($"/library?narrator={Uri.EscapeDataString(voice)}")">@voice</a>
                    }</span>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(book.OriginalTitle))
            {
                <p class="hint">@T("Originally {0}", book.OriginalTitle)</p>
            }
            @if (!string.IsNullOrWhiteSpace(book.Series))
            {
                <p class="hint">
                    <a href="@($"/library?series={Uri.EscapeDataString(book.Series)}")">@book.Series</a>
                    @if (book.SeriesNumber is int number)
                    {
                        <span> · @T("book {0}", number)</span>
                    }
                </p>
            }
            @if (nextVolume is not null)
            {
                <p class="hint">@T("Next:") <a href="/library/@nextVolume.Id">@nextVolume.Title</a></p>
            }
            <div class="badges">
                <StatusBadge Status="book.Status" />
                @if (!string.IsNullOrWhiteSpace(book.LoanedTo))
                {
                    <span class="badge loan">@T("On loan")</span>
                }
                @if (book.Loved)
                {
                    <span class="badge plain">@T("Loved")</span>
                }
                @if (book.Rating is int rating)
                {
                    <span class="badge plain">@T("{0} of 5", rating)</span>
                }
            </div>
            @if (book.Queued)
            {
                <p class="hint">@T("On the read-next list.")</p>
            }
            @if (pastReads.Length > 0)
            {
                <p class="hint"><a href="/library/@book.Id#reads">@(book.Status == BookStatus.Finished ? T("Read {0} times", pastReads.Length + 1) : pastReads.Length == 1 ? T("Read once before") : T("Read {0} times before", pastReads.Length))</a></p>
            }
            @if (links.Any(link => link.Kind == LinkKind.Edition))
            {
                <p class="hint">
                    @T("Other editions:")
                    @foreach (var (edition, index) in links.Where(link => link.Kind == LinkKind.Edition).Select((edition, index) => (edition, index)))
                    {
                        @(index > 0 ? " · " : " ")<a href="/library/@edition.BookId">@EditionLabel(edition)</a>
                    }
                </p>
            }
            @if (book.Status == BookStatus.Reading && BookProgress.Fraction(book, Audio) is double done)
            {
                <progress class="book-progress" max="1000" value="@((int)(done * 1000))" aria-label="@T("{0}% through", (int)Math.Round(done * 100))"></progress>
            }
            @if (BookProgress.ByRecording(book) && book.Status == BookStatus.Reading && BookProgress.Listened(book, Audio) is var (heard, length))
            {
                <p class="hint">@T("{0} left · {1}%", BookProgress.Span(length - heard), (int)Math.Round(heard * 100 / length))</p>
            }
            else if (BookRules.PagesRemaining(book) is int left)
            {
                <p class="hint">
                    @if (left == 0)
                    {
                        <span>@T("At the last page.")</span>
                    }
                    else
                    {
                        <span>@(left == 1 ? T("1 page left") : T("{0} pages left", left))</span>
                        @if (BookRules.DaysRemaining(book) is int days)
                        {
                            <span> · @(days == 1 ? T("about 1 day") : T("about {0} days", days))</span>
                        }
                    }
                </p>
            }
            @* The one thing most likely next leads; changing the status, editing, and the rest follow, the rarer ones under More. *@
            @* With an e-book and a recording, the one last used leads, and the other is a tap away to go back to. *@
            <div class="status-actions">
                @if (AudioFirst)
                {
                    <a class="button primary" href="/library/@book.Id/listen">@(book.Status == BookStatus.Reading ? T("Resume listening") : T("Listen"))</a>
                }
                @if (!string.IsNullOrWhiteSpace(book.EbookStoredName))
                {
                    <a class="button @(AudioFirst ? null : "primary")" href="/library/@book.Id/read">@(book.Status == BookStatus.Reading ? T("Resume reading") : T("Read"))</a>
                }
                @if (!string.IsNullOrWhiteSpace(book.AudioStoredName) && !AudioFirst)
                {
                    <a class="button @(string.IsNullOrWhiteSpace(book.EbookStoredName) ? "primary" : null)" href="/library/@book.Id/listen">@(book.Status == BookStatus.Reading ? T("Resume listening") : T("Listen"))</a>
                }
                @switch (book.Status)
                {
                    case BookStatus.Want:
                        <button type="button" class="@(HasFiles ? null : "primary")" @onclick="() => MoveTo(BookStatus.Reading)">@T("Start reading")</button>
                        break;
                    case BookStatus.Reading:
                        @if (!HasFiles)
                        {
                            <a class="button primary" href="/library/@book.Id#reading">@T("Update progress")</a>
                        }
                        <button type="button" @onclick="() => MoveTo(BookStatus.Finished)">@T("Mark finished")</button>
                        break;
                    case BookStatus.Abandoned:
                        <button type="button" @onclick="() => MoveTo(BookStatus.Reading)">@T("Pick it up again")</button>
                        break;
                    case BookStatus.Finished:
                        <button type="button" @onclick="ReadAgain">@T("Read it again")</button>
                        break;
                }
                <a class="button quiet" href="/library/@book.Id#details" @onclick="() => editing = true">@T("Edit")</a>
                @if (HasMore)
                {
                    <details class="menu">
                        <summary class="button quiet">@T("More")</summary>
                        <div class="menu-items">
                            @if (book.Status == BookStatus.Reading)
                            {
                                <button type="button" class="quiet" @onclick="() => MoveTo(BookStatus.Abandoned)">@T("Stop reading")</button>
                            }
                            @if (!string.IsNullOrWhiteSpace(book.AudioStoredName))
                            {
                                <button type="button" class="quiet play-here" data-play-book="@book.Id"><PlayerIcon Name="play" /> @T("Play while you browse")</button>
                            }
                            @if (!string.IsNullOrWhiteSpace(book.EbookStoredName) && offlineSupported && !EbookStore.IsComic(book.EbookStoredName))
                            {
                                @if (keptOffline)
                                {
                                    <button type="button" class="quiet" @onclick="ForgetOffline" aria-pressed="true">@T("Kept offline · forget")</button>
                                }
                                else
                                {
                                    <button type="button" class="quiet" @onclick="KeepOffline" disabled="@keeping">@(keeping ? T("Keeping…") : T("Keep for reading offline"))</button>
                                }
                            }
                            @if (!string.IsNullOrWhiteSpace(book.AudioStoredName) && offlineSupported)
                            {
                                @if (keptAudio)
                                {
                                    <button type="button" class="quiet" @onclick="ForgetAudio" aria-pressed="true">@T("Kept for listening offline · forget")</button>
                                }
                                else
                                {
                                    <button type="button" class="quiet" @onclick="KeepAudio" disabled="@keepingAudio">@(keepingAudio ? T("Keeping…") : T("Keep for listening offline"))</button>
                                }
                            }
                            @if (!string.IsNullOrWhiteSpace(book.EbookStoredName) && Email.Enabled && Kindle.Takes(book))
                            {
                                <button type="button" class="quiet" @onclick="SendToKindle" disabled="@sendingToKindle">@(sendingToKindle ? T("Sending…") : T("Send to Kindle"))</button>
                            }
                        </div>
                    </details>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(book.EbookStoredName) && !string.IsNullOrWhiteSpace(book.AudioStoredName))
            {
                <ul class="format-places">
                    <li>
                        <strong>@T("E-book")</strong>
                        <span>@EbookPlace(book)</span>
                        @if (lastRead is DateOnly read)
                        {
                            <span class="hint">· @T("last read {0}", read.Medium())</span>
                        }
                    </li>
                    <li>
                        <strong>@T("Audiobook")</strong>
                        <span>@AudioPlace(book)</span>
                        @if (lastHeard is DateOnly heardOn)
                        {
                            <span class="hint">· @T("last listened to {0}", heardOn.Medium())</span>
                        }
                    </li>
                </ul>
                <p class="hint">@(alongReady ? T("Each keeps its own place. Listen along, in the reader, plays the recording with the text, word by word.") : T("Each keeps its own place: reading doesn't move the recording on, nor listening the e-book."))</p>
            }
            @if (keptOffline || keptAudio)
            {
                <p class="hint kept-here">@(keptOffline && keptAudio ? T("On this device to read and listen to offline.") : keptOffline ? T("On this device to read offline.") : T("On this device to listen to offline."))</p>
            }
            @if (book.Status == BookStatus.Finished && book.FinishedOn is DateOnly finishedOn)
            {
                <p class="hint">@T("Finished {0}", finishedOn.Long())</p>
            }
            @if (!string.IsNullOrWhiteSpace(book.AudioStoredName) && offlineSupported)
            {
                <p class="hint" data-keep-progress data-template="@T("Track {0} of {1}")" aria-live="polite"></p>
            }
            @if (offlineNote is not null)
            {
                <p class="hint" role="status">@offlineNote</p>
            }
            @if (kindleNote is not null)
            {
                <p class="@(kindleSent ? "saved" : "validation-message")" role="status">@kindleNote @if (!kindleSent && kindleNeedsAddress) { <a href="/account#kindle">@T("Account")</a> }</p>
            }
            @if (!string.IsNullOrWhiteSpace(book.AudioStoredName) && ((book.AudioTrack ?? 0) > 0 || (book.AudioSeconds ?? 0) > 0))
            {
                <p class="hint">@T("Paused at {0}", PausedAt(book))</p>
            }
        </div>
    </header>

    @if (justFinished)
    {
        <section class="panel finished-prompt" aria-labelledby="finished-heading" role="status">
            <button type="button" class="icon-button dismiss" aria-label="@T("Dismiss")" @onclick="() => justFinished = false">✕</button>
            <h2 id="finished-heading">@T("Finished {0}", book.Title)</h2>
            <div class="finished-steps">
                <div>
                    <p>@T("How was it?")</p>
                    <div class="rate" role="group" aria-label="@T("Rating")">
                        @for (var stars = 1; stars <= 5; stars++)
                        {
                            var given = stars;
                            <button type="button" class="star @(book.Rating >= given ? "on" : null)" aria-pressed="@(book.Rating == given ? "true" : "false")" aria-label="@T("{0} of 5 stars", given)" @onclick="() => Rate(given)">★</button>
                        }
                    </div>
                </div>
                <div>
                    <p>@T("A line to keep?")</p>
                    <a class="button quiet" href="/library/@book.Id#quotes" @onclick="() => justFinished = false">@T("Save a quote")</a>
                </div>
                @if (nextChoices.Count > 0)
                {
                    <div>
                        <p>@T("What next?")</p>
                        <ul class="next-choices">
                            @foreach (var next in nextChoices)
                            {
                                <li>
                                    <BookCover Title="@next.Title" Url="@next.CoverShown" Width="2.5rem" />
                                    <span><a href="/library/@next.Id">@next.Title</a> <span class="hint">@next.Author</span></span>
                                    <button type="button" class="quiet" @onclick="() => StartNext(next.Id)">@T("Start")</button>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </section>
    }

    @if (WantsAvailability)
    {
        @* For a book with no e-book: where it can be had free, and where to borrow it. Looked up after the page shows. *@
        <section class="panel where" aria-labelledby="where-heading">
            <h2 id="where-heading">@T("Where to get it")</h2>
            @if (availability is null)
            {
                <p class="hint" role="status">@T("Looking in the free catalogs…")</p>
            }
            else
            {
                <ul class="where-list">
                    @if (availability.Gutenberg is { } gutenberg)
                    {
                        <li>
                            <span><strong>@T("Free e-book")</strong> · Project Gutenberg</span>
                            @if (fetching.Contains(gutenberg.Id))
                            {
                                <span class="saved" role="status">@T("Coming to this book. Free books shows how it is going.")</span>
                            }
                            else
                            {
                                <button type="button" class="primary" @onclick="() => Fetch(gutenberg)">@T("Add it to this book")</button>
                            }
                        </li>
                    }
                    @if (availability.LibriVox is { } librivox && string.IsNullOrWhiteSpace(book.AudioStoredName))
                    {
                        <li>
                            <span><strong>@T("Free audiobook")</strong> · LibriVox</span>
                            @if (fetching.Contains(librivox.Id))
                            {
                                <span class="saved" role="status">@T("Coming to this book. Free books shows how it is going.")</span>
                            }
                            else
                            {
                                <button type="button" @onclick="() => Fetch(librivox)">@T("Add it to this book")</button>
                            }
                        </li>
                    }
                    @if (availability.OpenLibraryUrl is { } lend)
                    {
                        <li>
                            <span><strong>@(availability.OpenLibraryFree ? T("Read free") : T("Borrow the e-book")) </strong> · Open Library</span>
                            <a href="@lend" rel="noopener" target="_blank">@T("Open it at Open Library")</a>
                        </li>
                    }
                    <li>
                        <span><strong>@T("At a library")</strong></span>
                        <span>
                            <a href="@CatalogAvailability.WorldCat(book.Title, book.Author)" rel="noopener" target="_blank">@T("Find a copy near you")</a> ·
                            <a href="@CatalogAvailability.OverDrive(book.Title, book.Author)" rel="noopener" target="_blank">@T("Borrow with Libby")</a>
                        </span>
                    </li>
                </ul>
                @if (!availability.Any)
                {
                    <p class="hint">@T("No free copy turned up; it may still be in copyright.")</p>
                }
            }
        </section>
    }

    @if (canFetch && book.VisitingLinkId is null)
    {
        @* Searching the indexers for this book, as Sonarr would: the releases, best first, and those being fetched. *@
        <section class="panel fetch" aria-labelledby="fetch-heading">
            <h2 id="fetch-heading">@T("Search your indexers")</h2>
            @foreach (var grab in grabs)
            {
                <p class="grab @grab.State.ToString().ToLowerInvariant()" role="status">
                    <strong>@GrabLabel(grab)</strong> · @grab.Title
                    @if (grab.State == GrabState.Downloading)
                    {
                        <progress max="100" value="@((int)(grab.Progress * 100))" aria-label="@T("{0}% downloaded", (int)(grab.Progress * 100))"></progress>
                    }
                    @if (grab.Problem is { } problem)
                    {
                        <span class="hint"> · @problem</span>
                    }
                    @if (grab.State is GrabState.Sent or GrabState.Downloading)
                    {
                        <button type="button" class="quiet" @onclick="() => CancelGrab(grab.Id)" disabled="@cancelling.Contains(grab.Id)" aria-label="@T("Cancel downloading {0}", grab.Title)">@T("Cancel")</button>
                    }
                </p>
            }
            <div class="fetch-search">
                <label>
                    @T("Look for")
                    <select @bind="fetchKind">
                        <option value="@FetchKind.Ebook">@T("An e-book")</option>
                        <option value="@FetchKind.Audiobook">@T("An audiobook")</option>
                    </select>
                </label>
                <button type="button" @onclick="SearchIndexers" disabled="@searching">@(searching ? T("Searching…") : T("Search"))</button>
            </div>
            @if (fetchProblem is not null)
            {
                <p class="validation-message" role="alert">@fetchProblem</p>
            }
            @if (releases is { } found)
            {
                @if (found.Count == 0)
                {
                    <p class="hint">@T("The indexers found nothing.")</p>
                }
                else
                {
                    <table class="releases">
                        <thead>
                            <tr><th scope="col">@T("Release")</th><th scope="col">@T("Size")</th><th scope="col">@T("Seeders")</th><th scope="col"><span class="visually-hidden">@T("Fetch")</span></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in found.Take(showAllReleases ? 100 : 15))
                            {
                                <tr class="@(item.Matches ? null : "unmatched")">
                                    <td>
                                        @item.Release.Title
                                        <span class="hint">· @(item.Release.Indexer ?? item.Release.Protocol)@(item.Format is { } format ? $" · {format.ToUpperInvariant()}" : "")@(item.Matches ? "" : " · " + T("not this book? {0}", item.Why ?? ""))</span>
                                    </td>
                                    <td>@FetchRules.Size(item.Release.Size)</td>
                                    <td>@(item.Release.Protocol == "usenet" ? "—" : (item.Release.Seeders?.ToString() ?? "?"))</td>
                                    <td><button type="button" class="@(item == found[0] && item.Matches ? "primary" : "quiet")" @onclick="() => Grab(item.Release)">@T("Fetch")</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!showAllReleases && found.Count > 15)
                    {
                        <button type="button" class="quiet" @onclick="() => showAllReleases = true">@T("Show all {0}", found.Count)</button>
                    }
                }
            }
        </section>
    }

    @if (ImportedMessage == "1")
    {
        <p class="saved" role="status">@T("Made from the file. Check the details below; anything the file did not say is blank.")</p>
    }
    @if (EbookMessage == "saved")
    {
        <p class="saved" role="status">@T("The e-book is on the shelf.")</p>
    }
    else if (EbookMessage == "unsupported")
    {
        <p class="validation-message" role="alert">@T("Choose an EPUB, a PDF, a comic (CBZ, CBR, or CB7), or a Kindle file.")</p>
    }
    else if (EbookMessage == "damaged")
    {
        <p class="validation-message" role="alert">@T("That file looks damaged or incomplete, so Shelf could not open it. Try downloading it again.")</p>
    }
    else if (EbookMessage == "large")
    {
        <p class="validation-message" role="alert">@T("That file is larger than {0}.", Localization.Counts.Size(EbookStore.MaxBytes))</p>
    }
    else if (EbookMessage == "full" || AudioMessage == "full")
    {
        <p class="validation-message" role="alert">@T("That file would take you past your storage limit. Ask an admin for more room, or remove files you no longer need.")</p>
    }
    else if (FormatMessage == "saved")
    {
        <p class="saved" role="status">@T("The format is kept with the book.")</p>
    }
    else if (FormatMessage == "main")
    {
        <p class="validation-message" role="alert">@T("That's the format of the main e-book. To replace the main e-book, upload it under E-book.")</p>
    }
    else if (FormatMessage is "unsupported" or "damaged" or "large" or "full")
    {
        <p class="validation-message" role="alert">@(FormatMessage switch
        {
            "damaged" => T("That file looks damaged or incomplete, so Shelf could not open it. Try downloading it again."),
            "large" => T("That file is larger than {0}.", Localization.Counts.Size(EbookStore.MaxBytes)),
            "full" => T("That file would take you past your storage limit. Ask an admin for more room, or remove files you no longer need."),
            _ => T("Another format can be an EPUB, a PDF, a comic, or a Kindle book (AZW3, AZW, or MOBI) without DRM."),
        })</p>
    }
    else if (EbookMessage == "convert")
    {
        <p class="validation-message" role="alert">@T("That Kindle file could not be turned into an EPUB. Shelf needs Calibre installed on the server for that, and a file locked with DRM cannot be converted at all.")</p>
    }
    @if (CoverMessage == "saved")
    {
        <p class="saved" role="status">@T("The cover is on the shelf.")</p>
    }
    else if (CoverMessage == "unsupported")
    {
        <p class="validation-message" role="alert">@T("Choose a JPEG, PNG, GIF, or WebP picture of 10 MB or less.")</p>
    }
    @if (AudioMessage == "saved")
    {
        <p class="saved" role="status">@T("The audiobook is on the shelf.")</p>
    }
    else if (AudioMessage == "unsupported")
    {
        <p class="validation-message" role="alert">@T("Choose an audio file, or a zip of them.")</p>
    }
    else if (AudioMessage == "large")
    {
        <p class="validation-message" role="alert">@T("That audiobook is larger than {0}.", Localization.Counts.Size(AudioStore.MaxBytes))</p>
    }

    @if (held is not null)
    {
        <div class="notice ask" role="alert">
            <p>
                @(held.Kind == UploadKind.Ebook ? T("That e-book is already on another book, byte for byte:") : T("That audiobook is already on another book, byte for byte:"))
                <a href="/library/@held.SameAsId">@heldSameTitle</a>.
                @T("Keep a second copy here as well?")
            </p>
            <div class="status-actions">
                <button type="button" @onclick="KeepHeld" disabled="@deciding">@T("Keep both")</button>
                <button type="button" class="quiet" @onclick="LetHeldGo" disabled="@deciding">@T("Don't add it")</button>
            </div>
        </div>
    }
    else if (heldExpired)
    {
        <p class="validation-message" role="alert">@T("That upload was not kept. Choose the file again to add it.")</p>
    }

    @if (!string.IsNullOrWhiteSpace(book.Inscription))
    {
        <p class="inscription">@book.Inscription</p>
    }

    <SectionTabs Label="@T("This book")" Tabs="BookTabs" Sections="BookSections" Default="@((EbookMessage ?? FormatMessage ?? AudioMessage ?? CoverMessage ?? PhotoMessage ?? HeldToken) is null ? null : "tab-copy")" @bind-Active="tab" />

    @if (tab == "tab-reading")
    {
    <section class="panel" id="reading">
    <h2>@T("Reading log")</h2>
    @if (book.Sessions.Count == 0)
    {
        <p class="hint">@T("No sessions yet.")</p>
    }
    else
    {
        <ul class="tag-counts">
            @foreach (var session in book.Sessions.OrderByDescending(item => item.Date).ThenByDescending(item => item.Id))
            {
                <li>
                    <span>
                        @session.Date.Medium()
                        @if (session.FromPage is int from && session.ToPage is int to)
                        {
                            <span> · @from–@to</span>
                        }
                        else if (session.ToPage is int end)
                        {
                            <span> · @T("to {0}", end)</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(session.Note))
                        {
                            <span> · @session.Note</span>
                        }
                    </span>
                    <button type="button" @onclick="() => RemoveSession(session.Id)">@T("Remove")</button>
                </li>
            }
        </ul>
        @if (BookRules.PagesPerDay(book.Sessions) is int pace)
        {
            <p class="hint">@(pace == 1 ? T("About 1 page a day.") : T("About {0} pages a day.", pace))</p>
        }
    }

    <EditForm Model="sessionDraft" OnValidSubmit="AddSession">
        <DataAnnotationsValidator />
        @if (sessionErrors is { Count: > 0 })
        {
            <ul class="validation-errors">
                @foreach (var message in sessionErrors.SelectMany(pair => pair.Value))
                {
                    <li>@message</li>
                }
            </ul>
        }
        <div class="pair">
            <label>
                @T("Date")
                <InputDate @bind-Value="sessionDraft.Date" />
            </label>
            <label>
                @T("Note")
                <InputText @bind-Value="sessionDraft.Note" maxlength="500" />
            </label>
        </div>
        <div class="pair">
            <label>
                @T("From page")
                <InputNumber @bind-Value="sessionDraft.FromPage" />
            </label>
            <label>
                @T("To page")
                <InputNumber @bind-Value="sessionDraft.ToPage" />
            </label>
        </div>
        <button type="submit">@T("Add session")</button>
    </EditForm>
    @if (throughs.Length > 1)
    {
        <h3 id="reads">@T("Each read")</h3>
        <ol class="reads">
            @foreach (var read in throughs)
            {
                <li>
                    <p>
                        <strong>@(read.Current ? T("This read") : T("Read no. {0}", read.Number))</strong>
                        <span class="hint"> · @ReadSpan(read)@(read.Rating is int stars ? " · " + new string('★', stars) : "")</span>
                    </p>
                    <p class="hint">@ReadCounts(read)</p>
                    @if (read.PastReadId is int pastId)
                    {
                        @if (editingRead == pastId)
                        {
                            <form @onsubmit="() => SaveRead(pastId)" @onsubmit:preventDefault>
                                <label>
                                    @T("Stars then")
                                    <select @bind="readRating">
                                        <option value="0">—</option>
                                        @for (var count = 1; count <= 5; count++)
                                        {
                                            <option value="@count">@(new string('★', count))</option>
                                        }
                                    </select>
                                </label>
                                <label>
                                    @T("What you made of it then, and what changed since")
                                    <textarea @bind="readThoughts" maxlength="@PastRead.MaxThoughtsLength" rows="4"></textarea>
                                </label>
                                <button type="submit">@T("Save")</button>
                                <button type="button" class="quiet" @onclick="() => editingRead = null">@T("Cancel")</button>
                            </form>
                        }
                        else
                        {
                            @if (read.Thoughts is not null)
                            {
                                <p class="review">@read.Thoughts</p>
                            }
                            <button type="button" class="quiet" @onclick="() => StartEditingRead(read)">@(read.Thoughts is null ? T("Write about this read") : T("Change"))</button>
                        }
                    }
                </li>
            }
        </ol>
    }
    </section>

    <section class="panel" id="quotes">
    <h2>@T("Quotes")</h2>
    @if (book.Quotes.Count == 0)
    {
        <p class="hint">@T("No quotes yet.")</p>
    }
    else
    {
        <ul class="quotes">
            @foreach (var quote in book.Quotes.OrderBy(item => item.NotedAt).ThenBy(item => item.Id))
            {
                <li>
                    <blockquote>
                        <p>@quote.Text</p>
                        @if (quote.Page is int page)
                        {
                            <span class="hint">p. @(page)</span>
                        }
                    </blockquote>
                    <button type="button" @onclick="() => RemoveQuote(quote.Id)">@T("Remove")</button>
                </li>
            }
        </ul>
    }

    <EditForm Model="quoteDraft" OnValidSubmit="AddQuote">
        <DataAnnotationsValidator />
        @if (quoteErrors is { Count: > 0 })
        {
            <ul class="validation-errors">
                @foreach (var message in quoteErrors.SelectMany(pair => pair.Value))
                {
                    <li>@message</li>
                }
            </ul>
        }
        <label>
            @T("Quote")
            <InputTextArea @bind-Value="quoteDraft.Text" maxlength="1000" rows="3" />
            <ValidationMessage For="() => quoteDraft.Text" />
        </label>
        <label>
            @T("Page")
            <InputNumber @bind-Value="quoteDraft.Page" />
            <ValidationMessage For="() => quoteDraft.Page" />
        </label>
        <button type="submit">@T("Add quote")</button>
    </EditForm>
    </section>

    <section class="panel" id="highlights">
    <h2>@T("Highlights")</h2>
    @if (book.Highlights.Count == 0)
    {
        <p class="hint">@T("No highlights yet.")</p>
    }
    else
    {
        <ul class="quotes">
            @foreach (var mark in book.Highlights.OrderBy(item => item.ChapterIndex).ThenBy(item => item.Id))
            {
                <li>
                    <blockquote>
                        <p>@mark.Text</p>
                        <span class="hint">@(EbookStore.IsPdf(book.EbookStoredName) ? T("Page {0}", mark.ChapterIndex + 1) : T("Chapter {0}", mark.ChapterIndex + 1))</span>
                    </blockquote>
                    @if (!string.IsNullOrWhiteSpace(mark.Note))
                    {
                        <p>@mark.Note</p>
                    }
                    <a href="@($"/library/{book.Id}/read?chapter={mark.ChapterIndex}")">@T("Open")</a>
                    <button type="button" @onclick="() => RemoveHighlight(mark.Id)">@T("Remove")</button>
                </li>
            }
        </ul>
    }
    @if (book.Highlights.Count > 0 || book.Quotes.Count > 0 || !string.IsNullOrWhiteSpace(book.Review) || !string.IsNullOrWhiteSpace(book.Notes))
    {
        <p class="hint"><a href="/books/@book.Id/notes.md" download>@T("Download this book's quotes, highlights, and notes as Markdown")</a></p>
    }
    </section>

    @if (positions is { Reports.Length: > 0 } where && (where.Reports.Length > 1 || where.Reports.Any(report => !report.Current)))
    {
        <section class="panel" id="positions">
            <details open="@where.Reports.Any(report => !report.Current)">
                <summary><h2>@T("Where each device has you")</h2></summary>
                <p class="hint">@T("Shelf keeps you at {0}. A place only moves forward by itself; if another is right, choose it here, back or forward.", where.Current)</p>
                <ul class="plain-list">
                    @foreach (var report in where.Reports)
                    {
                        <li>
                            <strong>@Positions.SourceLabel(report.Source, report.Device)</strong>
                            <span>@report.Where</span>
                            <span class="hint">@report.At.Medium()@(report.Current ? " · " + T("where Shelf keeps you") : "")</span>
                            @if (!report.Current)
                            {
                                <button type="button" class="quiet" @onclick="() => UsePosition(report.Id)">@T("Go here")</button>
                            }
                        </li>
                    }
                </ul>
                @if (where.Chosen.Length > 0)
                {
                    <p class="hint">@T("Chosen before:") @string.Join("; ", where.Chosen.Select(choice => T("{0}: {1} instead of {2}", choice.At.Medium(), choice.Place, choice.Before)))</p>
                }
            </details>
        </section>
    }
    }

    @if (tab == "tab-details")
    {
    <section class="panel" id="details">
        <h2>@T("Details")</h2>
        @* What is known of this copy, to read at a glance; the form to change it stays folded until wanted. *@
        @if (Facts.Count > 0 || customValues.Any(item => item.Value is not null))
        {
            <dl class="facts book-facts">
                @foreach (var (label, value) in Facts)
                {
                    <dt>@label</dt>
                    <dd>@value</dd>
                }
                @* The reader's own fields: each value a way to the other books holding it. *@
                @foreach (var item in customValues.Where(item => item.Value is not null))
                {
                    <dt>@item.Name</dt>
                    <dd><a href="/library?field=@item.FieldId&value=@Uri.EscapeDataString(item.Value!)">@CustomFields.Show(item.Kind, item.Value!)</a></dd>
                }
            </dl>
        }
        @if (!string.IsNullOrWhiteSpace(book.Review))
        {
            <h3>@T("Review")</h3>
            <p class="review">@book.Review</p>
        }
        @if (!string.IsNullOrWhiteSpace(book.Notes))
        {
            <h3>@T("Notes")</h3>
            <p class="review">@book.Notes</p>
        }
        <details class="edit" open="@(editing || formErrors is { Count: > 0 } || saved)">
            <summary>@T("Edit the catalog, notes, and loan")</summary>
    <EditForm Model="draft" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />
        @if (formErrors is { Count: > 0 })
        {
            <ul class="validation-errors">
                @foreach (var message in formErrors.SelectMany(pair => pair.Value))
                {
                    <li>@message</li>
                }
            </ul>
        }
        <BookFields Model="draft" Detailed="true" />
        @if (customValues.Length > 0)
        {
            <fieldset class="custom-fields">
                <legend>@T("Your fields")</legend>
                @foreach (var item in customValues)
                {
                    <label>
                        @item.Name
                        @switch (item.Kind)
                        {
                            case FieldKind.Number:
                                <input type="text" inputmode="decimal" value="@FieldDraft(item.FieldId)" @onchange="change => SetField(item.FieldId, change)" />
                                break;
                            case FieldKind.Date:
                                <input type="date" value="@FieldDraft(item.FieldId)" @onchange="change => SetField(item.FieldId, change)" />
                                break;
                            case FieldKind.YesNo:
                                <select value="@FieldDraft(item.FieldId)" @onchange="change => SetField(item.FieldId, change)">
                                    <option value="">@T("Not said")</option>
                                    <option value="yes">@T("Yes")</option>
                                    <option value="no">@T("No")</option>
                                </select>
                                break;
                            default:
                                <input type="text" maxlength="@CustomValue.MaxLength" value="@FieldDraft(item.FieldId)" @onchange="change => SetField(item.FieldId, change)" />
                                break;
                        }
                    </label>
                }
                <p class="hint"><a href="/fields">@T("Change your fields")</a></p>
            </fieldset>
        }
        else
        {
            <p class="hint">@T("Want to keep something Shelf doesn't ask for?") <a href="/fields">@T("Add fields of your own")</a></p>
        }
        <button type="submit">@T("Save changes")</button>
        @if (saved)
        {
            <span class="saved" role="status">@T("Saved.")</span>
        }
    </EditForm>
        </details>
    @if (others.Count > 0)
    {
        <h3>@T("Also by {0}", book.Author)</h3>
        <ul class="tag-counts">
            @foreach (var other in others)
            {
                <li><a href="/library/@other.Id">@other.Title</a></li>
            }
        </ul>
    }
    </section>

    <section class="panel" id="collections">
        <h2>@T("Collections")</h2>
        @if (bookCollections.Any(item => item.Holds))
        {
            <ul class="chips">
                @foreach (var item in bookCollections.Where(item => item.Holds))
                {
                    <li class="chip-row">
                        <a href="/collections/@item.Id">@item.Name</a>
                        <button type="button" class="icon-button small" @onclick="() => LeaveCollection(item.Id)" aria-label="@T("Take this book out of {0}", item.Name)">×</button>
                    </li>
                }
            </ul>
        }
        @if (bookCollections.Any(item => !item.Holds))
        {
            <div class="save-search">
                <label>
                    @T("Add to a collection")
                    <select @bind="chosenCollection">
                        <option value="0">—</option>
                        @foreach (var item in bookCollections.Where(item => !item.Holds))
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </label>
                <button type="button" @onclick="JoinCollection" disabled="@(chosenCollection == 0)">@T("Add")</button>
            </div>
        }
        else if (bookCollections.Length == 0)
        {
            <p class="hint">@T("Collections are lists you make by hand.") <a href="/collections">@T("Make one")</a></p>
        }
    </section>

    <section class="panel" id="links">
        <h2>@T("Connections")</h2>
        <p class="hint">@T("Lines you draw between your books: another edition or translation, a book that inspired this one, one that answers it.") <a href="/map?book=@book.Id">@T("See it on the map")</a></p>
        @if (links.Length > 0)
        {
            <ul class="link-list">
                @foreach (var link in links)
                {
                    <li>
                        <span class="hint">@BookLinks.Describe(link.Kind, link.Outgoing)</span>
                        <a href="/library/@link.BookId">@link.Title</a>
                        <span class="hint">@link.Author</span>
                        @if (link.Note is not null)
                        {
                            <span> · @link.Note</span>
                        }
                        <button type="button" class="icon-button small" @onclick="() => Unlink(link.LinkId)" aria-label="@T("Take away the link to {0}", link.Title)">×</button>
                    </li>
                }
            </ul>
        }
        <form class="link-form" @onsubmit="FindToLink" @onsubmit:preventDefault>
            <label>
                @T("This book")
                <select @bind="linkKind">
                    @foreach (var (kind, label) in BookLinks.Choices())
                    {
                        <option value="@kind">@label</option>
                    }
                </select>
            </label>
            <label>
                @T("Find a book on your shelf")
                <input type="search" @bind="linkSearch" maxlength="200" />
            </label>
            <label>
                @T("Note")
                <input @bind="linkNote" maxlength="@BookLink.MaxNoteLength" placeholder="@T("Optional: how they meet")" />
            </label>
            <button type="submit">@T("Find")</button>
        </form>
        @if (linkMatches is { Count: > 0 })
        {
            <ul class="link-list">
                @foreach (var match in linkMatches)
                {
                    <li>
                        <button type="button" @onclick="() => Link(match.Id)">@T("Link")</button>
                        <span>@match.Title</span> <span class="hint">@match.Author</span>
                    </li>
                }
            </ul>
        }
        else if (linkMatches is not null)
        {
            <p class="hint">@T("No other book on your shelf matches that.")</p>
        }
        @if (linkProblem is not null)
        {
            <p class="validation-message" role="alert">@linkProblem</p>
        }
    </section>
    }

    @if (tab == "tab-copy")
    {
    <section class="panel" id="copy">
        <h2>@T("Your copy")</h2>
        @if (copyNote is not null)
        {
            <p class="validation-message" role="alert">@copyNote</p>
        }
        @if (book.HomeLocation is { } home)
        {
            <p>@T("At {0} for now; it lives at {1}.", book.Location ?? T("no place"), home) <button type="button" class="quiet" @onclick="PutBackHome">@T("Put it back")</button></p>
        }
        @if (book.LeftOn is not null)
        {
            <p>@Lifecycle.Describe(book). <button type="button" class="quiet" @onclick="TakeBack">@T("It's back on the shelf")</button></p>
        }
        else if (book.VisitingLinkId is null)
        {
            <details class="let-go">
                <summary>@T("Let this copy go")</summary>
                <p class="hint">@T("Donated, sold, given away: the copy leaves the library, and its record and your reading stay, under Let go.")</p>
                <div class="recipe-grid">
                    <label>
                        @T("How")
                        <select @bind="leaveHow">
                            @foreach (var how in Enum.GetValues<Departure>())
                            {
                                <option value="@how">@Lifecycle.DepartureLabel(how)</option>
                            }
                        </select>
                    </label>
                    <label>@T("When") <input type="date" @bind="leaveOn" /></label>
                    <label>@T("To whom, or where") <input maxlength="120" @bind="leaveTo" /></label>
                    @if (leaveHow == Departure.Sold)
                    {
                        <label>@T("Sold for") <input type="number" min="0" step="0.01" @bind="leaveFor" /></label>
                    }
                </div>
                <button type="button" @onclick="LetGo">@T("Let it go")</button>
            </details>
        }
        <p class="hint">@T("Pictures of this copy: an inscription, a signature, a bookplate, the spine. Only you see them.")</p>
        @if (PhotoMessage == "saved")
        {
            <p class="saved" role="status">@T("The picture is kept with this copy.")</p>
        }
        else if (PhotoMessage == "unsupported")
        {
            <p class="validation-message" role="alert">@T("Choose a JPEG, PNG, GIF, or WebP picture of 10 MB or less.")</p>
        }
        else if (PhotoMessage == "full")
        {
            <p class="validation-message" role="alert">@T("A copy keeps up to {0} pictures.", CopyPhoto.MaxPerBook)</p>
        }
        @if (photos.Length > 0)
        {
            <ul class="copy-photos">
                @foreach (var photo in photos)
                {
                    <li>
                        <a href="/books/@book.Id/photos/@photo.Id" target="_blank" rel="noopener"><img src="/books/@book.Id/photos/@photo.Id" alt="@(photo.Caption ?? T("A picture of this copy"))" loading="lazy" /></a>
                        @if (photo.Caption is not null)
                        {
                            <p class="hint">@photo.Caption</p>
                        }
                        <button type="button" class="quiet" @onclick="() => RemovePhoto(photo.Id)">@T("Remove")</button>
                    </li>
                }
            </ul>
        }
        @if (photos.Length < CopyPhoto.MaxPerBook)
        {
            <form action="/books/@book.Id/photos" method="post" enctype="multipart/form-data" data-enhance="false" data-upload>
                <label>
                    @T("A picture: JPEG, PNG, GIF, or WebP, up to 10 MB")
                    <input type="file" name="file" accept="image/jpeg,image/png,image/gif,image/webp" required />
                </label>
                <label>
                    @T("What it shows")
                    <input name="caption" maxlength="@CopyPhoto.MaxCaptionLength" />
                </label>
                <progress data-upload-progress max="100" hidden></progress>
                <p class="hint" data-upload-status role="status" hidden></p>
                <button type="submit">@T("Keep the picture")</button>
            </form>
        }
    </section>

    <section class="panel" id="lending">
        <h2>@T("Lending")</h2>
        @if (!string.IsNullOrWhiteSpace(book.LoanedTo))
        {
            <p>
                @T("Loaned to") <a href="@($"/library?loanedTo={Uri.EscapeDataString(book.LoanedTo)}")">@book.LoanedTo</a>@(book.BorrowerId is null ? "" : T(", a reader here"))
                @if (book.LoanedOn is DateOnly loanedOn)
                {
                    <span> @T("since {0}", loanedOn.Medium())</span>
                }
                @if (book.DueOn is DateOnly due)
                {
                    <span class="@(due < Today ? "late" : null)"> · @T("due {0}", due.Medium())@(due < Today ? T(", overdue") : "")</span>
                }
            </p>
            @if (book.BorrowerId is not null)
            {
                <p class="hint">@LendNote</p>
            }
            @if (waitingCount > 0)
            {
                <p class="hint">@(waitingCount == 1 ? T("1 reader is waiting for it.") : T("{0} readers are waiting for it.", waitingCount))</p>
            }
            <div class="pair">
                <label>
                    @T("Came back in")
                    <select @bind="returnCondition">
                        <option value="">@T("As it went out")</option>
                        @foreach (var condition in Enum.GetValues<CopyCondition>())
                        {
                            <option value="@condition">@BookRules.ConditionLabel(condition)</option>
                        }
                    </select>
                </label>
                <label>
                    @T("A note on the loan (optional)")
                    <input maxlength="@LoanRecord.MaxNoteLength" @bind="returnNote" />
                </label>
            </div>
            <button type="button" @onclick="ReturnLoan">@T("Mark returned")</button>
            <button type="button" class="quiet" @onclick="Renew">@T("Renew")</button>
        }
        else if (readers.Count == 0)
        {
            <p class="hint">@T("Not on loan. To lend it to someone, fill in Loaned to under Details.")</p>
        }
    else
    {
        <p class="hint">@T("Lend this book to another reader here. It shows on their loans until it comes back.") @LendNote</p>
        <div class="pair">
            <label>
                @T("Reader")
                <select @bind="lendTo">
                    <option value="0">@T("Choose a reader")</option>
                    @foreach (var reader in readers)
                    {
                        <option value="@reader.Id">@reader.Name</option>
                    }
                </select>
            </label>
            <label>
                @T("Due back")
                <input type="date" @bind="lendDue" />
            </label>
        </div>
        <button type="button" @onclick="LendBook" disabled="@(lendTo == 0)">@T("Lend")</button>
        @if (lendProblem is not null)
        {
            <p class="validation-message" role="alert">@lendProblem</p>
        }
    }
        @if (loans.Length > 0 && loans.Any(loan => loan.ReturnedOn is not null))
        {
            <details>
                <summary>@T("Earlier loans")</summary>
                <ul class="plain-list">
                    @foreach (var loan in loans.Where(loan => loan.ReturnedOn is not null))
                    {
                        <li>
                            <span>@loan.Borrower</span>
                            <span class="hint">
                                @loan.LentOn.Medium() – @(loan.ReturnedOn?.Medium())
                                @if (loan.Renewals > 0)
                                {
                                    <span> · @(loan.Renewals == 1 ? T("renewed once") : T("renewed {0} times", loan.Renewals))</span>
                                }
                                @if (loan.ConditionOut is CopyCondition went)
                                {
                                    <span> · @T("went out {0}", BookRules.ConditionLabel(went).ToLowerInvariant())</span>
                                }
                                @if (loan.ConditionBack is CopyCondition came)
                                {
                                    <span> · @T("came back {0}", BookRules.ConditionLabel(came).ToLowerInvariant())</span>
                                }
                            </span>
                            @if (loan.Note is { } said)
                            {
                                <p class="hint">@said</p>
                            }
                        </li>
                    }
                </ul>
            </details>
        }
        @if (!string.IsNullOrWhiteSpace(book.Location) || book.AcquiredOn is not null || book.Acquisition is not null || book.Condition is not null || !string.IsNullOrWhiteSpace(book.RecommendedBy))
        {
            <h3>@T("This copy")</h3>
            <p class="hint">
                @if (book.Acquisition is Acquisition arrived)
                {
                    <span>@BookRules.AcquisitionLabel(arrived)</span>
                }
                @if (!string.IsNullOrWhiteSpace(book.Location))
                {
                    <span>@(book.Acquisition is null ? "" : " · ")</span>
                    <a href="@($"/library?place={Uri.EscapeDataString(book.Location)}")">@book.Location</a>
                }
                @if (book.AcquiredOn is DateOnly acquired)
                {
                    <span>@(book.Acquisition is null && string.IsNullOrWhiteSpace(book.Location) ? "" : " · ")@T("Acquired {0}", acquired.Medium())</span>
                }
                @if (book.Condition is CopyCondition condition)
                {
                    <span>@(book.Acquisition is null && string.IsNullOrWhiteSpace(book.Location) && book.AcquiredOn is null ? "" : " · ")@BookRules.ConditionLabel(condition)</span>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(book.RecommendedBy))
            {
                <p class="hint"><a href="@($"/library?recommendedBy={Uri.EscapeDataString(book.RecommendedBy)}")">@T("Recommended by {0}", book.RecommendedBy)</a></p>
            }
        }
    </section>

    <section class="panel" id="files">
        <h2>@T("Files")</h2>
    <h3>@T("Cover")</h3>
    <div class="cover-choice">
        <BookCover Title="@book.Title" Url="@book.CoverShown" Width="5rem" />
        <div>
            <p class="hint">@CoverSource</p>
            <form action="/books/@book.Id/cover" method="post" enctype="multipart/form-data" data-enhance="false" data-upload>
                <label>
                    @(book.CoverImage is null ? T("Use a picture of your own: JPEG, PNG, GIF, or WebP, up to 10 MB") : T("Use a different picture: JPEG, PNG, GIF, or WebP, up to 10 MB"))
                    <input type="file" name="file" accept="image/jpeg,image/png,image/gif,image/webp" required />
                </label>
                <progress data-upload-progress max="100" hidden></progress>
                <p class="hint" data-upload-status role="status" hidden></p>
                <button type="submit">@T("Upload the picture")</button>
                @if (book.CoverImage is not null)
                {
                    <button type="button" class="quiet" @onclick="RemoveCover">@T("Remove the picture")</button>
                }
            </form>
        </div>
    </div>
    @if (borrowable.Count > 0)
    {
        <p class="hint">@T("Before uploading: another reader has this book with a file you could borrow.")</p>
        <OpenCopies Copies="borrowable" />
    }
    <h3>@T("E-book")</h3>
    @if (!string.IsNullOrWhiteSpace(book.EbookFileName))
    {
        <p>@book.EbookFileName · <a href="/books/@book.Id/ebook/download" download>@T("Download the file")</a></p>
        @if (EbookStore.IsEpub(book.EbookStoredName))
        {
            <p class="hint">@T("The download carries this book's title, authors, series, and cover as Shelf has them, so other apps and devices show them too. The file kept here is unchanged.")</p>
        }
        <button type="button" @onclick="RemoveEbook">@T("Remove the file")</button>
    }
    <form action="/books/@book.Id/ebook" method="post" enctype="multipart/form-data" data-enhance="false" data-upload>
        <label>
            @T("EPUB, PDF, comic (CBZ, CBR, or CB7), or Kindle file, up to {0}", Localization.Counts.Size(EbookStore.MaxBytes))
            <input type="file" name="file" accept=".epub,.pdf,.cbz,.cbr,.cb7,.cbt,.mobi,.azw3,.azw,application/epub+zip,application/pdf" required />
        </label>
        <progress data-upload-progress max="100" hidden></progress>
        <p class="hint" data-upload-status role="status" hidden></p>
        <button type="submit">@T("Upload")</button>
