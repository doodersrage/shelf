@page "/library/{Id:int}"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory
@inject NavigationManager Navigation
@inject EbookStore Ebooks
@inject AudioStore Audio
@inject CoverStore Covers
@inject OcrService Ocr
@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider Protection
@using Microsoft.JSInterop
@inject IJSRuntime Js
@inject IEmailSender Email
@implements IAsyncDisposable

<PageTitle>@(book?.Title ?? "Shelf")</PageTitle>

@if (missing)
{
    <h1>@T("Not on the shelf")</h1>
    <p>@T("That book is not here.") <a href="/">@T("Back to the library")</a></p>
}
else if (book is not null)
{
    <p class="hint"><a href="/">@T("Library")</a></p>
    <header class="book-hero">
        <BookCover Title="@book.Title" Url="@book.CoverShown" Decorative="false" />
        <div>
            <h1>@book.Title</h1>
            @if (!string.IsNullOrWhiteSpace(book.Subtitle))
            {
                <p class="hint">@book.Subtitle</p>
            }
            <p class="by">
                <a href="@($"/?author={Uri.EscapeDataString(book.Author)}")">@book.Author</a>
                @if (!string.IsNullOrWhiteSpace(book.Translator))
                {
                    <span class="hint"> · @T("translated by {0}", book.Translator)</span>
                }
                @if (!string.IsNullOrWhiteSpace(book.Narrator))
                {
                    <span class="hint"> · @T("read by {0}", book.Narrator)</span>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(book.OriginalTitle))
            {
                <p class="hint">@T("Originally {0}", book.OriginalTitle)</p>
            }
            @if (!string.IsNullOrWhiteSpace(book.Series))
            {
                <p class="hint">
                    <a href="@($"/?series={Uri.EscapeDataString(book.Series)}")">@book.Series</a>
                    @if (book.SeriesNumber is int number)
                    {
                        <span> · @T("book {0}", number)</span>
                    }
                </p>
            }
            @if (nextVolume is not null)
            {
                <p class="hint">@T("Next:") <a href="/library/@nextVolume.Id">@nextVolume.Title</a></p>
            }
            <div class="badges">
                <StatusBadge Status="book.Status" />
                @if (!string.IsNullOrWhiteSpace(book.LoanedTo))
                {
                    <span class="badge loan">@T("On loan")</span>
                }
                @if (book.Loved)
                {
                    <span class="badge plain">@T("Loved")</span>
                }
                @if (book.Rating is int rating)
                {
                    <span class="badge plain">@T("{0} of 5", rating)</span>
                }
            </div>
            @if (book.Queued)
            {
                <p class="hint">@T("On the read-next list.")</p>
            }
            @if (BookRules.PagesRemaining(book) is int left)
            {
                <p class="hint">
                    @if (left == 0)
                    {
                        <span>@T("At the last page.")</span>
                    }
                    else
                    {
                        <span>@(left == 1 ? T("1 page left") : T("{0} pages left", left))</span>
                        @if (BookRules.DaysRemaining(book) is int days)
                        {
                            <span> · @(days == 1 ? T("about 1 day") : T("about {0} days", days))</span>
                        }
                    }
                </p>
            }
            <div class="status-actions">
                @switch (book.Status)
                {
                    case BookStatus.Want:
                        <button type="button" class="primary" @onclick="() => MoveTo(BookStatus.Reading)">@T("Start reading")</button>
                        break;
                    case BookStatus.Reading:
                        <button type="button" class="primary" @onclick="() => MoveTo(BookStatus.Finished)">@T("Mark finished")</button>
                        <button type="button" class="quiet" @onclick="() => MoveTo(BookStatus.Abandoned)">@T("Stop reading")</button>
                        break;
                    case BookStatus.Finished:
                        @if (book.FinishedOn is DateOnly finishedOn)
                        {
                            <span class="hint">@T("Finished {0}", finishedOn.Long())</span>
                        }
                        break;
                    case BookStatus.Abandoned:
                        <button type="button" class="quiet" @onclick="() => MoveTo(BookStatus.Reading)">@T("Pick it up again")</button>
                        break;
                }
                @if (!string.IsNullOrWhiteSpace(book.EbookStoredName))
                {
                    <a class="button" href="/library/@book.Id/read">@T("Read this e-book")</a>
                    @if (offlineSupported && !EbookStore.IsComic(book.EbookStoredName))
                    {
                        @if (keptOffline)
                        {
                            <button type="button" class="quiet" @onclick="ForgetOffline" aria-pressed="true">@T("Kept offline · forget")</button>
                        }
                        else
                        {
                            <button type="button" class="quiet" @onclick="KeepOffline" disabled="@keeping">@(keeping ? T("Keeping…") : T("Keep for reading offline"))</button>
                        }
                    }
                    @if (Email.Enabled && Kindle.Takes(book))
                    {
                        <button type="button" class="quiet" @onclick="SendToKindle" disabled="@sendingToKindle">@(sendingToKindle ? T("Sending…") : T("Send to Kindle"))</button>
                    }
                    @if (kindleNote is not null)
                    {
                        <span class="@(kindleSent ? "saved" : "validation-message")" role="status">@kindleNote @if (!kindleSent && kindleNeedsAddress) { <a href="/account#kindle">@T("Account")</a> }</span>
                    }
                }
                @if (!string.IsNullOrWhiteSpace(book.AudioStoredName))
                {
                    <a class="button" href="/library/@book.Id/listen">@T("Listen to this audiobook")</a>
                    <button type="button" class="quiet play-here" data-play-book="@book.Id"><PlayerIcon Name="play" /> @T("Play while you browse")</button>
                    @if (offlineSupported)
                    {
                        @if (keptAudio)
                        {
                            <button type="button" class="quiet" @onclick="ForgetAudio" aria-pressed="true">@T("Kept for listening offline · forget")</button>
                        }
                        else
                        {
                            <button type="button" class="quiet" @onclick="KeepAudio" disabled="@keepingAudio">@(keepingAudio ? T("Keeping…") : T("Keep for listening offline"))</button>
                        }
                        <span class="hint" data-keep-progress data-template="@T("Track {0} of {1}")" aria-live="polite"></span>
                    }
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(book.AudioStoredName) && ((book.AudioTrack ?? 0) > 0 || (book.AudioSeconds ?? 0) > 0))
            {
                <p class="hint">@T("Paused at {0}", PausedAt(book))</p>
            }
        </div>
    </header>

    @if (ImportedMessage == "1")
    {
        <p class="saved" role="status">@T("Made from the file. Check the details below; anything the file did not say is blank.")</p>
    }
    @if (EbookMessage == "saved")
    {
        <p class="saved" role="status">@T("The e-book is on the shelf.")</p>
    }
    else if (EbookMessage == "unsupported")
    {
        <p class="validation-message" role="alert">@T("Choose an EPUB, a PDF, a comic (CBZ), or a Kindle file.")</p>
    }
    else if (EbookMessage == "large")
    {
        <p class="validation-message" role="alert">@T("That file is larger than 80 MB.")</p>
    }
    else if (EbookMessage == "convert")
    {
        <p class="validation-message" role="alert">@T("That Kindle file could not be turned into an EPUB. Shelf needs Calibre installed on the server for that, and a file locked with DRM cannot be converted at all.")</p>
    }
    @if (CoverMessage == "saved")
    {
        <p class="saved" role="status">@T("The cover is on the shelf.")</p>
    }
    else if (CoverMessage == "unsupported")
    {
        <p class="validation-message" role="alert">@T("Choose a JPEG, PNG, GIF, or WebP picture of 10 MB or less.")</p>
    }
    @if (AudioMessage == "saved")
    {
        <p class="saved" role="status">@T("The audiobook is on the shelf.")</p>
    }
    else if (AudioMessage == "unsupported")
    {
        <p class="validation-message" role="alert">@T("Choose an audio file, or a zip of them.")</p>
    }
    else if (AudioMessage == "large")
    {
        <p class="validation-message" role="alert">@T("That audiobook is larger than 1 GB.")</p>
    }

    @if (held is not null)
    {
        <div class="notice ask" role="alert">
            <p>
                @(held.Kind == UploadKind.Ebook ? T("That e-book is already on another book, byte for byte:") : T("That audiobook is already on another book, byte for byte:"))
                <a href="/library/@held.SameAsId">@heldSameTitle</a>.
                @T("Keep a second copy here as well?")
            </p>
            <div class="status-actions">
                <button type="button" @onclick="KeepHeld" disabled="@deciding">@T("Keep both")</button>
                <button type="button" class="quiet" @onclick="LetHeldGo" disabled="@deciding">@T("Don't add it")</button>
            </div>
        </div>
    }
    else if (heldExpired)
    {
        <p class="validation-message" role="alert">@T("That upload was not kept. Choose the file again to add it.")</p>
    }

    @if (!string.IsNullOrWhiteSpace(book.Inscription))
    {
        <p class="inscription">@book.Inscription</p>
    }

    <nav class="section-nav" aria-label="@T("On this page")">
        <a href="/library/@book.Id#reading">@T("Reading")</a>
        <a href="/library/@book.Id#lending">@T("Lending")</a>
        <a href="/library/@book.Id#quotes">@T("Quotes")</a>
        <a href="/library/@book.Id#highlights">@T("Highlights")</a>
        <a href="/library/@book.Id#files">@T("Files")</a>
        <a href="/library/@book.Id#details">@T("Details")</a>
    </nav>

    <section class="panel" id="reading">
    <h2>@T("Reading log")</h2>
    @if (book.Sessions.Count == 0)
    {
        <p class="hint">@T("No sessions yet.")</p>
    }
    else
    {
        <ul class="tag-counts">
            @foreach (var session in book.Sessions.OrderByDescending(item => item.Date).ThenByDescending(item => item.Id))
            {
                <li>
                    <span>
                        @session.Date.Medium()
                        @if (session.FromPage is int from && session.ToPage is int to)
                        {
                            <span> · @from–@to</span>
                        }
                        else if (session.ToPage is int end)
                        {
                            <span> · @T("to {0}", end)</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(session.Note))
                        {
                            <span> · @session.Note</span>
                        }
                    </span>
                    <button type="button" @onclick="() => RemoveSession(session.Id)">@T("Remove")</button>
                </li>
            }
        </ul>
        @if (BookRules.PagesPerDay(book.Sessions) is int pace)
        {
            <p class="hint">@(pace == 1 ? T("About 1 page a day.") : T("About {0} pages a day.", pace))</p>
        }
    }

    <EditForm Model="sessionDraft" OnValidSubmit="AddSession">
        <DataAnnotationsValidator />
        @if (sessionErrors is { Count: > 0 })
        {
            <ul class="validation-errors">
                @foreach (var message in sessionErrors.SelectMany(pair => pair.Value))
                {
                    <li>@message</li>
                }
            </ul>
        }
        <div class="pair">
            <label>
                @T("Date")
                <InputDate @bind-Value="sessionDraft.Date" />
            </label>
            <label>
                @T("Note")
                <InputText @bind-Value="sessionDraft.Note" maxlength="500" />
            </label>
        </div>
        <div class="pair">
            <label>
                @T("From page")
                <InputNumber @bind-Value="sessionDraft.FromPage" />
            </label>
            <label>
                @T("To page")
                <InputNumber @bind-Value="sessionDraft.ToPage" />
            </label>
        </div>
        <button type="submit">@T("Add session")</button>
    </EditForm>
    </section>

    <section class="panel" id="lending">
        <h2>@T("Lending")</h2>
        @if (!string.IsNullOrWhiteSpace(book.LoanedTo))
        {
            <p>
                @T("Loaned to") <a href="@($"/?loanedTo={Uri.EscapeDataString(book.LoanedTo)}")">@book.LoanedTo</a>@(book.BorrowerId is null ? "" : T(", a reader here"))
                @if (book.LoanedOn is DateOnly loanedOn)
                {
                    <span> @T("since {0}", loanedOn.Medium())</span>
                }
                @if (book.DueOn is DateOnly due)
                {
                    <span class="@(due < Today ? "late" : null)"> · @T("due {0}", due.Medium())@(due < Today ? T(", overdue") : "")</span>
                }
            </p>
            <button type="button" @onclick="ReturnLoan">@T("Mark returned")</button>
        }
        else if (readers.Count == 0)
        {
            <p class="hint">@T("Not on loan. To lend it to someone, fill in Loaned to under Details.")</p>
        }
    else
    {
        <p class="hint">@T("Lend this book to another reader here. It shows on their loans until it comes back.")</p>
        <div class="pair">
            <label>
                @T("Reader")
                <select @bind="lendTo">
                    <option value="0">@T("Choose a reader")</option>
                    @foreach (var reader in readers)
                    {
                        <option value="@reader.Id">@reader.Name</option>
                    }
                </select>
            </label>
            <label>
                @T("Due back")
                <input type="date" @bind="lendDue" />
            </label>
        </div>
        <button type="button" @onclick="LendBook" disabled="@(lendTo == 0)">@T("Lend")</button>
        @if (lendProblem is not null)
        {
            <p class="validation-message" role="alert">@lendProblem</p>
        }
    }
        @if (!string.IsNullOrWhiteSpace(book.Location) || book.AcquiredOn is not null || book.Acquisition is not null || book.Condition is not null || !string.IsNullOrWhiteSpace(book.RecommendedBy))
        {
            <h3>@T("This copy")</h3>
            <p class="hint">
                @if (book.Acquisition is Acquisition arrived)
                {
                    <span>@BookRules.AcquisitionLabel(arrived)</span>
                }
                @if (!string.IsNullOrWhiteSpace(book.Location))
                {
                    <span>@(book.Acquisition is null ? "" : " · ")</span>
                    <a href="@($"/?place={Uri.EscapeDataString(book.Location)}")">@book.Location</a>
                }
                @if (book.AcquiredOn is DateOnly acquired)
                {
                    <span>@(book.Acquisition is null && string.IsNullOrWhiteSpace(book.Location) ? "" : " · ")@T("Acquired {0}", acquired.Medium())</span>
                }
                @if (book.Condition is CopyCondition condition)
                {
                    <span>@(book.Acquisition is null && string.IsNullOrWhiteSpace(book.Location) && book.AcquiredOn is null ? "" : " · ")@BookRules.ConditionLabel(condition)</span>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(book.RecommendedBy))
            {
                <p class="hint"><a href="@($"/?recommendedBy={Uri.EscapeDataString(book.RecommendedBy)}")">@T("Recommended by {0}", book.RecommendedBy)</a></p>
            }
        }
    </section>

    <section class="panel" id="collections">
        <h2>@T("Collections")</h2>
        @if (bookCollections.Any(item => item.Holds))
        {
            <ul class="chips">
                @foreach (var item in bookCollections.Where(item => item.Holds))
                {
                    <li class="chip-row">
                        <a href="/collections/@item.Id">@item.Name</a>
                        <button type="button" class="icon-button small" @onclick="() => LeaveCollection(item.Id)" aria-label="@T("Take this book out of {0}", item.Name)">×</button>
                    </li>
                }
            </ul>
        }
        @if (bookCollections.Any(item => !item.Holds))
        {
            <div class="save-search">
                <label>
                    @T("Add to a collection")
                    <select @bind="chosenCollection">
                        <option value="0">—</option>
                        @foreach (var item in bookCollections.Where(item => !item.Holds))
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </label>
                <button type="button" @onclick="JoinCollection" disabled="@(chosenCollection == 0)">@T("Add")</button>
            </div>
        }
        else if (bookCollections.Length == 0)
        {
            <p class="hint">@T("Collections are lists you make by hand.") <a href="/collections">@T("Make one")</a></p>
        }
    </section>

    <section class="panel" id="quotes">
    <h2>@T("Quotes")</h2>
    @if (book.Quotes.Count == 0)
    {
        <p class="hint">@T("No quotes yet.")</p>
    }
    else
    {
        <ul class="quotes">
            @foreach (var quote in book.Quotes.OrderBy(item => item.NotedAt).ThenBy(item => item.Id))
            {
                <li>
                    <blockquote>
                        <p>@quote.Text</p>
                        @if (quote.Page is int page)
                        {
                            <span class="hint">p. @(page)</span>
                        }
                    </blockquote>
                    <button type="button" @onclick="() => RemoveQuote(quote.Id)">@T("Remove")</button>
                </li>
            }
        </ul>
    }

    <EditForm Model="quoteDraft" OnValidSubmit="AddQuote">
        <DataAnnotationsValidator />
        @if (quoteErrors is { Count: > 0 })
        {
            <ul class="validation-errors">
                @foreach (var message in quoteErrors.SelectMany(pair => pair.Value))
                {
                    <li>@message</li>
                }
            </ul>
        }
        <label>
            @T("Quote")
            <InputTextArea @bind-Value="quoteDraft.Text" maxlength="1000" rows="3" />
            <ValidationMessage For="() => quoteDraft.Text" />
        </label>
        <label>
            @T("Page")
            <InputNumber @bind-Value="quoteDraft.Page" />
            <ValidationMessage For="() => quoteDraft.Page" />
        </label>
        <button type="submit">@T("Add quote")</button>
    </EditForm>
    </section>

    <section class="panel" id="highlights">
    <h2>@T("Highlights")</h2>
    @if (book.Highlights.Count == 0)
    {
        <p class="hint">@T("No highlights yet.")</p>
    }
    else
    {
        <ul class="quotes">
            @foreach (var mark in book.Highlights.OrderBy(item => item.ChapterIndex).ThenBy(item => item.Id))
            {
                <li>
                    <blockquote>
                        <p>@mark.Text</p>
                        <span class="hint">@(EbookStore.IsPdf(book.EbookStoredName) ? T("Page {0}", mark.ChapterIndex + 1) : T("Chapter {0}", mark.ChapterIndex + 1))</span>
                    </blockquote>
                    @if (!string.IsNullOrWhiteSpace(mark.Note))
                    {
                        <p>@mark.Note</p>
                    }
                    <a href="@($"/library/{book.Id}/read?chapter={mark.ChapterIndex}")">@T("Open")</a>
                    <button type="button" @onclick="() => RemoveHighlight(mark.Id)">@T("Remove")</button>
                </li>
            }
        </ul>
    }
    @if (book.Highlights.Count > 0 || book.Quotes.Count > 0 || !string.IsNullOrWhiteSpace(book.Review) || !string.IsNullOrWhiteSpace(book.Notes))
    {
        <p class="hint"><a href="/books/@book.Id/notes.md" download>@T("Download this book's quotes, highlights, and notes as Markdown")</a></p>
    }
    </section>

    <section class="panel" id="files">
        <h2>@T("Files")</h2>
    <h3>@T("Cover")</h3>
    <div class="cover-choice">
        <BookCover Title="@book.Title" Url="@book.CoverShown" Width="5rem" />
        <div>
            <p class="hint">@CoverSource</p>
            <form action="/books/@book.Id/cover" method="post" enctype="multipart/form-data" data-enhance="false" data-upload>
                <label>
                    @(book.CoverImage is null ? T("Use a picture of your own: JPEG, PNG, GIF, or WebP, up to 10 MB") : T("Use a different picture: JPEG, PNG, GIF, or WebP, up to 10 MB"))
                    <input type="file" name="file" accept="image/jpeg,image/png,image/gif,image/webp" required />
                </label>
                <progress data-upload-progress max="100" hidden></progress>
                <p class="hint" data-upload-status role="status" hidden></p>
                <button type="submit">@T("Upload the picture")</button>
                @if (book.CoverImage is not null)
                {
                    <button type="button" class="quiet" @onclick="RemoveCover">@T("Remove the picture")</button>
                }
            </form>
        </div>
    </div>
    @if (borrowable.Count > 0)
    {
        <p class="hint">@T("Before uploading: another reader has this book with a file you could borrow.")</p>
        <OpenCopies Copies="borrowable" />
    }
    <h3>@T("E-book")</h3>
    @if (offlineNote is not null)
    {
        <p class="hint" role="status">@offlineNote</p>
    }
    @if (!string.IsNullOrWhiteSpace(book.EbookFileName))
    {
        <p>@book.EbookFileName</p>
        <button type="button" @onclick="RemoveEbook">@T("Remove the file")</button>
    }
    <form action="/books/@book.Id/ebook" method="post" enctype="multipart/form-data" data-enhance="false" data-upload>
        <label>
            @T("EPUB, PDF, comic (CBZ), or Kindle file, up to 80 MB")
            <input type="file" name="file" accept=".epub,.pdf,.cbz,.mobi,.azw3,.azw,application/epub+zip,application/pdf" required />
        </label>
        <progress data-upload-progress max="100" hidden></progress>
        <p class="hint" data-upload-status role="status" hidden></p>
        <button type="submit">@T("Upload")</button>
    </form>

    <h3>@T("Audiobook")</h3>
    @if (!string.IsNullOrWhiteSpace(book.AudioFileName))
    {
        <p>@book.AudioFileName</p>
        <button type="button" @onclick="RemoveAudio">@T("Remove the recording")</button>
    }
    <form action="/books/@book.Id/audio" method="post" enctype="multipart/form-data" data-enhance="false" data-upload>
        <label>
            @T("Audio or a zip of tracks, up to 1 GB")
            <input type="file" name="file" accept=".mp3,.m4a,.m4b,.aac,.ogg,.opus,.wav,.flac,.zip,audio/*" multiple required />
        </label>
        <progress data-upload-progress max="100" hidden></progress>
        <p class="hint" data-upload-status role="status" hidden></p>
        <button type="submit">@T("Upload")</button>
    </form>
    </section>

    <section class="panel" id="details">
        <h2>@T("Details")</h2>
        <details class="edit" open="@(formErrors is { Count: > 0 } || saved)">
            <summary>@T("Edit the catalog, notes, and loan")</summary>
    <EditForm Model="draft" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />
        @if (formErrors is { Count: > 0 })
        {
            <ul class="validation-errors">
                @foreach (var message in formErrors.SelectMany(pair => pair.Value))
                {
                    <li>@message</li>
                }
            </ul>
        }
        <BookFields Model="draft" Detailed="true" />
        <button type="submit">@T("Save changes")</button>
        @if (saved)
        {
            <span class="saved" role="status">@T("Saved.")</span>
        }
    </EditForm>
        </details>
    @if (others.Count > 0)
    {
        <h3>@T("Also by {0}", book.Author)</h3>
        <ul class="tag-counts">
            @foreach (var other in others)
            {
                <li><a href="/library/@other.Id">@other.Title</a></li>
            }
        </ul>
    }
    </section>

    <section class="panel" id="remove">
        <h2>@T("Remove")</h2>
    @if (!confirmingDelete)
    {
        <button type="button" class="danger" @onclick="() => confirmingDelete = true">@T("Delete this book")</button>
    }
    else
    {
        <p>@T("This deletes the book, its quotes, its highlights, its reading log, its e-book, and its audiobook.")</p>
        <button type="button" class="danger" @onclick="Delete">@T("Yes, delete it")</button>
        <button type="button" @onclick="() => confirmingDelete = false">@T("Cancel")</button>
    }
    </section>
}

@code {
    private IJSObjectReference? keepModule;
    private bool offlineSupported;
    private bool keptOffline;
    private bool keptAudio;
    private bool keepingAudio;
    private bool keeping;
    private string? offlineNote;
    private bool sendingToKindle;
    private string? kindleNote;
    private bool kindleSent;
    private bool kindleNeedsAddress;

    private async Task SendToKindle()
    {
        if (book is null)
        {
            return;
        }

        sendingToKindle = true;
        kindleNote = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var problem = await Kindle.SendAsync(db, Ebooks, Email, book.Id, CancellationToken.None);
            kindleSent = problem is null;
            kindleNeedsAddress = !kindleSent && !await db.Readers.AnyAsync(reader => reader.Id == db.ReaderId && reader.KindleEmail != null);
            kindleNote = problem ?? T("Sent. It reaches the Kindle in a few minutes, once Amazon has it.");
        }
        finally
        {
            sendingToKindle = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || book is null || (string.IsNullOrWhiteSpace(book.EbookStoredName) && string.IsNullOrWhiteSpace(book.AudioStoredName)))
        {
            return;
        }

        try
        {
            keepModule = await Js.InvokeAsync<IJSObjectReference>("import", "./keep.js");
            offlineSupported = await keepModule.InvokeAsync<bool>("supported");
            keptOffline = offlineSupported && await keepModule.InvokeAsync<bool>("isKept", book.Id);
            keptAudio = offlineSupported && await keepModule.InvokeAsync<bool>("isAudioKept", book.Id);
            StateHasChanged();
        }
        catch (JSException)
        {
            offlineSupported = false;
        }
    }

    // The e-book goes into this browser's storage, for the offline reader to open without a connection.
    private async Task KeepOffline()
    {
        if (keepModule is null || book is null)
        {
            return;
        }

        keeping = true;
        try
        {
            var type = EbookStore.IsPdf(book.EbookStoredName) ? "pdf" : "epub";
            keptOffline = await keepModule.InvokeAsync<bool>("keep", book.Id, book.Title, book.Author, type);
            offlineNote = keptOffline
                ? T("Kept on this device. When the shelf cannot be reached, it opens in the offline reader, and your place comes back when you are online.")
                : T("This e-book could not be kept on this device.");
        }
        catch (JSException)
        {
            offlineNote = T("This browser would not keep the e-book. It may be out of space, or in a private window.");
        }
        finally
        {
            keeping = false;
        }
    }

    // Every track goes into this browser's storage, so the book plays with no connection, here or in the offline page.
    private async Task KeepAudio()
    {
        if (keepModule is null || book is null)
        {
            return;
        }

        keepingAudio = true;
        try
        {
            keptAudio = await keepModule.InvokeAsync<bool>("keepAudio", TimeSpan.FromHours(1), [book.Id]);
            offlineNote = keptAudio
                ? T("Kept on this device. It plays from here, and with no connection it is in the offline page; your place goes back when you are online.")
                : T("This audiobook could not be kept on this device.");
        }
        catch (JSException)
        {
            offlineNote = T("This browser would not keep the audiobook. It may be out of space, or in a private window.");
        }
        finally
        {
            keepingAudio = false;
        }
    }

    private async Task ForgetAudio()
    {
        if (keepModule is null || book is null)
        {
            return;
        }

        await keepModule.InvokeVoidAsync("forgetAudio", book.Id);
        keptAudio = false;
        offlineNote = T("No longer kept on this device.");
    }

    private async Task ForgetOffline()
    {
        if (keepModule is null || book is null)
        {
            return;
        }

        await keepModule.InvokeVoidAsync("forget", book.Id);
        keptOffline = false;
        offlineNote = T("No longer kept on this device.");
    }

    public async ValueTask DisposeAsync()
    {
        if (keepModule is not null)
        {
            try
            {
                await keepModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

