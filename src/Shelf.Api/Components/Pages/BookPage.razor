                @foreach (var name in makeable)
                {
                    <button type="button" class="quiet" disabled="@(converting is not null)" @onclick="() => Convert(name)">@T("Make {0}", name)</button>
                }
            </p>
        }
    }
    @if (converting is not null)
    {
        <p class="hint" role="status">@T("Making the {0}… This can take a minute.", converting)</p>
    }
    else if (convertNote is not null)
    {
        <p class="@(convertOk ? "saved" : "validation-message")" role="@(convertOk ? "status" : "alert")">@convertNote</p>
    }
    <form action="/books/@book.Id/ebook/formats" method="post" enctype="multipart/form-data" data-enhance="false" data-upload>
        <label>
            @T("Another format of this book (EPUB, PDF, CBZ, AZW3, or MOBI), kept as it is beside the main e-book")
            <input type="file" name="file" accept=".epub,.pdf,.cbz,.cbr,.cb7,.cbt,.mobi,.azw3,.azw" required />
        </label>
        <progress data-upload-progress max="100" hidden></progress>
        <p class="hint" data-upload-status role="status" hidden></p>
        <button type="submit">@T("Add the format")</button>
    </form>

    @if (EbookStore.IsComic(book.EbookStoredName))
    {
        <ComicVineSearch BookId="book.Id" InitialQuery="@(book.Series is { } series ? $"{series} {book.SeriesNumber}".Trim() : book.Title)" Changed="() => LoadAsync()" />
    }

    <h3>@T("Audiobook")</h3>
    @if (!string.IsNullOrWhiteSpace(book.AudioFileName))
    {
        <p>@book.AudioFileName · <a href="/books/@book.Id/audio/download" download>@T("Download the recording")</a></p>
        <p class="hint">@T("The download carries this book's title, author, narrator, and cover in its files, and its chapters in a single file, so other players show them. The files kept here are unchanged.")</p>
        <p><AddToPlaylist BookId="book.Id" Title="@book.Title" /> · <a href="/sessions?book=@book.Id">@T("Listening sessions")</a></p>
        <AudioFeedControl BookId="book.Id" />
        <button type="button" @onclick="RemoveAudio">@T("Remove the recording")</button>
    }
    @if (!string.IsNullOrWhiteSpace(book.AudioStoredName) || book.Format == BookFormat.Audiobook)
    {
        <AudibleSearch BookId="book.Id" InitialTitle="@book.Title" InitialAuthor="@book.Author" HasChapters="book.AudioChapterNames is not null" Changed="() => LoadAsync()" />
    }
    <ReadAlongPanel BookId="book.Id" />
    <M4bPanel BookId="book.Id" />
    <form action="/books/@book.Id/audio" method="post" enctype="multipart/form-data" data-enhance="false" data-upload>
        <label>
            @T("Audio or a zip of tracks, up to {0}", Localization.Counts.Size(AudioStore.MaxBytes))
            <input type="file" name="file" accept=".mp3,.m4a,.m4b,.aac,.ogg,.opus,.wav,.flac,.zip,audio/*" multiple required />
        </label>
        <progress data-upload-progress max="100" hidden></progress>
        <p class="hint" data-upload-status role="status" hidden></p>
        <button type="submit">@T("Upload")</button>
    </form>
    </section>
    }

    @if (tab == "tab-history")
    {
    <section class="panel" id="history">
        <details>
            <summary><h2>@T("History")</h2></summary>
            <p class="hint">@T("Every change to this book's details, newest first. Put back sets a detail as it was before that change, whatever it is now.")</p>
            @if (changes.Length == 0)
            {
                <p class="hint">@T("No changes yet.")</p>
            }
            else
            {
                <ul class="plain-list">
                    @foreach (var change in changes)
                    {
                        <li>
                            <strong>@change.Label</strong>
                            <span>@(change.Field == BookChange.Tag ? (change.After is not null ? T("{0} put on", change.After) : T("{0} taken off", change.Before ?? "")) : T("{0} → {1}", change.Before ?? T("(empty)"), change.After ?? T("(empty)")))</span>
                            <span class="hint">@change.At.Medium()@(change.Batch is { } batch ? " · " + batch : "")</span>
                            <button type="button" class="quiet" @onclick="() => PutBack(change.Id)">@T("Put back")</button>
                        </li>
                    }
                </ul>
            }
        </details>
    </section>

    <section class="panel" id="remove">
        <h2>@T("Remove")</h2>
    @if (!confirmingDelete)
    {
        <button type="button" class="danger" @onclick="() => confirmingDelete = true">@T("Delete this book")</button>
    }
    else
    {
        <p>@T("This deletes the book, its quotes, its highlights, its reading log, its e-book, and its audiobook.") @T("They wait in the trash for {0} days, and can be brought back from there.", Trash.Days(Configuration))</p>
        <button type="button" class="danger" @onclick="Delete">@T("Yes, delete it")</button>
        <button type="button" @onclick="() => confirmingDelete = false">@T("Cancel")</button>
    }
    </section>
    }

}

@code {
    private string tab = "";

    private static IReadOnlyList<(string Key, string Label)> BookTabs =>
    [
        ("tab-reading", T("Reading")),
        ("tab-details", T("Details")),
        ("tab-copy", T("Your copy")),
        ("tab-history", T("History")),
    ];

    // Which tab each section is in, so a link to /library/1#lending, say, opens its tab.
    private static readonly Dictionary<string, string> BookSections = new()
    {
        ["reading"] = "tab-reading",
        ["reads"] = "tab-reading",
        ["quotes"] = "tab-reading",
        ["highlights"] = "tab-reading",
        ["positions"] = "tab-reading",
        ["details"] = "tab-details",
        ["collections"] = "tab-details",
        ["links"] = "tab-details",
        ["copy"] = "tab-copy",
        ["lending"] = "tab-copy",
        ["files"] = "tab-copy",
        ["history"] = "tab-history",
        ["remove"] = "tab-history",
    };

    private IJSObjectReference? keepModule;
    private bool offlineSupported;
    private bool keptOffline;
    private bool keptAudio;
    private bool keepingAudio;
    private bool keeping;
    private string? offlineNote;
    private bool sendingToKindle;
    private string? kindleNote;
    private bool kindleSent;
    private bool kindleNeedsAddress;

    private async Task SendToKindle()
    {
        if (book is null)
        {
            return;
        }

        sendingToKindle = true;
        kindleNote = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var problem = await Kindle.SendAsync(db, Ebooks, WithDetails, Email, book.Id, CancellationToken.None);
            kindleSent = problem is null;
            kindleNeedsAddress = !kindleSent && !await db.Readers.AnyAsync(reader => reader.Id == db.ReaderId && reader.KindleEmail != null);
            kindleNote = problem ?? T("Sent. It reaches the Kindle in a few minutes, once Amazon has it.");
        }
        finally
        {
            sendingToKindle = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && grabs.Any(grab => grab.State is GrabState.Sent or GrabState.Downloading or GrabState.Importing))
        {
            FollowGrabs();
        }

        if (firstRender && WantsAvailability && availability is null && book is { } wanted)
        {
            using var limit = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            availability = await Availability.FindAsync(wanted.Title, wanted.Author, limit.Token);
            StateHasChanged();
        }

        if (!firstRender || book is null || (string.IsNullOrWhiteSpace(book.EbookStoredName) && string.IsNullOrWhiteSpace(book.AudioStoredName)))
        {
            return;
        }

        try
        {
            keepModule = await Js.InvokeAsync<IJSObjectReference>("import", "./keep.js");
            offlineSupported = await keepModule.InvokeAsync<bool>("supported");
            keptOffline = offlineSupported && await keepModule.InvokeAsync<bool>("isKept", book.Id);
            keptAudio = offlineSupported && await keepModule.InvokeAsync<bool>("isAudioKept", book.Id);
            StateHasChanged();
        }
        catch (JSException)
        {
            offlineSupported = false;
        }
    }

    // The e-book goes into this browser's storage, for the offline reader to open without a connection.
    private async Task KeepOffline()
    {
        if (keepModule is null || book is null)
        {
            return;
        }

        keeping = true;
        try
        {
            var type = EbookStore.IsPdf(book.EbookStoredName) ? "pdf" : "epub";
            keptOffline = await keepModule.InvokeAsync<bool>("keep", book.Id, book.Title, book.Author, type);
            offlineNote = keptOffline
                ? T("Kept on this device. When the shelf cannot be reached, it opens in the offline reader, and your place comes back when you are online.")
                : T("This e-book could not be kept on this device.");
        }
        catch (JSException)
        {
            offlineNote = T("This browser would not keep the e-book. It may be out of space, or in a private window.");
        }
        finally
        {
            keeping = false;
        }
    }

    // Every track goes into this browser's storage, so the book plays with no connection, here or in the offline page.
    private async Task KeepAudio()
    {
        if (keepModule is null || book is null)
        {
            return;
        }

        keepingAudio = true;
        try
        {
            keptAudio = await keepModule.InvokeAsync<bool>("keepAudio", TimeSpan.FromHours(1), [book.Id]);
            offlineNote = keptAudio
                ? T("Kept on this device. It plays from here, and with no connection it is in the offline page; your place goes back when you are online.")
                : T("This audiobook could not be kept on this device.");
        }
        catch (JSException)
        {
            offlineNote = T("This browser would not keep the audiobook. It may be out of space, or in a private window.");
        }
        finally
        {
            keepingAudio = false;
        }
    }

    private async Task ForgetAudio()
    {
        if (keepModule is null || book is null)
        {
            return;
        }

        await keepModule.InvokeVoidAsync("forgetAudio", book.Id);
        keptAudio = false;
        offlineNote = T("No longer kept on this device.");
    }

    private async Task ForgetOffline()
    {
        if (keepModule is null || book is null)
        {
            return;
        }

        await keepModule.InvokeVoidAsync("forget", book.Id);
        keptOffline = false;
        offlineNote = T("No longer kept on this device.");
    }

    public async ValueTask DisposeAsync()
    {
        if (fetchTimer is not null)
        {
            await fetchTimer.DisposeAsync();
        }

        if (keepModule is not null)
        {
            try
            {
                await keepModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private DateOnly Today => Clock.Today;

    private Book? book;
    private bool missing;
    private bool saved;
    private bool confirmingDelete;
    // Where to get a book with no e-book: the free catalogs follow Free books' setting unless set on their own.
    private bool WantsAvailability => book is not null && book.VisitingLinkId is null && string.IsNullOrWhiteSpace(book.EbookStoredName)
        && Configuration.GetValue("Availability:Enabled", Configuration.GetValue("FreeBooks:Enabled", true));

    private BookAvailability? availability;

    // Fetching: whether the shelf is set up for it, what has been found, and what is being fetched for this book.
    private bool canFetch;
    private FetchKind fetchKind;
    private bool searching;
    private bool showAllReleases;
    private string? fetchProblem;
    private IReadOnlyList<ScoredRelease>? releases;
    private List<FetchGrab> grabs = [];

    private async Task LoadFetchAsync(ShelfDb db)
    {
        var settings = await FetchRules.SettingsAsync(db);
        canFetch = Fetcher.Ready(settings) && !await Family.IsRestrictedAsync(db);
        grabs = canFetch ? await db.FetchGrabs.AsNoTracking().Where(grab => grab.BookId == Id && grab.ReaderId == db.ReaderId).OrderByDescending(grab => grab.Id).Take(5).ToListAsync() : [];
        if (book is not null && !string.IsNullOrWhiteSpace(book.EbookStoredName) && string.IsNullOrWhiteSpace(book.AudioStoredName))
        {
            fetchKind = FetchKind.Audiobook;
        }
    }

    // While something is being fetched, the panel follows it, and the page takes the file when it lands.
    private System.Threading.Timer? fetchTimer;

    private void FollowGrabs()
    {
        fetchTimer ??= new System.Threading.Timer(_ => InvokeAsync(async () =>
        {
            if (!grabs.Any(grab => grab.State is GrabState.Sent or GrabState.Downloading or GrabState.Importing))
            {
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var before = grabs.Select(grab => grab.State).ToList();
            await LoadFetchAsync(db);
            if (!before.SequenceEqual(grabs.Select(grab => grab.State)) && grabs.Any(grab => grab.State == GrabState.Done))
            {
                await LoadAsync(replaceDraft: false);
            }

            StateHasChanged();
        }), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private static string GrabLabel(FetchGrab grab) => grab.State switch
    {
        GrabState.Sent => T("Sent to the download client"),
        GrabState.Downloading => T("Downloading"),
        GrabState.Importing => T("Bringing it onto the book"),
        GrabState.Done => T("Fetched"),
        GrabState.Cancelled => T("Cancelled"),
        _ => T("Could not be fetched"),
    };

    private async Task SearchIndexers()
    {
        if (book is null)
        {
            return;
        }

        (searching, fetchProblem, releases, showAllReleases) = (true, null, null, false);
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            using var limit = new CancellationTokenSource(TimeSpan.FromSeconds(90));
            releases = await Fetcher.SearchAsync(await FetchRules.SettingsAsync(db), book.Title, book.Author, fetchKind, limit.Token);
        }
        catch (Exception ex) when (ex is FetchProblem or HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            fetchProblem = ex is FetchProblem ? ex.Message : T("The indexers did not answer.");
        }
        finally
        {
            searching = false;
        }
    }

    private async Task Grab(Release release)
    {
        if (book is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var current = await db.Books.AsNoTracking().FirstAsync(item => item.Id == Id);
        await Fetcher.GrabAsync(db, await FetchRules.SettingsAsync(db), current, fetchKind, release, CancellationToken.None);
        releases = null;
        await LoadFetchAsync(db);
        FollowGrabs();
    }

    private readonly HashSet<int> cancelling = [];

    private async Task CancelGrab(int grabId)
    {
        if (!cancelling.Add(grabId))
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await Fetcher.CancelAsync(db, grabId, CancellationToken.None);
            await LoadFetchAsync(db);
        }
        finally
        {
            cancelling.Remove(grabId);
        }
    }

    private readonly HashSet<string> fetching = [];

    private async Task Fetch(FreeBook free)
    {
        if (book is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        Free.Enqueue(db.ReaderId, free, (book.Title, book.Author));
        fetching.Add(free.Id);
    }

