    private string CoverSource => book switch
    {
        { CoverImage: not null } => T("A picture kept on the shelf: one you uploaded, or one that came with the book's files."),
        { CoverUrl: { Length: > 0 } } => T("From the cover address in the details below."),
        { FileCover: true } => T("From inside the e-book."),
        _ => T("No cover yet: upload a picture, fill the details from Open Library, or add an e-book with a cover inside."),
    };

    private async Task RemoveCover()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.Books.FirstOrDefaultAsync(item => item.Id == Id);
        if (existing is not null)
