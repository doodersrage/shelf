    private async Task Save()
    {
        saved = false;
        var write = draft.ToWrite();
        formErrors = BookRules.Validate(write);
        // The reader's own fields are checked with the rest, so nothing is kept until all of it can be.
        foreach (var item in customValues)
        {
            if (CustomFields.Normalize(item.Kind, fieldDraft.GetValueOrDefault(item.FieldId)) is (_, { } trouble))
            {
                (formErrors ??= [])[item.Name] = [$"{item.Name}: {trouble}"];
            }
        }

        if (formErrors is not null || book is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.Books.Include(item => item.Tags).FirstOrDefaultAsync(item => item.Id == Id);
        if (existing is null)
        {
            missing = true;
            book = null;
            return;
        }

        BookRules.Apply(existing, write, today: db.Today);
        await BookRules.SyncTagsAsync(db, existing, write.Tags, CancellationToken.None);
        await db.SaveChangesAsync();
        await BookRules.RemoveUnusedTagsAsync(db, CancellationToken.None);
        if (customValues.Length > 0)
        {
            formErrors = await CustomFields.SetForBookAsync(db, existing.Id, customValues.ToDictionary(item => item.FieldId, item => fieldDraft.GetValueOrDefault(item.FieldId)));
            if (formErrors is not null)
            {
                return;
            }
        }

        formErrors = null;
        saved = true;
        await LoadAsync();
    }

