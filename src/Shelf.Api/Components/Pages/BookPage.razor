    @* Other formats of the same book, as Calibre keeps them: to download or send on, and to make the main one. *@
    <h4>@T("Other formats")</h4>
    @if (formats.Length > 0)
    {
        <ul class="plain-list formats">
            @foreach (var format in formats)
            {
                <li>
                    <strong>@format.Format</strong> <span class="hint">@format.FileName · @Localization.Counts.Size(format.Size)</span>
                    <a href="/books/@book.Id/ebook/formats/@format.Id" download>@T("Download")</a>
                    @if (formatAsked == (format.Id, "main"))
                    {
                        <span role="alert">@T("Read the {0} from now on? The place in the e-book starts again at the beginning, for you and anyone reading it with you; the e-book now kept stays as another format.", format.Format)</span>
                        <button type="button" @onclick="() => MakeMain(format.Id)">@T("Make it the main e-book")</button>
                        <button type="button" class="quiet" @onclick="() => formatAsked = null">@T("Cancel")</button>
                    }
                    else if (formatAsked == (format.Id, "remove"))
                    {
                        <span role="alert">@T("Remove the {0}? Its file is deleted, and can't be brought back.", format.Format)</span>
                        <button type="button" class="danger" @onclick="() => RemoveFormat(format.Id)">@T("Remove it")</button>
                        <button type="button" class="quiet" @onclick="() => formatAsked = null">@T("Keep it")</button>
                    }
                    else
                    {
                        @if (format.CanBeMain)
                        {
                            <button type="button" class="quiet" @onclick="() => AskMain(format.Id)">@T("Make it the main e-book")</button>
                        }
                        <button type="button" class="quiet danger" @onclick="() => AskRemove(format.Id)" aria-label="@T("Remove the {0}", format.Format)">@T("Remove")</button>
