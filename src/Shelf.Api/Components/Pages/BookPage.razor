@page "/library/{Id:int}"
@rendermode InteractiveServer
@inject IDbContextFactory<ShelfDb> DbFactory
@inject NavigationManager Navigation
@inject EbookStore Ebooks
@inject AudioStore Audio
@inject OcrService Ocr
@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider Protection
@using Microsoft.JSInterop
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>@(book?.Title ?? "Shelf")</PageTitle>

@if (missing)
{
    <h1>Not on the shelf</h1>
    <p>That book is not here. <a href="/">Back to the library</a></p>
}
else if (book is not null)
{
    <p class="hint"><a href="/">Library</a></p>
    <header class="book-hero">
        <BookCover Title="@book.Title" Url="@book.CoverShown" Decorative="false" />
        <div>
            <h1>@book.Title</h1>
            @if (!string.IsNullOrWhiteSpace(book.Subtitle))
            {
                <p class="hint">@book.Subtitle</p>
            }
            <p class="by">
                <a href="@($"/?author={Uri.EscapeDataString(book.Author)}")">@book.Author</a>
                @if (!string.IsNullOrWhiteSpace(book.Translator))
                {
                    <span class="hint"> · translated by @book.Translator</span>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(book.OriginalTitle))
            {
                <p class="hint">Originally @book.OriginalTitle</p>
            }
            @if (!string.IsNullOrWhiteSpace(book.Series))
            {
                <p class="hint">
                    <a href="@($"/?series={Uri.EscapeDataString(book.Series)}")">@book.Series</a>
                    @if (book.SeriesNumber is int number)
                    {
                        <span> · book @number</span>
                    }
                </p>
            }
            @if (nextVolume is not null)
            {
                <p class="hint">Next: <a href="/library/@nextVolume.Id">@nextVolume.Title</a></p>
            }
            <div class="badges">
                <StatusBadge Status="book.Status" />
                @if (!string.IsNullOrWhiteSpace(book.LoanedTo))
                {
                    <span class="badge loan">On loan</span>
                }
                @if (book.Loved)
                {
                    <span class="badge plain">Loved</span>
                }
                @if (book.Rating is int rating)
                {
                    <span class="badge plain">@rating of 5</span>
                }
            </div>
            @if (book.Queued)
            {
                <p class="hint">On the read-next list.</p>
            }
            @if (BookRules.PagesRemaining(book) is int left)
            {
                <p class="hint">
                    @if (left == 0)
                    {
                        <span>At the last page.</span>
                    }
                    else
                    {
                        <span>@left @(left == 1 ? "page" : "pages") left</span>
                        @if (BookRules.DaysRemaining(book) is int days)
                        {
                            <span> · about @days @(days == 1 ? "day" : "days")</span>
                        }
                    }
                </p>
            }
            <div class="status-actions">
                @switch (book.Status)
                {
                    case BookStatus.Want:
                        <button type="button" class="primary" @onclick="() => MoveTo(BookStatus.Reading)">Start reading</button>
                        break;
                    case BookStatus.Reading:
                        <button type="button" class="primary" @onclick="() => MoveTo(BookStatus.Finished)">Mark finished</button>
                        <button type="button" class="quiet" @onclick="() => MoveTo(BookStatus.Abandoned)">Stop reading</button>
                        break;
                    case BookStatus.Finished:
                        @if (book.FinishedOn is DateOnly finishedOn)
                        {
                            <span class="hint">Finished @finishedOn.Long()</span>
                        }
                        break;
                    case BookStatus.Abandoned:
                        <button type="button" class="quiet" @onclick="() => MoveTo(BookStatus.Reading)">Pick it up again</button>
                        break;
                }
                @if (!string.IsNullOrWhiteSpace(book.EbookStoredName))
                {
                    <a class="button" href="/library/@book.Id/read">Read this e-book</a>
                    @if (offlineSupported)
                    {
                        @if (keptOffline)
                        {
                            <button type="button" class="quiet" @onclick="ForgetOffline" aria-pressed="true">Kept offline · forget</button>
                        }
                        else
                        {
                            <button type="button" class="quiet" @onclick="KeepOffline" disabled="@keeping">@(keeping ? "Keeping…" : "Keep for reading offline")</button>
                        }
                    }
                }
                @if (!string.IsNullOrWhiteSpace(book.AudioStoredName))
                {
                    <a class="button" href="/library/@book.Id/listen">Listen to this audiobook</a>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(book.AudioStoredName) && ((book.AudioTrack ?? 0) > 0 || (book.AudioSeconds ?? 0) > 0))
            {
                <p class="hint">Paused at @PausedAt(book)</p>
            }
        </div>
    </header>

    @if (ImportedMessage == "1")
    {
        <p class="saved" role="status">Made from the file. Check the details below; anything the file did not say is blank.</p>
    }
    @if (EbookMessage == "saved")
    {
        <p class="saved" role="status">The e-book is on the shelf.</p>
    }
    else if (EbookMessage == "unsupported")
    {
        <p class="validation-message" role="alert">Choose an EPUB or a PDF.</p>
    }
    else if (EbookMessage == "large")
    {
        <p class="validation-message" role="alert">That file is larger than 80 MB.</p>
    }
    @if (AudioMessage == "saved")
    {
        <p class="saved" role="status">The audiobook is on the shelf.</p>
    }
    else if (AudioMessage == "unsupported")
    {
        <p class="validation-message" role="alert">Choose an audio file, or a zip of them.</p>
    }
    else if (AudioMessage == "large")
    {
        <p class="validation-message" role="alert">That audiobook is larger than 1 GB.</p>
    }

    @if (held is not null)
    {
        <div class="notice ask" role="alert">
            <p>
                That @(held.Kind == UploadKind.Ebook ? "e-book" : "audiobook") is already on
                <a href="/library/@held.SameAsId">@heldSameTitle</a>, byte for byte.
                Keep a second copy here as well?
            </p>
            <div class="status-actions">
                <button type="button" @onclick="KeepHeld" disabled="@deciding">Keep both</button>
                <button type="button" class="quiet" @onclick="LetHeldGo" disabled="@deciding">Don't add it</button>
            </div>
        </div>
    }
    else if (heldExpired)
    {
        <p class="validation-message" role="alert">That upload was not kept. Choose the file again to add it.</p>
    }

    @if (!string.IsNullOrWhiteSpace(book.Inscription))
    {
        <p class="inscription">@book.Inscription</p>
    }

    <nav class="section-nav" aria-label="On this page">
        <a href="/library/@book.Id#reading">Reading</a>
        <a href="/library/@book.Id#lending">Lending</a>
        <a href="/library/@book.Id#quotes">Quotes</a>
        <a href="/library/@book.Id#highlights">Highlights</a>
        <a href="/library/@book.Id#files">Files</a>
        <a href="/library/@book.Id#details">Details</a>
    </nav>

    <section class="panel" id="reading">
    <h2>Reading log</h2>
    @if (book.Sessions.Count == 0)
    {
        <p class="hint">No sessions yet.</p>
    }
    else
    {
        <ul class="tag-counts">
            @foreach (var session in book.Sessions.OrderByDescending(item => item.Date).ThenByDescending(item => item.Id))
            {
                <li>
                    <span>
                        @session.Date.Medium()
                        @if (session.FromPage is int from && session.ToPage is int to)
                        {
                            <span> · @from–@to</span>
                        }
                        else if (session.ToPage is int end)
                        {
                            <span> · to @end</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(session.Note))
                        {
                            <span> · @session.Note</span>
                        }
                    </span>
                    <button type="button" @onclick="() => RemoveSession(session.Id)">Remove</button>
                </li>
            }
        </ul>
        @if (BookRules.PagesPerDay(book.Sessions) is int pace)
        {
            <p class="hint">About @pace @(pace == 1 ? "page" : "pages") a day.</p>
        }
    }

    <EditForm Model="sessionDraft" OnValidSubmit="AddSession">
        <DataAnnotationsValidator />
        @if (sessionErrors is { Count: > 0 })
        {
            <ul class="validation-errors">
                @foreach (var message in sessionErrors.SelectMany(pair => pair.Value))
                {
                    <li>@message</li>
                }
            </ul>
        }
        <div class="pair">
            <label>
                Date
                <InputDate @bind-Value="sessionDraft.Date" />
            </label>
            <label>
                Note
                <InputText @bind-Value="sessionDraft.Note" maxlength="500" />
            </label>
        </div>
        <div class="pair">
            <label>
                From page
                <InputNumber @bind-Value="sessionDraft.FromPage" />
            </label>
            <label>
                To page
                <InputNumber @bind-Value="sessionDraft.ToPage" />
            </label>
        </div>
        <button type="submit">Add session</button>
    </EditForm>
    </section>

    <section class="panel" id="lending">
        <h2>Lending</h2>
        @if (!string.IsNullOrWhiteSpace(book.LoanedTo))
        {
            <p>
                Loaned to <a href="@($"/?loanedTo={Uri.EscapeDataString(book.LoanedTo)}")">@book.LoanedTo</a>@(book.BorrowerId is null ? "" : ", a reader here")
                @if (book.LoanedOn is DateOnly loanedOn)
                {
                    <span> since @loanedOn.Medium()</span>
                }
                @if (book.DueOn is DateOnly due)
                {
                    <span class="@(due < Today ? "late" : null)"> · due @due.Medium()@(due < Today ? ", overdue" : "")</span>
                }
            </p>
            <button type="button" @onclick="ReturnLoan">Mark returned</button>
        }
        else if (readers.Count == 0)
        {
            <p class="hint">Not on loan. To lend it to someone, fill in Loaned to under Details.</p>
        }
    else
    {
        <p class="hint">Lend this book to another reader here. It shows on their loans until it comes back.</p>
        <div class="pair">
            <label>
                Reader
                <select @bind="lendTo">
                    <option value="0">Choose a reader</option>
                    @foreach (var reader in readers)
                    {
                        <option value="@reader.Id">@reader.Name</option>
                    }
                </select>
            </label>
            <label>
                Due back
                <input type="date" @bind="lendDue" />
            </label>
        </div>
        <button type="button" @onclick="LendBook" disabled="@(lendTo == 0)">Lend</button>
        @if (lendProblem is not null)
        {
            <p class="validation-message" role="alert">@lendProblem</p>
        }
    }
        @if (!string.IsNullOrWhiteSpace(book.Location) || book.AcquiredOn is not null || book.Acquisition is not null || book.Condition is not null || !string.IsNullOrWhiteSpace(book.RecommendedBy))
        {
            <h3>This copy</h3>
            <p class="hint">
                @if (book.Acquisition is Acquisition arrived)
                {
                    <span>@(arrived == Acquisition.Gift ? "A gift" : arrived.ToString())</span>
                }
                @if (!string.IsNullOrWhiteSpace(book.Location))
                {
                    <span>@(book.Acquisition is null ? "" : " · ")</span>
                    <a href="@($"/?place={Uri.EscapeDataString(book.Location)}")">@book.Location</a>
                }
                @if (book.AcquiredOn is DateOnly acquired)
                {
                    <span>@(book.Acquisition is null && string.IsNullOrWhiteSpace(book.Location) ? "" : " · ")Acquired @acquired.Medium()</span>
                }
                @if (book.Condition is CopyCondition condition)
                {
                    <span>@(book.Acquisition is null && string.IsNullOrWhiteSpace(book.Location) && book.AcquiredOn is null ? "" : " · ")@BookRules.ConditionLabel(condition)</span>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(book.RecommendedBy))
            {
                <p class="hint"><a href="@($"/?recommendedBy={Uri.EscapeDataString(book.RecommendedBy)}")">Recommended by @book.RecommendedBy</a></p>
            }
        }
    </section>

    <section class="panel" id="quotes">
    <h2>Quotes</h2>
    @if (book.Quotes.Count == 0)
    {
        <p class="hint">No quotes yet.</p>
    }
    else
    {
        <ul class="quotes">
            @foreach (var quote in book.Quotes.OrderBy(item => item.NotedAt).ThenBy(item => item.Id))
            {
                <li>
                    <blockquote>
                        <p>@quote.Text</p>
                        @if (quote.Page is int page)
                        {
                            <span class="hint">p. @(page)</span>
                        }
                    </blockquote>
                    <button type="button" @onclick="() => RemoveQuote(quote.Id)">Remove</button>
                </li>
            }
        </ul>
    }

    <EditForm Model="quoteDraft" OnValidSubmit="AddQuote">
        <DataAnnotationsValidator />
        @if (quoteErrors is { Count: > 0 })
        {
            <ul class="validation-errors">
                @foreach (var message in quoteErrors.SelectMany(pair => pair.Value))
                {
                    <li>@message</li>
                }
            </ul>
        }
        <label>
            Quote
            <InputTextArea @bind-Value="quoteDraft.Text" maxlength="1000" rows="3" />
            <ValidationMessage For="() => quoteDraft.Text" />
        </label>
        <label>
            Page
            <InputNumber @bind-Value="quoteDraft.Page" />
            <ValidationMessage For="() => quoteDraft.Page" />
        </label>
        <button type="submit">Add quote</button>
    </EditForm>
    </section>

    <section class="panel" id="highlights">
    <h2>Highlights</h2>
    @if (book.Highlights.Count == 0)
    {
        <p class="hint">No highlights yet.</p>
    }
    else
    {
        <ul class="quotes">
            @foreach (var mark in book.Highlights.OrderBy(item => item.ChapterIndex).ThenBy(item => item.Id))
            {
                <li>
                    <blockquote>
                        <p>@mark.Text</p>
                        <span class="hint">@(EbookStore.IsPdf(book.EbookStoredName) ? "Page" : "Chapter") @(mark.ChapterIndex + 1)</span>
                    </blockquote>
                    @if (!string.IsNullOrWhiteSpace(mark.Note))
                    {
                        <p>@mark.Note</p>
                    }
                    <a href="@($"/library/{book.Id}/read?chapter={mark.ChapterIndex}")">Open</a>
                    <button type="button" @onclick="() => RemoveHighlight(mark.Id)">Remove</button>
                </li>
            }
        </ul>
    }
    </section>

    <section class="panel" id="files">
        <h2>Files</h2>
    @if (borrowable.Count > 0)
    {
        <p class="hint">Before uploading: another reader has this book with a file you could borrow.</p>
        <OpenCopies Copies="borrowable" />
    }
    <h3>E-book</h3>
    @if (offlineNote is not null)
    {
        <p class="hint" role="status">@offlineNote</p>
    }
    @if (!string.IsNullOrWhiteSpace(book.EbookFileName))
    {
        <p>@book.EbookFileName</p>
        <button type="button" @onclick="RemoveEbook">Remove the file</button>
    }
    <form action="/books/@book.Id/ebook" method="post" enctype="multipart/form-data" data-enhance="false" data-upload>
        <label>
            EPUB or PDF, up to 80 MB
            <input type="file" name="file" accept=".epub,.pdf,application/epub+zip,application/pdf" required />
        </label>
        <progress data-upload-progress max="100" hidden></progress>
        <p class="hint" data-upload-status role="status" hidden></p>
        <button type="submit">Upload</button>
    </form>

    <h3>Audiobook</h3>
    @if (!string.IsNullOrWhiteSpace(book.AudioFileName))
    {
        <p>@book.AudioFileName</p>
        <button type="button" @onclick="RemoveAudio">Remove the recording</button>
    }
    <form action="/books/@book.Id/audio" method="post" enctype="multipart/form-data" data-enhance="false" data-upload>
        <label>
            Audio or a zip of tracks, up to 1 GB
            <input type="file" name="file" accept=".mp3,.m4a,.m4b,.aac,.ogg,.opus,.wav,.flac,.zip,audio/*" multiple required />
        </label>
        <progress data-upload-progress max="100" hidden></progress>
        <p class="hint" data-upload-status role="status" hidden></p>
        <button type="submit">Upload</button>
    </form>
    </section>

    <section class="panel" id="details">
        <h2>Details</h2>
        <details class="edit" open="@(formErrors is { Count: > 0 } || saved)">
            <summary>Edit the catalog, notes, and loan</summary>
    <EditForm Model="draft" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />
        @if (formErrors is { Count: > 0 })
        {
            <ul class="validation-errors">
                @foreach (var message in formErrors.SelectMany(pair => pair.Value))
                {
                    <li>@message</li>
                }
            </ul>
        }
        <BookFields Model="draft" Detailed="true" />
        <button type="submit">Save changes</button>
        @if (saved)
        {
            <span class="saved" role="status">Saved.</span>
        }
    </EditForm>
        </details>
    @if (others.Count > 0)
    {
        <h3>Also by @book.Author</h3>
        <ul class="tag-counts">
            @foreach (var other in others)
            {
                <li><a href="/library/@other.Id">@other.Title</a></li>
            }
        </ul>
    }
    </section>

    <section class="panel" id="remove">
        <h2>Remove</h2>
    @if (!confirmingDelete)
    {
        <button type="button" class="danger" @onclick="() => confirmingDelete = true">Delete this book</button>
    }
    else
    {
        <p>This deletes the book, its quotes, its highlights, its reading log, its e-book, and its audiobook.</p>
        <button type="button" class="danger" @onclick="Delete">Yes, delete it</button>
        <button type="button" @onclick="() => confirmingDelete = false">Cancel</button>
    }
    </section>
}

@code {
    private IJSObjectReference? keepModule;
    private bool offlineSupported;
    private bool keptOffline;
    private bool keeping;
    private string? offlineNote;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || book is null || string.IsNullOrWhiteSpace(book.EbookStoredName))
        {
            return;
        }

        try
        {
            keepModule = await Js.InvokeAsync<IJSObjectReference>("import", "./keep.js");
            offlineSupported = await keepModule.InvokeAsync<bool>("supported");
            keptOffline = offlineSupported && await keepModule.InvokeAsync<bool>("isKept", book.Id);
            StateHasChanged();
        }
        catch (JSException)
        {
            offlineSupported = false;
        }
    }

    // The e-book goes into this browser's storage, for the offline reader to open without a connection.
    private async Task KeepOffline()
    {
        if (keepModule is null || book is null)
        {
            return;
        }

        keeping = true;
        try
        {
            var type = EbookStore.IsPdf(book.EbookStoredName) ? "pdf" : "epub";
            keptOffline = await keepModule.InvokeAsync<bool>("keep", book.Id, book.Title, book.Author, type);
            offlineNote = keptOffline
                ? "Kept on this device. When the shelf cannot be reached, it opens in the offline reader, and your place comes back when you are online."
                : "This e-book could not be kept on this device.";
        }
        catch (JSException)
        {
            offlineNote = "This browser would not keep the e-book. It may be out of space, or in a private window.";
        }
        finally
        {
            keeping = false;
        }
    }

    private async Task ForgetOffline()
    {
        if (keepModule is null || book is null)
        {
            return;
        }

        await keepModule.InvokeVoidAsync("forget", book.Id);
        keptOffline = false;
        offlineNote = "No longer kept on this device.";
    }

    public async ValueTask DisposeAsync()
    {
        if (keepModule is not null)
        {
            try
            {
                await keepModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow);

    private Book? book;
    private bool missing;
    private bool saved;
    private bool confirmingDelete;
    private BookFormModel draft = new();
    private readonly QuoteFormModel quoteDraft = new();
    private readonly SessionFormModel sessionDraft = new();
    private List<OtherBook> others = [];
    private List<OpenCopy> borrowable = [];
    private NextVolume? nextVolume;
    private List<ReaderResponse> readers = [];
    private int lendTo;
    private DateOnly? lendDue;
    private string? lendProblem;
    private Dictionary<string, string[]>? formErrors;
    private Dictionary<string, string[]>? quoteErrors;
    private Dictionary<string, string[]>? sessionErrors;

    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "ebook")]
    public string? EbookMessage { get; set; }

    [SupplyParameterFromQuery(Name = "audio")]
    public string? AudioMessage { get; set; }

    [SupplyParameterFromQuery(Name = "imported")]
    public string? ImportedMessage { get; set; }

    [SupplyParameterFromQuery(Name = "held")]
    public string? HeldToken { get; set; }

    private HeldUpload? held;
    private string? heldSameTitle;
    private bool heldExpired;
    private bool deciding;

    private async Task ReadHeldAsync()
    {
        held = null;
        heldExpired = false;
        if (string.IsNullOrEmpty(HeldToken) || book is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        held = Duplicates.Read(Protection, HeldToken, db.ReaderId, book.Id);
        heldSameTitle = held is null ? null : await db.Books.AsNoTracking()
            .Where(item => item.Id == held.SameAsId)
            .Select(item => item.Title)
            .FirstOrDefaultAsync();
        if (held is null || heldSameTitle is null || !IsStillHeld(held))
        {
            held = null;
            heldExpired = true;
        }
    }

    private bool IsStillHeld(HeldUpload upload) => upload.Kind == UploadKind.Ebook
        ? File.Exists(Path.Combine(Ebooks.HeldRoot, upload.StoredName))
        : Directory.Exists(Path.Combine(Audio.HeldRoot, upload.StoredName));

    private async Task KeepHeld()
    {
        if (held is not { } upload || deciding)
        {
            return;
        }

        deciding = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.Books.FirstOrDefaultAsync(item => item.Id == upload.BookId);
        var kept = existing is not null && (upload.Kind == UploadKind.Ebook ? Ebooks.Release(upload.StoredName) : Audio.Release(upload.StoredName));
        if (existing is not null && kept)
        {
            if (upload.Kind == UploadKind.Ebook)
            {
                await EbookEndpoints.AttachAsync(db, Ebooks, existing, upload.StoredName, upload.FileName, default);
                Ocr.Nudge();
            }
            else
            {
                await AudioEndpoints.AttachAsync(db, Audio, existing, upload.StoredName, upload.FileName, default);
            }
        }

        deciding = false;
        var kind = upload.Kind == UploadKind.Ebook ? "ebook" : "audio";
        Navigation.NavigateTo(kept ? $"/library/{upload.BookId}?{kind}=saved" : $"/library/{upload.BookId}", forceLoad: kept);
    }

    private void LetHeldGo()
    {
        if (held is not { } upload)
        {
            return;
        }

        if (upload.Kind == UploadKind.Ebook)
        {
            Ebooks.Forget(upload.StoredName);
        }
        else
        {
            Audio.Forget(upload.StoredName);
        }

        held = null;
        Navigation.NavigateTo($"/library/{upload.BookId}");
    }

    protected override async Task OnParametersSetAsync()
    {
        saved = false;
        confirmingDelete = false;
        await LoadAsync();
        await ReadHeldAsync();
    }

    private async Task LoadAsync(bool replaceDraft = true)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        book = await db.Books.AsNoTracking().WithDetails().FirstOrDefaultAsync(existing => existing.Id == Id);
        missing = book is null;
        others = book is null
            ? []
            : await db.Books.AsNoTracking()
                .Where(item => item.Author == book.Author && item.Id != book.Id)
                .OrderBy(item => item.Title)
                .Select(item => new OtherBook(item.Id, item.Title))
                .ToListAsync();
        nextVolume = null;
        if (book is not null)
        {
            var siblings = await db.Books.AsNoTracking()
                .Where(item => item.Series != null && item.Id != book.Id)
                .Select(item => new Book
                {
                    Id = item.Id,
                    Title = item.Title,
                    Author = item.Author,
                    Series = item.Series,
                    SeriesNumber = item.SeriesNumber,
                })
                .ToListAsync();
            if (BookRules.NextInSeries(book, siblings) is { } next)
            {
                nextVolume = new NextVolume(next.Id, next.Title);
            }
        }
        readers = book is null ? [] : (await ReaderRules.OthersAsync(db, db.ReaderId)).ToList();
        borrowable = book is null ? [] : Asking.Matching(await Asking.OpenCopiesAsync(db, book.Title, book.Isbn), book.Isbn, book.Title, book.Author)
            .Where(copy => (copy.HasEbook && book.EbookStoredName is null) || (copy.HasAudio && book.AudioStoredName is null))
            .ToList();
        if (book is not null && replaceDraft)
        {
            draft = BookFormModel.From(book);
        }
    }

    private async Task LendBook()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var result = await Lending.LendAsync(db, Id, lendTo, lendDue);
        if (result == LendResult.NoBook)
        {
            missing = true;
            book = null;
            return;
        }

        if (result != LendResult.Lent)
        {
            lendProblem = Lending.Describe(result);
            return;
        }

        lendTo = 0;
        lendDue = null;
        lendProblem = null;
        saved = false;
        await LoadAsync();
    }

    private async Task Save()
    {
        saved = false;
        var write = draft.ToWrite();
        formErrors = BookRules.Validate(write);
        if (formErrors is not null || book is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.Books.Include(item => item.Tags).FirstOrDefaultAsync(item => item.Id == Id);
        if (existing is null)
        {
            missing = true;
            book = null;
            return;
        }

        BookRules.Apply(existing, write);
        await BookRules.SyncTagsAsync(db, existing, write.Tags, CancellationToken.None);
        await db.SaveChangesAsync();
        await BookRules.RemoveUnusedTagsAsync(db, CancellationToken.None);
        formErrors = null;
        saved = true;
        await LoadAsync();
    }

    private async Task AddQuote()
    {
        quoteErrors = BookRules.ValidateQuote(quoteDraft.Text, quoteDraft.Page, draft.Pages);
        if (quoteErrors is not null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.Books.AnyAsync(item => item.Id == Id);
        if (!existing)
        {
            missing = true;
            book = null;
            return;
        }

        db.Quotes.Add(new Quote
        {
            BookId = Id,
            Text = quoteDraft.Text.Trim(),
            Page = quoteDraft.Page,
            NotedAt = DateTimeOffset.UtcNow,
        });
        await db.SaveChangesAsync();
        quoteDraft.Clear();
        quoteErrors = null;
        saved = false;
        await LoadAsync(replaceDraft: false);
    }

    private async Task RemoveQuote(int quoteId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var quote = await db.Quotes.FirstOrDefaultAsync(item => item.Id == quoteId && item.BookId == Id);
        if (quote is null)
        {
            return;
        }

        db.Quotes.Remove(quote);
        await db.SaveChangesAsync();
        saved = false;
        await LoadAsync(replaceDraft: false);
    }

    private async Task Delete()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.Books.FirstOrDefaultAsync(item => item.Id == Id);
        if (existing is not null)
        {
            Ebooks.Delete(existing.EbookStoredName);
            Audio.Delete(existing.AudioStoredName);
            db.Books.Remove(existing);
            await db.SaveChangesAsync();
            await BookRules.RemoveUnusedTagsAsync(db, CancellationToken.None);
        }

        Navigation.NavigateTo("/");
    }

    private async Task RemoveEbook()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.Books.FirstOrDefaultAsync(item => item.Id == Id);
        if (existing is null)
        {
            missing = true;
            book = null;
            return;
        }

        Ebooks.Delete(existing.EbookStoredName);
        existing.EbookStoredName = null;
        existing.FileCover = false;
        existing.KoreaderDigest = null;
        existing.EbookFileName = null;
        existing.EbookChapter = null;
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task RemoveAudio()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.Books.FirstOrDefaultAsync(item => item.Id == Id);
        if (existing is null)
        {
            missing = true;
            book = null;
            return;
        }

        Audio.Delete(existing.AudioStoredName);
        existing.AudioStoredName = null;
        existing.AudioFileName = null;
        existing.AudioTrack = null;
        existing.AudioSeconds = null;
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private static string PausedAt(Book book)
    {
        var seconds = Math.Max(0, book.AudioSeconds ?? 0);
        var clock = $"{seconds / 60}:{seconds % 60:00}";
        return (book.AudioTrack ?? 0) > 0 ? $"track {book.AudioTrack + 1}, {clock}" : clock;
    }

