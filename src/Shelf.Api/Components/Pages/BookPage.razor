    private async Task AddSession()
    {
        var request = new CreateSessionRequest(sessionDraft.Date, sessionDraft.FromPage, sessionDraft.ToPage, sessionDraft.Note);
        sessionErrors = BookRules.ValidateSession(request, draft.Pages);
        if (sessionErrors is not null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.Books.FirstOrDefaultAsync(item => item.Id == Id);
        if (existing is null)
        {
            missing = true;
            book = null;
            return;
        }

        db.Sessions.Add(new ReadingSession
        {
            BookId = Id,
            Date = request.Date ?? DateOnly.FromDateTime(DateTime.UtcNow),
            FromPage = request.FromPage,
            ToPage = request.ToPage,
            Note = string.IsNullOrWhiteSpace(request.Note) ? null : request.Note.Trim(),
        });
        BookRules.AdvanceProgress(existing, request.ToPage);
        await db.SaveChangesAsync();
        sessionDraft.Clear();
        sessionErrors = null;
        saved = false;
        await LoadAsync();
    }

