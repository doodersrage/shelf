    private async Task LoadAsync(bool replaceDraft = true)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        book = await db.Books.AsNoTracking().WithDetails().FirstOrDefaultAsync(existing => existing.Id == Id);
        missing = book is null;
        await LoadFetchAsync(db);
        bookCollections = book is null ? [] : await Collections.ForBookAsync(db, book.Id);
        pastReads = book is null ? [] : await Rereads.ForBookAsync(db, book.Id);
        throughs = book is null || pastReads.Length == 0 ? [] : await Rereads.ThroughsAsync(db, book.Id) ?? [];
        links = book is null ? [] : await BookLinks.ForBookAsync(db, book.Id);
        photos = book is null ? [] : await CopyPhotos.ListAsync(db, book.Id);
        positions = book is null ? null : await Positions.ForBookAsync(db, book.Id, Audio);
        others = book is null
            ? []
            : await db.Books.AsNoTracking()
                .Where(item => item.Author == book.Author && item.Id != book.Id)
                .OrderBy(item => item.Title)
                .Select(item => new OtherBook(item.Id, item.Title))
                .ToListAsync();
        nextVolume = null;
        if (book is not null)
        {
            var siblings = await db.Books.AsNoTracking()
                .Where(item => item.Series != null && item.Id != book.Id)
                .Select(item => new Book
                {
                    Id = item.Id,
                    Title = item.Title,
                    Author = item.Author,
                    Series = item.Series,
                    SeriesNumber = item.SeriesNumber,
                })
                .ToListAsync();
            if (BookRules.NextInSeries(book, siblings) is { } next)
            {
                nextVolume = new NextVolume(next.Id, next.Title);
            }
        }
        if (book is not null)
        {
            var readerId = db.ReaderId;
            lastRead = await db.ReadingDays.AsNoTracking().Where(day => day.BookId == book.Id && day.ReaderId == readerId).MaxAsync(day => (DateOnly?)day.Day);
            lastHeard = await db.ListeningDays.AsNoTracking().Where(day => day.BookId == book.Id && day.ReaderId == readerId).MaxAsync(day => (DateOnly?)day.Day);
            alongReady = await db.ReadAlongs.AsNoTracking().AnyAsync(row => row.BookId == book.Id && row.State == ReadAlongState.Ready);
        }
        readers = book is null ? [] : (await ReaderRules.OthersAsync(db, db.ReaderId)).ToList();
        if (book is not null)
        {
            loans = await LoanHistory.ForBookAsync(db, Id);
            changes = await History.ForBookAsync(db, Id);
            waitingCount = await db.LoanAsks.CountAsync(ask => ask.BookId == Id);
        }
        borrowable = book is null ? [] : Asking.Matching(await Asking.OpenCopiesAsync(db, book.Title, book.Isbn), book.Isbn, book.Title, book.Author)
            .Where(copy => (copy.HasEbook && book.EbookStoredName is null) || (copy.HasAudio && book.AudioStoredName is null))
            .ToList();
        customValues = book is null ? [] : await CustomFields.ForBookAsync(db, book.Id) ?? [];
        formats = book is null ? [] : await EbookFormats.ListAsync(db, Ebooks, book.Id) ?? [];
        canConvert = book?.EbookStoredName is not null && await Ebooks.CanConvertAsync();
        if (book is not null && replaceDraft)
        {
            draft = BookFormModel.From(book);
            fieldDraft = customValues.ToDictionary(item => item.FieldId, item => item.Value);
        }
    }

