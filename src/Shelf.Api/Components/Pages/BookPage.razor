    // When a read ran: from its start to its finish, or on from its start.
    private static string ReadSpan(ReadThrough read) => (read.StartedOn, read.FinishedOn) switch
    {
        (DateOnly from, DateOnly to) => T("{0} to {1}", from.Medium(), to.Medium()),
        (null, DateOnly to) => T("finished {0}", to.Medium()),
        (DateOnly from, null) => T("since {0}", from.Medium()),
        _ => T("undated"),
    };

    private static string ReadCounts(ReadThrough read) =>
        string.Join(" · ", new[]
        {
            read.Sessions == 0 ? null : read.Sessions == 1 ? T("1 session") : T("{0} sessions", read.Sessions),
            read.Highlights == 0 ? null : read.Highlights == 1 ? T("1 highlight") : T("{0} highlights", read.Highlights),
            read.Quotes == 0 ? null : read.Quotes == 1 ? T("1 quote") : T("{0} quotes", read.Quotes),
        }.OfType<string>()) is { Length: > 0 } counts ? counts : T("Nothing logged or marked in these days.");

    // An edition told apart from this one by what differs: its translator, reader, format, or language.
    private string EditionLabel(BookLinked edition)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(edition.Translator) && edition.Translator != book?.Translator)
        {
            parts.Add(T("translated by {0}", edition.Translator));
        }

        if (!string.IsNullOrWhiteSpace(edition.Narrator) && edition.Narrator != book?.Narrator)
        {
            parts.Add(T("read by {0}", edition.Narrator));
        }

        if (edition.Format is BookFormat format && format != book?.Format)
        {
            parts.Add(format.ToString());
        }

        if (!string.IsNullOrWhiteSpace(edition.Language) && edition.Language != book?.Language)
        {
            parts.Add(edition.Language);
        }

        if (edition.Status == BookStatus.Finished)
        {
            parts.Add(T("the one you read"));
        }

        return parts.Count == 0 ? edition.Title : $"{edition.Title} ({string.Join(", ", parts)})";
    }

