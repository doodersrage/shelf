            Add(T("Place"), book.HomeLocation is { } home ? T("{0}, for now; usually {1}", book.Location ?? T("no place"), home) : book.Location);
            Add(T("Let go"), book.LeftOn is DateOnly left ? Lifecycle.Describe(book) : null);
