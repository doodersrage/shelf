@inherits LayoutComponentBase
@inject IHostEnvironment Environment
@inject IConfiguration Configuration
@inject IDbContextFactory<ShelfDb> DbFactory
@inject NavigationManager Navigation
@inject IServiceProvider Services

@if (!signedIn)
{
    <div class="app signed-out">
        <div class="content">
            <header>
                <a class="wordmark" href="/">@Mark shelf</a>
            </header>
            <main id="main">
                @Body
            </main>
        </div>
    </div>
}
else if (Focused)
{
    @* Reading and listening get the whole window: no sidebar, no reminders, just a way back. *@
    <div class="app focus">
        <header class="focus-bar">
            <a class="wordmark" href="/">@Mark shelf</a>
            <a href="/library">@T("Library")</a>
        </header>
        <main id="main" class="focus-main">
            @Body
        </main>
    </div>
}
else
{
    <a class="skip-link" href="#main">@T("Skip to the page")</a>
    <div class="app signed-in">
        <aside class="sidebar" aria-label="Shelf">
            @Sidebar
        </aside>

        <div class="content">
            <header class="topbar">
                <a class="wordmark" href="/">@Mark shelf</a>
                <details class="drawer">
                    <summary class="button" aria-label="@T("Menu")">@T("Menu")</summary>
                    <aside class="sidebar" aria-label="@T("Shelf menu")">
                        @Sidebar
                    </aside>
                </details>
            </header>

            @if (reminders is { Any: true } due)
            {
                <p class="notice" role="status">
                    <a href="/loans">@string.Join(" · ", ReminderLines(due))</a>
                </p>
            }

            @if (import is { } running && new Uri(Navigation.Uri).AbsolutePath != running.Page)
            {
                @* An import in the background, on every page while it runs; imports.js keeps it moving. *@
                <p class="notice import-notice" role="status" data-import-progress data-done="@T("{0}. See how it went.", importDone)">
                    <a href="@running.Page">
                        <span>@running.Title:</span>
                        <span data-import-text>@ImportJobs.Describe(running)</span>
                    </a>
                    <progress data-import-bar max="@Math.Max(1, running.Total)" value="@(running.Total - running.Left)" aria-hidden="true"></progress>
                </p>
            }

            <main id="main">
                @Body
            </main>
        </div>

        <nav class="bottom-nav" aria-label="@T("Most used")">
            <a href="/" aria-current="@Current("/")">@Icon(HomeIcon) @T("Home")</a>
            <a href="/library" aria-current="@Current("/library")">@Icon(LibraryIcon) @T("Library")</a>
            <a href="/library?add=1" class="add" aria-current="@Current("/library?add=1")">@Icon("M12 5v14M5 12h14") @T("Add")</a>
            <a href="/reading" aria-current="@Current("/reading")">@Icon(ReadingIcon) @T("Reading")</a>
            <a href="/stats" aria-current="@Current("/stats")">@Icon(InsightsIcon) @T("Insights")</a>
        </nav>
    </div>
}

@* Shown by live.js when a page's live connection cannot start, which Blazor itself does not show. *@
<div id="live-unavailable" class="live-unavailable" role="alert" hidden data-nosnippet>
    <p><strong>@T("This page's buttons cannot reach Shelf.")</strong> @T("The live connection they use did not start in this browser. A browser extension that blocks scripts or WebSockets (uBlock Origin, NoScript, Privacy Badger), or a strict privacy setting, is the usual cause: allow this site, then reload. Links and forms still work.")</p>
    <a href="." class="reload">@T("Reload")</a>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @T("The connection dropped.")
    <a href="." class="reload">@T("Reload")</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private bool signedIn;
    private bool isAdmin;
    private bool isChild;
    private string? readerName;
    private Reminders? reminders;
    private List<SavedSearch> savedSearches = [];
    private int seriesAlerts;
    private bool fetching;
    private ImportSummary? import;
    private string importDone = "";

    private string? SavedCurrent(int id) =>
        new Uri(Navigation.Uri) is { AbsolutePath: "/library" } here
            && Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(here.Query).TryGetValue("saved", out var value) && value == id.ToString(System.Globalization.CultureInfo.InvariantCulture)
            ? "page"
            : null;

    [CascadingParameter]
    private Task<AuthenticationState>? Authentication { get; set; }

    // A plain open book of spines: the wordmark's only ornament.
    private static readonly RenderFragment Mark = @<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
        <rect x="3" y="4" width="4" height="16" rx="1" />
        <rect x="9" y="6" width="4" height="14" rx="1" />
        <rect x="15.2" y="5.2" width="4" height="15" rx="1" transform="rotate(-12 17.2 12.7)" />
    </svg>;

    private RenderFragment Sidebar => @<text>
        <a class="wordmark" href="/">@Mark shelf</a>
        <form class="search" action="/library" method="get" role="search" aria-label="@T("Search the library")" data-enhance>
            <label class="visually-hidden" for="@SearchId">@T("Search the library")</label>
            <input id="@SearchId" name="q" type="search" placeholder="@T("Search the library")" autocomplete="off" />
        </form>
        <a class="button primary" href="/library?add=1">@T("Add a book")</a>
        @* Five places to go; the rest is a click further, in groups that open by themselves on their own pages. *@
        <nav class="nav-main" aria-label="@T("Main")">
            <ul>
                <li><a href="/" aria-current="@Current("/")">@Icon(HomeIcon) @T("Home")</a></li>
                <li><a href="/library" aria-current="@Current("/library")">@Icon(LibraryIcon) @T("Library")</a></li>
                <li><a href="/reading" aria-current="@Current("/reading")">@Icon(ReadingIcon) @T("Reading")</a></li>
                <li>
                    <a href="/loans" aria-current="@Current("/loans")">
                        @Icon(LoansIcon) @T("Loans")
                        @if (reminders is { Any: true } due)
                        {
                            <span class="badge plain" aria-label="@T("{0} waiting", Waiting(due))">@Waiting(due)</span>
                        }
                    </a>
                </li>
                <li><a href="/stats" aria-current="@Current("/stats")">@Icon(InsightsIcon) @T("Insights")</a></li>
            </ul>
        </nav>
        <details class="nav-group" open="@(Within(BrowseLinks) || savedSearches.Count > 0 || seriesAlerts > 0)">
            <summary>@T("Browse")</summary>
            <ul>
                <li><a href="/library?status=Want" aria-current="@Current("/library?status=Want")">@T("Want to read")</a></li>
                <li><a href="/library?status=Finished" aria-current="@Current("/library?status=Finished")">@T("Finished")</a></li>
                @foreach (var search in savedSearches)
                {
                    <li><a href="@($"/library?{search.Query}&saved={search.Id}")" aria-current="@SavedCurrent(search.Id)">@search.Name</a></li>
                }
                <li><a href="/collections" aria-current="@Current("/collections")">@T("Collections")</a></li>
                <li>
                    <a href="/series" aria-current="@Current("/series")">
                        @T("Series")
                        @if (seriesAlerts > 0)
                        {
                            <span class="badge plain" aria-label="@T("{0} new", seriesAlerts)">@seriesAlerts</span>
                        }
                    </a>
                </li>
                <li><a href="/authors" aria-current="@Current("/authors")">@T("Authors")</a></li>
                <li><a href="/podcasts" aria-current="@Current("/podcasts")">@T("Podcasts")</a></li>
                <li><a href="/quotes" aria-current="@Current("/quotes")">@T("Quotes & highlights")</a></li>
                <li><a href="/search" aria-current="@Current("/search")">@T("Search inside books")</a></li>
                <li><a href="/next" aria-current="@Current("/next")">@T("What to read next")</a></li>
                @if (fetching)
                {
                    <li><a href="/wanted" aria-current="@Current("/wanted")">@T("Wanted")</a></li>
                }
                <li><a href="/clubs" aria-current="@Current("/clubs")">@T("Book clubs")</a></li>
                <li><a href="/free" aria-current="@Current("/free")">@T("Free books")</a></li>
                <li><a href="/years" aria-current="@Current("/years")">@T("Years")</a></li>
            </ul>
        </details>
        <details class="nav-group" open="@Within(CopiesLinks)">
            <summary>@T("Your copies")</summary>
            <ul>
                @if (!isChild)
                {
                    <li><a href="/shelves" aria-current="@Current("/shelves")">@T("Shelves")</a></li>
                }
                <li><a href="/places" aria-current="@Current("/places")">@T("Places")</a></li>
                <li><a href="/copies" aria-current="@Current("/copies")">@T("Condition")</a></li>
                <li><a href="/recommenders" aria-current="@Current("/recommenders")">@T("Recommenders")</a></li>
                <li><a href="/duplicates" aria-current="@Current("/duplicates")">@T("Duplicates")</a></li>
                <li><a href="/tidy" aria-current="@Current("/tidy")">@T("Tidy up")</a></li>
            </ul>
        </details>
        <details class="nav-group" open="@Within(SettingsLinks)">
            <summary>@T("Settings")</summary>
            <ul>
                <li><a href="/account" aria-current="@Current("/account")">@T("Account")</a></li>
                <li><a href="/activity" aria-current="@Current("/activity")">@T("Activity")</a></li>
                <li><a href="/backup" aria-current="@Current("/backup")">@T("Backup & restore")</a></li>
                <li><a href="/sync" aria-current="@Current("/sync")">@T("Devices")</a></li>
                <li><a href="/offline.html">@T("Offline reading")</a></li>
                @if (isAdmin)
                {
                    <li><a href="/admin" aria-current="@Current("/admin")">@T("Readers")</a></li>
                    <li><a href="/downloads" aria-current="@Current("/downloads")">@T("Downloads")</a></li>
                }
            </ul>
        </details>
        <div class="sidebar-foot">
            <p>
                <span class="reader-name">@readerName</span> ·
                <form class="inline" method="post" action="/account/signout">
                    <AntiforgeryToken />
                    <button type="submit" class="link">@T("Sign out")</button>
                </form>
            </p>
            <p><span title="@(ShelfVersion.Commit is null ? null : T("Built from {0}", ShelfVersion.Commit))">Shelf @ShelfVersion.Number</span> · <a href="@ShelfVersion.SourceUrl(Configuration)">@T("Source code")</a></p>
            <p>
                <a href="/books">JSON</a>
                @if (Environment.IsDevelopment())
                {
                    <span> · <a href="/openapi/v1.json">OpenAPI</a></span>
                }
            </p>
        </div>
    </text>;

    // The sidebar is drawn twice, once for wide screens and once in the phone drawer, so ids stay unique.
    private int searchCount;
    private string SearchId => $"library-search-{++searchCount}";

    protected override async Task OnParametersSetAsync()
    {
        var user = Authentication is null ? null : (await Authentication).User;
        signedIn = user?.Identity?.IsAuthenticated == true;
        readerName = user?.Identity?.Name;
        if (signedIn)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            reminders = await Asking.RemindersAsync(db);
            isAdmin = await ReaderRules.IsAdminAsync(db, db.ReaderId);
            isChild = await Family.IsRestrictedAsync(db);
            savedSearches = await db.SavedSearches.AsNoTracking().OrderBy(search => search.Name).ToListAsync();
            seriesAlerts = await SeriesWatch.CountAsync(db);
            fetching = Fetcher.Ready(await FetchRules.SettingsAsync(db)) && !isChild;
            var job = ImportJobs.Running(Services, db.ReaderId);
            import = job is null ? null : ImportJobs.Summarize(job, DateTimeOffset.UtcNow);
            importDone = job?.Title(true) ?? "";
        }
    }

    private bool Focused => System.Text.RegularExpressions.Regex.IsMatch(
        new Uri(Navigation.Uri).AbsolutePath, "^/library/[0-9]+/(read|listen)$");

    // The library's own views differ only by their query, so those links match it exactly.
    private string? Current(string href)
    {
        var here = new Uri(Navigation.Uri);
        var status = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(here.Query).TryGetValue("status", out var value) ? value.ToString() : "";
        var adding = here.Query.Contains("add=1", StringComparison.Ordinal);
        var matches = href switch
        {
            "/" => here.AbsolutePath == "/",
            "/library" => here.AbsolutePath == "/library" && status is not ("Want" or "Finished") && !adding && !here.Query.Contains("saved=", StringComparison.Ordinal),
            "/library?add=1" => here.AbsolutePath == "/library" && adding,
            _ when href.StartsWith("/library?status=", StringComparison.Ordinal) =>
                here.AbsolutePath == "/library" && !adding && string.Equals(status, href["/library?status=".Length..], StringComparison.OrdinalIgnoreCase),
            _ => here.AbsolutePath == href || here.AbsolutePath.StartsWith(href + "/", StringComparison.Ordinal),
        };
        return matches ? "page" : null;
    }

    private const string HomeIcon = "M4 11l8-6 8 6v8a1 1 0 0 1-1 1h-4v-6h-6v6H5a1 1 0 0 1-1-1z";
    private const string LibraryIcon = "M4 5h4v14H4zM10 5h4v14h-4zM16 6l3.5-.9 3 13.5-3.5.9z";
    private const string ReadingIcon = "M4 6c3-1.5 5.5-1.5 8 0v13c-2.5-1.5-5-1.5-8 0zM12 6c2.5-1.5 5-1.5 8 0v13c-3-1.5-5.5-1.5-8 0z";
    private const string LoansIcon = "M7 7h11l-3-3M17 17H6l3 3";
    private const string InsightsIcon = "M5 19V11M12 19V5M19 19v-6";

    private static readonly string[] BrowseLinks = ["/library?status=Want", "/library?status=Finished", "/collections", "/series", "/authors", "/podcasts", "/quotes", "/search", "/next", "/wanted", "/clubs", "/free", "/years"];
    private static readonly string[] CopiesLinks = ["/shelves", "/places", "/copies", "/recommenders", "/duplicates", "/tidy"];
    private static readonly string[] SettingsLinks = ["/account", "/activity", "/backup", "/sync", "/admin", "/downloads"];

    // A group opens by itself when the page shown is one of its own.
    private bool Within(string[] links) => links.Any(link => Current(link) is not null);

    private static RenderFragment Icon(string path) => @<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="@path" /></svg>;

    private static int Waiting(Reminders due) => due.LentOverdue + due.BorrowedOverdue + due.BorrowedDueSoon + due.Asks;

    private static IEnumerable<string> ReminderLines(Reminders due)
    {
        if (due.LentOverdue > 0)
        {
            yield return due.LentOverdue == 1 ? T("1 book you lent is overdue") : T("{0} books you lent are overdue", due.LentOverdue);
        }

        if (due.BorrowedOverdue > 0)
        {
            yield return due.BorrowedOverdue == 1 ? T("1 book you borrowed is overdue") : T("{0} books you borrowed are overdue", due.BorrowedOverdue);
        }

        if (due.BorrowedDueSoon > 0)
        {
            yield return due.BorrowedDueSoon == 1 ? T("1 borrowed book is due within three days") : T("{0} borrowed books are due within three days", due.BorrowedDueSoon);
        }

        if (due.Asks > 0)
        {
            yield return due.Asks == 1 ? T("1 reader has asked to borrow") : T("{0} readers have asked to borrow", due.Asks);
        }
    }
}
