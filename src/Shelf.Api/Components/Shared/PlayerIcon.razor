@* The player's icons: drawn in the text color, and hidden from screen readers, as the buttons carry the words. *@
<svg class="player-icon @Name" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    @switch (Name)
    {
        case "play":
            <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" stroke="none" />
            break;
        case "pause":
            <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor" stroke="none" />
            break;
        case "back":
            <path d="M4 12a8 8 0 1 0 2.6-5.9" /><path d="M4 4.5V9h4.5" />
            break;
        case "forward":
            <path d="M20 12a8 8 0 1 1-2.6-5.9" /><path d="M20 4.5V9h-4.5" />
            break;
        case "prev":
            <path d="M18 19 9 12l9-7z" fill="currentColor" stroke="none" /><path d="M6 5v14" />
            break;
        case "next":
            <path d="m6 5 9 7-9 7z" fill="currentColor" stroke="none" /><path d="M18 5v14" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "sleep":
            <path d="M20 13.5A8 8 0 1 1 10.5 4a6.5 6.5 0 0 0 9.5 9.5z" />
            break;
        case "volume":
            <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor" stroke="none" /><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";
}
