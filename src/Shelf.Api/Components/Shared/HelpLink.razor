@inject IConfiguration Configuration

@* A "?" beside a page's heading: the part of the documentation about this page, in a new tab. *@
<a class="help-link" href="@Docs.Url(Configuration, Page, Section)" target="_blank" rel="noopener" title="@T("Help with this page")" aria-label="@T("Help with this page")">?</a>

@code {
    [Parameter, EditorRequired]
    public string Page { get; set; } = "";

    [Parameter]
    public string? Section { get; set; }
}
