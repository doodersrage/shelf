@* A household library's books, each a way into reading or listening. *@
<ul class="family-books">
    @foreach (var book in Books)
    {
        <li>
            <BookCover Title="@book.Title" Url="@book.Cover" Width="5rem" />
            <span>
                <strong>@book.Title</strong>
                <span class="hint">@book.Author</span>
                <span>
                    @if (book.HasEbook)
                    {
                        <a href="/library/@book.Id/read" aria-label="@T("Read {0}", book.Title)">@T("Read")</a>
                    }
                    @if (book.HasAudio)
                    {
                        <a href="/library/@book.Id/listen" aria-label="@T("Listen to {0}", book.Title)">@T("Listen")</a>
                    }
                    @if (!book.HasEbook && !book.HasAudio)
                    {
                        <span class="hint">@T("On the shelf at home")</span>
                    }
                </span>
            </span>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<FamilyBook> Books { get; set; } = [];
}
