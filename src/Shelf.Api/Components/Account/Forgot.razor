@page "/forgot"
@attribute [AllowAnonymous]
@inject IEmailSender Email

<PageTitle>@T("Forgot the password") · Shelf</PageTitle>

<h1>@T("Forgot the password")</h1>

@if (!Email.Enabled)
{
    <p>@T("This shelf cannot send email, so an admin has to give you a new password. They can do it from Readers.")</p>
    <p class="hint"><a href="/signin">@T("Back to sign in")</a></p>
}
else if (Sent == "1")
{
    <p role="status">@T("If that address, or name, belongs to a reader with an email address, a link to choose a new password is on its way. It works for an hour.")</p>
    <p class="hint"><a href="/signin">@T("Back to sign in")</a></p>
}
else
{
    <p class="hint">@T("Enter the email address you sign in with, and we will send a link to choose a new password.")</p>
    <form class="account" method="post" action="/account/forgot">
        <AntiforgeryToken />
        <label>
            @T("Email address")
            <input name="who" maxlength="@EmailRules.MaxAddressLength" autocomplete="username" required autofocus />
        </label>
        <button type="submit">@T("Send the link")</button>
    </form>
    <p class="hint"><a href="/signin">@T("Back to sign in")</a></p>
}

@code {
    [SupplyParameterFromQuery]
    public string? Sent { get; set; }
}
