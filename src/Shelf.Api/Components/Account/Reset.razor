@page "/reset"
@attribute [AllowAnonymous]
@inject IDbContextFactory<ShelfDb> DbFactory

<PageTitle>@T("Choose a new password") · Shelf</PageTitle>

<h1>@T("Choose a new password")</h1>

@if (!live)
{
    <p>@ReaderRules.Describe(AccountProblem.ResetExpired)</p>
    <p class="hint"><a href="/forgot">@T("Ask for a new link")</a></p>
}
else
{
    @if (Problem is AccountProblem problem)
    {
        <p class="validation-message" role="alert">@ReaderRules.Describe(problem)</p>
    }

    <form class="account" method="post" action="/account/reset">
        <AntiforgeryToken />
        <input type="hidden" name="token" value="@Token" />
        <label>
            @T("New password, at least {0} characters", ReaderRules.MinPasswordLength)
            <input type="password" name="password" minlength="@ReaderRules.MinPasswordLength" maxlength="@ReaderRules.MaxPasswordLength" autocomplete="new-password" required autofocus />
        </label>
        <label>
            @T("The new password again")
            <input type="password" name="confirm" minlength="@ReaderRules.MinPasswordLength" maxlength="@ReaderRules.MaxPasswordLength" autocomplete="new-password" required />
        </label>
        <p class="hint">@T("Saving it signs you out everywhere else.")</p>
        <button type="submit">@T("Save the new password")</button>
    </form>
}

@code {
    private bool live;

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "problem")]
    public string? ProblemCode { get; set; }

    private AccountProblem? Problem =>
        Enum.TryParse<AccountProblem>(ProblemCode, out var problem) && Enum.IsDefined(problem) ? problem : null;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        live = await EmailRules.ResetIsLiveAsync(db, Token);
    }
}
