@page "/signin"
@attribute [AllowAnonymous]

<PageTitle>Sign in · Shelf</PageTitle>

<h1>Sign in</h1>

@if (Notice == "changed")
{
    <p class="hint" role="status">Your password is changed. Sign in with the new one.</p>
}
else if (Notice == "removed")
{
    <p class="hint" role="status">Your account is deleted.</p>
}

@if (Problem is AccountProblem problem)
{
    <p class="validation-message" role="alert">@ReaderRules.Describe(problem)</p>
}

<form class="account" method="post" action="/account/signin">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />
    <label>
        Name
        <input name="name" value="@Name" maxlength="@ReaderRules.MaxNameLength" autocomplete="username" required autofocus />
    </label>
    <label>
        Password
        <input type="password" name="password" maxlength="@ReaderRules.MaxPasswordLength" autocomplete="current-password" required />
    </label>
    <button type="submit">Sign in</button>
</form>

<p class="hint">New to this shelf? <a href="@SignUpHref">Make an account</a></p>
<p class="hint">Forgot the password? An admin of this shelf can give you a new one.</p>

@code {
    [SupplyParameterFromQuery(Name = "problem")]
    public string? ProblemCode { get; set; }

    [SupplyParameterFromQuery]
    public string? Name { get; set; }

    [SupplyParameterFromQuery]
    public string? Notice { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private AccountProblem? Problem =>
        Enum.TryParse<AccountProblem>(ProblemCode, out var problem) && Enum.IsDefined(problem) ? problem : null;

    private string? SafeReturnUrl => ReaderRules.IsLocalUrl(ReturnUrl) ? ReturnUrl : null;

    private string SignUpHref => SafeReturnUrl is null ? "/signup" : $"/signup?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";
}
