@page "/signin"
@attribute [AllowAnonymous]
@inject IEmailSender Email

<PageTitle>@T("Sign in") · Shelf</PageTitle>

<h1>@T("Sign in")</h1>

@if (Notice == "changed")
{
    <p class="hint" role="status">@T("Your password is changed. Sign in with the new one.")</p>
}
else if (Notice == "removed")
{
    <p class="hint" role="status">@T("Your account is deleted.")</p>
}
else if (Notice == "reset")
{
    <p class="hint" role="status">@T("Your new password is saved. Sign in with it.")</p>
}

@if (Problem is AccountProblem problem)
{
    <p class="validation-message" role="alert">@ReaderRules.Describe(problem)</p>
}

<form class="account" method="post" action="/account/signin">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />
    <label>
        @T("Name")
        <input name="name" value="@Name" maxlength="@ReaderRules.MaxNameLength" autocomplete="username" required autofocus />
    </label>
    <label>
        @T("Password")
        <input type="password" name="password" maxlength="@ReaderRules.MaxPasswordLength" autocomplete="current-password" required />
    </label>
    <button type="submit">@T("Sign in")</button>
</form>

@* Shown by passkey.js when the browser can use passkeys. *@
<div class="account passkey-signin" data-passkey-panel hidden>
    <p class="hint">@T("Or, with a passkey saved on this device or in a password manager:")</p>
    <button type="button" data-passkey-signin data-return-url="@SafeReturnUrl">@T("Sign in with a passkey")</button>
    <p class="validation-message" data-passkey-status role="alert" hidden></p>
</div>

<p class="hint">@T("New to this shelf?") <a href="@SignUpHref">@T("Make an account")</a></p>
@if (Email.Enabled)
{
    <p class="hint"><a href="/forgot">@T("Forgot the password?")</a></p>
}
else
{
    <p class="hint">@T("Forgot the password? An admin of this shelf can give you a new one.")</p>
}

@code {
    [SupplyParameterFromQuery(Name = "problem")]
    public string? ProblemCode { get; set; }

    [SupplyParameterFromQuery]
    public string? Name { get; set; }

    [SupplyParameterFromQuery]
    public string? Notice { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private AccountProblem? Problem =>
        Enum.TryParse<AccountProblem>(ProblemCode, out var problem) && Enum.IsDefined(problem) ? problem : null;

    private string? SafeReturnUrl => ReaderRules.IsLocalUrl(ReturnUrl) ? ReturnUrl : null;

    private string SignUpHref => SafeReturnUrl is null ? "/signup" : $"/signup?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";
}
